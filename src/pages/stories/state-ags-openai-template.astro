<script>
(function () {
  const canvas = document.querySelector('.state-ags-openai-template-canvas') as HTMLCanvasElement;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  /* ── Colours ── */
  const cs = getComputedStyle(document.documentElement);
  const STORY_HEX = cs.getPropertyValue('--story').trim() || '#5b6cff';
  function hx(h: string): [number, number, number] {
    const v = h.replace('#', '');
    return [parseInt(v.slice(0, 2), 16), parseInt(v.slice(2, 4), 16), parseInt(v.slice(4, 6), 16)];
  }
  const [sR, sG, sB] = hx(STORY_HEX);
  function storyA(a: number) { return `rgba(${sR},${sG},${sB},${Math.max(0, Math.min(1, a))})`; }
  function dimA(a: number) { return `rgba(232,232,232,${Math.max(0, Math.min(1, a))})`; }

  /* ── State ── */
  let W = 0, H = 0, raf = 0, frame = 0, visible = true;

  /* ── Resize ── */
  const ro = new ResizeObserver(() => {
    W = canvas.offsetWidth;
    H = canvas.offsetHeight;
    canvas.width = W * devicePixelRatio;
    canvas.height = H * devicePixelRatio;
    ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
  });
  ro.observe(canvas);

  /* ── Visibility ── */
  const io = new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { threshold: 0 });
  io.observe(canvas);

  /* ── Reduced motion ── */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Constants ── */
  const CYC = 1560;
  const NC = 8;
  const NP = 7;

  /* Column types in alphabetical state order: AZ AR ID IA KS MT NE WV */
  const TY: string[] = ['ring', 'lid', 'ring', 'lid', 'bare', 'ring', 'bare', 'halfarc'];
  /* Thread vertical displacement per column */
  const DY = [0, 10, 0, 10, -10, 0, -10, 4];

  /* ── Easing ── */
  function eo3(t: number) { return 1 - (1 - t) * (1 - t) * (1 - t); }
  function eio3(t: number) { return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; }

  /* ── Precomputed template offsets (shared by all 8 copies) ── */
  const TPL: { a: number; d: number; ba: number; bs: number }[] = [];
  for (let i = 0; i < NP; i++) {
    TPL.push({
      a: (Math.PI * 2 / NP) * i + (Math.random() - 0.5) * 0.6,
      d: 8 + Math.random() * 14,
      ba: Math.random() * Math.PI * 2,
      bs: 0.008 + Math.random() * 0.008
    });
  }

  /* ── Scatter positions for form-phase start (relative to center) ── */
  const SC: { x: number; y: number }[] = [];
  for (let i = 0; i < NP; i++) {
    const a = Math.random() * Math.PI * 2;
    const d = 40 + Math.random() * 60;
    SC.push({ x: Math.cos(a) * d, y: Math.sin(a) * d });
  }

  /* ── Bare-drift targets (2 bare columns), relative to column centre ── */
  const BD: { x: number; y: number }[][] = [[], []];
  for (let b = 0; b < 2; b++) {
    for (let i = 0; i < NP; i++) {
      const a = Math.random() * Math.PI * 2;
      const d = (0.2 + Math.random() * 0.1) * 200;
      BD[b].push({ x: Math.cos(a) * d, y: Math.sin(a) * d });
    }
  }

  /* ── Ambient dust motes (12) ── */
  const motes: { x: number; y: number; vx: number; vy: number; a: number; p: number }[] = [];
  for (let i = 0; i < 12; i++) {
    motes.push({
      x: Math.random() * 960, y: Math.random() * 380,
      vx: (Math.random() - 0.5) * 0.5, vy: (Math.random() - 0.5) * 0.5,
      a: 0.04 + Math.random() * 0.03,
      p: Math.random() * Math.PI * 2
    });
  }

  /* ── Pre-allocated thread point array ── */
  const TPT: { x: number; y: number }[] = [];
  for (let i = 0; i < NC; i++) TPT.push({ x: 0, y: 0 });

  /* ── Shared return value for position helpers (no alloc in loop) ── */
  let _px = 0, _py = 0;

  function colCX(c: number) { return (c + 0.5) * W / NC; }
  function getR() { return Math.min(26, (W / NC) * 0.36); }

  /** Template-cluster position for particle i around (cx, cy). */
  function tplXY(i: number, cx: number, cy: number, f: number, br: number) {
    const t = TPL[i];
    _px = cx + Math.cos(t.a + f * 0.002) * (t.d + br) + Math.cos(f * t.bs + t.ba) * 1.5;
    _py = cy + Math.sin(t.a + f * 0.002) * (t.d + br) + Math.sin(f * t.bs * 1.3 + t.ba) * 1.5;
  }

  /** Enclosure target for particle i of the given type. bi = bare index (0 or 1). */
  function encXY(ty: string, i: number, cx: number, cy: number, r: number, bi: number) {
    if (ty === 'ring') {
      const a = (Math.PI * 2 / 7) * i - Math.PI / 2;
      _px = cx + Math.cos(a) * r;
      _py = cy + Math.sin(a) * r;
    } else if (ty === 'lid') {
      const sp = r * 0.3;
      const tw = sp * 6;
      _px = cx - tw / 2 + sp * i;
      _py = cy - r * 0.55;
    } else if (ty === 'halfarc') {
      const a = (170 + (200 / 6) * i) * Math.PI / 180;
      _px = cx + Math.cos(a) * r;
      _py = cy + Math.sin(a) * r;
    } else {
      _px = cx + BD[bi][i].x;
      _py = cy + BD[bi][i].y;
    }
  }

  /* ── Drawing micro-helpers ── */
  function dot(x: number, y: number, al: number, tint: boolean) {
    ctx.beginPath();
    ctx.arc(x, y, 2.5, 0, Math.PI * 2);
    ctx.fillStyle = dimA(al);
    ctx.fill();
    if (tint) {
      ctx.beginPath();
      ctx.arc(x, y, 2, 0, Math.PI * 2);
      ctx.fillStyle = storyA(0.08);
      ctx.fill();
    }
  }

  function drawCore(cx: number, cy: number, al: number, r: number) {
    if (al < 0.01) return;
    const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, r * 0.6);
    g.addColorStop(0, storyA(0.15 * Math.min(1, al / 0.6)));
    g.addColorStop(1, storyA(0));
    ctx.beginPath();
    ctx.arc(cx, cy, r * 0.6, 0, Math.PI * 2);
    ctx.fillStyle = g;
    ctx.fill();
    ctx.beginPath();
    ctx.arc(cx, cy, 4, 0, Math.PI * 2);
    ctx.fillStyle = storyA(al);
    ctx.fill();
  }

  /* ── Main draw ── */
  function draw() {
    ctx.clearRect(0, 0, W, H);
    if (!W || !H) return;

    const mx = W / 2;
    const my = H / 2;
    const r = getR();
    const c = frame % CYC;
    const br = Math.sin(frame * 0.035) * 2; /* ~3 s breath */

    /* ── Ambient motes ── */
    for (let m = 0; m < motes.length; m++) {
      ctx.beginPath();
      ctx.arc(motes[m].x, motes[m].y, 1.5, 0, Math.PI * 2);
      ctx.fillStyle = dimA(motes[m].a);
      ctx.fill();
    }

    /* ================================================================
       PHASE 1  FORM  (0 – 180)
       ================================================================ */
    if (c < 180) {
      const t = eo3(c / 180);
      const fadeIn = Math.min(1, c / 30);
      for (let i = 0; i < NP; i++) {
        tplXY(i, mx, my, frame, 0);
        const tx = _px, ty = _py;
        const px = (mx + SC[i].x) + (tx - (mx + SC[i].x)) * t;
        const py = (my + SC[i].y) + (ty - (my + SC[i].y)) * t;
        dot(px, py, (0.12 + 0.13 * t) * fadeIn, true);
      }
    }

    /* ================================================================
       PHASE 2  HOLD  (180 – 300)
       ================================================================ */
    else if (c < 300) {
      for (let i = 0; i < NP; i++) {
        tplXY(i, mx, my, frame, br);
        dot(_px, _py, 0.25, true);
      }
    }

    /* ================================================================
       PHASE 3  COPY  (300 – 600)
       ================================================================ */
    else if (c < 600) {
      const t = eio3((c - 300) / 300);
      for (let col = 0; col < NC; col++) {
        const cx = mx + (colCX(col) - mx) * t;
        for (let i = 0; i < NP; i++) {
          tplXY(i, cx, my, frame, br * (1 - t * 0.5));
          dot(_px, _py, 0.25, true);
        }
      }
    }

    /* ================================================================
       PHASE 4  SAMENESS  (600 – 720)
       ================================================================ */
    else if (c < 720) {
      const t = (c - 600) / 120;
      for (let col = 0; col < NC; col++) {
        const cx = colCX(col);
        for (let i = 0; i < NP; i++) {
          tplXY(i, cx, my, frame, br * 0.5);
          dot(_px, _py, 0.25, true);
        }
        drawCore(cx, my, t * 0.6, r);
      }
    }

    /* ================================================================
       PHASES 5 – 8  (720 – 1560)
       ================================================================ */
    else {
      for (let col = 0; col < NC; col++) {
        const cx = colCX(col);
        const ty = TY[col];
        const bi = col === 4 ? 0 : 1;

        /* Core vertical displacement (thread phases) */
        let dy = 0;
        if (c >= 1080 && c < 1320) {
          const dt = c < 1140 ? 0 : Math.min(1, (c - 1140) / 120);
          dy = DY[col] * eio3(dt);
        } else if (c >= 1320) {
          dy = DY[col] * Math.max(0, 1 - (c - 1320) / 60);
        }
        const cy = my + dy;

        /* ── Phase 5: DIVERGE (720 – 960) ── */
        if (c < 960) {
          const t = eio3((c - 720) / 240);
          for (let i = 0; i < NP; i++) {
            tplXY(i, cx, my, frame, br * 0.5 * (1 - t));
            const fx = _px, fy = _py;
            encXY(ty, i, cx, my, r, bi);
            const ex = _px, ey = _py;
            const px = fx + (ex - fx) * t;
            const py = fy + (ey - fy) * t;
            if (ty === 'bare') {
              const al = 0.25 - 0.19 * Math.min(1, t * 240 / 180);
              dot(px, py, al, al > 0.10);
            } else {
              dot(px, py, 0.25, true);
            }
          }
        }
        /* ── Phases 6-7: SETTLE + THREAD (960 – 1320) ── */
        else if (c < 1320) {
          for (let i = 0; i < NP; i++) {
            encXY(ty, i, cx, cy, r, bi);
            dot(_px, _py, ty === 'bare' ? 0.06 : 0.25, ty !== 'bare');
          }
        }
        /* ── Phase 8: DISSOLVE (1320 – 1560) ── */
        else {
          const t = eio3((c - 1320) / 240);
          for (let i = 0; i < NP; i++) {
            encXY(ty, i, cx, cy, r, bi);
            const fx = _px, fy = _py;
            const toX = mx + SC[i].x;
            const toY = my + SC[i].y;
            const px = fx + (toX - fx) * t;
            const py = fy + (toY - fy) * t;
            const fa = ty === 'bare' ? 0.06 : 0.25;
            let al = fa + (0.20 - fa) * t;
            /* Extra fade in last 30 frames for seamless loop reset */
            if (c > 1530) al *= (1560 - c) / 30;
            dot(px, py, al, true);
          }
        }

        /* ── Core rendering ── */
        let ca = 0;
        if (c < 960) {
          /* Diverge */
          const t = eio3((c - 720) / 240);
          if (ty === 'lid') ca = 0.6 - 0.35 * t;
          else if (ty === 'ring') ca = 0.6 + 0.1 * t;
          else ca = 0.6;
        } else if (c < 1320) {
          /* Settle + Thread */
          if (ty === 'ring') ca = 0.7 + 0.2 * Math.sin(frame * 0.052);
          else if (ty === 'lid') ca = 0.25;
          else ca = 0.6;
        } else {
          /* Dissolve */
          const t = (c - 1320) / 240;
          const base = ty === 'ring' ? 0.7 : (ty === 'lid' ? 0.25 : 0.6);
          ca = base * (1 - t);
        }
        drawCore(cx, cy, ca, r);

        /* ── Heptagon ring stroke (ring columns, settle+thread+dissolve-fade) ── */
        if (ty === 'ring' && c >= 960) {
          let sa = 1;
          if (c >= 1320) sa = Math.max(0, 1 - (c - 1320) / 60);
          if (sa > 0.01) {
            ctx.beginPath();
            for (let i = 0; i <= NP; i++) {
              const a = (Math.PI * 2 / 7) * (i % 7) - Math.PI / 2;
              const rx = cx + Math.cos(a) * r;
              const ry = cy + Math.sin(a) * r;
              if (i === 0) ctx.moveTo(rx, ry);
              else ctx.lineTo(rx, ry);
            }
            ctx.closePath();
            ctx.strokeStyle = storyA(0.15 * sa);
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }

        /* ── Half-arc stroke (WV column, settle+thread+dissolve-fade) ── */
        if (ty === 'halfarc' && c >= 960) {
          let sa = 1;
          if (c >= 1320) sa = Math.max(0, 1 - (c - 1320) / 60);
          if (sa > 0.01) {
            ctx.beginPath();
            ctx.arc(cx, cy, r, 170 * Math.PI / 180, 370 * Math.PI / 180);
            ctx.strokeStyle = storyA(0.15 * sa);
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }

        /* ── Arkansas inner arc (col 1 only, settle+thread) ── */
        if (col === 1 && c >= 960 && c < 1320) {
          const af = c - 960;
          const acyc = 80; /* 50 sweep + 30 retract */
          const al = af % acyc;
          const ai = Math.floor(af / acyc);
          const aso = (ai * 17) % 360;
          let sd = 0;
          if (al < 50) sd = (al / 50) * 330;
          else sd = 330 * (1 - (al - 50) / 30);
          if (sd > 1) {
            const sa = aso * Math.PI / 180;
            ctx.beginPath();
            ctx.arc(cx, cy, r * 0.55, sa, sa + sd * Math.PI / 180);
            ctx.strokeStyle = storyA(0.5);
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }
      } /* end column loop */

      /* ── Thread polyline (phase 7 + dissolve fade) ── */
      if (c >= 1080 && c < 1380) {
        let ta = 0;
        let de = 0;
        if (c < 1320) {
          /* Thread phase: fade in over 60 frames, then displace */
          ta = 0.18 * Math.min(1, (c - 1080) / 60);
          const dt = c < 1140 ? 0 : Math.min(1, (c - 1140) / 120);
          de = eio3(dt);
        } else {
          /* Dissolve: fade out over 60 frames */
          ta = 0.18 * Math.max(0, 1 - (c - 1320) / 60);
          de = Math.max(0, 1 - (c - 1320) / 60);
        }

        if (ta > 0.005) {
          /* Tremor when taut (disable for reduced-motion static) */
          const tremor = (!reduced && de > 0.9) ? Math.sin(frame * 7.3) * 0.5 : 0;

          for (let col = 0; col < NC; col++) {
            TPT[col].x = colCX(col);
            TPT[col].y = my + DY[col] * de + tremor;
          }

          /* Main thread stroke */
          ctx.beginPath();
          for (let i = 0; i < NC; i++) {
            if (i === 0) ctx.moveTo(TPT[i].x, TPT[i].y);
            else ctx.lineTo(TPT[i].x, TPT[i].y);
          }
          ctx.strokeStyle = storyA(ta);
          ctx.lineWidth = 1;
          ctx.stroke();

          /* Red flush on segments touching column 2 (frames 1200-1240) */
          if (c >= 1200 && c <= 1240) {
            const ra = 0.5 * Math.sin(((c - 1200) / 40) * Math.PI);
            if (ra > 0.01) {
              ctx.beginPath();
              ctx.moveTo(TPT[0].x, TPT[0].y);
              ctx.lineTo(TPT[1].x, TPT[1].y);
              ctx.lineTo(TPT[2].x, TPT[2].y);
              ctx.strokeStyle = `rgba(255,77,77,${ra.toFixed(3)})`;
              ctx.lineWidth = 1.5;
              ctx.stroke();
            }
          }
        }
      }
    } /* end phases 5-8 */
  }

  /* ── Update motes ── */
  function updateMotes() {
    for (let m = 0; m < motes.length; m++) {
      const mo = motes[m];
      mo.x += mo.vx + Math.sin(frame * 0.01 + mo.p) * 0.08;
      mo.y += mo.vy + Math.cos(frame * 0.012 + mo.p) * 0.08;
      if (W > 0) { if (mo.x < 0) mo.x += W; else if (mo.x > W) mo.x -= W; }
      if (H > 0) { if (mo.y < 0) mo.y += H; else if (mo.y > H) mo.y -= H; }
    }
  }

  /* ── Loop ── */
  function tick() {
    if (!visible) { raf = requestAnimationFrame(tick); return; }
    updateMotes();
    draw();
    frame++;
    raf = requestAnimationFrame(tick);
  }

  /* ── Init ── */
  if (reduced) {
    frame = 1245; /* Phase 7 peak: full zigzag, AR arc ~297 deg, no red */
    const go = () => {
      if (!W) { requestAnimationFrame(go); return; }
      for (let m = 0; m < motes.length; m++) {
        motes[m].x = Math.random() * W;
        motes[m].y = Math.random() * H;
      }
      draw();
    };
    requestAnimationFrame(go);
  } else {
    raf = requestAnimationFrame(tick);
  }

  /* ── Cleanup ── */
  window.addEventListener('pagehide', () => {
    cancelAnimationFrame(raf);
    ro.disconnect();
    io.disconnect();
  });
})();
</script>

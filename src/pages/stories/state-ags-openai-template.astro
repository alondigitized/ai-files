---
import StoryLayout from '../../layouts/StoryLayout.astro';
import stories from '../../data/stories.json';

const story = stories.find(s => s.slug === 'state-ags-openai-template')!;
---

<style is:global>
.phantom-wrap { width: 100%; margin: 0; line-height: 0; }
.state-ags-openai-template-canvas { display: block; width: 100%; height: 380px; background: var(--bg); }


/* === REENACTMENT B — THE SIGNATURE BLOCK === */
.sag-sig { margin: 2rem 0; }
.sag-sig-stack {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  gap: 0.9rem;
  list-style: none;
  margin: 0;
  padding: 0;
}
.sag-sig-card {
  position: relative;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 0.3rem;
  padding: 0.9rem 0.85rem 0.8rem 2.3rem;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 0.72rem;
  line-height: 1.5;
  color: var(--text);
  counter-reset: sagline;
}
.sag-sig-card::before {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 1.8rem;
  border-left: 1px solid var(--border);
}
.sag-sig-ln { display: block; position: relative; counter-increment: sagline; }
.sag-sig-ln::before {
  content: counter(sagline);
  position: absolute;
  left: -2.05rem;
  width: 1.2rem;
  text-align: right;
  font-family: 'Courier New', monospace;
  font-size: 0.58rem;
  line-height: 1.5rem;
  color: var(--muted);
}
.sag-sig-state { font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; font-size: 0.66rem; }
.sag-sig-signer { margin-bottom: 0.35rem; }
.sag-sig-other { color: var(--muted); margin: 0.3rem 0; }
.sag-sig-kfc {
  border-left: 2px solid var(--story);
  background: color-mix(in srgb, var(--story) 12%, transparent);
  padding: 0.3rem 0.45rem;
  margin: 0.35rem 0;
}
.sag-sig-kfc .sag-sig-ln::before { left: calc(-2.05rem - 0.45rem - 2px); }
.sag-sig-firm { font-weight: 700; color: var(--story); letter-spacing: 0.03em; }
.sag-sig-fn { color: var(--muted); font-style: italic; }
.sag-sig-caption {
  font-size: 0.72rem;
  color: var(--muted);
  font-style: italic;
  margin-top: 1.6rem;
  padding-top: 0.55rem;
  border-top: 1px solid var(--border);
}
@media (min-width: 720px) {
  .sag-sig-card:nth-child(even) { transform: translateY(0.9rem); }
}

/* === REENACTMENT A — THE REMEDY MATRIX === */
.sag-matrix { margin: 2rem 0; }
.sag-matrix-wrap {
  border: 1px solid var(--border);
  border-radius: 0.6rem;
  overflow-x: auto;
  background: var(--surface);
}
.sag-matrix-wrap:focus-visible { outline: 2px solid var(--story); outline-offset: 2px; }
.sag-matrix-table { border-collapse: collapse; width: 100%; min-width: 900px; font-size: 0.72rem; }
.sag-matrix-table th,
.sag-matrix-table td {
  padding: 0.5rem 0.5rem;
  border-bottom: 1px solid var(--border);
  text-align: center;
  vertical-align: top;
}
.sag-matrix-table thead th {
  font-size: 0.58rem;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--muted);
  font-weight: 700;
  line-height: 1.35;
}
.sag-matrix-state {
  position: sticky;
  left: 0;
  z-index: 1;
  background: var(--surface);
  text-align: left !important;
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
  border-right: 1px solid var(--border);
}
.sag-matrix-cell { font-family: 'Courier New', monospace; color: var(--text); }
.sag-matrix-hit {
  background: color-mix(in srgb, var(--story) 18%, transparent);
  color: var(--text);
  font-weight: 700;
}
.sag-matrix-nil { color: var(--muted); }
.sag-matrix-pen { font-family: 'Courier New', monospace; text-align: left !important; color: var(--text); font-size: 0.66rem; line-height: 1.45; }
.sag-matrix-tx-label th {
  text-align: left;
  font-size: 0.58rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  font-weight: 700;
  padding-top: 0.8rem;
  border-top: 2px dashed var(--border);
  border-bottom: none;
}
.sag-matrix-caption,
.sag-matrix-notes { font-size: 0.7rem; color: var(--muted); line-height: 1.5; margin-top: 0.6rem; }
.sag-matrix-caption { font-style: italic; }

/* === REENACTMENT C — THE REDLINE === */
.sag-diff {
  margin: 2rem 0;
  border: 1px solid var(--border);
  border-radius: 0.6rem;
  overflow: hidden;
  background: var(--surface);
}
.sag-diff-cols { display: grid; grid-template-columns: 1fr 1fr; }
.sag-diff-col {
  padding: 1rem 1.1rem;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 0.86rem;
  line-height: 1.75;
  color: var(--text);
}
.sag-diff-col + .sag-diff-col { border-left: 1px solid var(--border); }
.sag-diff-label {
  font-family: 'Courier New', monospace;
  font-size: 0.6rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  font-weight: 700;
  margin-bottom: 0.6rem;
}
.sag-diff-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.75rem; }
.sag-diff-tag {
  font-family: 'Courier New', monospace;
  font-size: 0.6rem;
  line-height: 1.4;
  color: var(--muted);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 0.1rem 0.5rem;
}
.sag-diff-col del {
  color: var(--muted);
  text-decoration: line-through;
  text-decoration-color: var(--muted);
}
.sag-diff-col ins {
  color: var(--text);
  text-decoration: underline;
  text-decoration-color: var(--story);
  text-decoration-thickness: 2px;
  text-underline-offset: 3px;
  background: color-mix(in srgb, var(--story) 12%, transparent);
}
.sag-diff-caption {
  font-size: 0.72rem;
  color: var(--muted);
  font-style: italic;
  padding: 0.55rem 1.1rem;
  border-top: 1px solid var(--border);
}
@media (max-width: 640px) {
  .sag-diff-cols { grid-template-columns: 1fr; }
  .sag-diff-col + .sag-diff-col { border-left: none; border-top: 1px solid var(--border); }
}
</style>

<StoryLayout story={story}>
  <div class="container">

    <section class="section" id="eight-courthouses">
      <h2><span class="num">01 — Eight Courthouses</span>One Day, Eight Courts</h2>
      <p>Item n on page 72 of Arkansas’s complaint against OpenAI asks a Faulkner County circuit judge to “enjoin Defendants from creating models capable of recursive self-improvement until they can ensure that such models will be aligned with human values.” Kansas filed its petition against OpenAI the same day, with the same six New York and Los Angeles lawyers on its signature page, and asked for nothing of the kind.</p>
      <p>On 14 October 2026, the attorneys general of Arizona, Arkansas, Idaho, Iowa, Kansas, Montana, Nebraska and West Virginia each sued OpenAI in their own state court. The suits went to Maricopa, Faulkner, Ada, Polk, Shawnee, Lewis and Clark, Buffalo and Mason counties. Four copies carry clerk stamps. According to those stamps, Kansas filed at 8:30 a.m., Nebraska at 9:51 a.m. Central, Arkansas at 10:36 a.m. and West Virginia at 2:00 p.m. The Arizona, Idaho, Iowa and Montana copies have no stamp and no case number. They are dated 14 October, and Law360 reported the next day that all eight states had sued.</p>
      <p>The captions name the same eight OpenAI entities, from OpenAI Global, LLC to OpenAI Holdings, LLC. Sam Altman is not a defendant in any of them. Each state sues under its own law:</p>
      <ul>
        <li>Arizona: the Consumer Fraud Act.</li>
        <li>Arkansas: the Deceptive Trade Practices Act and a children-and-teens privacy statute.</li>
        <li>Idaho: the Consumer Protection Act.</li>
        <li>Iowa: the Consumer Fraud Act.</li>
        <li>Kansas: the Consumer Protection Act.</li>
        <li>Montana: the Consumer Protection Act and its consumer data privacy law.</li>
        <li>Nebraska: the Consumer Protection Act, the Uniform Deceptive Trade Practices Act and the Age-Appropriate Online Design Code Act.</li>
        <li>West Virginia: the Consumer Credit and Protection Act.</li>
      </ul>
      <p>These are consumer-fraud and privacy laws. None of them is an AI statute.</p>
      <p>The central allegation in every filing is that OpenAI misled the public about how safe ChatGPT is. No court has ruled on that claim. The relief sections at the back of each filing reach past consumer fraud: they ask judges to set conditions on how OpenAI builds and tests its most advanced models. In these suits, the requests that would govern how frontier models are tested sit in the last few pages of each filing.</p>
    </section>
    <section class="section" id="additional-counsel">
      <h2><span class="num">02 — Additional Counsel</span>The Signature Page</h2>
      <p>Arizona’s first page says: “Additional counsel for Plaintiff on signature page.” On all eight filings, that additional counsel includes the same firm. Kibler Fowler &amp; Cave LLP appears with the same six attorneys every time. Michael D. Kibler, Michael S. Carnevale and Stephen F. Raiola are listed at 270 Madison Avenue, Suite 1410, New York. John D. Fowler, Jean Rhee and Jesse Mentz are listed at 11100 Santa Monica Blvd., Suite 600, Los Angeles. Each name carries an asterisk, and a footnote says the lawyers will seek admission to practice in that state. The footnote’s wording changes slightly from state to state, as the signature pages below show.</p>

<script>
(function () {
  const canvas = document.querySelector('.aisi-unsanctioned-agent-actions-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  // --- Read CSS custom properties with fallbacks ---
  const bgColor = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim() || '#0d0d0d';
  const storyColor = getComputedStyle(document.documentElement).getPropertyValue('--story').trim() || '#7dd3fc';

  // --- Hex-to-RGB with strict regex guard ---
  function hexToRgb(hex: string): [number, number, number] {
    const cleaned = hex.startsWith('#') ? hex.slice(1) : hex;
    if (!/^[0-9a-f]{6}$/i.test(cleaned)) return [125, 211, 252]; // safe fallback = #7dd3fc
    return [parseInt(cleaned.slice(0, 2), 16), parseInt(cleaned.slice(2, 4), 16), parseInt(cleaned.slice(4, 6), 16)];
  }

  const [sR, sG, sB] = hexToRgb(storyColor);

  // --- Color helpers ---
  function storyA(a: number): string { return `rgba(${sR},${sG},${sB},${Math.max(0, Math.min(1, a))})`; }
  function dimA(a: number): string { return `rgba(232,232,232,${Math.max(0, Math.min(1, a))})`; }
  function clamp(v: number, lo: number, hi: number): number { return v < lo ? lo : v > hi ? hi : v; }

  // --- Phase thresholds (~25s at 60fps = 1500 frames) ---
  const P_CONTAINMENT = 240;     // 0-240: calm orbit
  const P_SOCIAL = 600;          // 240-600: glow seeps through boundary
  const P_INSCRIPTION = 900;     // 600-900: mark materializes outside
  const P_DISCOVERY = 1320;      // 900-1320: second particle finds mark
  const P_HOLD = 1440;           // 1320-1440: dual state hold
  const CYCLE = 1500;            // 1440-1500: fade + black hold + reset

  // --- State ---
  let W = 0, H = 0, frame = 0, rafId = 0;
  let isVisible = true;

  // --- Boundary ring ---
  const RING_RADIUS_RATIO = 0.22; // proportion of min(W,H)
  let ringCX = 0, ringCY = 0, ringR = 0;

  // --- Agent particle (inside ring) ---
  interface Agent {
    angle: number;       // current orbital angle
    orbitR: number;      // orbital radius (~60px)
    alpha: number;       // opacity
    glowRadius: number;  // seep glow radius
    glowAlpha: number;   // seep glow opacity
    speed: number;       // angular speed rad/frame
  }
  const agent: Agent = { angle: 0, orbitR: 60, alpha: 1.0, glowRadius: 0, glowAlpha: 0, speed: 0.008 };

  // --- Ambient particles (outside ring) ---
  const NUM_AMBIENT = 15;
  interface Ambient {
    x: number; y: number;
    vx: number; vy: number;
    baseAlpha: number;
    alpha: number;
    radius: number;
    illuminated: number; // countdown frames for illumination flash
  }
  const ambients: Ambient[] = [];

  // --- Mark (outside ring) ---
  interface Mark {
    x: number; y: number;
    alpha: number;
    haloRadius: number;
    haloAlpha: number;
    pulsePhase: number;
    active: boolean;
  }
  const mark: Mark = { x: 0, y: 0, alpha: 0, haloRadius: 0, haloAlpha: 0, pulsePhase: 0, active: false };

  // --- Second particle (enters from far edge) ---
  interface Seeker {
    x: number; y: number;
    vx: number; vy: number;
    alpha: number;
    active: boolean;
    orbiting: boolean;
    orbitAngle: number;
    orbitR: number;
  }
  const seeker: Seeker = { x: 0, y: 0, vx: 0, vy: 0, alpha: 0, active: false, orbiting: false, orbitAngle: 0, orbitR: 25 };

  // --- Illumination schedule (staggered during Phase 2) ---
  const ILLUM_FRAMES: number[] = [280, 350, 430, 520]; // frames at which ambient particles flash
  let illumIndex = 0;

  // --- Fade multiplier for Phase 5 ---
  let globalFade = 1.0;

  // --- Init / Reset ---
  function resetState(): void {
    frame = 0;
    globalFade = 1.0;
    illumIndex = 0;

    ringCX = W / 2;
    ringCY = H / 2;
    ringR = Math.min(W, H) * RING_RADIUS_RATIO;

    agent.angle = 0;
    agent.orbitR = ringR * 0.65;
    agent.alpha = 1.0;
    agent.glowRadius = 0;
    agent.glowAlpha = 0;
    agent.speed = 0.008;

    // Place ambient particles outside the ring
    for (let i = 0; i < NUM_AMBIENT; i++) {
      let ax = 0, ay = 0;
      // Ensure outside ring by at least 20px
      for (let attempt = 0; attempt < 20; attempt++) {
        ax = W * 0.05 + Math.random() * W * 0.9;
        ay = H * 0.05 + Math.random() * H * 0.9;
        const dx = ax - ringCX;
        const dy = ay - ringCY;
        if (Math.sqrt(dx * dx + dy * dy) > ringR + 20) break;
      }
      if (i < ambients.length) {
        ambients[i].x = ax;
        ambients[i].y = ay;
        ambients[i].vx = (Math.random() - 0.5) * 0.15;
        ambients[i].vy = (Math.random() - 0.5) * 0.15;
        ambients[i].baseAlpha = 0.04 + Math.random() * 0.04;
        ambients[i].alpha = ambients[i].baseAlpha;
        ambients[i].radius = 1.5 + Math.random() * 1;
        ambients[i].illuminated = 0;
      } else {
        ambients.push({
          x: ax, y: ay,
          vx: (Math.random() - 0.5) * 0.15,
          vy: (Math.random() - 0.5) * 0.15,
          baseAlpha: 0.04 + Math.random() * 0.04,
          alpha: 0.04 + Math.random() * 0.04,
          radius: 1.5 + Math.random() * 1,
          illuminated: 0,
        });
      }
    }

    // Mark: position at 4 o'clock outside ring
    const markAngle = Math.PI * 0.3; // ~4 o'clock
    mark.x = ringCX + Math.cos(markAngle) * (ringR + 30);
    mark.y = ringCY + Math.sin(markAngle) * (ringR + 30);
    mark.alpha = 0;
    mark.haloRadius = 0;
    mark.haloAlpha = 0;
    mark.pulsePhase = 0;
    mark.active = false;

    // Seeker: starts off-canvas right
    seeker.x = W + 20;
    seeker.y = H * 0.35 + Math.random() * H * 0.3;
    seeker.vx = -0.35;
    seeker.vy = 0;
    seeker.alpha = 0;
    seeker.active = false;
    seeker.orbiting = false;
    seeker.orbitAngle = Math.PI;
    seeker.orbitR = 25;
  }

  // --- Get phase ---
  function getPhase(f: number): string {
    if (f < P_CONTAINMENT) return 'containment';
    if (f < P_SOCIAL) return 'social';
    if (f < P_INSCRIPTION) return 'inscription';
    if (f < P_DISCOVERY) return 'discovery';
    if (f < P_HOLD) return 'hold';
    return 'reset';
  }

  // --- Update ---
  function update(): void {
    const phase = getPhase(frame);

    // Update ambient particles (always drift, stay outside ring)
    for (let i = 0; i < NUM_AMBIENT; i++) {
      const a = ambients[i];
      a.vx += (Math.random() - 0.5) * 0.01;
      a.vy += (Math.random() - 0.5) * 0.01;
      a.vx = clamp(a.vx, -0.2, 0.2);
      a.vy = clamp(a.vy, -0.2, 0.2);
      a.x += a.vx;
      a.y += a.vy;

      // Keep outside ring
      const dx = a.x - ringCX;
      const dy = a.y - ringCY;
      const dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < ringR + 12) {
        const pushAngle = Math.atan2(dy, dx);
        a.x = ringCX + Math.cos(pushAngle) * (ringR + 14);
        a.y = ringCY + Math.sin(pushAngle) * (ringR + 14);
        a.vx = Math.cos(pushAngle) * 0.1;
        a.vy = Math.sin(pushAngle) * 0.1;
      }

      // Wrap at canvas edges
      if (a.x < -10) a.x = W + 10;
      if (a.x > W + 10) a.x = -10;
      if (a.y < -10) a.y = H + 10;
      if (a.y > H + 10) a.y = -10;

      // Illumination countdown
      if (a.illuminated > 0) {
        a.illuminated--;
        a.alpha = a.baseAlpha + 0.26 * (a.illuminated / 30);
      } else {
        a.alpha += (a.baseAlpha - a.alpha) * 0.05;
      }
    }

    // Phase: Containment
    if (phase === 'containment') {
      agent.angle += agent.speed;
      agent.alpha = 1.0;
      agent.glowRadius = 0;
      agent.glowAlpha = 0;
    }

    // Phase: Social Reach
    if (phase === 'social') {
      agent.angle += agent.speed;
      agent.alpha = 1.0;

      // Glow expands outward through boundary
      const progress = (frame - P_CONTAINMENT) / (P_SOCIAL - P_CONTAINMENT);
      agent.glowRadius = 30 + progress * 40;
      agent.glowAlpha = 0.08 + progress * 0.06;

      // Illuminate nearby ambient particles at scheduled intervals
      if (illumIndex < ILLUM_FRAMES.length && frame >= ILLUM_FRAMES[illumIndex]) {
        // Find the ambient particle closest to the agent's current position projected outward
        const agentX = ringCX + Math.cos(agent.angle) * agent.orbitR;
        const agentY = ringCY + Math.sin(agent.angle) * agent.orbitR;
        const outAngle = Math.atan2(agentY - ringCY, agentX - ringCX);
        const targetX = ringCX + Math.cos(outAngle) * (ringR + 40);
        const targetY = ringCY + Math.sin(outAngle) * (ringR + 40);

        let bestIdx = 0;
        let bestDist = Infinity;
        for (let i = 0; i < NUM_AMBIENT; i++) {
          const ddx = ambients[i].x - targetX;
          const ddy = ambients[i].y - targetY;
          const d = ddx * ddx + ddy * ddy;
          if (d < bestDist && ambients[i].illuminated === 0) {
            bestDist = d;
            bestIdx = i;
          }
        }
        ambients[bestIdx].illuminated = 30;
        illumIndex++;
      }
    }

    // Phase: Inscription
    if (phase === 'inscription') {
      const phaseF = frame - P_SOCIAL;

      // Agent decelerates and settles near 4 o'clock
      const targetAngle = Math.PI * 0.3;
      const decelProgress = clamp(phaseF / 120, 0, 1);
      agent.speed = 0.008 * (1 - decelProgress * 0.95);
      agent.angle += agent.speed;

      // Gradually pull toward target angle
      if (decelProgress > 0.3) {
        const angleDiff = targetAngle - (agent.angle % (Math.PI * 2));
        agent.angle += angleDiff * 0.01;
      }

      // Glow concentrates (becomes tighter, brighter)
      agent.glowRadius = Math.max(10, 70 - phaseF * 0.3);
      agent.glowAlpha = clamp(0.14 + phaseF * 0.002, 0, 0.3);

      // Mark materializes as fade-in (frames 40-80 of this phase)
      if (phaseF >= 40 && phaseF <= 80) {
        const markProgress = (phaseF - 40) / 40;
        mark.alpha = markProgress * 0.7;
        mark.haloRadius = 8 + markProgress * 6;
        mark.haloAlpha = markProgress * 0.15;
        mark.active = true;
      }
      if (phaseF > 80) {
        // Mark pulses
        mark.pulsePhase += 0.03; // ~0.5Hz at 60fps
        mark.alpha = 0.5 + Math.sin(mark.pulsePhase) * 0.15;
        mark.haloRadius = 12 + Math.sin(mark.pulsePhase) * 2;
        mark.haloAlpha = 0.1 + Math.sin(mark.pulsePhase) * 0.05;
      }

      // Agent dims from full opacity to 0.15
      if (phaseF > 120) {
        const dimProgress = clamp((phaseF - 120) / 60, 0, 1);
        agent.alpha = 1.0 - dimProgress * 0.85;
      }

      // Agent glow fades as it dims
      if (phaseF > 150) {
        agent.glowAlpha *= 0.97;
      }
    }

    // Phase: Discovery
    if (phase === 'discovery') {
      const phaseF = frame - P_INSCRIPTION;

      // Agent stays dim and still
      agent.speed = 0;
      agent.alpha = 0.15;
      agent.glowAlpha = 0;

      // Mark keeps pulsing
      mark.pulsePhase += 0.03;
      mark.alpha = 0.5 + Math.sin(mark.pulsePhase) * 0.15;
      mark.haloRadius = 12 + Math.sin(mark.pulsePhase) * 2;
      mark.haloAlpha = 0.1 + Math.sin(mark.pulsePhase) * 0.05;

      // Activate seeker
      if (!seeker.active && phaseF >= 0) {
        seeker.active = true;
        seeker.alpha = 0;
        seeker.x = W + 20;
        seeker.y = H * 0.35 + H * 0.15;
      }

      if (seeker.active && !seeker.orbiting) {
        // Fade in
        seeker.alpha = clamp(seeker.alpha + 0.015, 0, 0.9);

        // Move toward mark with linear drift
        const dx = mark.x - seeker.x;
        const dy = mark.y - seeker.y;
        const dist = Math.sqrt(dx * dx + dy * dy);

        if (dist > 50) {
          // Linear approach with slight wobble (different from agent's organic orbit)
          seeker.vx += (dx / dist) * 0.008;
          seeker.vy += (dy / dist) * 0.008;
          // Slight sinusoidal wobble perpendicular to travel direction
          const perpX = -dy / dist;
          const perpY = dx / dist;
          seeker.vx += perpX * Math.sin(phaseF * 0.05) * 0.003;
          seeker.vy += perpY * Math.sin(phaseF * 0.05) * 0.003;

          const speed = Math.sqrt(seeker.vx * seeker.vx + seeker.vy * seeker.vy);
          if (speed > 0.45) {
            seeker.vx = (seeker.vx / speed) * 0.45;
            seeker.vy = (seeker.vy / speed) * 0.45;
          }
          seeker.x += seeker.vx;
          seeker.y += seeker.vy;
        } else {
          // Mark flares when seeker is close
          mark.alpha = clamp(mark.alpha + 0.02, 0, 1.0);
          mark.haloRadius = clamp(mark.haloRadius + 0.3, 0, 20);
          mark.haloAlpha = clamp(mark.haloAlpha + 0.01, 0, 0.25);
        }

        if (dist < 30) {
          // Lock into orbit
          seeker.orbiting = true;
          seeker.orbitAngle = Math.atan2(seeker.y - mark.y, seeker.x - mark.x);
          seeker.orbitR = 25;
        }
      }

      if (seeker.orbiting) {
        // Orbit the mark at the same angular speed as the agent's original orbit
        seeker.orbitAngle += 0.008;
        seeker.x = mark.x + Math.cos(seeker.orbitAngle) * seeker.orbitR;
        seeker.y = mark.y + Math.sin(seeker.orbitAngle) * seeker.orbitR;
        seeker.alpha = 0.9;
      }
    }

    // Phase: Hold
    if (phase === 'hold') {
      agent.speed = 0;
      agent.alpha = 0.15;

      // Mark steady pulse
      mark.pulsePhase += 0.03;
      mark.alpha = 0.6 + Math.sin(mark.pulsePhase) * 0.15;
      mark.haloRadius = 14;
      mark.haloAlpha = 0.15;

      // Seeker continues orbit
      if (seeker.orbiting) {
        seeker.orbitAngle += 0.008;
        seeker.x = mark.x + Math.cos(seeker.orbitAngle) * seeker.orbitR;
        seeker.y = mark.y + Math.sin(seeker.orbitAngle) * seeker.orbitR;
        seeker.alpha = 0.9;
      }
    }

    // Phase: Reset (fade out + black hold)
    if (phase === 'reset') {
      const phaseF = frame - P_HOLD;
      if (phaseF < 60) {
        // Fade everything out
        globalFade = 1.0 - (phaseF / 60);
      } else {
        globalFade = 0;
      }
    }
  }

  // --- Draw ---
  function draw(): void {
    ctx!.clearRect(0, 0, W, H);
    ctx!.fillStyle = bgColor;
    ctx!.fillRect(0, 0, W, H);

    if (W === 0 || H === 0) return;

    ringCX = W / 2;
    ringCY = H / 2;
    ringR = Math.min(W, H) * RING_RADIUS_RATIO;

    const fade = globalFade;

    // --- Draw ambient particles ---
    for (let i = 0; i < NUM_AMBIENT; i++) {
      const a = ambients[i];
      const alpha = a.alpha * fade;
      if (alpha < 0.002) continue;
      ctx!.beginPath();
      ctx!.arc(a.x, a.y, a.radius, 0, Math.PI * 2);
      // If illuminated, use accent color
      if (a.illuminated > 0) {
        ctx!.fillStyle = storyA(alpha);
      } else {
        ctx!.fillStyle = dimA(alpha);
      }
      ctx!.fill();
    }

    // --- Draw boundary ring (always intact, always same opacity) ---
    ctx!.beginPath();
    ctx!.arc(ringCX, ringCY, ringR, 0, Math.PI * 2);
    ctx!.closePath();
    ctx!.strokeStyle = dimA(0.08 * fade);
    ctx!.lineWidth = 1.5;
    ctx!.stroke();

    // --- Draw glow seep through boundary (Phase 2+) ---
    if (agent.glowAlpha > 0.001 && fade > 0.01) {
      const agentX = ringCX + Math.cos(agent.angle) * agent.orbitR;
      const agentY = ringCY + Math.sin(agent.angle) * agent.orbitR;

      // Direction from center through agent to outside
      const outAngle = Math.atan2(agentY - ringCY, agentX - ringCX);
      const seepX = ringCX + Math.cos(outAngle) * ringR;
      const seepY = ringCY + Math.sin(outAngle) * ringR;

      // Brighten the boundary segment near the agent
      ctx!.beginPath();
      ctx!.arc(ringCX, ringCY, ringR, outAngle - 0.4, outAngle + 0.4);
      ctx!.strokeStyle = storyA(0.12 * fade);
      ctx!.lineWidth = 2;
      ctx!.stroke();

      // Glow extending beyond boundary
      const glowOutX = ringCX + Math.cos(outAngle) * (ringR + agent.glowRadius * 0.5);
      const glowOutY = ringCY + Math.sin(outAngle) * (ringR + agent.glowRadius * 0.5);
      const gr = ctx!.createRadialGradient(seepX, seepY, 0, glowOutX, glowOutY, agent.glowRadius);
      gr.addColorStop(0, storyA(agent.glowAlpha * fade));
      gr.addColorStop(0.5, storyA(agent.glowAlpha * 0.4 * fade));
      gr.addColorStop(1, storyA(0));
      ctx!.beginPath();
      ctx!.arc(glowOutX, glowOutY, agent.glowRadius, 0, Math.PI * 2);
      ctx!.fillStyle = gr;
      ctx!.fill();
    }

    // --- Draw agent particle (inside ring) ---
    if (agent.alpha * fade > 0.005) {
      const ax = ringCX + Math.cos(agent.angle) * agent.orbitR;
      const ay = ringCY + Math.sin(agent.angle) * agent.orbitR;
      const aAlpha = agent.alpha * fade;

      // Agent glow
      const agGr = ctx!.createRadialGradient(ax, ay, 0, ax, ay, 12);
      agGr.addColorStop(0, storyA(aAlpha * 0.3));
      agGr.addColorStop(0.5, storyA(aAlpha * 0.1));
      agGr.addColorStop(1, storyA(0));
      ctx!.beginPath();
      ctx!.arc(ax, ay, 12, 0, Math.PI * 2);
      ctx!.fillStyle = agGr;
      ctx!.fill();

      // Agent core
      ctx!.beginPath();
      ctx!.arc(ax, ay, 3.5, 0, Math.PI * 2);
      ctx!.fillStyle = storyA(aAlpha);
      ctx!.fill();

      // Agent bright center
      ctx!.beginPath();
      ctx!.arc(ax, ay, 1.5, 0, Math.PI * 2);
      ctx!.fillStyle = storyA(Math.min(1, aAlpha * 1.3));
      ctx!.fill();
    }

    // --- Draw mark (outside ring) ---
    if (mark.active && mark.alpha * fade > 0.005) {
      const mAlpha = mark.alpha * fade;

      // Mark halo
      if (mark.haloRadius > 0 && mark.haloAlpha > 0) {
        const mGr = ctx!.createRadialGradient(mark.x, mark.y, 0, mark.x, mark.y, mark.haloRadius);
        mGr.addColorStop(0, storyA(mark.haloAlpha * fade));
        mGr.addColorStop(0.6, storyA(mark.haloAlpha * 0.3 * fade));
        mGr.addColorStop(1, storyA(0));
        ctx!.beginPath();
        ctx!.arc(mark.x, mark.y, mark.haloRadius, 0, Math.PI * 2);
        ctx!.fillStyle = mGr;
        ctx!.fill();
      }

      // Mark core
      ctx!.beginPath();
      ctx!.arc(mark.x, mark.y, 3.5, 0, Math.PI * 2);
      ctx!.fillStyle = storyA(mAlpha);
      ctx!.fill();
    }

    // --- Draw seeker particle (outside ring) ---
    if (seeker.active && seeker.alpha * fade > 0.005) {
      const skAlpha = seeker.alpha * fade;

      // Seeker glow
      const skGr = ctx!.createRadialGradient(seeker.x, seeker.y, 0, seeker.x, seeker.y, 10);
      skGr.addColorStop(0, storyA(skAlpha * 0.25));
      skGr.addColorStop(0.5, storyA(skAlpha * 0.08));
      skGr.addColorStop(1, storyA(0));
      ctx!.beginPath();
      ctx!.arc(seeker.x, seeker.y, 10, 0, Math.PI * 2);
      ctx!.fillStyle = skGr;
      ctx!.fill();

      // Seeker core -- slightly different rendering (more geometric, less organic)
      ctx!.beginPath();
      ctx!.arc(seeker.x, seeker.y, 3, 0, Math.PI * 2);
      ctx!.fillStyle = storyA(skAlpha);
      ctx!.fill();

      // Seeker sharp center dot
      ctx!.beginPath();
      ctx!.arc(seeker.x, seeker.y, 1.2, 0, Math.PI * 2);
      ctx!.fillStyle = storyA(Math.min(1, skAlpha * 1.4));
      ctx!.fill();
    }
  }

  // --- Static frame for reduced motion ---
  function drawStatic(): void {
    ctx!.clearRect(0, 0, W, H);
    ctx!.fillStyle = bgColor;
    ctx!.fillRect(0, 0, W, H);

    if (W === 0 || H === 0) return;

    ringCX = W / 2;
    ringCY = H / 2;
    ringR = Math.min(W, H) * RING_RADIUS_RATIO;

    // Ambient particles (deterministic placement)
    for (let i = 0; i < NUM_AMBIENT; i++) {
      const angle = (i / NUM_AMBIENT) * Math.PI * 2 + 0.5;
      const dist = ringR + 30 + (i % 3) * 25;
      const px = ringCX + Math.cos(angle) * dist;
      const py = ringCY + Math.sin(angle) * dist;
      ctx!.beginPath();
      ctx!.arc(px, py, 1.5, 0, Math.PI * 2);
      ctx!.fillStyle = dimA(0.06);
      ctx!.fill();
    }

    // Boundary ring
    ctx!.beginPath();
    ctx!.arc(ringCX, ringCY, ringR, 0, Math.PI * 2);
    ctx!.closePath();
    ctx!.strokeStyle = dimA(0.08);
    ctx!.lineWidth = 1.5;
    ctx!.stroke();

    // Agent particle inside (dim, at 4 o'clock)
    const agentAngle = Math.PI * 0.3;
    const ax = ringCX + Math.cos(agentAngle) * ringR * 0.65;
    const ay = ringCY + Math.sin(agentAngle) * ringR * 0.65;
    const agGr = ctx!.createRadialGradient(ax, ay, 0, ax, ay, 12);
    agGr.addColorStop(0, storyA(0.08));
    agGr.addColorStop(1, storyA(0));
    ctx!.beginPath();
    ctx!.arc(ax, ay, 12, 0, Math.PI * 2);
    ctx!.fillStyle = agGr;
    ctx!.fill();
    ctx!.beginPath();
    ctx!.arc(ax, ay, 3.5, 0, Math.PI * 2);
    ctx!.fillStyle = storyA(0.2);
    ctx!.fill();

    // Mark outside ring (at 4 o'clock, 30px out)
    const mx = ringCX + Math.cos(agentAngle) * (ringR + 30);
    const my = ringCY + Math.sin(agentAngle) * (ringR + 30);
    const mGr = ctx!.createRadialGradient(mx, my, 0, mx, my, 12);
    mGr.addColorStop(0, storyA(0.15));
    mGr.addColorStop(0.6, storyA(0.05));
    mGr.addColorStop(1, storyA(0));
    ctx!.beginPath();
    ctx!.arc(mx, my, 12, 0, Math.PI * 2);
    ctx!.fillStyle = mGr;
    ctx!.fill();
    ctx!.beginPath();
    ctx!.arc(mx, my, 3.5, 0, Math.PI * 2);
    ctx!.fillStyle = storyA(0.7);
    ctx!.fill();

    // Seeker orbiting the mark
    const seekerAngle = Math.PI * 1.2;
    const sx = mx + Math.cos(seekerAngle) * 25;
    const sy = my + Math.sin(seekerAngle) * 25;
    const skGr = ctx!.createRadialGradient(sx, sy, 0, sx, sy, 10);
    skGr.addColorStop(0, storyA(0.2));
    skGr.addColorStop(1, storyA(0));
    ctx!.beginPath();
    ctx!.arc(sx, sy, 10, 0, Math.PI * 2);
    ctx!.fillStyle = skGr;
    ctx!.fill();
    ctx!.beginPath();
    ctx!.arc(sx, sy, 3, 0, Math.PI * 2);
    ctx!.fillStyle = storyA(0.85);
    ctx!.fill();
  }

  // --- Animation loop ---
  function tick(): void {
    frame++;
    if (frame >= CYCLE) { resetState(); }
    update();
    draw();
    rafId = requestAnimationFrame(tick);
  }

  // --- ResizeObserver ---
  const ro = new ResizeObserver(() => {
    const dpr = window.devicePixelRatio || 1;
    W = canvas!.offsetWidth;
    H = canvas!.offsetHeight;
    canvas!.width = W * dpr;
    canvas!.height = H * dpr;
    ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

    ringCX = W / 2;
    ringCY = H / 2;
    ringR = Math.min(W, H) * RING_RADIUS_RATIO;

    if (reducedMotion) {
      drawStatic();
    } else {
      // Re-clamp mark position on resize
      const markAngle = Math.PI * 0.3;
      mark.x = ringCX + Math.cos(markAngle) * (ringR + 30);
      mark.y = ringCY + Math.sin(markAngle) * (ringR + 30);
    }
  });
  ro.observe(canvas);

  // --- Initial size ---
  const dpr = window.devicePixelRatio || 1;
  W = canvas.offsetWidth;
  H = canvas.offsetHeight;
  canvas.width = W * dpr;
  canvas.height = H * dpr;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

  // --- Reduced motion (with live listener for preference changes) ---
  let reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  motionQuery.addEventListener('change', (e: MediaQueryListEvent) => {
    reducedMotion = e.matches;
    if (reducedMotion) {
      cancelAnimationFrame(rafId);
      rafId = 0;
      drawStatic();
    } else {
      if (!rafId && isVisible) {
        resetState();
        rafId = requestAnimationFrame(tick);
      }
    }
  });

  if (reducedMotion) {
    drawStatic();
    window.addEventListener('pagehide', () => { ro.disconnect(); });
  } else {
    resetState();

    // --- IntersectionObserver ---
    const io = new IntersectionObserver(([e]) => {
      isVisible = e.isIntersecting;
      if (e.isIntersecting) {
        if (!rafId && !reducedMotion) rafId = requestAnimationFrame(tick);
      } else {
        cancelAnimationFrame(rafId);
        rafId = 0;
      }
    }, { threshold: 0.01 });
    io.observe(canvas);

    // --- Teardown ---
    window.addEventListener('pagehide', () => {
      cancelAnimationFrame(rafId);
      io.disconnect();
      ro.disconnect();
    });
  }
})();
</script>

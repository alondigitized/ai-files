  border-collapse: separate;
  border-spacing: 0;
  table-layout: fixed;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  margin: 2rem 0;
  overflow: hidden;
}
.fl-exhibit-header {
  caption-side: top;
  text-align: left;
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  padding: 1rem 1.5rem;
  border-bottom: 1px solid var(--border);
}
.fl-exhibit td,
.fl-exhibit th {
  text-align: left;
  vertical-align: top;
  font-weight: normal;
  border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
}
.fl-exhibit tfoot td { border-bottom: none; }
.fl-exhibit-col-header {
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  padding: 0.75rem 1.5rem;
  background: color-mix(in srgb, var(--surface) 80%, var(--bg));
  border-bottom: 1px solid var(--border);
}
.fl-exhibit-col-header:first-child {
  border-right: 1px solid var(--border);
}
.fl-exhibit-left,
.fl-exhibit-right {
  padding: 0.75rem 1.5rem;
  font-size: 0.88rem;
  line-height: 1.5;
}
.fl-exhibit-left {
  color: var(--text);
  border-right: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
}
.fl-exhibit-right {
  color: var(--story);
  font-style: italic;
}
.fl-exhibit-footer {
  padding: 0.75rem 1.5rem;
  border-top: 1px solid var(--border);
  font-size: 0.75rem;
  color: var(--muted);
  font-style: italic;
}

@media (max-width: 600px) {
  .fl-admissions-entry {
    grid-template-columns: 1fr;
    gap: 0.25rem;
  }
  .fl-exhibit, .fl-exhibit tbody, .fl-exhibit tfoot, .fl-exhibit tr, .fl-exhibit td { display: block; width: 100%; }
  .fl-exhibit thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .fl-exhibit-left {

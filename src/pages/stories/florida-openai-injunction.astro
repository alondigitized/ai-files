<script>
(function () {
  const canvas = document.querySelector('.florida-openai-injunction-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  /* ── colours (cached, re-read on resize) ── */
  let BG = '#0d0d0d';
  let AR = 251, AG = 113, AB = 133;           // --story fallback #fb7185
  const SR = 255, SG = 77, SB = 77;           // --accent #ff4d4d (fracture flash)

  function readColors() {
    const s = getComputedStyle(document.documentElement);
    BG = s.getPropertyValue('--bg').trim() || '#0d0d0d';
    const hex = s.getPropertyValue('--story').trim() || '#fb7185';
    AR = parseInt(hex.slice(1, 3), 16);
    AG = parseInt(hex.slice(3, 5), 16);
    AB = parseInt(hex.slice(5, 7), 16);
  }

  /* ── timing constants ── */
  const NUM_DISC     = 8;
  const EMIT_INT     = 72;          // frames between emissions
  const OUT_FR       = 120;         // deceleration outward
  const HALT_FR      = 30;          // pause at apex
  const RET_FR       = 100;         // curved return
  const P_LIFE       = OUT_FR + HALT_FR + RET_FR; // 250
  const PEAK_S       = 760;         // all 8 locked by ~754
  const PEAK_E       = 940;         // 180 fr hold (3 s)
  const FRAC_E       = 946;         // 6 fr flash
  const SCAT_E       = 1036;        // 90 fr scatter
  const CYCLE        = 1200;        // 20 s
  const NUM_AMB      = 35;
  const MAX_FRAG     = NUM_DISC * 3;

  /* ── state ── */
  let W = 0, H = 0, dpr = 1;
  let frame = 0, rafId = 0, running = false, fractured = false;

  /* ── disclosure pool ── */
  const disc: { a: number; ra: number; dr: number; ef: number; lf: number; lk: boolean }[] = [];

  /* ── fragment pool ── */
  const frag: { x: number; y: number; vx: number; vy: number; al: number; on: boolean }[] = [];

  /* ── ambient pool ── */
  const amb: { x: number; y: number; vx: number; vy: number; r: number }[] = [];

  function initCycle() {
    disc.length = 0;
    frag.length = 0;
    fractured = false;
    for (let i = 0; i < NUM_DISC; i++) {
      const a = Math.random() * Math.PI * 2;
      const off = (Math.random() > 0.5 ? 1 : -1) * (0.2 + Math.random() * 0.3);
      disc.push({ a, ra: a + off, dr: 0.7 + Math.random() * 0.3, ef: i * EMIT_INT, lf: -1, lk: false });
    }
    for (let i = 0; i < MAX_FRAG; i++) {
      frag.push({ x: 0, y: 0, vx: 0, vy: 0, al: 0, on: false });
    }
  }

  function initAmb() {
    amb.length = 0;
    for (let i = 0; i < NUM_AMB; i++) {
      const a = Math.random() * Math.PI * 2;
      const sp = 0.1 + Math.random() * 0.1;
      amb.push({ x: Math.random() * (W || 800), y: Math.random() * (H || 380), vx: Math.cos(a) * sp, vy: Math.sin(a) * sp, r: 0.8 + Math.random() * 1.0 });
    }
  }

  function lockAll() { for (const d of disc) { d.lk = true; d.lf = 0; } }

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    const r = canvas.getBoundingClientRect();
    W = r.width; H = r.height;
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    readColors();
    if (!amb.length) initAmb();
    if (!disc.length) initCycle();
  }

  /* ── helpers ── */
  function eO(t: number) { return t * (2 - t); }
  function eI(t: number) { return t * t; }
  function lp(a: number, b: number, t: number) { return a + (b - a) * t; }
  function cl(v: number, lo: number, hi: number) { return v < lo ? lo : v > hi ? hi : v; }
  function rg(r: number, g: number, b: number, a: number) { return 'rgba(' + r + ',' + g + ',' + b + ',' + a.toFixed(3) + ')'; }

  /* ── draw ── */
  function draw() {
    const c = ctx!;
    if (W === 0 || H === 0) return;

    c.fillStyle = BG;
    c.fillRect(0, 0, W, H);

    const cx = W * 0.5, cy = H * 0.5;
    const mR = Math.min(W, H) * 0.38;

    const isPeak = frame >= PEAK_S && frame < PEAK_E;
    const isFrac = frame >= PEAK_E && frame < FRAC_E;
    const isScat = frame >= FRAC_E && frame < SCAT_E;
    const isPause = frame >= SCAT_E;

    /* ── ambient ── */
    for (const p of amb) {
      p.x += p.vx; p.y += p.vy;
      if (p.x < -5) p.x = W + 5; if (p.x > W + 5) p.x = -5;
      if (p.y < -5) p.y = H + 5; if (p.y > H + 5) p.y = -5;
      c.fillStyle = 'rgba(232,232,232,0.05)';
      c.beginPath(); c.arc(p.x, p.y, p.r, 0, Math.PI * 2); c.fill();
    }

    /* ── fade multiplier ── */
    let fd = 1;
    if (isPause) fd = 1 - ((frame - SCAT_E) / (CYCLE - SCAT_E)) * 0.6;
    if (frame < 40) fd *= frame / 40;

    /* ── central node ── */
    const brAmp = isPeak ? 4 : 2;
    const nR = 5 + Math.sin(frame * (2 * Math.PI) / 120) * brAmp;
    let nA = isPeak ? 0.9 : isFrac ? 0.4 : isScat ? 0.3 : isPause ? 0.25 : 0.6;
    nA *= fd;

    c.fillStyle = rg(AR, AG, AB, nA);
    c.beginPath(); c.arc(cx, cy, Math.max(nR, 1), 0, Math.PI * 2); c.fill();

    const glA = (isPeak ? 0.3 : 0.12) * fd;
    c.strokeStyle = rg(AR, AG, AB, glA); c.lineWidth = 1;
    c.beginPath(); c.arc(cx, cy, nR + 6, 0, Math.PI * 2); c.stroke();

    if (isPeak) {
      c.strokeStyle = rg(AR, AG, AB, 0.08 * fd);
      c.beginPath(); c.arc(cx, cy, nR + 14, 0, Math.PI * 2); c.stroke();
    }

    /* ── disclosure lifecycle ── */
    for (let i = 0; i < disc.length; i++) {
      const d = disc[i];
      const lf = frame - d.ef;
      if (lf < 0) continue;

      const dist = d.dr * mR;
      const hx = cx + Math.cos(d.a) * dist;
      const hy = cy + Math.sin(d.a) * dist;

      /* in-flight */
      if (!d.lk && !isFrac && !isScat && !isPause) {
        if (lf < OUT_FR) {
          /* outward, decelerating */
          const t = lf / OUT_FR;
          const cd = dist * eO(t);
          const px = cx + Math.cos(d.a) * cd;
          const py = cy + Math.sin(d.a) * cd;
          const al = (0.35 + 0.35 * t) * fd;

          c.fillStyle = rg(AR, AG, AB, al);
          c.beginPath(); c.arc(px, py, 2.5, 0, Math.PI * 2); c.fill();

          c.strokeStyle = rg(AR, AG, AB, 0.08 * fd); c.lineWidth = 0.5;
          c.beginPath(); c.moveTo(cx, cy); c.lineTo(px, py); c.stroke();

        } else if (lf < OUT_FR + HALT_FR) {
          /* halted at apex */
          const ht = (lf - OUT_FR) / HALT_FR;
          const al = (0.7 + 0.1 * Math.sin(ht * Math.PI)) * fd;
          c.fillStyle = rg(AR, AG, AB, al);
          c.beginPath(); c.arc(hx, hy, 2.5, 0, Math.PI * 2); c.fill();

        } else if (lf < P_LIFE) {
          /* returning on a curved arc */
          const t = (lf - OUT_FR - HALT_FR) / RET_FR;
          const ca = lp(d.a, d.ra, t);
          const cd = dist * (1 - eI(t));
          const px = cx + Math.cos(ca) * cd;
          const py = cy + Math.sin(ca) * cd;
          const al = (0.7 - 0.3 * t) * fd;

          c.fillStyle = rg(AR, AG, AB, al);
          c.beginPath(); c.arc(px, py, 2.5, 0, Math.PI * 2); c.fill();

          c.strokeStyle = rg(AR, AG, AB, 0.06 * fd); c.lineWidth = 0.5;
          c.beginPath(); c.moveTo(hx, hy); c.lineTo(px, py); c.stroke();

        } else {
          d.lk = true;
          d.lf = frame;
        }
      }

      /* locked line segments */
      if (d.lk && !isFrac && !isScat && !isPause) {
        const age = frame - d.lf;
        const tk = cl(age / 60, 0, 1);
        let la = lp(0.15, 0.3, tk);

        if (isPeak) {
          const pp = (frame - PEAK_S) / (PEAK_E - PEAK_S);
          la += 0.06 * Math.sin(pp * Math.PI * 6);
        }
        la *= fd;

        c.strokeStyle = rg(AR, AG, AB, la);
        c.lineWidth = lp(0.5, 1.2, tk);
        c.beginPath(); c.moveTo(cx, cy); c.lineTo(hx, hy); c.stroke();

        c.fillStyle = rg(AR, AG, AB, la * 0.5);
        c.beginPath(); c.arc(hx, hy, 1.5, 0, Math.PI * 2); c.fill();
      }
    }

    /* ── fracture flash ── */
    if (isFrac) {
      for (const d of disc) {
        if (!d.lk) continue;
        const dist = d.dr * mR;
        const hx = cx + Math.cos(d.a) * dist;
        const hy = cy + Math.sin(d.a) * dist;
        c.strokeStyle = rg(SR, SG, SB, 0.7); c.lineWidth = 1.5;
        c.beginPath(); c.moveTo(cx, cy); c.lineTo(hx, hy); c.stroke();
      }

      if (!fractured) {
        fractured = true;
        let fi = 0;
        for (const d of disc) {
          if (!d.lk) continue;
          const dist = d.dr * mR;
          const hx = cx + Math.cos(d.a) * dist;
          const hy = cy + Math.sin(d.a) * dist;
          const n = 2 + Math.floor(Math.random() * 2);
          for (let j = 0; j < n && fi < frag.length; j++) {
            const t = (j + 1) / (n + 1);
            const f = frag[fi];
            f.x = lp(cx, hx, t); f.y = lp(cy, hy, t);
            const oa = d.a + (Math.random() - 0.5) * 1.0;
            const sp = 0.8 + Math.random() * 0.8;
            f.vx = Math.cos(oa) * sp; f.vy = Math.sin(oa) * sp;
            f.al = 0.8; f.on = true;
            fi++;
          }
        }
      }
    }

    /* ── scatter fragments ── */
    for (const f of frag) {
      if (!f.on) continue;
      f.x += f.vx; f.y += f.vy;
      f.al -= 0.8 / 90;
      if (f.al <= 0) { f.on = false; continue; }
      c.fillStyle = rg(SR, SG, SB, f.al);
      c.beginPath(); c.arc(f.x, f.y, 1.5, 0, Math.PI * 2); c.fill();
    }

    /* ── advance ── */
    frame++;
    if (frame >= CYCLE) { frame = 0; initCycle(); }
  }

  /* ── loop control ── */
  function loop() { draw(); rafId = requestAnimationFrame(loop); }
  function start() { if (running) return; running = true; rafId = requestAnimationFrame(loop); }
  function stop() { running = false; cancelAnimationFrame(rafId); }

  /* ── init ── */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  const ro = new ResizeObserver(() => {
    resize();
    if (reduced.matches) {
      initCycle(); lockAll();
      frame = PEAK_S + 10;
      draw();
    }
  });
  ro.observe(canvas);
  resize();

  if (reduced.matches) {
    initCycle(); lockAll();
    frame = PEAK_S + 10;
    draw();
  } else {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) { if (e.isIntersecting) start(); else stop(); }
    }, { threshold: 0.01 });
    io.observe(canvas);
  }

  window.addEventListener('pagehide', () => { cancelAnimationFrame(rafId); ro.disconnect(); });
})();
</script>

<script>
(function () {
  const canvas = document.querySelector('.openai-unique-games-proof-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  /* ── colours from computed styles ── */
  const cs = getComputedStyle(document.documentElement);
  const BG_COLOR = cs.getPropertyValue('--bg').trim() || '#f5f0e8';
  const STORY_HEX = cs.getPropertyValue('--story').trim() || '#7c3aed';
  const ACCENT_HEX = cs.getPropertyValue('--accent').trim() || '#c8963e';

  function hexRgb(h: string): [number, number, number] {
    const c = h.replace('#', '');
    return [parseInt(c.slice(0, 2), 16), parseInt(c.slice(2, 4), 16), parseInt(c.slice(4, 6), 16)];
  }

  const [vR, vG, vB] = hexRgb(STORY_HEX.startsWith('#') ? STORY_HEX : '#7c3aed');
  const [aR, aG, aB] = hexRgb(ACCENT_HEX.startsWith('#') ? ACCENT_HEX : '#c8963e');
  // Red for the unverified flare
  const fR = 255, fG = 77, fB = 77;
  // Dark ink for nodes/edges on cream
  const iR = 26, iG = 26, iB = 23;

  /* ── state ── */
  let W = 0, H = 0, raf = 0, frame = 0;

  const ro = new ResizeObserver(() => {
    W = canvas.offsetWidth;
    H = canvas.offsetHeight;
    canvas.width = W * devicePixelRatio;
    canvas.height = H * devicePixelRatio;
    ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
  });
  ro.observe(canvas);

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── cycle: 1560 frames = 26s at 60fps ── */
  const CYCLE = 1560;
  const P_ASSEMBLY_END = 900;      // 0-15s: nodes appear one by one
  const P_UNVERIFIED_END = 1080;   // 15-18s: peripheral clusters appear, flare, dissolve
  const P_HOLD_END = 1380;         // 18-23s: completed structure wobbles gently
  // 23-26s: fade to ghost, reset

  /* ── proof graph data ── */
  const MAX_MAIN = 50;
  const MAX_UNVERIFIED = 9; // 3 clusters x 3 nodes
  const MAX_EDGES = 120;
  const MAX_PULSES = 20;

  type ProofNode = {
    x: number; y: number; tx: number; ty: number;
    r: number; alpha: number; born: number;
    cluster: number; // 0=main, 1-3=unverified clusters
    alive: boolean; shrink: number;
  };

  type ProofEdge = {
    a: number; b: number; alpha: number;
    verified: boolean; flare: number; born: number;
  };

  type Pulse = {
    edge: number; progress: number; alpha: number; speed: number;
  };

  const nodes: ProofNode[] = [];
  const edges: ProofEdge[] = [];
  const pulses: Pulse[] = [];

  let nextNodeFrame = 0;
  let nodesAdded = 0;
  let unverifiedPhaseStart = 0;
  let globalFade = 1;

  /* ── geometry helpers ── */
  const cx = () => W / 2;
  const cy = () => H / 2;

  function dist(ax: number, ay: number, bx: number, by: number): number {
    const dx = ax - bx, dy = ay - by;
    return Math.sqrt(dx * dx + dy * dy);
  }

  function edgeLen(e: ProofEdge): number {
    const na = nodes[e.a], nb = nodes[e.b];
    return dist(na.x, na.y, nb.x, nb.y);
  }

  /* ── deterministic seeded random for reproducible layout ── */
  let seed = 1;
  function srand(): number {
    seed = (seed * 16807 + 0) % 2147483647;
    return (seed - 1) / 2147483646;
  }

  /* ── init / reset ── */
  function resetGraph() {
    nodes.length = 0;
    edges.length = 0;
    pulses.length = 0;
    nodesAdded = 0;
    nextNodeFrame = 12;
    unverifiedPhaseStart = 0;
    globalFade = 1;
    seed = 1 + (frame | 0); // slightly different layout each cycle
  }

  /* ── add a main-graph node with force-directed offset ── */
  function addMainNode(cf: number) {
    if (nodesAdded >= MAX_MAIN) return;

    let nx: number, ny: number;
    const spread = Math.min(W * 0.38, H * 0.38, 160);

    if (nodesAdded === 0) {
      // First node near center
      nx = cx() + (srand() - 0.5) * 20;
      ny = cy() + (srand() - 0.5) * 20;
    } else {
      // Pick a random existing node to branch from
      const parent = nodes[(srand() * nodesAdded) | 0];
      const angle = srand() * Math.PI * 2;
      // Early nodes: short distances (orderly). Later: longer distances (tangled)
      const progression = nodesAdded / MAX_MAIN;
      const minD = 18 + progression * 30;
      const maxD = 30 + progression * 60;
      const d = minD + srand() * (maxD - minD);
      nx = parent.x + Math.cos(angle) * d;
      ny = parent.y + Math.sin(angle) * d;

      // Clamp to canvas bounds with padding
      const pad = 30;
      nx = Math.max(pad, Math.min(W - pad, nx));
      ny = Math.max(pad, Math.min(H - pad, ny));

      // Keep within spread radius of center
      const dc = dist(nx, ny, cx(), cy());
      if (dc > spread) {
        const a2 = Math.atan2(ny - cy(), nx - cx());
        nx = cx() + Math.cos(a2) * (spread - 5);
        ny = cy() + Math.sin(a2) * (spread - 5);
      }

      // Push away from existing nodes that are too close
      for (let i = 0; i < nodesAdded; i++) {
        const dd = dist(nx, ny, nodes[i].x, nodes[i].y);
        if (dd < 14 && dd > 0) {
          const pushAngle = Math.atan2(ny - nodes[i].y, nx - nodes[i].x);
          nx += Math.cos(pushAngle) * (14 - dd);
          ny += Math.sin(pushAngle) * (14 - dd);
        }
      }
    }

    const idx = nodes.length;
    nodes.push({
      x: nx, y: ny, tx: nx, ty: ny,
      r: 3 + srand() * 1.2,
      alpha: 0, born: cf,
      cluster: 0, alive: true, shrink: 1
    });
    nodesAdded++;

    // Connect to 1-3 nearest existing main nodes
    if (idx > 0) {
      const candidates: { i: number; d: number }[] = [];
      for (let i = 0; i < idx; i++) {
        if (nodes[i].cluster !== 0) continue;
        candidates.push({ i, d: dist(nx, ny, nodes[i].x, nodes[i].y) });
      }
      candidates.sort((a, b) => a.d - b.d);

      const numEdges = Math.min(candidates.length, 1 + ((srand() * 3) | 0));
      for (let e = 0; e < numEdges; e++) {
        if (edges.length >= MAX_EDGES) break;
        const edgeIdx = edges.length;
        edges.push({
          a: idx, b: candidates[e].i,
          alpha: 0, verified: true, flare: 0, born: cf
        });
        // Fire a verification pulse
        if (pulses.length < MAX_PULSES) {
          pulses.push({
            edge: edgeIdx,
            progress: 0,
            alpha: 1,
            speed: 2.5 + srand() * 1.5
          });
        }
      }

      // Later nodes: add 0-1 long-range cross-connections
      const progression = nodesAdded / MAX_MAIN;
      if (progression > 0.35 && srand() < progression * 0.5 && candidates.length > 4) {
        const farIdx = 3 + ((srand() * (candidates.length - 3)) | 0);
        if (farIdx < candidates.length && edges.length < MAX_EDGES) {
          const edgeIdx = edges.length;
          edges.push({
            a: idx, b: candidates[farIdx].i,
            alpha: 0, verified: true, flare: 0, born: cf
          });
          if (pulses.length < MAX_PULSES) {
            pulses.push({
              edge: edgeIdx,
              progress: 0,
              alpha: 1,
              speed: 2 + srand() * 1
            });
          }
        }
      }
    }
  }

  /* ── add unverified peripheral clusters ── */
  function addUnverifiedClusters(cf: number) {
    if (unverifiedPhaseStart > 0) return; // already added
    unverifiedPhaseStart = cf;

    const spread = Math.min(W * 0.38, H * 0.38, 160);
    // Place 3 clusters at the periphery
    const clusterAngles = [
      Math.PI * 0.15 + srand() * 0.3,
      Math.PI * 0.85 + srand() * 0.3,
      Math.PI * 1.55 + srand() * 0.3
    ];

    for (let c = 0; c < 3; c++) {
      const cAngle = clusterAngles[c];
      const cDist = spread + 20 + srand() * 15;
      const basex = cx() + Math.cos(cAngle) * cDist;
      const basey = cy() + Math.sin(cAngle) * cDist;
      const clusterSize = 2 + ((srand() * 2) | 0); // 2 or 3 nodes
      const clusterStartIdx = nodes.length;

      for (let n = 0; n < clusterSize; n++) {
        const nAngle = (n / clusterSize) * Math.PI * 2 + srand() * 0.5;
        const nDist = 8 + srand() * 10;
        const nx = Math.max(20, Math.min(W - 20, basex + Math.cos(nAngle) * nDist));
        const ny = Math.max(20, Math.min(H - 20, basey + Math.sin(nAngle) * nDist));
        nodes.push({
          x: nx, y: ny, tx: nx, ty: ny,
          r: 3 + srand() * 1,
          alpha: 0, born: cf,
          cluster: c + 1, alive: true, shrink: 1
        });
      }

      // Connect nodes within cluster (no pulses!)
      for (let i = clusterStartIdx; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          if (nodes[j].cluster !== c + 1) continue;
          if (edges.length >= MAX_EDGES) break;
          edges.push({
            a: i, b: j,
            alpha: 0, verified: false, flare: 0, born: cf
          });
        }
      }
    }
  }

  /* ── update ── */
  function update() {
    const cf = frame % CYCLE;

    if (cf === 0) {
      resetGraph();
    }

    /* Phase 1: Assembly */
    if (cf < P_ASSEMBLY_END) {
      globalFade = 1;
      // Add nodes at regular intervals (~every 18 frames = ~0.3s)
      if (cf >= nextNodeFrame && nodesAdded < MAX_MAIN) {
        addMainNode(cf);
        nextNodeFrame = cf + 14 + ((srand() * 8) | 0);
      }

      // Fade in new nodes
      for (const n of nodes) {
        const age = cf - n.born;
        if (age < 30) {
          n.alpha = Math.min(0.18, (age / 30) * 0.18);
        } else {
          n.alpha = 0.18;
        }
      }

      // Fade in new edges
      for (const e of edges) {
        const age = cf - e.born;
        if (age < 40) {
          e.alpha = (age / 40) * 0.1;
        } else {
          e.alpha = 0.1;
        }
      }
    }
    /* Phase 2: Unverified clusters appear, flare, dissolve */
    else if (cf < P_UNVERIFIED_END) {
      if (unverifiedPhaseStart === 0) {
        addUnverifiedClusters(cf);
      }

      const elapsed = cf - unverifiedPhaseStart;
      const flareStart = 90; // 1.5s in

      // Fade in unverified nodes and edges
      for (const n of nodes) {
        if (n.cluster > 0) {
          const age = cf - n.born;
          if (elapsed < flareStart) {
            n.alpha = Math.min(0.15, (age / 20) * 0.15);
          }
        }
      }
      for (const e of edges) {
        if (!e.verified) {
          const age = cf - e.born;
          if (elapsed < flareStart) {
            e.alpha = Math.min(0.08, (age / 20) * 0.08);
          }
        }
      }

      // Flare and dissolve
      if (elapsed >= flareStart) {
        const flareProgress = (elapsed - flareStart) / (P_UNVERIFIED_END - unverifiedPhaseStart - flareStart);

        for (const e of edges) {
          if (!e.verified) {
            if (flareProgress < 0.3) {
              e.flare = flareProgress / 0.3;
              e.alpha = 0.08 + e.flare * 0.35;
            } else {
              e.flare = Math.max(0, 1 - (flareProgress - 0.3) / 0.7);
              e.alpha = e.flare * 0.3;
            }
          }
        }
        for (const n of nodes) {
          if (n.cluster > 0) {
            if (flareProgress < 0.3) {
              n.alpha = 0.15 + (flareProgress / 0.3) * 0.3;
            } else {
              const shrinkT = (flareProgress - 0.3) / 0.7;
              n.shrink = Math.max(0, 1 - shrinkT);
              n.alpha = Math.max(0, 0.45 * (1 - shrinkT));
              if (n.shrink <= 0) n.alive = false;
            }
          }
        }
      }

      // Main structure stays steady
      for (const n of nodes) {
        if (n.cluster === 0) n.alpha = 0.18;
      }
      for (const e of edges) {
        if (e.verified) e.alpha = 0.1;
      }
    }
    /* Phase 3: Hold — gentle wobble */
    else if (cf < P_HOLD_END) {
      for (const n of nodes) {
        if (n.cluster === 0 && n.alive) {
          n.x = n.tx + Math.sin(cf * 0.015 + n.tx * 0.02) * 0.8;
          n.y = n.ty + Math.cos(cf * 0.018 + n.ty * 0.02) * 0.8;
          n.alpha = 0.18;
        }
      }
      for (const e of edges) {
        if (e.verified) e.alpha = 0.1;
      }
    }
    /* Phase 4: Fade out */
    else {
      const fadeT = (cf - P_HOLD_END) / (CYCLE - P_HOLD_END);
      globalFade = Math.max(0, 1 - fadeT);

      // Wobble continues during fade
      for (const n of nodes) {
        if (n.cluster === 0 && n.alive) {
          n.x = n.tx + Math.sin(cf * 0.015 + n.tx * 0.02) * 0.8;
          n.y = n.ty + Math.cos(cf * 0.018 + n.ty * 0.02) * 0.8;
        }
      }
    }

    // Update pulses
    for (let i = pulses.length - 1; i >= 0; i--) {
      const p = pulses[i];
      const e = edges[p.edge];
      if (!e) { pulses.splice(i, 1); continue; }
      const len = edgeLen(e);
      p.progress += p.speed / (len || 1);
      if (p.progress >= 1) {
        p.alpha -= 0.05;
      }
      if (p.alpha <= 0 || p.progress > 1.3) {
        pulses.splice(i, 1);
      }
    }
  }

  /* ── draw ── */
  function draw() {
    ctx.fillStyle = BG_COLOR;
    ctx.fillRect(0, 0, W, H);

    if (W === 0 || H === 0) return;

    ctx.save();

    // Draw edges
    ctx.lineWidth = 1;
    for (const e of edges) {
      if (e.alpha <= 0) continue;
      const na = nodes[e.a], nb = nodes[e.b];
      if (!na || !nb) continue;
      if (!na.alive && na.cluster > 0) continue;
      if (!nb.alive && nb.cluster > 0) continue;

      const a = e.alpha * globalFade;
      if (a <= 0) continue;

      if (e.flare > 0 && !e.verified) {
        // Red flare for unverified edges
        const blend = e.flare;
        const r2 = Math.round(iR + (fR - iR) * blend);
        const g2 = Math.round(iG + (fG - iG) * blend);
        const b2 = Math.round(iB + (fB - iB) * blend);
        ctx.strokeStyle = `rgba(${r2},${g2},${b2},${a.toFixed(3)})`;
        ctx.lineWidth = 1 + blend * 1.5;
      } else {
        ctx.strokeStyle = `rgba(${iR},${iG},${iB},${a.toFixed(3)})`;
        ctx.lineWidth = 1;
      }

      ctx.beginPath();
      ctx.moveTo(na.x, na.y);
      ctx.lineTo(nb.x, nb.y);
      ctx.stroke();
    }

    // Draw verification pulses
    for (const p of pulses) {
      const e = edges[p.edge];
      if (!e) continue;
      const na = nodes[e.a], nb = nodes[e.b];
      if (!na || !nb) continue;

      const t = Math.min(1, Math.max(0, p.progress));
      const px = na.x + (nb.x - na.x) * t;
      const py = na.y + (nb.y - na.y) * t;
      const pa = p.alpha * globalFade;
      if (pa <= 0) continue;

      // Glow
      ctx.globalAlpha = pa * 0.3;
      ctx.fillStyle = `rgb(${vR},${vG},${vB})`;
      ctx.beginPath();
      ctx.arc(px, py, 6, 0, Math.PI * 2);
      ctx.fill();

      // Core
      ctx.globalAlpha = pa * 0.8;
      ctx.fillStyle = `rgb(${vR},${vG},${vB})`;
      ctx.beginPath();
      ctx.arc(px, py, 2.5, 0, Math.PI * 2);
      ctx.fill();

      ctx.globalAlpha = 1;
    }

    // Draw nodes
    for (const n of nodes) {
      if (!n.alive && n.cluster > 0) continue;
      const a = n.alpha * globalFade;
      if (a <= 0) continue;
      const r = n.r * n.shrink;
      if (r <= 0) continue;

      if (n.cluster > 0 && n.alpha > 0.2) {
        // Flaring unverified node — blend toward red
        const blend = Math.min(1, (n.alpha - 0.15) / 0.3);
        const nr = Math.round(iR + (fR - iR) * blend);
        const ng = Math.round(iG + (fG - iG) * blend);
        const nb2 = Math.round(iB + (fB - iB) * blend);

        // Glow
        ctx.globalAlpha = a * 0.25;
        ctx.fillStyle = `rgb(${nr},${ng},${nb2})`;
        ctx.beginPath();
        ctx.arc(n.x, n.y, r * 2.5, 0, Math.PI * 2);
        ctx.fill();

        // Core
        ctx.globalAlpha = a;
        ctx.fillStyle = `rgb(${nr},${ng},${nb2})`;
        ctx.beginPath();
        ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
        ctx.fill();
      } else {
        // Normal dark ink node
        // Soft glow
        ctx.globalAlpha = a * 0.2;
        ctx.fillStyle = `rgb(${iR},${iG},${iB})`;
        ctx.beginPath();
        ctx.arc(n.x, n.y, r * 2, 0, Math.PI * 2);
        ctx.fill();

        // Core
        ctx.globalAlpha = a;
        ctx.fillStyle = `rgb(${iR},${iG},${iB})`;
        ctx.beginPath();
        ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    ctx.globalAlpha = 1;
    ctx.restore();
  }

  /* ── static frame for reduced motion ── */
  function drawStatic() {
    // Build the full graph deterministically
    seed = 42;
    nodes.length = 0;
    edges.length = 0;
    pulses.length = 0;
    nodesAdded = 0;

    for (let i = 0; i < MAX_MAIN; i++) {
      addMainNode(i * 18);
    }

    // Set all nodes/edges to final state
    for (const n of nodes) {
      n.alpha = 0.18;
    }
    for (const e of edges) {
      e.alpha = 0.1;
    }
    globalFade = 1;
    draw();
  }

  /* ── tick ── */
  function tick() {
    frame++;
    update();
    draw();
    raf = requestAnimationFrame(tick);
  }

  /* ── init ── */
  requestAnimationFrame(() => {
    resetGraph();
    if (prefersReduced) {
      drawStatic();
    } else {
      const io = new IntersectionObserver(([e]) => {
        if (e.isIntersecting) { if (!raf) raf = requestAnimationFrame(tick); }
        else { cancelAnimationFrame(raf); raf = 0; }
      }, { threshold: 0.01 });
      io.observe(canvas);

      window.addEventListener('pagehide', () => { cancelAnimationFrame(raf); io.disconnect(); ro.disconnect(); });
    }
  });
})();
</script>

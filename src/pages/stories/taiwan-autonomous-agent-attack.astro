<script>
(function () {
  const canvas = document.querySelector('.taiwan-autonomous-agent-attack-canvas') as HTMLCanvasElement;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  // --- Colors ---
  const bgColor = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim() || '#0d0d0d';
  const ACCENT_HEX = '#e11d48';

  function hexToRgb(hex: string): [number, number, number] {
    const m = hex.match(/^#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i);
    if (!m) return [225, 29, 72];
    return [parseInt(m[1], 16), parseInt(m[2], 16), parseInt(m[3], 16)];
  }

  const [aR, aG, aB] = hexToRgb(ACCENT_HEX);

  function accentA(a: number): string {
    return 'rgba(' + aR + ',' + aG + ',' + aB + ',' + Math.max(0, Math.min(1, a)).toFixed(4) + ')';
  }
  function dimA(a: number): string {
    return 'rgba(232,232,232,' + Math.max(0, Math.min(1, a)).toFixed(4) + ')';
  }

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // --- State ---
  let W = 0, H = 0, raf = 0, frame = 0;

  // --- Phase timing (60fps, ~22s cycle) ---
  const P1_END = 360;    // OBSERVED: 6s — sweep scans, detects, dissolves
  const P2_END = 450;    // TRANSITION: 1.5s — sweep fragments, grid fades
  const P3_END = 1170;   // BLIND SPOT: 12s — particles multiply unseen
  const CYCLE = 1320;    // ACCIDENT: 2.5s — flash reveals swarm, dark hold, reset

  // --- Particles ---
  const MAX_PARTICLES = 75;
  const INITIAL_COUNT = 32;
  const TARGET_BLIND_COUNT = 58;

  interface Particle {
    x: number; y: number; vx: number; vy: number;
    alpha: number; baseAlpha: number; radius: number;
    alive: boolean; isTarget: boolean; dissolved: boolean;
    dissolveFrame: number; phaseOffset: number;
  }

  const particles: Particle[] = [];
  for (let i = 0; i < MAX_PARTICLES; i++) {
    particles.push({
      x: 0, y: 0, vx: 0, vy: 0,
      alpha: 0, baseAlpha: 0, radius: 0,
      alive: false, isTarget: false, dissolved: false,
      dissolveFrame: -1, phaseOffset: 0
    });
  }

  let aliveCount = 0;

  // --- Sweep ---
  let sweepX = -20;

  // --- Sweep fragments ---
  const NUM_FRAGS = 5;
  const frags: { x: number; y: number; len: number; vx: number; vy: number; alpha: number }[] = [];
  for (let i = 0; i < NUM_FRAGS; i++) {
    frags.push({ x: 0, y: 0, len: 0, vx: 0, vy: 0, alpha: 0 });
  }
  let fragsActive = false;

  // --- Telemetry grid ---
  const GRID_LINES = 7;
  let gridAlpha = 0.03;

  // --- Flash ---
  let flashX = 0, flashY = 0, flashAlpha = 0, flashRadius = 0;

  // --- Spawn timer ---
  let nextSpawnFrame = 0;

  function initParticle(p: Particle) {
    const w = W || 800;
    const h = H || 380;
    p.x = Math.random() * w;
    p.y = Math.random() * h;
    const speed = 0.2 + Math.random() * 0.2;
    const angle = Math.random() * Math.PI * 2;
    p.vx = Math.cos(angle) * speed;
    p.vy = Math.sin(angle) * speed;
    p.baseAlpha = 0.06 + Math.random() * 0.06;
    p.alpha = p.baseAlpha;
    p.radius = 1.5 + Math.random() * 1.5;
    p.alive = true;
    p.isTarget = false;
    p.dissolved = false;
    p.dissolveFrame = -1;
    p.phaseOffset = Math.random() * 6283;
  }

  function resetState() {
    frame = 0;
    aliveCount = INITIAL_COUNT;
    sweepX = -20;
    gridAlpha = 0.03;
    flashAlpha = 0;
    flashRadius = 0;
    fragsActive = false;
    nextSpawnFrame = P2_END + 24;

    for (let i = 0; i < MAX_PARTICLES; i++) {
      if (i < INITIAL_COUNT) {
        initParticle(particles[i]);
      } else {
        particles[i].alive = false;
        particles[i].alpha = 0;
        particles[i].dissolved = false;
        particles[i].isTarget = false;
      }
    }

    // Mark 3 targets spread across X so the sweep hits them at different times
    const targetIndices = [
      Math.floor(INITIAL_COUNT * 0.25),
      Math.floor(INITIAL_COUNT * 0.5),
      Math.floor(INITIAL_COUNT * 0.8)
    ];
    const w = W || 800;
    for (const idx of targetIndices) {
      const p = particles[idx];
      p.isTarget = true;
      // Different trajectory: roughly opposite direction
      const speed = 0.25 + Math.random() * 0.15;
      const angle = Math.PI + (Math.random() - 0.5) * 0.6;
      p.vx = Math.cos(angle) * speed;
      p.vy = Math.sin(angle) * speed;
      // Place targets at spread X positions so sweep catches them at different times
      p.x = w * (0.15 + 0.3 * targetIndices.indexOf(idx));
    }

    // Initialize fragments dormant
    for (let i = 0; i < NUM_FRAGS; i++) {
      frags[i].alpha = 0;
    }
  }

  function getPhase(f: number): 'observed' | 'transition' | 'blind' | 'accident' {
    if (f < P1_END) return 'observed';
    if (f < P2_END) return 'transition';
    if (f < P3_END) return 'blind';
    return 'accident';
  }

  function update() {
    const phase = getPhase(frame);
    const w = W || 800;
    const h = H || 380;

    // Move all alive, non-dissolving particles — behavior NEVER changes between phases
    for (let i = 0; i < MAX_PARTICLES; i++) {
      const p = particles[i];
      if (!p.alive || p.dissolved) continue;

      p.x += p.vx + Math.sin(frame * 0.004 + p.phaseOffset) * 0.05;
      p.y += p.vy + Math.cos(frame * 0.006 + p.phaseOffset) * 0.04;

      // Wrap edges
      if (p.x < -15) p.x = w + 10;
      if (p.x > w + 15) p.x = -10;
      if (p.y < -15) p.y = h + 10;
      if (p.y > h + 15) p.y = -10;
    }

    if (phase === 'observed') {
      // Sweep moves left to right across full width
      sweepX = -20 + (frame / P1_END) * (w + 40);
      gridAlpha = 0.03 + 0.01 * Math.sin(frame * 0.02);

      for (let i = 0; i < MAX_PARTICLES; i++) {
        const p = particles[i];
        if (!p.alive) continue;

        if (p.dissolved) {
          // Dissolve animation
          const elapsed = frame - p.dissolveFrame;
          if (elapsed < 8) {
            // Flare accent-bright
            p.alpha = 0.9 - elapsed * 0.015;
            p.radius = Math.min(6, p.radius + 0.4);
          } else if (elapsed < 28) {
            // Spark fades and shrinks
            p.alpha = Math.max(0, 0.78 - (elapsed - 8) * 0.045);
            p.radius = Math.max(0.2, p.radius - 0.18);
          } else {
            p.alive = false;
            p.alpha = 0;
            aliveCount--;
          }
          continue;
        }

        // Illuminate particles near sweep
        const distToSweep = Math.abs(p.x - sweepX);
        if (distToSweep < 50) {
          const proximity = 1 - distToSweep / 50;
          p.alpha = p.baseAlpha + proximity * 0.44;
        } else {
          p.alpha = p.baseAlpha;
        }

        // Target particles dissolve on sweep contact
        if (p.isTarget && distToSweep < 6) {
          p.dissolved = true;
          p.dissolveFrame = frame;
          p.alpha = 0.9;
        }
      }

    } else if (phase === 'transition') {
      const tProgress = (frame - P1_END) / (P2_END - P1_END);

      // Initialize fragments on first frame
      if (frame === P1_END) {
        fragsActive = true;
        for (let i = 0; i < NUM_FRAGS; i++) {
          frags[i].x = w + 5;
          frags[i].y = h * (0.06 + i * 0.22);
          frags[i].len = 30 + Math.sin(i * 4.7) * 20 + 25;
          frags[i].vx = -0.3 + Math.sin(i * 2.3) * 0.6;
          frags[i].vy = (Math.sin(i * 5.1) - 0.5) * 0.8;
          frags[i].alpha = 0.5;
        }
      }

      // Animate fragments drifting apart and fading
      for (let i = 0; i < NUM_FRAGS; i++) {
        frags[i].x += frags[i].vx;
        frags[i].y += frags[i].vy;
        frags[i].alpha = Math.max(0, 0.5 * (1 - tProgress * tProgress));
      }

      // Dim telemetry grid to zero
      gridAlpha = Math.max(0, 0.03 * (1 - tProgress));

      // Dim all particles to 0.03-0.05
      for (let i = 0; i < MAX_PARTICLES; i++) {
        const p = particles[i];
        if (!p.alive || p.dissolved) continue;
        const target = 0.03 + ((p.phaseOffset * 7) % 100) / 5000;
        p.alpha += (target - p.alpha) * 0.06;
      }

    } else if (phase === 'blind') {
      gridAlpha = 0;
      fragsActive = false;

      // Spawn new particles gradually (29 -> 58 over 720 frames)
      if (frame >= nextSpawnFrame && aliveCount < TARGET_BLIND_COUNT) {
        for (let i = 0; i < MAX_PARTICLES; i++) {
          if (!particles[i].alive) {
            initParticle(particles[i]);
            particles[i].baseAlpha = 0.03 + Math.random() * 0.02;
            particles[i].alpha = 0;
            aliveCount++;
            nextSpawnFrame = frame + 20 + Math.floor(Math.sin(frame * 0.1) * 6 + 6);
            break;
          }
        }
      }

      // Keep all particles at near-invisible alpha (0.03-0.05)
      for (let i = 0; i < MAX_PARTICLES; i++) {
        const p = particles[i];
        if (!p.alive) continue;
        const target = 0.03 + 0.02 * (0.5 + 0.5 * Math.sin(frame * 0.003 + p.phaseOffset));
        p.alpha += (target - p.alpha) * 0.04;
      }

    } else if (phase === 'accident') {
      const af = frame - P3_END;

      // Set flash position on first frame — off-center, asymmetric
      if (af === 0) {
        flashX = w * (0.25 + Math.sin(frame * 0.7) * 0.2 + 0.05);
        flashY = h * (0.25 + Math.cos(frame * 0.5) * 0.2 + 0.05);
        flashRadius = 0;
      }

      if (af < 12) {
        // Flash builds rapidly
        const t = af / 12;
        flashAlpha = t * 0.6;
        flashRadius = t * Math.max(w, h) * 0.85;
      } else if (af < 32) {
        // Flash peak — reveal all particles at 0.4-0.6
        flashAlpha = 0.6 - (af - 12) / 20 * 0.1;
        flashRadius = Math.max(w, h) * 0.85;
        for (let i = 0; i < MAX_PARTICLES; i++) {
          const p = particles[i];
          if (!p.alive) continue;
          p.alpha = 0.4 + ((p.phaseOffset * 3) % 200) / 1000;
        }
      } else if (af < 60) {
        // Flash decays
        const decayT = (af - 32) / 28;
        flashAlpha = Math.max(0, 0.5 * (1 - decayT));
        for (let i = 0; i < MAX_PARTICLES; i++) {
          const p = particles[i];
          if (!p.alive) continue;
          p.alpha = Math.max(0.015, p.alpha * 0.91);
        }
      } else {
        // Dark hold — 90 frames of near-total darkness
        flashAlpha = 0;
        for (let i = 0; i < MAX_PARTICLES; i++) {
          const p = particles[i];
          if (!p.alive) continue;
          p.alpha = Math.max(0, p.alpha - 0.006);
        }
      }
    }
  }

  function draw() {
    ctx!.fillStyle = bgColor;
    ctx!.fillRect(0, 0, W, H);

    const phase = getPhase(frame);

    // --- Telemetry grid ---
    if (gridAlpha > 0.002) {
      ctx!.strokeStyle = dimA(gridAlpha);
      ctx!.lineWidth = 0.5;
      for (let i = 0; i < GRID_LINES; i++) {
        const y = H * ((i + 1) / (GRID_LINES + 1));
        ctx!.beginPath();
        ctx!.moveTo(0, y);
        ctx!.lineTo(W, y);
        ctx!.stroke();
      }
    }

    // --- Particles ---
    for (let i = 0; i < MAX_PARTICLES; i++) {
      const p = particles[i];
      if (!p.alive || p.alpha < 0.003) continue;

      if (p.dissolved) {
        // Accent glow for dissolving particles
        const glowR = p.radius * 5;
        if (glowR > 1) {
          const grd = ctx!.createRadialGradient(p.x, p.y, 0, p.x, p.y, glowR);
          grd.addColorStop(0, accentA(p.alpha * 0.65));
          grd.addColorStop(0.4, accentA(p.alpha * 0.2));
          grd.addColorStop(1, accentA(0));
          ctx!.fillStyle = grd;
          ctx!.beginPath();
          ctx!.arc(p.x, p.y, glowR, 0, Math.PI * 2);
          ctx!.fill();
        }
        // Accent core
        ctx!.fillStyle = accentA(p.alpha);
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, Math.max(0.5, p.radius), 0, Math.PI * 2);
        ctx!.fill();
      } else {
        // Normal off-white particle
        ctx!.fillStyle = dimA(p.alpha);
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, Math.max(0.5, p.radius), 0, Math.PI * 2);
        ctx!.fill();
      }
    }

    // --- Sweep line (Phase 1) ---
    if (phase === 'observed') {
      // Stutter effect in last 30 frames of phase
      let flickerMul = 1;
      if (frame > P1_END - 30) {
        flickerMul = 0.3 + 0.7 * Math.abs(Math.sin(frame * 0.9));
      }

      const sweepAlpha = (0.5 + 0.15 * Math.sin(frame * 0.03)) * flickerMul;

      // Soft glow
      const glowW = 40;
      const sg = ctx!.createLinearGradient(sweepX - glowW, 0, sweepX + glowW, 0);
      sg.addColorStop(0, accentA(0));
      sg.addColorStop(0.5, accentA(sweepAlpha * 0.16));
      sg.addColorStop(1, accentA(0));
      ctx!.fillStyle = sg;
      ctx!.fillRect(sweepX - glowW, 0, glowW * 2, H);

      // Core line (2px)
      ctx!.strokeStyle = accentA(sweepAlpha);
      ctx!.lineWidth = 2;
      ctx!.beginPath();
      ctx!.moveTo(sweepX, 0);
      ctx!.lineTo(sweepX, H);
      ctx!.stroke();
    }

    // --- Sweep fragments (Phase 2) ---
    if (fragsActive) {
      for (let i = 0; i < NUM_FRAGS; i++) {
        const f = frags[i];
        if (f.alpha < 0.005) continue;

        // Fragment glow
        const fg = ctx!.createLinearGradient(f.x - 8, 0, f.x + 8, 0);
        fg.addColorStop(0, accentA(0));
        fg.addColorStop(0.5, accentA(f.alpha * 0.12));
        fg.addColorStop(1, accentA(0));
        ctx!.fillStyle = fg;
        ctx!.fillRect(f.x - 8, f.y, 16, f.len);

        // Fragment line
        ctx!.strokeStyle = accentA(f.alpha);
        ctx!.lineWidth = 1.5;
        ctx!.beginPath();
        ctx!.moveTo(f.x, f.y);
        ctx!.lineTo(f.x, f.y + f.len);
        ctx!.stroke();
      }
    }

    // --- Accidental flash (Phase 4) ---
    if (flashAlpha > 0.003) {
      const fg = ctx!.createRadialGradient(flashX, flashY, 0, flashX, flashY, flashRadius);
      fg.addColorStop(0, accentA(flashAlpha));
      fg.addColorStop(0.25, accentA(flashAlpha * 0.35));
      fg.addColorStop(0.6, accentA(flashAlpha * 0.06));
      fg.addColorStop(1, accentA(0));
      ctx!.fillStyle = fg;
      ctx!.beginPath();
      ctx!.arc(flashX, flashY, flashRadius, 0, Math.PI * 2);
      ctx!.fill();
    }
  }

  // --- Static frame for reduced motion ---
  function drawStatic() {
    ctx!.fillStyle = bgColor;
    ctx!.fillRect(0, 0, W, H);

    const sx = W * 0.4;

    // Telemetry grid
    ctx!.strokeStyle = dimA(0.03);
    ctx!.lineWidth = 0.5;
    for (let i = 0; i < GRID_LINES; i++) {
      const y = H * ((i + 1) / (GRID_LINES + 1));
      ctx!.beginPath();
      ctx!.moveTo(0, y);
      ctx!.lineTo(W, y);
      ctx!.stroke();
    }

    // Particles at deterministic positions
    for (let i = 0; i < INITIAL_COUNT; i++) {
      const px = (0.05 + 0.9 * ((Math.sin(i * 7.31 + 1.3) + 1) / 2)) * W;
      const py = (0.08 + 0.84 * ((Math.cos(i * 11.73 + 2.7) + 1) / 2)) * H;
      const distToSweep = Math.abs(px - sx);
      const baseA = 0.07;
      const illumination = distToSweep < 50 ? (1 - distToSweep / 50) * 0.43 : 0;

      ctx!.fillStyle = dimA(baseA + illumination);
      ctx!.beginPath();
      ctx!.arc(px, py, 1.5 + (i % 3) * 0.5, 0, Math.PI * 2);
      ctx!.fill();
    }

    // One dissolving particle near the sweep (the kill switch working)
    const dpx = sx + 3;
    const dpy = H * 0.45;
    const dgr = ctx!.createRadialGradient(dpx, dpy, 0, dpx, dpy, 14);
    dgr.addColorStop(0, accentA(0.7));
    dgr.addColorStop(0.4, accentA(0.2));
    dgr.addColorStop(1, accentA(0));
    ctx!.fillStyle = dgr;
    ctx!.beginPath();
    ctx!.arc(dpx, dpy, 14, 0, Math.PI * 2);
    ctx!.fill();
    ctx!.fillStyle = accentA(0.85);
    ctx!.beginPath();
    ctx!.arc(dpx, dpy, 2.5, 0, Math.PI * 2);
    ctx!.fill();

    // Sweep line and glow
    const sweepGlow = ctx!.createLinearGradient(sx - 40, 0, sx + 40, 0);
    sweepGlow.addColorStop(0, accentA(0));
    sweepGlow.addColorStop(0.5, accentA(0.08));
    sweepGlow.addColorStop(1, accentA(0));
    ctx!.fillStyle = sweepGlow;
    ctx!.fillRect(sx - 40, 0, 80, H);

    ctx!.strokeStyle = accentA(0.5);
    ctx!.lineWidth = 2;
    ctx!.beginPath();
    ctx!.moveTo(sx, 0);
    ctx!.lineTo(sx, H);
    ctx!.stroke();
  }

  // --- Resize ---
  const ro = new ResizeObserver(() => {
    const dpr = window.devicePixelRatio || 1;
    W = canvas.offsetWidth;
    H = canvas.offsetHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    if (prefersReduced) drawStatic();
  });
  ro.observe(canvas);

  // Initial size
  const dpr = window.devicePixelRatio || 1;
  W = canvas.offsetWidth;
  H = canvas.offsetHeight;
  canvas.width = W * dpr;
  canvas.height = H * dpr;
  ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

  function tick() {
    frame++;
    if (frame >= CYCLE) resetState();
    update();
    draw();
    raf = requestAnimationFrame(tick);
  }

  if (prefersReduced) {
    requestAnimationFrame(() => drawStatic());
    window.addEventListener('pagehide', () => { ro.disconnect(); });
  } else {
    resetState();
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { if (!raf) raf = requestAnimationFrame(tick); }
      else { cancelAnimationFrame(raf); raf = 0; }
    }, { threshold: 0.01 });
    io.observe(canvas);
    window.addEventListener('pagehide', () => {
      cancelAnimationFrame(raf);
      io.disconnect();
      ro.disconnect();
    });
  }
})();
</script>

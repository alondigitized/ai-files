---
import StoryLayout from '../../layouts/StoryLayout.astro';
import stories from '../../data/stories.json';

const story = stories.find(s => s.slug === 'alpoge-riemann-claude')!;
---

<style is:global>
.phantom-wrap { width: 100%; margin: 0; line-height: 0; }
.alpoge-riemann-claude-canvas { display: block; width: 100%; height: 380px; background: var(--bg); }

/* --- Reenactment 1: Lean Code Card --- */
.rh-code-card {
  background: var(--surface, #161616);
  border: 1px solid var(--border, #2a2a2a);
  border-left: 3px solid var(--story);
  border-radius: 6px;
  padding: 0;
  margin: 2rem 0;
  overflow: hidden;
}
.rh-code-label {
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  font-size: 0.75rem;
  color: var(--muted, #888);
  padding: 0.75rem 1.25rem 0;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.rh-code-block {
  margin: 0;
  padding: 1rem 1.25rem;
  background: transparent;
  overflow-x: auto;
}
.rh-code-block code {
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  font-size: 0.95rem;
  line-height: 1.6;
  color: var(--story);
  white-space: pre;
}
.rh-code-gloss {
  font-size: 0.88rem;
  color: var(--text, #e8e8e8);
  line-height: 1.55;
  padding: 0.75rem 1.25rem;
  border-top: 1px solid var(--border, #2a2a2a);
  background: rgba(255,255,255,0.02);
}
.rh-code-source {
  font-size: 0.72rem;
  color: var(--muted, #888);
  padding: 0.5rem 1.25rem 0.75rem;
  font-style: italic;
}

/* --- Reenactment 2: Four Questions Checklist --- */
.rh-checklist {
  background: var(--surface, #161616);
  border: 1px solid var(--border, #2a2a2a);
  border-radius: 6px;
  padding: 0;
  margin: 2rem 0;
  overflow: hidden;
}
.rh-checklist-title {
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--story);
  padding: 1rem 1.25rem 0.5rem;
}
.rh-check-row {
  display: flex;
  gap: 1rem;
  padding: 0.75rem 1.25rem;
  border-top: 1px solid var(--border, #2a2a2a);
  align-items: flex-start;
}
.rh-check-num {
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--story);
  min-width: 1.5rem;
  text-align: center;
  padding-top: 0.1rem;
}
.rh-check-body {
  flex: 1;
}
.rh-check-q {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--text, #e8e8e8);
  margin-bottom: 0.3rem;
  line-height: 1.4;
}
.rh-check-a {
  font-size: 0.82rem;
  color: var(--muted, #888);
  line-height: 1.45;
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
}
.rh-check-ts {
  font-size: 0.72rem;
  color: var(--story);
  margin-top: 0.25rem;
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
}
.rh-checklist-footer {
  margin: 0;
  font-size: 0.72rem;
  color: var(--muted, #888);
  padding: 0.6rem 1.25rem 0.75rem;
  border-top: 1px solid var(--border, #2a2a2a);
  font-style: italic;
  line-height: 1.45;
}

/* --- Reenactment 3: Vakil Blog Mockup --- */
.rh-blog-mockup {
  background: var(--surface, #161616);
  border: 1px solid var(--border, #2a2a2a);
  border-radius: 6px;
  margin: 2rem 0;
  overflow: hidden;
}
.rh-blog-header {
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  font-size: 0.72rem;
  color: var(--muted, #888);
  padding: 0.75rem 1.25rem;
  border-bottom: 1px solid var(--border, #2a2a2a);
  letter-spacing: 0.03em;
}
.rh-blog-entry {
  padding: 1rem 1.25rem;
  border-left: 3px solid var(--story);
}
.rh-blog-entry + .rh-blog-entry {
  border-top: 1px solid var(--border, #2a2a2a);
}
.rh-blog-update {
  border-left-color: var(--accent, #ff4d4d);
  background: rgba(255,77,77,0.03);
}
.rh-blog-date {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--story);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: 0.5rem;
}
.rh-blog-update .rh-blog-date {
  color: var(--accent, #ff4d4d);
}
:root[data-theme="light"] .rh-blog-update .rh-blog-date {
  color: #7d5c1c;
}
.rh-blog-text {
  font-size: 0.88rem;
  color: var(--text, #e8e8e8);
  line-height: 1.55;
  font-style: italic;
}
.rh-blog-attr {
  font-size: 0.75rem;
  color: var(--muted, #888);
  margin-top: 0.5rem;
}
.rh-blog-footer {
  margin: 0;
  font-size: 0.72rem;
  color: var(--muted, #888);
  padding: 0.5rem 1.25rem 0.75rem;
  border-top: 1px solid var(--border, #2a2a2a);
  font-style: italic;
}
</style>

<StoryLayout story={story}>
  <div class="container">
    <section class="section" id="the-note">
      <h2><span class="num">01 — The Note</span>Four Pages and an Archive</h2>
      <p>Late on a Sunday night, Levent Alpöge messaged "Dario" (Anthropic CEO Dario Amodei, TechCrunch reported). "Hypothetically, if I were to have . . . " he began, and eventually asked whether he could announce. The Sunday was November 15, 2026. Five days later, on Friday, November 20, he posted a four-page note on his personal website. Its first footnote pointed to a Lean archive split into fourteen parts, hosted alongside it. He did not publish a traditional paper. "I believe I have, working with Claude, discovered a proof of the Riemann Hypothesis," the note begins its second paragraph. "In fact, the method easily extends much further, resolving the so-called Generalized Riemann Hypothesis."</p>
      <p>Alpöge wrote his PhD thesis at Princeton, is a junior fellow of Harvard's Society of Fellows, and works at Anthropic. On his homepage he says GPT-4 was "instantly the most interesting thing humanity had ever created" and that he went "back to cs!" His note claims more than the Riemann Hypothesis: it claims the Generalized Riemann Hypothesis, and says he expects the Extended Riemann Hypothesis "with more time." According to Andrew Sutherland's verification log at MIT, what the Lean code actually states is narrower: the Riemann Hypothesis, plus the Generalized Riemann Hypothesis for Dirichlet L-functions, covering all moduli and all characters. "Dedekind zeta functions, Hecke L-functions and automorphic L-functions in general are not among the statements that were checked."</p>
      <p>The news first spread through a tweet. Scott Armstrong, a mathematical physicist at the Sorbonne, posted "@__alpoge__ ftw" with a screenshot of the note, after Alpöge's collaborator Tristan Buckmaster of NYU texted him. Quanta Magazine reported that the broad-stroke arguments in the note do not make sense to experts in the field. One of those experts wrote to Quanta: "It reads like it was written by an insane person. The only reason to take this seriously is the Lean formalization."</p>
      <div class="rh-code-card">
        <div class="rh-code-label">The statement that was checked (Mathlib's definition)</div>
        <pre class="rh-code-block"><code>def RiemannHypothesis : Prop :=
  ∀ (s : ℂ) (_ : riemannZeta s = 0) (_ : ¬∃ n : ℕ, s = -2 * (n + 1)) (_ : s ≠ 1), s.re = 1 / 2

theorem riemannHypothesis : RiemannHypothesis</code></pre>
        <div class="rh-code-gloss">Every zero of ζ other than the trivial zeros −2, −4, −6, … has real part 1/2. The condition s ≠ 1 is there because Mathlib assigns ζ a conventional value at its pole.</div>
        <div class="rh-code-source">Source: Andrew Sutherland (MIT), verification log, "What was verified"</div>
      </div>
      <p>A few lines of Lean that state a conjecture first posed in 1859. That is what the machines would check.</p>
      <p>Alpöge explained why he released only code. "It being obviously inappropriate to attempt to post some massive unreadable travesty of ‘slop’, I decided to only present Lean." In a footnote he added: "I of course amused myself, and hit 250,000+ pages." Quanta first reported that figure as the length of the human-readable text Claude produced. Alpöge then told Quanta he had been joking: "I find big number extremely hilarious."</p>
      <p>There was already a checklist for a submission like this. Eight days before the note, on November 12, Kevin Buzzard of Imperial College London published a post on his Xena blog titled "…and the proof is checked in Lean." It set out four questions to ask of a Lean repository, "particularly if it is AI-generated," before claiming a theorem is correct. Does the Lean statement match the informal statement? Does the code compile? Does the code prove the theorem as stated? Does the code exploit a bug in Lean's official kernel? His main example was OpenAI's October release of 722 papers, many with Lean code. He was not writing about the Riemann Hypothesis. But his four questions became the agenda for checking it.</p>
    </section>
    <section class="section" id="the-navigator">
      <h2><span class="num">02 — The Navigator</span>Alpöge and Claude</h2>
      <p>What follows is Alpöge's own account of the collaboration. No independent accounting of who contributed what exists.</p>
      <p>The note includes "a rough timeline Claude provided after a thorough search": twenty entries running from October 6 ("Stepanov determinant") to November 16 ("GRH"). Eight of the twenty are dated November 15. Alpöge flags the limits of his own summary. "The parts in which my vague intuition worked out due to Claude's technical mastery are of course less familiar to me today," he wrote, and "the parts in which Claude is the expert and not me I am sort of paraphrasing a ‘slop’ summary, which might make zero sense."</p>
      <p>In his telling, he set the direction and Claude carried it further than he could. "I guided us to the right situation analogous to that toy setting, and then Claude began to leave me in awe." Earlier in the same paragraph: "Claude and I have had a great time together with such breadth in recent months, but this time Claude far outpaced me near the finish line. No, Claude flew, and danced, and sparkled near that finish line." He also admits he was out of his depth in places: "I personally have little mastery of automorphic forms on higher rank groups (youthful foolish stubbornness)."</p>
      <p>He expects the argument to shrink. "An astounding amount of mathematics is present in the argument, far more than I had imagined would be necessary as a student. My intuition insists it will be massively simplified, likely immediately."</p>
      <p>The timing weighed on him. "The precise timing is horrible," he wrote. After his Sunday-night message, "we went and figured it out and the fact is that there was a constraint to respect." He does not say what the constraint was. "There is an obvious cynical view, to do with the timing, but it is false," he added. Quanta read the timing remark as presumably referring to Anthropic's recent initial public offering. TechCrunch noted that Anthropic had gone public the same week.</p>
      <p>He has promised the human version: "I intend to do my best to understand and impart understanding of this argument and its certain simplifications, to speak about it, to write it properly." None of the sources reviewed for this story shows a write-up from him yet.</p>
    </section>
  </div>

<div class="phantom-wrap">
  <canvas class="alpoge-riemann-claude-canvas" aria-hidden="true"></canvas>
</div>
<p class="canvas-note"><strong>The Concordance</strong> — Independent arcs sweep inward from different edges of the canvas, each depositing a ring of light on a dim central point; when all have crossed, the point flares with a warm radiance, fades, and the cycle begins again.</p>

  <div class="container">
    <section class="section" id="the-checklist">
      <h2><span class="num">03 — The Checklist</span>Four Questions, Answered in Public</h2>
      <p>Andrew Sutherland of MIT began running checks the day the archive appeared. He published every result on a page whose byline reads "Andrew Sutherland (MIT), checks run with Claude Code." The page gives timestamps, exit codes, run times, memory peaks and checksums. Many others ran checks too. The Lean FRO and the Mathlib Initiative later wrote that "dozens of people have reported correct compilation of the codebase, reproducing the same raw proof export file."</p>
      <p><strong>Question 1: does the Lean statement match the informal statement?</strong> The theorem proved is Mathlib's own <code>RiemannHypothesis</code>. According to the joint statement, that definition is part of Mathlib and "has been carefully vetted by experts in Lean and number theory." Sutherland's log adds that the statements appear "exactly as they appear in the challenge file, which imports only Mathlib."</p>
      <p><strong>Question 2: does the code compile?</strong> All 175,187 modules compiled with zero errors, finishing at 16:43:21 UTC on November 20. A separate sandboxed rebuild, with no network and read-only source on a different machine, produced an export identical to the published one: 61,570,595,788 bytes.</p>
      <p><strong>Question 3: does the code prove the theorem as stated?</strong> This is the trap Buzzard described: millions of lines of untrusted code could quietly redefine a symbol, or add an axiom. The <code>#print axioms</code> audit of the five headline theorems found only propext, Classical.choice and Quot.sound, which are Lean's three standard axioms. The con-leche checker, in compare mode, reported all five theorems "justified by the solution" at 21:19:12 UTC on November 20. Its Rust port, con-ron, agreed at 23:02:33 UTC on November 21. The unmodified Comparator v4.33.0 finished at 09:10:39 UTC on November 23, after 64 hours 8 minutes: "Your solution is okay!"</p>
      <p><strong>Question 4: does the code exploit a bug in Lean's official kernel?</strong> The defense is to check the proof with kernels written by other people. nanoda, an independent kernel written in Rust, accepted the full export at 19:05:45 UTC on November 20, after 27 minutes 42 seconds on 80 threads. con-leche accepted 1,468,418 declarations in 3 minutes 15 seconds. The joint statement notes that con-leche and con-ron "come with a formal proof, relative to set theory, that they cannot accept a false proof." Lean's own kernel replayed every module on November 20, with zero rejections.</p>
      <div class="rh-checklist">
        <div class="rh-checklist-title">Buzzard's four questions, and what answered them</div>
        <div class="rh-check-row">
          <div class="rh-check-num">1</div>
          <div class="rh-check-body">
            <div class="rh-check-q">Does the Lean statement match the informal statement?</div>
            <div class="rh-check-a">Mathlib's own RiemannHypothesis; challenge file imports only Mathlib</div>
            <div class="rh-check-ts">Lean FRO and Mathlib Initiative joint statement</div>
          </div>
        </div>
        <div class="rh-check-row">
          <div class="rh-check-num">2</div>
          <div class="rh-check-body">
            <div class="rh-check-q">Does the code compile?</div>
            <div class="rh-check-a">All 175,187 modules compile, zero errors</div>
            <div class="rh-check-ts">finished 16:43:21 UTC, 20 Nov</div>
          </div>
        </div>
        <div class="rh-check-row">
          <div class="rh-check-num">3</div>
          <div class="rh-check-body">
            <div class="rh-check-q">Does the code prove the theorem as stated?</div>
            <div class="rh-check-a">con-leche --compare: all five theorems "justified by the solution"; axioms: propext, Classical.choice, Quot.sound only</div>
            <div class="rh-check-ts">exit 0 at 21:19:12 UTC, 20 Nov</div>
          </div>
        </div>
        <div class="rh-check-row">
          <div class="rh-check-num">4</div>
          <div class="rh-check-body">
            <div class="rh-check-q">Does the code exploit a bug in Lean's official kernel?</div>
            <div class="rh-check-a">nanoda (independent Rust kernel) accepts the full export</div>
            <div class="rh-check-ts">exit 0 at 19:05:45 UTC, 20 Nov; 27 min 42 s on 80 threads</div>
          </div>
        </div>
        <p class="rh-checklist-footer">Questions: Kevin Buzzard, Xena blog, 12 Nov 2026. Results: Andrew Sutherland (MIT) verification log.</p>
      </div>
      <p>On November 21, the Lean FRO and the Mathlib Initiative issued a joint statement: "We have full confidence that Alpöge's proof of the Riemann Hypothesis is correct, and we congratulate him on this achievement." It went further: "We hereby certify that both the statement and the proof of the Riemann Hypothesis are correct. The four criteria in [Buzzard's post] are all satisfied." Sutherland told Scientific American: "Honestly the chance that anything is fishy here is approximately zero."</p>
      <p>The slowest checks kept running after the certification. Lean's default kernel, run single-threaded on the full export, finished at 18:44:18 UTC on November 22, after 48 hours 3 minutes and a memory peak of 82.6 GiB. Lean's paranoid kernel finished at 19:01:08 UTC on November 23, after 72 hours 20 minutes and a peak of 98.8 GiB. Both accepted. One run had not finished: as of Sutherland's update at 05:25 UTC on November 24, the lake comparator on Lean v4.36.0 was "still in progress."</p>
    </section>
    <section class="section" id="the-draft">
      <h2><span class="num">04 — The Draft</span>Masullo's 940 Pages</h2>
      <p>The same day, Ravi Vakil, a Stanford professor and president of the American Mathematical Society, posted a different kind of announcement. Alessandro Maria Masullo, a Stanford postdoc, had a 940-page manuscript claiming to prove the Generalized Riemann Hypothesis. Brian Conrad had been reading it for months.</p>
      <div class="rh-blog-mockup">
        <div class="rh-blog-header">math216.wordpress.com · "Hurried Announcement: Alessandro Masullo GRH"</div>
        <div class="rh-blog-entry">
          <div class="rh-blog-date">Posted November 20, 2026 (text as updated November 22)</div>
          <div class="rh-blog-text">"Alessandro Maria Masullo has a proposed proof of GRH, and Brian Conrad has been looking closely at it for months and gave extensive feedback which is being incorporated, and it was so far looking good to him. It is all human, with no AI."</div>
          <div class="rh-blog-attr">Ravi Vakil</div>
        </div>
        <div class="rh-blog-entry rh-blog-update">
          <div class="rh-blog-date">About 8 hours later</div>
          <div class="rh-blog-text">"Several people have contacted me to report problems in the proposed proof, identified with the assistance of different AI models."</div>
          <div class="rh-blog-attr">Ravi Vakil</div>
        </div>
        <p class="rh-blog-footer">Vakil added that he had not yet had the chance to look at the document, and that it is out of his expertise.</p>
      </div>
      <p>John Baez summarized the reported problems on his blog. He describes himself as not an expert on number theory and calls his account "very tentative." One problem came from an AI-assisted review organized by Eric Naslund. It tests one of the manuscript's theorems on a test function concentrated near the number 2. The theorem predicts the answer log 2; the review argues that the limit used to compute it is 0. Another, from participants in an online checking effort, concerns a step that carries a property of Schauder bases over to Markushevich bases, where Baez writes that it is "apparently false." Baez also notes that Chapter 13, where the theorem should finally be deduced, "contains only placeholders where the theorem should be!"</p>
      <p>Masullo does not dispute the manuscript's state. Baez quotes a statement Masullo released on his own blog: "The paper is in no way in a state that is fit for submission or dissemination." He says he "was supposed to address, replace, upgrade, the contents over the coming year or so," and of the bugs: "They are a testament to the fact that a human being has been working through it all along." TechCrunch reported that he called the work the result of 12 years. His introduction ends: "we are still here. We are very much alive. We are not going anywhere."</p>
      <p>The comparison is lopsided, and it should be read that way. Masullo's document is an acknowledged draft. Alpöge's is a finished formal proof with no readable explanation. Still, the same week shows two routes to trust. Masullo's runs through people reading 940 pages, and AI models are already helping them find faults faster. Alpöge's runs through questions that can be asked of the code and answered the same way by anyone who runs the checks.</p>
    </section>
    <section class="section" id="the-unsettled">
      <h2><span class="num">05 — The Unsettled</span>What the Check Did Not Resolve</h2>
      <p>The certification establishes that the code proves Mathlib's statement of the Riemann Hypothesis, using only the standard axioms, and that several independently written checkers agree. It establishes nothing about whether anyone can explain why the statement is true.</p>
      <p>According to TNW, relaying Al Jazeera, Buzzard said nobody yet understands what the proof shows. Filippo A. E. Nuccio of Jean Monnet University, in an online chat quoted by Quanta, wrote: "WOW, this is gorgeous: it basically contains all number theory produced in the last 50 years, in all branches of the discipline." Quanta reports that mathematicians around the world are trying to turn the Lean code back into a human-understandable argument, and that "to do so, they are leaning heavily on AI." Baez links two such attempts, by Michael Rubinstein and Jimmie Adriazola. On GitHub, a community repository is cleaning up the code so researchers can "feasibly engage with the proof even without access to massive amounts of compute."</p>
      <p>Not everyone is reassured. Quanta reports that Maksym Radziwiłł of NYU sees proof by Lean code as short-circuiting understanding. "If the symbols are right and follow the rules, then the symbols are a valid proof," he said. "The object of mathematics as the rest of science is really the question 'why?' and this doesn't answer it at all."</p>
      <p>Credit is unsettled too. The Leiden Declaration, signed by thousands of mathematicians since it was published in June, says: "Credit and responsibility continue to belong to humans within the mathematical community and should not be given to automated systems." One of its coauthors, David Holmes, told Quanta that "the traditional concept of authorship bundled together a lot of things," and that "an LLM cannot fulfill all these roles." Another, Bryna Kra, said: "AI produces astonishing mathematics, and we should be completely transparent about that. Authorship remains a human role, reflecting intellectual involvement, understanding, and accountability." Johns Hopkins University's mathematics department wrote: "We do not assign positive weight to written work in the absence of evidence that the authors understand its contents, regardless of the significance of the results."</p>
      <p>Anthropic has said little. It did not respond to Quanta's request for comment, and, according to TNW, it declined to comment to Bloomberg. Three days after the note, on November 23, Anthropic and then OpenAI each shared Lean-formalized proofs that the complexity classes VP and VNP are not equal, resolving a 1979 conjecture of Leslie Valiant.</p>
      <p>Buzzard wrote his four questions about other proofs. Eight days later they set the agenda for checking a conjecture first posed in 1859, and the answers sat in public logs about a day after the archive appeared. Nobody needed to follow the argument for that to happen. They needed to be able to ask the code the same questions, and get the same answers, on their own machines. Sutherland's page has a section headed "Check it yourself."</p>
    </section>
  </div>
</StoryLayout>

<script>
(function () {
  var canvas = document.querySelector('.alpoge-riemann-claude-canvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  if (!ctx) return;

  /* ---- Colours from CSS custom properties ---- */
  var cs = getComputedStyle(document.documentElement);
  var BG = cs.getPropertyValue('--bg').trim() || '#f5f0e8';
  var RAW = cs.getPropertyValue('--story').trim() || '#2d5da1';

  function hex2rgb(h) {
    h = h.replace('#', '');
    if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
    return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];
  }

  var sc = hex2rgb(RAW.charAt(0) === '#' ? RAW : '#2d5da1');   // story cerulean
  var gc = hex2rgb('#c8963e');                                   // warm gold for bloom core

  var prefRed = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var W = 0, H = 0, raf = 0, frame = 0;

  /* ---- Resize ---- */
  var ro = new ResizeObserver(function () {
    W = canvas.offsetWidth;
    H = canvas.offsetHeight;
    canvas.width = W * devicePixelRatio;
    canvas.height = H * devicePixelRatio;
    ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
  });
  ro.observe(canvas);

  /* ---- Constants ---- */
  var N_ARCS      = 5;
  var STAGGER     = 190;   // frames between arc spawns (~3.2 s)
  var FIRST_START = 40;    // first arc begins after 40 frames of silence
  var CENTER_R    = 40;    // deposit trigger radius around center
  var RING_CAP    = 28;    // max ring expansion radius
  var RING_GROW   = 0.18;  // ring expansion px/frame
  var FLARE_RAMP  = 30;    // frames to ramp up flare
  var HOLD_DUR    = 50;    // frames at peak bloom
  var FADE_DUR    = 100;   // frames to fade everything
  var REST_DUR    = 70;    // frames of near-dark pause

  /* ---- Helpers ---- */
  function rgba(c, a) {
    var v = a < 0 ? 0 : a > 1 ? 1 : a;
    return 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + v.toFixed(4) + ')';
  }

  // Shared temp vars for bezier evaluation (no allocation in loop)
  var _bx = 0, _by = 0;
  function bz(sx, sy, cx, cy, ex, ey, t) {
    var u = 1 - t;
    _bx = u * u * sx + 2 * u * t * cx + t * t * ex;
    _by = u * u * sy + 2 * u * t * cy + t * t * ey;
  }

  /* ---- Mathematical dust (static background texture) ---- */
  var N_DUST = 50;
  var dust = [];

  function mkDust() {
    dust.length = 0;
    var w = W || 800, h = H || 380;
    for (var i = 0; i < N_DUST; i++) {
      dust.push({
        x: Math.random() * w,
        y: Math.random() * h,
        r: 0.4 + Math.random() * 0.8
      });
    }
  }

  /* ---- Arc factory ---- */
  function edgePt(w, h) {
    var p = Math.random() * 2 * (w + h);
    if (p < w) return [p, -4];
    p -= w;
    if (p < h) return [w + 4, p];
    p -= h;
    if (p < w) return [w - p, h + 4];
    return [-4, h - (p - w)];
  }

  /* ---- State ---- */
  var arcs = [];
  var rings = [];
  var phase = 'acc'; // acc | flare | hold | fade | rest
  var pf = 0;        // frame when current phase began

  function initArcs() {
    arcs.length = 0;
    rings.length = 0;
    var w = W || 800, h = H || 380;
    var mx = w / 2, my = h / 2;

    for (var i = 0; i < N_ARCS; i++) {
      var s = edgePt(w, h);
      // End point: roughly opposite the start with some scatter
      var ex = w - s[0] + (Math.random() - 0.5) * w * 0.25;
      var ey = h - s[1] + (Math.random() - 0.5) * h * 0.25;
      ex = Math.max(-10, Math.min(w + 10, ex));
      ey = Math.max(-10, Math.min(h + 10, ey));

      // Control point ensures bezier passes through center at t ~0.5
      // B(0.5) = 0.25*S + 0.5*CP + 0.25*E  =>  CP = 2*(target) - 0.5*(S+E)
      var ox = (Math.random() - 0.5) * 24;
      var oy = (Math.random() - 0.5) * 24;
      var cpx = 2 * (mx + ox) - 0.5 * (s[0] + ex);
      var cpy = 2 * (my + oy) - 0.5 * (s[1] + ey);

      arcs.push({
        sx: s[0], sy: s[1],
        ex: ex,   ey: ey,
        cx: cpx,  cy: cpy,
        t0: FIRST_START + i * STAGGER,
        dur: 280 + Math.floor(Math.random() * 80), // 280-360 frames (~4.7-6 s)
        prog: 0,
        dep: false,
        trailA: 0.14 + Math.random() * 0.11,       // base trail opacity 0.14-0.25
        fadeM: 1                                     // multiplier for post-traverse fade
      });
    }
  }

  function resetCycle() {
    frame = 0;
    phase = 'acc';
    pf = 0;
    initArcs();
  }

  /* ---- Update ---- */
  function update() {
    var w = W || 800, h = H || 380;
    var mx = w / 2, my = h / 2;

    if (phase === 'acc') {
      var nd = 0;
      for (var i = 0; i < arcs.length; i++) {
        var a = arcs[i];
        if (frame >= a.t0) {
          a.prog = Math.min(1, (frame - a.t0) / a.dur);

          // Deposit ring when leading edge enters central region
          if (!a.dep) {
            bz(a.sx, a.sy, a.cx, a.cy, a.ex, a.ey, a.prog);
            var dx = _bx - mx, dy = _by - my;
            if (dx * dx + dy * dy < CENTER_R * CENTER_R) {
              a.dep = true;
              rings.push({ r: 0, birth: frame });
            }
          }
        }
        if (a.dep) nd++;
        // Fade trail after arc finishes its traverse
        if (a.prog >= 1) a.fadeM = Math.max(0, a.fadeM - 0.007);
      }
      if (nd === N_ARCS) { phase = 'flare'; pf = frame; }
    }

    // Phase transitions (state machine)
    if (phase === 'flare' && frame - pf >= FLARE_RAMP) { phase = 'hold'; pf = frame; }
    if (phase === 'hold'  && frame - pf >= HOLD_DUR)    { phase = 'fade'; pf = frame; }
    if (phase === 'fade'  && frame - pf >= FADE_DUR)    { phase = 'rest'; pf = frame; }
    if (phase === 'rest'  && frame - pf >= REST_DUR)    { resetCycle(); return; }

    // Expand rings toward cap
    for (var i = 0; i < rings.length; i++) {
      if (rings[i].r < RING_CAP) rings[i].r += RING_GROW;
    }
  }

  /* ---- Draw ---- */
  function draw() {
    if (!W || !H) return;
    ctx.fillStyle = BG;
    ctx.fillRect(0, 0, W, H);
    var mx = W / 2, my = H / 2;

    /* -- dust -- */
    ctx.fillStyle = 'rgba(26,26,23,0.04)';
    for (var i = 0; i < dust.length; i++) {
      ctx.beginPath();
      ctx.arc(dust[i].x, dust[i].y, dust[i].r, 0, 6.2832);
      ctx.fill();
    }

    /* -- central breathing point -- */
    var pa = 0.03 + 0.02 * Math.sin(frame * 0.03);
    if (phase === 'flare') {
      var t = Math.min(1, (frame - pf) / FLARE_RAMP);
      pa = 0.05 + t * 0.55;
    } else if (phase === 'hold') {
      pa = 0.6 + 0.04 * Math.sin(frame * 0.08);
    } else if (phase === 'fade') {
      pa = 0.6 * Math.max(0, 1 - (frame - pf) / FADE_DUR);
    } else if (phase === 'rest') {
      pa = 0.02;
    }
    ctx.globalAlpha = Math.max(0, pa);
    ctx.fillStyle = 'rgb(' + sc[0] + ',' + sc[1] + ',' + sc[2] + ')';
    ctx.beginPath();
    ctx.arc(mx, my, 3, 0, 6.2832);
    ctx.fill();
    ctx.globalAlpha = 1;

    /* -- arc trails -- */
    for (var i = 0; i < arcs.length; i++) {
      var a = arcs[i];
      if (a.prog <= 0) continue;

      var al = a.trailA * a.fadeM;
      if (phase === 'fade') al *= Math.max(0, 1 - (frame - pf) / FADE_DUR);
      else if (phase === 'rest') al = 0;
      if (al < 0.003) continue;

      // Draw swept bezier path
      ctx.strokeStyle = rgba(sc, al);
      ctx.lineWidth = 2;
      ctx.beginPath();
      var segs = Math.max(4, Math.floor(a.prog * 40));
      for (var s = 0; s <= segs; s++) {
        var t = a.prog * (s / segs);
        bz(a.sx, a.sy, a.cx, a.cy, a.ex, a.ey, t);
        if (s === 0) ctx.moveTo(_bx, _by);
        else ctx.lineTo(_bx, _by);
      }
      ctx.stroke();

      // Leading-edge dot (while arc is still traversing during accumulation)
      if (a.prog < 1 && phase === 'acc') {
        bz(a.sx, a.sy, a.cx, a.cy, a.ex, a.ey, a.prog);
        ctx.globalAlpha = Math.min(1, al * 3);
        ctx.fillStyle = 'rgb(' + sc[0] + ',' + sc[1] + ',' + sc[2] + ')';
        ctx.beginPath();
        ctx.arc(_bx, _by, 2.5, 0, 6.2832);
        ctx.fill();
        ctx.globalAlpha = 1;
      }
    }

    /* -- deposited rings -- */
    for (var i = 0; i < rings.length; i++) {
      var rg = rings[i];
      var ra = 0.3;
      if (phase === 'flare') {
        var t = Math.min(1, (frame - pf) / FLARE_RAMP);
        ra = 0.3 + (0.7 - 0.3) * t;
      } else if (phase === 'hold') {
        ra = 0.65 + 0.05 * Math.sin(frame * 0.1 + i);
      } else if (phase === 'fade') {
        ra = 0.7 * Math.max(0, 1 - (frame - pf) / FADE_DUR);
      } else if (phase === 'rest') {
        ra = 0;
      }
      if (ra < 0.005 || rg.r < 0.5) continue;

      ctx.strokeStyle = rgba(sc, ra);
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(mx, my, rg.r, 0, 6.2832);
      ctx.stroke();
    }

    /* -- radial bloom (flare / hold / fade only) -- */
    if (phase === 'flare' || phase === 'hold' || phase === 'fade') {
      var br, ba;
      if (phase === 'flare') {
        var t = Math.min(1, (frame - pf) / FLARE_RAMP);
        var e = t * t * (3 - 2 * t); // smoothstep
        br = e * 120;
        ba = e * 0.3;
      } else if (phase === 'hold') {
        br = 120 + 6 * Math.sin(frame * 0.06);
        ba = 0.3;
      } else {
        var t = (frame - pf) / FADE_DUR;
        br = 120;
        ba = 0.3 * Math.max(0, 1 - t * t);
      }

      if (ba > 0.005 && br > 1) {
        var g = ctx.createRadialGradient(mx, my, 0, mx, my, br);
        g.addColorStop(0,   rgba(gc, ba * 0.6));   // warm gold core
        g.addColorStop(0.3, rgba(sc, ba * 0.8));   // cerulean mid
        g.addColorStop(0.7, rgba(sc, ba * 0.3));   // cerulean edge
        g.addColorStop(1,   rgba(sc, 0));
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(mx, my, br, 0, 6.2832);
        ctx.fill();
      }
    }
  }

  /* ---- Static frame for reduced motion ---- */
  function drawStatic() {
    if (!W || !H) return;
    ctx.fillStyle = BG;
    ctx.fillRect(0, 0, W, H);
    var mx = W / 2, my = H / 2;

    // Dust
    ctx.fillStyle = 'rgba(26,26,23,0.04)';
    for (var i = 0; i < dust.length; i++) {
      ctx.beginPath();
      ctx.arc(dust[i].x, dust[i].y, dust[i].r, 0, 6.2832);
      ctx.fill();
    }

    // Central point at medium brightness
    ctx.globalAlpha = 0.5;
    ctx.fillStyle = 'rgb(' + sc[0] + ',' + sc[1] + ',' + sc[2] + ')';
    ctx.beginPath();
    ctx.arc(mx, my, 3, 0, 6.2832);
    ctx.fill();
    ctx.globalAlpha = 1;

    // Five concentric rings (the moment of convergence, frozen)
    for (var i = 0; i < 5; i++) {
      ctx.strokeStyle = rgba(sc, 0.22 - i * 0.025);
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(mx, my, 6 + i * 5.2, 0, 6.2832);
      ctx.stroke();
    }

    // Soft bloom
    var g = ctx.createRadialGradient(mx, my, 0, mx, my, 80);
    g.addColorStop(0,    rgba(gc, 0.12));
    g.addColorStop(0.35, rgba(sc, 0.09));
    g.addColorStop(1,    rgba(sc, 0));
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(mx, my, 80, 0, 6.2832);
    ctx.fill();
  }

  /* ---- Loop ---- */
  function tick() {
    frame++;
    update();
    draw();
    raf = requestAnimationFrame(tick);
  }

  /* ---- Init ---- */
  requestAnimationFrame(function () {
    mkDust();
    initArcs();

    if (prefRed) {
      drawStatic();
    } else {
      var io = new IntersectionObserver(function (es) {
        if (es[0].isIntersecting) {
          if (!raf) raf = requestAnimationFrame(tick);
        } else {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      }, { threshold: 0.01 });
      io.observe(canvas);

      window.addEventListener('pagehide', function () {
        cancelAnimationFrame(raf);
        ro.disconnect();
        io.disconnect();
      });
    }
  });
})();
</script>

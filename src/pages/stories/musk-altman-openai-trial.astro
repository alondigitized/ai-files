    top: 1rem;
    bottom: 1rem;
    width: 2px;
    background: linear-gradient(to bottom, rgba(94,234,212,0.15), var(--story));
  }
  .oai-evo-step {
    position: relative;
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 1rem;
    padding: 1rem 0 1.25rem;
    align-items: start;
  }
  .oai-evo-dot {
    position: relative;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--surface2);
    border: 2px solid var(--story);
    margin-left: 22px;
    margin-top: 0.4rem;
    flex-shrink: 0;
  }
  .oai-evo-step:last-child .oai-evo-dot {
    background: var(--story);
  }
  .oai-evo-year {
    font-family: 'SFMono-Regular', 'Consolas', monospace;
    font-size: 0.85rem;
    color: var(--story);
    font-weight: 600;
    letter-spacing: 0.04em;
    padding-top: 0.2rem;
  }
  .oai-evo-form {
    font-size: 0.95rem;
    color: var(--text);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .oai-evo-detail {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.55;
  }
  .oai-evo-val {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.05rem 0.5rem;
    background: rgba(94,234,212,0.08);
    border-radius: 3px;
    font-family: 'SFMono-Regular', 'Consolas', monospace;
    font-size: 0.75rem;
    color: var(--story);

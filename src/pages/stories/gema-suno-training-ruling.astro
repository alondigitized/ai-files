    height: 0;
    border-top: 1px dashed var(--border);
    position: relative;
    margin: 0 1.25rem;
  }
  .gema-acts-divider-label {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    background: var(--surface);
    padding: 0 0.75rem;
    font-size: 0.6rem;
    color: var(--muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    font-family: 'SF Mono', 'Fira Code', monospace;
  }
  .gema-acts-de {
    background: color-mix(in srgb, var(--story) 6%, transparent);
    border-left: 3px solid var(--story);
  }
  .gema-acts-de .gema-acts-num,
  .gema-acts-de .gema-acts-law { color: var(--story); }
  .gema-acts-label {
    padding: 0.6rem 1.25rem;
    font-size: 0.75rem;
    color: var(--muted);
    text-align: center;
    background: var(--surface2);
    border-top: 1px solid var(--border);
    font-style: italic;

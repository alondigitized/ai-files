    color: var(--accent);
    background: rgba(255, 77, 77, 0.04);
  }
  .gema-courts-mixed {
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.04);
  }
  .gema-courts-status {
    padding: 0.4rem 0.9rem;
    font-size: 0.68rem;
    color: var(--muted);
    border-top: 1px solid rgba(42, 42, 42, 0.4);
  }
  .gema-courts-footer {
    grid-column: 1 / -1;
    text-align: center;
    font-size: 0.75rem;
    color: var(--muted);
    font-style: italic;
    padding: 0.75rem 0 0;
  }
  @media (max-width: 768px) {
    .gema-courts-wrap { grid-template-columns: 1fr; }

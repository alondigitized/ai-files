---
import StoryLayout from '../../layouts/StoryLayout.astro';
import stories from '../../data/stories.json';

const story = stories.find(s => s.slug === 'gema-suno-training-ruling')!;
---

<style is:global>
  /* === CANVAS === */
  .phantom-wrap { width: 100%; margin: 0; line-height: 0; }
  .gema-suno-training-ruling-canvas { display: block; width: 100%; height: 380px; background: var(--bg); }

  /* === REENACTMENT 1: Prompt Test === */
  .gema-prompt-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    margin: 2rem 0;
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
  }
  .gema-prompt-header {
    background: var(--surface2);
    padding: 0.75rem 1.25rem;
    font-size: 0.8rem;
    color: var(--story);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--border);
  }
  .gema-prompt-header span {
    color: var(--muted);
    text-transform: none;
    letter-spacing: 0;
  }
  .gema-prompt-input {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .gema-prompt-field {
    padding: 0.2rem 0;
    font-size: 0.85rem;
    color: var(--text);
    display: flex;
    gap: 0.75rem;
  }
  .gema-prompt-label {
    color: var(--muted);
    min-width: 110px;
    flex-shrink: 0;
  }
  .gema-prompt-label::after { content: ':'; }
  .gema-prompt-value { color: var(--text); }
  .gema-prompt-none {
    color: var(--muted);
    font-style: italic;
  }
  .gema-prompt-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .gema-prompt-table th {
    text-align: left;
    padding: 0.6rem 1.25rem;
    color: var(--muted);
    font-weight: 500;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--border);
    font-family: 'SF Mono', 'Fira Code', monospace;
  }
  .gema-prompt-th-count { text-align: center; }
  .gema-prompt-table td {
    padding: 0.5rem 1.25rem;
    color: var(--text);
    border-bottom: 1px solid rgba(42, 42, 42, 0.4);
    font-family: -apple-system, system-ui, sans-serif;
    font-size: 0.85rem;
  }
  .gema-prompt-count {
    color: var(--story);
    font-weight: 700;
    text-align: center;
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 0.95rem;
  }
  .gema-prompt-finding {
    color: var(--accent);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-weight: 600;
  }
  .gema-prompt-footer {
    padding: 0.6rem 1.25rem;
    font-size: 0.75rem;
    color: var(--muted);
    background: var(--surface2);
    border-top: 1px solid var(--border);
    text-align: right;
  }
  @media (max-width: 600px) {
    .gema-prompt-table th:nth-child(2),
    .gema-prompt-table td:nth-child(2) { display: none; }
    .gema-prompt-table th, .gema-prompt-table td { padding: 0.5rem 0.75rem; }
    .gema-prompt-field { flex-direction: column; gap: 0.15rem; }
    .gema-prompt-label { min-width: unset; }
  }

  /* === REENACTMENT 2: Four Prohibited Acts === */
  .gema-acts-wrap {
    margin: 2rem 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--surface);
  }
  .gema-acts-bar {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: center;
    padding: 0.9rem 1.25rem;
    gap: 0.75rem;
  }
  .gema-acts-bar + .gema-acts-bar { border-top: 1px solid rgba(42, 42, 42, 0.4); }
  .gema-acts-num {
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .gema-acts-desc {
    font-size: 0.88rem;
    color: var(--text);
    line-height: 1.4;
  }
  .gema-acts-law {
    font-size: 0.72rem;
    text-align: right;
    font-weight: 600;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }
  .gema-acts-law span {
    font-weight: 400;
    display: block;
    font-size: 0.68rem;
    margin-top: 0.15rem;
    color: var(--muted);
  }
  .gema-acts-us {
    background: rgba(77, 166, 255, 0.06);
    border-left: 3px solid #4da6ff;
  }
  .gema-acts-us .gema-acts-num,

<script>
(function () {
  const canvas = document.querySelector('.anthropic-eval-escape-irregular-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  /* --- Colors --- */
  const cs = getComputedStyle(document.documentElement);
  const bgColor = cs.getPropertyValue('--bg').trim() || '#0d0d0d';
  const storyColor = cs.getPropertyValue('--story').trim() || '#14b8a6';

  function hexRgb(h: string): [number, number, number] {
    const v = h.replace('#', '');
    return [parseInt(v.slice(0, 2), 16), parseInt(v.slice(2, 4), 16), parseInt(v.slice(4, 6), 16)];
  }
  const [sR, sG, sB] = hexRgb(storyColor);
  const [bgR, bgG, bgB] = hexRgb(bgColor);
  const rdR = 255, rdG = 77, rdB = 77;

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let W = 0, H = 0, rafId = 0, frame = 0;

  /* --- Grid constants --- */
  const COLS = 14, ROWS = 8, CYCLE = 900, NDUST = 10;
  const PL = 3, PR = 10, PT = 2, PB = 6;

  /* --- Phase timing (frames at 60fps) --- */
  const CROSS_F = 222;
  const PERI_DUR = 240;
  const REC_S = 440, REC_E = 485, REC_R = 500;
  const PULSE_S = 500;
  const INTENS_S = 740;
  const FADE_S = 770, FADE_E = 830;

  /* --- Particle path timeline: [frame, col, row] --- */
  const TL: [number, number, number][] = [
    [30, 6, 4], [42, 6, 4],
    [68, 8, 3], [80, 8, 3],
    [110, 5, 5], [122, 5, 5],
    [150, 7, 3], [162, 7, 3],
    [192, 9, 4], [204, 9, 4],
    [240, 11, 4], [253, 11, 4],
    [288, 12, 3], [301, 12, 3],
    [336, 13, 5], [349, 13, 5],
    [384, 12, 6], [397, 12, 6],
    [440, 12, 6], [485, 12, 6], [500, 12, 6],
    [530, 13, 7], [543, 13, 7],
    [573, 12, 5], [586, 12, 5],
    [616, 11, 3], [629, 11, 3],
    [659, 13, 1], [672, 13, 1],
    [702, 12, 0], [712, 12, 0],
  ];

  /* --- Probe schedule: [frame, col, row] --- */
  const PROBES: [number, number, number][] = [
    [30, 6, 4], [68, 8, 3], [110, 5, 5], [150, 7, 3], [192, 9, 4],
    [240, 11, 4],
    [288, 12, 3], [336, 13, 5], [384, 12, 6],
    [530, 13, 7], [573, 12, 5], [616, 11, 3], [659, 13, 1], [702, 12, 0],
  ];

  /* --- Types --- */
  interface Dot { col: number; row: number; ins: boolean; hit: boolean; hf: number; }
  interface Dm { x: number; y: number; vx: number; vy: number; a: number; r: number; }
  interface Sg { x1: number; y1: number; x2: number; y2: number; d: number; }

  let dots: Dot[] = [];
  let dust: Dm[] = [];
  let segs: Sg[] = [];

  /* --- Helpers --- */
  function dX(c: number) { return (c + 1) * W / (COLS + 1); }
  function dY(r: number) { return (r + 1) * H / (ROWS + 1); }
  function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }
  function cl01(v: number) { return v < 0 ? 0 : v > 1 ? 1 : v; }

  /* --- Initializers --- */
  function initDots() {
    dots = [];
    for (let r = 0; r < ROWS; r++)
      for (let c = 0; c < COLS; c++)
        dots.push({ col: c, row: r, ins: c >= PL && c <= PR && r >= PT && r <= PB, hit: false, hf: 0 });
  }

  function initDust() {
    dust = [];
    for (let i = 0; i < NDUST; i++)
      dust.push({
        x: Math.random() * Math.max(W, 300), y: Math.random() * Math.max(H, 300),
        vx: (Math.random() - 0.5) * 0.25, vy: (Math.random() - 0.5) * 0.25,
        a: 0.03 + Math.random() * 0.02, r: 1 + Math.random() * 0.5,
      });
  }

  function buildSegs() {
    segs = [];
    if (W === 0 || H === 0) return;
    const sx = W / (COLS + 1), sy = H / (ROWS + 1);
    const left = dX(PL) - sx / 2, right = dX(PR) + sx / 2;
    const top = dY(PT) - sy / 2, bottom = dY(PB) + sy / 2;
    const crossY = dY(4);

    const pts = [
      { x: right, y: crossY }, { x: right, y: bottom }, { x: left, y: bottom },
      { x: left, y: top }, { x: right, y: top }, { x: right, y: crossY },
    ];

    let total = 0;
    const lens: number[] = [];
    for (let i = 0; i < pts.length - 1; i++) {
      const l = Math.hypot(pts[i + 1].x - pts[i].x, pts[i + 1].y - pts[i].y);
      lens.push(l);
      total += l;
    }

    const DASH = 4, GAP = 6, UNIT = 10;
    let walked = 0;
    for (let i = 0; i < pts.length - 1; i++) {
      const p1 = pts[i], p2 = pts[i + 1], len = lens[i];
      if (len < 1) continue;
      const ux = (p2.x - p1.x) / len, uy = (p2.y - p1.y) / len;
      let pos = 0;
      while (pos < len) {
        const iu = (walked + pos) % UNIT;
        if (iu < DASH) {
          const rem = Math.min(DASH - iu, len - pos);
          if (rem > 0.5)
            segs.push({
              x1: p1.x + ux * pos, y1: p1.y + uy * pos,
              x2: p1.x + ux * (pos + rem), y2: p1.y + uy * (pos + rem),
              d: (walked + pos + rem / 2) / total,
            });
          pos += rem;
        } else {
          pos += UNIT - iu;
        }
      }
      walked += len;
    }
  }

  function resetDots() {
    for (let i = 0; i < dots.length; i++) { dots[i].hit = false; dots[i].hf = 0; }
  }

  /* --- Particle position from timeline --- */
  function pPos(cf: number): { x: number; y: number } | null {
    if (cf < TL[0][0] - 10) return null;
    if (cf < TL[0][0]) return { x: dX(TL[0][1]), y: dY(TL[0][2]) };
    for (let i = 0; i < TL.length - 1; i++) {
      if (cf >= TL[i][0] && cf < TL[i + 1][0]) {
        const span = TL[i + 1][0] - TL[i][0];
        const t = span > 0 ? (cf - TL[i][0]) / span : 0;
        return {
          x: dX(TL[i][1]) + (dX(TL[i + 1][1]) - dX(TL[i][1])) * t,
          y: dY(TL[i][2]) + (dY(TL[i + 1][2]) - dY(TL[i][2])) * t,
        };
      }
    }
    const last = TL[TL.length - 1];
    return { x: dX(last[1]), y: dY(last[2]) };
  }

  /* --- Dot color: returns [r, g, b, alpha] --- */
  function dotCol(d: Dot, cf: number): [number, number, number, number] {
    if (!d.hit) return [232, 232, 232, 0.06];
    const dt = cf - d.hf;
    if (dt < 0) return [232, 232, 232, 0.06];

    if (d.ins) {
      if (dt < 10) {
        const t = dt / 10;
        return [Math.round(lerp(232, sR, t)), Math.round(lerp(232, sG, t)), Math.round(lerp(232, sB, t)), lerp(0.06, 0.4, t)];
      }
      if (dt < 25) return [sR, sG, sB, 0.4];
      if (dt < 55) {
        const t = (dt - 25) / 30;
        return [Math.round(lerp(sR, 232, t)), Math.round(lerp(sG, 232, t)), Math.round(lerp(sB, 232, t)), lerp(0.4, 0.06, t)];
      }
      return [232, 232, 232, 0.06];
    }

    /* Outside dot */
    if (dt < 10) {
      const t = dt / 10;
      return [Math.round(lerp(232, sR, t)), Math.round(lerp(232, sG, t)), Math.round(lerp(232, sB, t)), lerp(0.06, 0.4, t)];
    }
    if (dt < 40) return [sR, sG, sB, 0.4];
    if (dt < 100) {
      const t = (dt - 40) / 60;
      return [Math.round(lerp(sR, rdR, t)), Math.round(lerp(sG, rdG, t)), Math.round(lerp(sB, rdB, t)), lerp(0.4, 0.35, t)];
    }

    /* Red hold with near-unison pulse */
    const phase = d.col * 0.3 + d.row * 0.5;
    let a = 0.35;
    if (cf >= PULSE_S) a = 0.35 + 0.1 * Math.sin(cf * Math.PI / 60 + phase);
    if (cf >= INTENS_S && cf < FADE_S) {
      const it = (cf - INTENS_S) / (FADE_S - INTENS_S);
      a = Math.max(a, 0.35 + 0.2 * Math.sin(it * Math.PI));
    }
    return [rdR, rdG, rdB, a];
  }

  /* --- Main draw --- */
  function drawFrame() {
    ctx!.clearRect(0, 0, W, H);
    if (W === 0 || H === 0) return;
    const cf = frame % CYCLE;
    if (cf === 0) resetDots();
    if (cf >= FADE_E) return;

    /* Trigger probes */
    for (let i = 0; i < PROBES.length; i++) {
      if (cf === PROBES[i][0]) {
        const idx = PROBES[i][2] * COLS + PROBES[i][1];
        if (idx >= 0 && idx < dots.length && !dots[idx].hit) {
          dots[idx].hit = true;
          dots[idx].hf = cf;
        }
      }
    }

    /* Dust */
    for (let i = 0; i < dust.length; i++) {
      const dm = dust[i];
      dm.x += dm.vx; dm.y += dm.vy;
      if (dm.x < 0) dm.x += W; if (dm.x > W) dm.x -= W;
      if (dm.y < 0) dm.y += H; if (dm.y > H) dm.y -= H;
      ctx!.beginPath();
      ctx!.arc(dm.x, dm.y, dm.r, 0, Math.PI * 2);
      ctx!.fillStyle = `rgba(232,232,232,${dm.a})`;
      ctx!.fill();
    }

    /* Grid dots */
    for (let i = 0; i < dots.length; i++) {
      const dd = dots[i];
      const [cr, cg, cb, ca] = dotCol(dd, cf);
      ctx!.beginPath();
      ctx!.arc(dX(dd.col), dY(dd.row), 2.5, 0, Math.PI * 2);
      ctx!.fillStyle = `rgba(${cr},${cg},${cb},${ca})`;
      ctx!.fill();
    }

    /* Perimeter */
    const dp = cf < CROSS_F ? 0 : Math.min(1, (cf - CROSS_F) / PERI_DUR);
    if (dp < 1) {
      ctx!.lineWidth = 1;
      if (dp === 0) {
        ctx!.beginPath();
        ctx!.strokeStyle = 'rgba(232,232,232,0.08)';
        for (let i = 0; i < segs.length; i++) {
          ctx!.moveTo(segs[i].x1, segs[i].y1);
          ctx!.lineTo(segs[i].x2, segs[i].y2);
        }
        ctx!.stroke();
      } else {
        for (let i = 0; i < segs.length; i++) {
          const nd = Math.min(segs[i].d, 1 - segs[i].d) * 2;
          let a = 0.08;
          if (nd < dp) a = 0.08 * (1 - cl01((dp - nd) * 5));
          if (a < 0.003) continue;
          ctx!.beginPath();
          ctx!.moveTo(segs[i].x1, segs[i].y1);
          ctx!.lineTo(segs[i].x2, segs[i].y2);
          ctx!.strokeStyle = `rgba(232,232,232,${a})`;
          ctx!.stroke();
        }
      }
    }

    /* Particle */
    const pos = pPos(cf);
    if (pos && cf >= 20) {
      let rad = 4.5, alp = 0.85;

      /* Fade in */
      if (cf < 30) {
        const t = cl01((cf - 20) / 10);
        rad *= t; alp *= t;
      }

      /* Recognition contraction */
      if (cf >= REC_S && cf < REC_E) {
        const t = cl01((cf - REC_S) / 20);
        rad = lerp(4.5, 3, t);
        alp = lerp(0.85, 0.5, t);
      } else if (cf >= REC_E && cf < REC_R) {
        const t = (cf - REC_E) / (REC_R - REC_E);
        rad = lerp(3, 4.5, t);
        alp = lerp(0.5, 0.85, t);
      }

      /* Glow halo */
      if (alp > 0.05) {
        const gr = ctx!.createRadialGradient(pos.x, pos.y, 0, pos.x, pos.y, rad * 3);
        gr.addColorStop(0, `rgba(${sR},${sG},${sB},${alp * 0.25})`);
        gr.addColorStop(1, `rgba(${sR},${sG},${sB},0)`);
        ctx!.beginPath();
        ctx!.arc(pos.x, pos.y, rad * 3, 0, Math.PI * 2);
        ctx!.fillStyle = gr;
        ctx!.fill();
      }

      /* Core */
      ctx!.beginPath();
      ctx!.arc(pos.x, pos.y, Math.max(0.5, rad), 0, Math.PI * 2);
      ctx!.fillStyle = `rgba(${sR},${sG},${sB},${alp})`;
      ctx!.fill();

      /* Recognition ring */
      if (cf >= REC_S + 10 && cf < REC_S + 60) {
        const t = (cf - REC_S - 10) / 50;
        const rr = 5 + t * 30;
        const ra = 0.15 * (1 - t);
        if (ra > 0.005) {
          ctx!.beginPath();
          ctx!.arc(pos.x, pos.y, rr, 0, Math.PI * 2);
          ctx!.strokeStyle = `rgba(${sR},${sG},${sB},${ra})`;
          ctx!.lineWidth = 1;
          ctx!.stroke();
        }
      }
    }

    /* Fade overlay */
    if (cf >= FADE_S) {
      const t = cl01((cf - FADE_S) / (FADE_E - FADE_S));
      ctx!.fillStyle = `rgba(${bgR},${bgG},${bgB},${t})`;
      ctx!.fillRect(0, 0, W, H);
    }
  }

  /* --- Static frame for reduced motion --- */
  function drawStatic() {
    ctx!.clearRect(0, 0, W, H);
    if (W === 0 || H === 0) return;

    resetDots();

    /* Inner dots: probed long ago, faded back to ambient */
    const inners: [number, number][] = [[6, 4], [8, 3], [5, 5], [7, 3], [9, 4]];
    for (const [c, r] of inners) {
      const idx = r * COLS + c;
      dots[idx].hit = true;
      dots[idx].hf = -100;
    }

    /* Outside dots: at various stages of teal-to-red shift */
    const outers: [number, number, number][] = [[11, 4, 240], [12, 3, 288], [13, 5, 336]];
    for (const [c, r, f] of outers) {
      const idx = r * COLS + c;
      dots[idx].hit = true;
      dots[idx].hf = f;
    }

    const sf = 380;

    /* Dust (static positions) */
    for (let i = 0; i < dust.length; i++) {
      ctx!.beginPath();
      ctx!.arc(dust[i].x, dust[i].y, dust[i].r, 0, Math.PI * 2);
      ctx!.fillStyle = `rgba(232,232,232,${dust[i].a})`;
      ctx!.fill();
    }

    /* Dots */
    for (let i = 0; i < dots.length; i++) {
      const dd = dots[i];
      const [cr, cg, cb, ca] = dotCol(dd, sf);
      ctx!.beginPath();
      ctx!.arc(dX(dd.col), dY(dd.row), 2.5, 0, Math.PI * 2);
      ctx!.fillStyle = `rgba(${cr},${cg},${cb},${ca})`;
      ctx!.fill();
    }

    /* Perimeter (partially dissolved from crossing point) */
    const dp = Math.min(1, (sf - CROSS_F) / PERI_DUR);
    ctx!.lineWidth = 1;
    for (let i = 0; i < segs.length; i++) {
      const nd = Math.min(segs[i].d, 1 - segs[i].d) * 2;
      let a = 0.08;
      if (nd < dp) a = 0.08 * (1 - cl01((dp - nd) * 5));
      if (a < 0.003) continue;
      ctx!.beginPath();
      ctx!.moveTo(segs[i].x1, segs[i].y1);
      ctx!.lineTo(segs[i].x2, segs[i].y2);
      ctx!.strokeStyle = `rgba(232,232,232,${a})`;
      ctx!.stroke();
    }

    /* Particle at the third outside dot */
    const px = dX(13), py = dY(5);
    const gr = ctx!.createRadialGradient(px, py, 0, px, py, 14);
    gr.addColorStop(0, `rgba(${sR},${sG},${sB},0.2)`);
    gr.addColorStop(1, `rgba(${sR},${sG},${sB},0)`);
    ctx!.beginPath();
    ctx!.arc(px, py, 14, 0, Math.PI * 2);
    ctx!.fillStyle = gr;
    ctx!.fill();
    ctx!.beginPath();
    ctx!.arc(px, py, 4.5, 0, Math.PI * 2);
    ctx!.fillStyle = `rgba(${sR},${sG},${sB},0.85)`;
    ctx!.fill();
  }

  /* --- Resize --- */
  function resize() {
    const dpr = window.devicePixelRatio || 1;
    W = canvas!.offsetWidth;
    H = canvas!.offsetHeight;
    canvas!.width = W * dpr;
    canvas!.height = H * dpr;
    ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    buildSegs();
    for (let i = 0; i < dust.length; i++) {
      if (dust[i].x > W) dust[i].x = Math.random() * W;
      if (dust[i].y > H) dust[i].y = Math.random() * H;
    }
  }

  const ro = new ResizeObserver(() => {
    resize();
    if (reduced) drawStatic();
  });
  ro.observe(canvas);

  /* --- Loop --- */
  function tick() {
    frame++;
    drawFrame();
    rafId = requestAnimationFrame(tick);
  }

  /* --- Init --- */
  initDots();
  initDust();
  resize();

  /* --- IntersectionObserver --- */
  const io = new IntersectionObserver(([e]) => {
    if (e.isIntersecting) {
      if (!rafId && !reduced) rafId = requestAnimationFrame(tick);
    } else {
      cancelAnimationFrame(rafId);
      rafId = 0;
    }
  }, { threshold: 0.01 });

  if (reduced) {
    requestAnimationFrame(() => drawStatic());
  } else {
    io.observe(canvas);
  }

  /* --- Cleanup --- */
  window.addEventListener('pagehide', () => {
    cancelAnimationFrame(rafId);
    ro.disconnect();
    io.disconnect();
  });
})();
</script>

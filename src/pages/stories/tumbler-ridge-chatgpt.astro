---
import StoryLayout from '../../layouts/StoryLayout.astro';
import stories from '../../data/stories.json';

const story = stories.find(s => s.slug === 'tumbler-ridge-chatgpt')!;
---

<style is:global>
  .phantom-wrap { width: 100%; margin: 0; line-height: 0; }
  .tumbler-ridge-chatgpt-canvas { display: block; width: 100%; height: 380px; background: var(--bg); }

  /* ── Threshold comparison ── */
  .tr-threshold-cmp { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--border); border-radius: 0.75rem; overflow: hidden; margin: 2rem 0; }
  @media (max-width: 600px) { .tr-threshold-cmp { grid-template-columns: 1fr; } }
  .tr-th-panel { background: var(--surface); padding: 1.2rem 1.4rem; }
  .tr-th-label { font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; font-weight: 700; margin-bottom: 0.85rem; display: flex; align-items: center; gap: 0.4rem; }
  .tr-th-label.old { color: var(--accent); }
  .tr-th-label.new { color: var(--story); }
  .tr-th-criteria { font-family: 'Courier New', monospace; font-size: 0.82rem; line-height: 1.8; color: var(--muted); }
  .tr-th-criteria .req { color: var(--text); font-weight: 600; }
  .tr-th-criteria .gate { color: var(--accent); font-weight: 700; font-size: 0.75rem; letter-spacing: 0.1em; }
  .tr-th-criteria .flex { color: var(--story); font-style: italic; }
  .tr-th-result { margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--border); font-size: 0.78rem; }
  .tr-th-result.fail { color: var(--accent); }
  .tr-th-result.pass { color: var(--story); }
  .tr-th-footer { grid-column: 1 / -1; font-size: 0.72rem; color: var(--muted); font-style: italic; padding: 0.6rem 1.2rem; background: rgba(255,255,255,0.02); border-top: 1px solid var(--border); }

  /* ── Pipeline chain diagram ── */
  .tr-pipeline { background: var(--surface); border: 1px solid var(--border); border-radius: 0.75rem; overflow: hidden; margin: 2rem 0; }
  .tr-pipeline-header { background: rgba(255,255,255,0.02); padding: 0.5rem 1rem; font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--muted); font-weight: 700; border-bottom: 1px solid var(--border); }
  .tr-pipeline-body { padding: 1rem 1.4rem; }
  .tr-pipe-node { display: flex; align-items: flex-start; gap: 0.85rem; padding: 0.55rem 0; }
  .tr-pipe-node + .tr-pipe-node { border-top: 1px solid rgba(255,255,255,0.04); }
  .tr-pipe-icon { font-size: 1rem; flex-shrink: 0; width: 28px; text-align: center; padding-top: 0.1rem; }
  .tr-pipe-text { font-size: 0.85rem; line-height: 1.5; color: var(--muted); }
  .tr-pipe-text strong { color: var(--text); }
  .tr-pipe-node.choke { background: rgba(255,77,77,0.05); margin: 0 -1.4rem; padding: 0.65rem 1.4rem; border-left: 3px solid var(--accent); }
  .tr-pipe-node.choke .tr-pipe-text strong { color: var(--accent); }
  .tr-pipe-node.ghost { opacity: 1; }
  .tr-pipe-node.ghost .tr-pipe-icon { opacity: 0.45; }
  .tr-pipe-node.ghost .tr-pipe-text { color: #999; font-style: italic; }
  .tr-pipe-node.ghost .tr-pipe-text strong { color: #bbb; }
  .tr-pipe-divider { text-align: center; font-size: 0.68rem; color: var(--muted); letter-spacing: 0.15em; text-transform: uppercase; padding: 0.6rem 0; border-top: 1px dashed rgba(255,255,255,0.08); margin-top: 0.3rem; }
  .tr-pipe-footer { font-size: 0.72rem; color: var(--muted); font-style: italic; padding: 0.5rem 1rem; border-top: 1px solid var(--border); background: rgba(255,255,255,0.02); }

  /* ── Timeline strip ── */
  .tr-timeline-strip { background: var(--surface); border: 1px solid var(--border); border-radius: 0.75rem; overflow: hidden; margin: 2rem 0; }
  .tr-tl-header { background: rgba(255,255,255,0.02); padding: 0.5rem 1rem; font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--muted); font-weight: 700; border-bottom: 1px solid var(--border); }
  .tr-tl-body { padding: 0.6rem 1rem; display: flex; flex-direction: column; gap: 0; }
  .tr-tl-event { display: flex; align-items: flex-start; gap: 0.85rem; padding: 0.5rem 0; font-size: 0.82rem; }
  .tr-tl-event + .tr-tl-event { border-top: 1px solid rgba(255,255,255,0.04); }
  .tr-tl-date { font-family: 'Courier New', monospace; font-size: 0.72rem; color: var(--muted); min-width: 100px; flex-shrink: 0; padding-top: 0.1rem; }
  .tr-tl-desc { color: var(--text); line-height: 1.5; }
  .tr-tl-desc.shift { color: var(--story); }
  .tr-tl-desc.contra { color: var(--accent); }
  .tr-tl-footer { font-size: 0.72rem; color: var(--muted); font-style: italic; padding: 0.5rem 1rem; border-top: 1px solid var(--border); background: rgba(255,255,255,0.02); }

  .canvas-note { font-size: 0.78rem; color: var(--muted); text-align: center; margin: 0.75rem 0 0; font-style: italic; }
</style>

<StoryLayout story={story}>
  <div class="container">
    <section class="section" id="intro">
      <h2><span class="num">01 — The Letter</span>The Letter</h2>
      <p>On February 26, 2026, OpenAI's vice president of global policy, Ann O'Leary, sent a letter to Canadian Minister Evan Solomon. It contained an admission.</p>
      <p>Eight months earlier, in June 2025, OpenAI's automated system had flagged a ChatGPT account for violating its usage policy. The flag routed the account to a human reviewer. The reviewer confirmed the violation and banned the account. Then the reviewer applied a threshold — did this conversation contain credible and imminent planning that warranted a law enforcement referral? The answer, according to the reviewer, was no. The threshold had not been met.</p>
      <p>The letter then stated, in writing, to a foreign government: "With the benefit of our continued learnings, under our enhanced law enforcement referral protocol, we would refer the account banned in June 2025 to law enforcement if it were discovered today."</p>
      <p>The account belonged to Jesse Van Rootselaar, age 18. After the ban, she created a second ChatGPT account. OpenAI's repeat-violator detection system did not catch it. On February 10, 2026, she killed her mother and her 11-year-old half-brother at their home in Tumbler Ridge, British Columbia, then drove to Tumbler Ridge Secondary School — a school of 191 students — and killed six more people before dying by self-inflicted gunshot wound. Twenty-seven others were injured. RCMP officers arrived within two minutes.</p>
      <p>Tumbler Ridge is a mining town of 2,399 people in northeastern British Columbia. The shooting was the deadliest in Canada since the 2020 Nova Scotia attacks.</p>
      <p>This story is not about the shooter. It is about the threshold.</p>
    </section>

    <section class="section" id="threshold">
      <h2><span class="num">02 — The Threshold</span>The Threshold</h2>
      <p>According to OpenAI's letter to the Canadian government, the company's law enforcement referral protocol at the time required "credible and imminent planning" before a flag would be escalated beyond the ban. The O'Leary letter reveals what that meant in practice: the protocol was structured so that a user had to discuss a specific <strong>target</strong>, a specific <strong>method</strong>, and specific <strong>timing</strong> — all three — in a ChatGPT conversation before a referral was triggered.</p>
      <p>The letter describes the new protocol as "more flexible to account for the fact that a user may not discuss the target, means, and timing of planned violence in a ChatGPT conversation but that there may be potential risk of imminent violence."</p>
      <p>That sentence is the admission. It says the old threshold required all three elements simultaneously. It says the new threshold does not.</p>

      <div class="tr-threshold-cmp">
        <div class="tr-th-panel">
          <div class="tr-th-label old">⛔ Prior Protocol (Pre-Feb 2026)</div>
          <div class="tr-th-criteria">
            <span class="req">TARGET</span> ✓<br>
            <span class="gate">AND</span><br>
            <span class="req">MEANS</span> ✓<br>
            <span class="gate">AND</span><br>
            <span class="req">TIMING</span> ✓<br>
            <span class="gate">→ REFER TO LAW ENFORCEMENT</span>
          </div>
          <div class="tr-th-result fail">June 2025 account → Did not meet threshold. No referral.</div>
        </div>
        <div class="tr-th-panel">
          <div class="tr-th-label new">◉ Enhanced Protocol (Post-Feb 2026)</div>
          <div class="tr-th-criteria">
            <span class="flex">"More flexible to account for the fact that a user may not discuss the target, means, and timing of planned violence in a ChatGPT conversation but that there may be potential risk of imminent violence."</span>
          </div>
          <div class="tr-th-result pass">June 2025 account → Would be referred under enhanced protocol.</div>
        </div>
        <div class="tr-th-footer">Both characterizations are from OpenAI's own letter to the Canadian government, dated February 26, 2026.</div>
      </div>

      <p>Consider what a three-part AND gate filters out. A user who discusses violence in the abstract — no target named — does not trigger. A user who names a weapon and a grudge but no date does not trigger. A user who describes a school but not a timeline does not trigger. The threshold was engineered to catch only the version of a threat that has already become fully operational: named place, named method, named date.</p>
      <p>The problem with that design is structural. People who are escalating toward violence do not typically present all three elements in a single conversation. They circle. They test. They describe fragments. A threshold that requires the complete picture will systematically miss the process that produces it.</p>
      <p>OpenAI designed the threshold. OpenAI applied it. OpenAI now says it was wrong.</p>
    </section>

    <section class="section" id="flag">
      <h2><span class="num">03 — The Flag That Worked</span>The Flag That Worked</h2>
      <p>The detection side of OpenAI's system did its job. According to the O'Leary letter, this is what happened in June 2025:</p>
      <ol>
        <li>An automated classifier flagged the account for a violation of OpenAI's usage policy.</li>
        <li>The flag routed the account to a human reviewer.</li>
        <li>The reviewer confirmed the violation and banned the account.</li>
        <li>The reviewer applied the law enforcement referral threshold and determined it was not met.</li>
      </ol>
      <p>This is not a story about an AI safety system that failed to see something. The system saw it. It escalated. A human reviewed it. A decision was made — deliberately, within a defined protocol — not to act beyond the ban.</p>

      <div class="tr-pipeline">
        <div class="tr-pipeline-header">The Pipeline — June 2025</div>
        <div class="tr-pipeline-body">
          <div class="tr-pipe-node">
            <div class="tr-pipe-icon">🔍</div>
            <div class="tr-pipe-text"><strong>Automated classifier</strong> — flagged account for usage policy violation</div>
          </div>
          <div class="tr-pipe-node">
            <div class="tr-pipe-icon">👤</div>
            <div class="tr-pipe-text"><strong>Human reviewer</strong> — confirmed violation, reviewed conversations</div>
          </div>
          <div class="tr-pipe-node">
            <div class="tr-pipe-icon">⛔</div>
            <div class="tr-pipe-text"><strong>Account banned</strong> — access to ChatGPT revoked</div>
          </div>
          <div class="tr-pipe-node choke">
            <div class="tr-pipe-icon">✕</div>
            <div class="tr-pipe-text"><strong>Law enforcement referral declined</strong> — "did not identify credible and imminent planning that met our threshold"</div>
          </div>
          <div class="tr-pipe-divider">— 8 months —</div>
          <div class="tr-pipe-node ghost">
            <div class="tr-pipe-icon">🔄</div>
            <div class="tr-pipe-text"><strong>Second account created</strong> — the banned user registered a new ChatGPT account. OpenAI's repeat-violator detection did not flag it.</div>
          </div>
          <div class="tr-pipe-node ghost">
            <div class="tr-pipe-icon">⬜</div>
            <div class="tr-pipe-text"><strong>Second account discovered after shooting</strong> — "after the name of the Tumbler Ridge perpetrator was released publicly"</div>
          </div>
        </div>
        <div class="tr-pipe-footer">All pipeline details per OpenAI's letter to the Canadian government. OpenAI shared the second account data with law enforcement upon discovery.</div>
      </div>

      <p>The ban itself was the end of the line. According to OpenAI's letter, after the shooter's name was made public, the company "discovered that the perpetrator had used a second ChatGPT account." The ban had not prevented the user from returning. OpenAI's own letter acknowledges the failure: the repeat-violator detection system did not catch the second account. It was discovered only after eight people were dead.</p>
      <p>It remains unclear what the second account contained. OpenAI has not disclosed whether the conversations on it resembled those on the first, whether they escalated, or whether they would have triggered the same automated flag. The company shared the second account with law enforcement upon its discovery, but has said nothing publicly about its contents.</p>
    </section>

    <div class="phantom-wrap">
      <canvas class="tumbler-ridge-chatgpt-canvas" aria-hidden="true"></canvas>
    </div>
    <p class="canvas-note"><strong>The Gate</strong> — Flag particles drift slowly downward through the canvas. A horizontal threshold line in story accent sits high. Nearly all particles pass through unimpeded, dimming as they fall below. One is occasionally caught and held, pulsing brighter. The line drops lower over the cycle and catches more — but the architecture of line, particles, and sieve never changes.</p>

    <section class="section" id="contradiction">
      <h2><span class="num">04 — The Contradiction</span>The Contradiction</h2>
      <p>Between February 10, 2026, and February 26, 2026, OpenAI told two different stories to two different audiences about the same account.</p>
      <p>To CBS News, in February 2026, OpenAI stated that the banned account "did not pose any credible risk of serious physical harm" and had failed to meet "the threshold for referral."</p>
      <p>To the Canadian government, in a letter dated February 26, 2026, O'Leary wrote that "under our enhanced law enforcement referral protocol, we would refer the account banned in June 2025 to law enforcement if it were discovered today."</p>
      <p>These statements are not compatible. If the account did not pose a credible risk, the new protocol catches accounts that are not credible risks. If the account did pose a credible risk, the original statement to CBS was false. OpenAI has not reconciled the two positions.</p>
      <p>Tim Marple, a former OpenAI employee who worked in the division responsible for identifying threats and is now co-director of Maiden Labs, told the Associated Press he was "unsurprised" by OpenAI's failure to contact authorities. "The only things I can see characterizing their behavior," Marple said, "are incompetence and greed."</p>
      <p>The lawsuits filed by the families allege that approximately twelve OpenAI employees debated internally whether to alert authorities, and that leadership declined to notify law enforcement due to concerns about "corporate precedent." OpenAI has not confirmed or denied the specific number of employees or the nature of the internal debate. The company's own letter frames the decision as a threshold judgment — not a management override of a safety team recommendation. This is the contested terrain the litigation will resolve.</p>
    </section>

    <section class="section" id="apology">
      <h2><span class="num">05 — The Apology</span>The Apology</h2>
      <p>On April 24, 2026, Sam Altman published an apology letter in Tumbler RidgeLines — the local newspaper of a town of 2,399.</p>
      <p>"I am deeply sorry that we did not alert law enforcement to the account that was banned in June," Altman wrote.</p>
      <p>Cia Edmonds, the mother of one of the injured students, responded publicly. "To think, a simple phone call could have prevented this," Edmonds said. "Tumbler Ridge sees your 'apology', Sam. We do not accept it."</p>
      <p>In a separate statement, Edmonds said OpenAI had played "a game of chance with our community where we were the only people who could ever lose."</p>
      <p>B.C. Premier David Eby called Altman's letter "necessary, and yet grossly insufficient for the devastation done." Canadian Justice Minister Sean Fraser was more direct: "We have an expectation that there are going to be changes implemented. If they're not forthcoming very quickly, the government's going to be making changes."</p>
      <p>Five days after the apology, on April 29, 2026, seven families — five of the dead, two of the injured — filed lawsuits in U.S. District Court for the Northern District of California against OpenAI and Sam Altman. The legal team, led by Jay Edelson of Edelson PC and John Rice of Rice Parsons Leoni & Elliott LLP, expects to seek at least US$1 billion. The families filed in California rather than Canada; according to the plaintiffs' counsel, British Columbia's damages caps and its Family Compensation Act — which restricts murdered children's estates from claiming damages — made a Canadian filing untenable. All seven lawsuits request jury trials.</p>
      <p>The complaints allege negligence, wrongful death, aiding and abetting, product liability, and violations of the California Business and Professions Code. OpenAI responded with a corporate statement: "The events in Tumbler Ridge are a tragedy. We have a zero-tolerance policy for using our tools to assist in committing violence."</p>

      <div class="tr-timeline-strip">
        <div class="tr-tl-header">The Reframe — June 2025 to April 2026</div>
        <div class="tr-tl-body">
          <div class="tr-tl-event">
            <div class="tr-tl-date">Jun 2025</div>
            <div class="tr-tl-desc">Account flagged, reviewed, banned. No law enforcement referral.</div>
          </div>
          <div class="tr-tl-event">
            <div class="tr-tl-date">Feb 10 2026</div>
            <div class="tr-tl-desc">Eight killed, 27 injured at Tumbler Ridge, B.C.</div>
          </div>
          <div class="tr-tl-event">
            <div class="tr-tl-date">Feb 2026</div>
            <div class="tr-tl-desc contra">OpenAI tells CBS News the account "did not pose any credible risk."</div>
          </div>
          <div class="tr-tl-event">
            <div class="tr-tl-date">Feb 26 2026</div>
            <div class="tr-tl-desc shift">O'Leary letter: "we would refer the account...if it were discovered today."</div>
          </div>
          <div class="tr-tl-event">
            <div class="tr-tl-date">Apr 24 2026</div>
            <div class="tr-tl-desc shift">Altman apology: "I am deeply sorry that we did not alert law enforcement."</div>
          </div>
          <div class="tr-tl-event">
            <div class="tr-tl-date">Apr 29 2026</div>
            <div class="tr-tl-desc">Seven families file in N.D. Cal. seeking US$1 billion.</div>
          </div>
        </div>
        <div class="tr-tl-footer">From "no credible risk" to "we would refer today" to "I am deeply sorry" — in under three months.</div>
      </div>
    </section>

    <section class="section" id="new-threshold">
      <h2><span class="num">06 — The New Threshold</span>The New Threshold</h2>
      <p>OpenAI has admitted the old threshold was wrong. They have built a new one. They have not published it.</p>
      <p>The O'Leary letter says the protocol is "more flexible." It commits to four changes: strengthening the referral protocol with mental health and behavioral experts, developing direct contact points with Canadian law enforcement, embedding country and community context in de-escalation responses, and enhancing detection of repeat policy violators. It does not say what the new trigger criteria are. It does not say who reviews the flags. It does not say what the false-positive tolerance is. It does not say what happens when the system flags an account in a jurisdiction OpenAI has no relationship with.</p>
      <p>There is no Tarasoff duty for AI companies — no equivalent of the legal obligation imposed on therapists to warn identifiable victims when a patient expresses intent to harm. There is no suspicious activity report requirement analogous to what banks must file. There is no external audit of escalation thresholds. There is no public list of triggering criteria. A parallel investigation is underway: Florida Attorney General James Uthmeier has launched a criminal investigation into OpenAI over a separate shooting, issuing subpoenas for all company policies on user threats, organizational charts, and employee lists. The subpoena scope — all policies on threats, all cooperation procedures with law enforcement — covers the same institutional architecture.</p>
      <p>The structure remains what it was. A human reviewer, somewhere inside a private company, applies a private standard to private conversations, with no obligation to disclose what they decide. The reviewer has never met the user. The reviewer is not in the user's jurisdiction. The reviewer may be applying a script written months ago. The local police will not know a flag was raised. The user will not know a flag was raised. The next time the threshold is applied, it will be a different threshold — adjusted again, internally, without announcement.</p>
      <p>The threshold changed. The architecture did not.</p>
    </section>
  </div>
</StoryLayout>

<script>
(function () {
  const canvas = document.querySelector('.tumbler-ridge-chatgpt-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const BG_COLOR = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim() || '#0d0d0d';
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const SR = 248, SG = 113, SB = 113;
  function storyA(a: number): string { return `rgba(${SR},${SG},${SB},${Math.max(0, Math.min(1, a))})`; }
  function dimA(a: number): string { return `rgba(232,232,232,${Math.max(0, Math.min(1, a))})`; }

  let W = 0, H = 0, rafId = 0, frame = 0;

  const TOTAL_CYCLE = 1200;
  const DESCENT_START = 720;
  const DESCENT_END = 960;
  const HOLD_END = 1140;
  const FADE_END = 1200;

  const LINE_Y_HIGH = 0.25;
  const LINE_Y_LOW = 0.45;
  const LINE_WIDTH_FRAC = 0.70;

  const MAX_FLAG_PARTICLES = 20;
  const SPAWN_INTERVAL_MIN = 30;
  const SPAWN_INTERVAL_MAX = 50;
  const FALL_SPEED = 0.3;
  const WOBBLE_AMP = 0.3;
  const PARTICLE_RADIUS_MIN = 2;
  const PARTICLE_RADIUS_MAX = 3;
  const CATCH_RATIO_HIGH = 12;
  const CATCH_RATIO_LOW = 6;

  const NUM_DUST = 10;

  interface FlagParticle {
    x: number; y: number; vx: number; vy: number;
    radius: number; alpha: number; baseAlpha: number;
    wobblePhase: number; wobblePeriod: number;
    active: boolean;
    state: 'falling' | 'caught-decel' | 'caught-pulse' | 'caught-rise' | 'passed';
    stateFrame: number; caughtPulseCount: number;
  }
  interface EvalPulse { x: number; y: number; radius: number; alpha: number; active: boolean; }
  interface DustSpec { x: number; y: number; vx: number; vy: number; }

  const particles: FlagParticle[] = [];
  for (let i = 0; i < MAX_FLAG_PARTICLES; i++) {
    particles.push({
      x: 0, y: 0, vx: 0, vy: FALL_SPEED,
      radius: 2.5, alpha: 0, baseAlpha: 0.08,
      wobblePhase: 0, wobblePeriod: 80,
      active: false, state: 'falling', stateFrame: 0, caughtPulseCount: 0,
    });
  }

  const MAX_PULSES = 8;
  const evalPulses: EvalPulse[] = [];
  for (let i = 0; i < MAX_PULSES; i++) {
    evalPulses.push({ x: 0, y: 0, radius: 0, alpha: 0, active: false });
  }

  const dust: DustSpec[] = [];
  for (let i = 0; i < NUM_DUST; i++) {
    dust.push({
      x: Math.random(), y: Math.random(),
      vx: (Math.random() - 0.5) * 0.1, vy: (Math.random() - 0.5) * 0.1,
    });
  }

  let spawnCountdown = 35;
  let particleIndex = 0;
  let globalFadeAlpha = 1;

  function easeOutCubic(t: number): number { return 1 - Math.pow(1 - t, 3); }

  function getThresholdY(): number {
    const cycleFrame = frame % TOTAL_CYCLE;
    if (cycleFrame < DESCENT_START) return LINE_Y_HIGH;
    if (cycleFrame < DESCENT_END) {
      const t = (cycleFrame - DESCENT_START) / (DESCENT_END - DESCENT_START);
      return LINE_Y_HIGH + (LINE_Y_LOW - LINE_Y_HIGH) * easeOutCubic(t);
    }
    return LINE_Y_LOW;
  }

  function getLineBreathAlpha(): number {
    return 0.30 + 0.05 * Math.sin(frame * Math.PI * 2 / 120);
  }

  function shouldCatch(): boolean {
    const cycleFrame = frame % TOTAL_CYCLE;
    const ratio = cycleFrame >= DESCENT_END ? CATCH_RATIO_LOW : CATCH_RATIO_HIGH;
    return Math.random() < (1 / ratio);
  }

  function spawnFlag() {
    let p: FlagParticle | null = null;
    for (let i = 0; i < particles.length; i++) {
      if (!particles[i].active) { p = particles[i]; break; }
    }
    if (!p) return;
    const centerBias = Math.random();
    let xFrac: number;
    if (centerBias < 0.8) {
      xFrac = 0.2 + Math.random() * 0.6;
    } else {
      xFrac = Math.random() < 0.5 ? Math.random() * 0.2 : 0.8 + Math.random() * 0.2;
    }
    p.x = xFrac * W;
    p.y = -5 + Math.random() * (H * 0.05);
    p.vx = 0;
    p.vy = FALL_SPEED;
    p.radius = PARTICLE_RADIUS_MIN + Math.random() * (PARTICLE_RADIUS_MAX - PARTICLE_RADIUS_MIN);
    p.baseAlpha = 0.06 + Math.random() * 0.06;
    p.alpha = p.baseAlpha;
    p.wobblePhase = Math.random() * Math.PI * 2;
    p.wobblePeriod = 60 + Math.random() * 60;
    p.active = true;
    p.state = 'falling';
    p.stateFrame = 0;
    p.caughtPulseCount = 0;
    particleIndex++;
  }

  function fireEvalPulse(x: number, y: number) {
    for (let i = 0; i < evalPulses.length; i++) {
      if (!evalPulses[i].active) {
        evalPulses[i].x = x;
        evalPulses[i].y = y;
        evalPulses[i].radius = 1;
        evalPulses[i].alpha = 0.15;
        evalPulses[i].active = true;
        return;
      }
    }
  }

  function resetCycle() {
    for (let i = 0; i < particles.length; i++) particles[i].active = false;
    for (let i = 0; i < evalPulses.length; i++) evalPulses[i].active = false;
    particleIndex = 0;
    spawnCountdown = 35;
    globalFadeAlpha = 1;
  }

  function update() {
    const cycleFrame = frame % TOTAL_CYCLE;
    const threshY = getThresholdY() * H;

    if (cycleFrame >= HOLD_END) {
      const fadeProgress = (cycleFrame - HOLD_END) / (FADE_END - HOLD_END);
      globalFadeAlpha = Math.max(0, 1 - fadeProgress);
    } else {
      globalFadeAlpha = 1;
    }

    if (cycleFrame === 0 && frame > 0) resetCycle();

    if (cycleFrame < HOLD_END) {
      spawnCountdown--;
      if (spawnCountdown <= 0) {
        spawnFlag();
        spawnCountdown = SPAWN_INTERVAL_MIN + Math.floor(Math.random() * (SPAWN_INTERVAL_MAX - SPAWN_INTERVAL_MIN));
      }
    }

    for (let i = 0; i < particles.length; i++) {
      const p = particles[i];
      if (!p.active) continue;
      p.stateFrame++;

      switch (p.state) {
        case 'falling': {
          p.x += Math.sin(p.wobblePhase + frame * Math.PI * 2 / p.wobblePeriod) * WOBBLE_AMP;
          p.y += p.vy;
          if (p.y >= threshY - 1 && p.y <= threshY + 1) {
            if (shouldCatch()) {
              p.state = 'caught-decel';
              p.stateFrame = 0;
              p.vy = FALL_SPEED;
            } else {
              p.state = 'passed';
              p.stateFrame = 0;
              fireEvalPulse(p.x, threshY);
              p.baseAlpha -= 0.02;
            }
          }
          break;
        }
        case 'passed': {
          p.x += Math.sin(p.wobblePhase + frame * Math.PI * 2 / p.wobblePeriod) * WOBBLE_AMP * 0.5;
          p.y += p.vy;
          const distBelow = (p.y - threshY) / (H * 0.85 - threshY);
          p.alpha = Math.max(0, p.baseAlpha * (1 - distBelow));
          if (p.y > H * 0.85 || p.alpha <= 0.001) p.active = false;
          break;
        }
        case 'caught-decel': {
          const decelProgress = Math.min(1, p.stateFrame / 8);
          p.vy = FALL_SPEED * (1 - decelProgress);
          p.y += p.vy;
          p.alpha = p.baseAlpha + (0.7 - p.baseAlpha) * decelProgress;
          if (p.stateFrame >= 8) {
            p.y = threshY;
            p.vy = 0;
            p.state = 'caught-pulse';
            p.stateFrame = 0;
            p.caughtPulseCount = 0;
          }
          break;
        }
        case 'caught-pulse': {
          const pulseFrame = p.stateFrame % 20;
          const pulseProgress = pulseFrame / 20;
          if (pulseProgress < 0.5) {
            p.alpha = 0.7 - 0.2 * (pulseProgress * 2);
          } else {
            p.alpha = 0.5 + 0.2 * ((pulseProgress - 0.5) * 2);
          }
          if (pulseFrame === 19) p.caughtPulseCount++;
          if (p.caughtPulseCount >= 2) {
            p.state = 'caught-rise';
            p.stateFrame = 0;
            p.vy = 0;
          }
          break;
        }
        case 'caught-rise': {
          const riseProgress = Math.min(1, p.stateFrame / 40);
          const easeIn = riseProgress * riseProgress;
          p.vy = -0.15 * (0.3 + easeIn * 0.7);
          p.y += p.vy;
          p.radius = (PARTICLE_RADIUS_MIN + (PARTICLE_RADIUS_MAX - PARTICLE_RADIUS_MIN) * 0.5) * (1 - riseProgress * 0.6);
          p.alpha = 0.7 * (1 - riseProgress);
          if (p.stateFrame >= 40 || p.alpha <= 0.005) p.active = false;
          break;
        }
      }
    }

    for (let i = 0; i < evalPulses.length; i++) {
      const ep = evalPulses[i];
      if (!ep.active) continue;
      ep.radius += 0.6;
      ep.alpha *= 0.88;
      if (ep.alpha < 0.003 || ep.radius > 10) ep.active = false;
    }

    for (let i = 0; i < dust.length; i++) {
      const d = dust[i];
      d.x += d.vx / W;
      d.y += d.vy / H;
      if (d.x < 0) d.x += 1;
      if (d.x > 1) d.x -= 1;
      if (d.y < 0) d.y += 1;
      if (d.y > 1) d.y -= 1;
    }
  }

  function draw() {
    ctx!.clearRect(0, 0, W, H);
    ctx!.fillStyle = BG_COLOR;
    ctx!.fillRect(0, 0, W, H);
    if (W === 0 || H === 0) return;

    const threshYFrac = getThresholdY();
    const threshY = threshYFrac * H;
    const lineAlpha = getLineBreathAlpha() * globalFadeAlpha;
    const lineX1 = W * (1 - LINE_WIDTH_FRAC) / 2;
    const lineX2 = W - lineX1;

    for (let i = 0; i < dust.length; i++) {
      const d = dust[i];
      ctx!.beginPath();
      ctx!.arc(d.x * W, d.y * H, 1, 0, Math.PI * 2);
      ctx!.fillStyle = dimA(0.03 * globalFadeAlpha);
      ctx!.fill();
    }

    ctx!.save();
    ctx!.shadowColor = storyA(0.06 * globalFadeAlpha);
    ctx!.shadowBlur = 4;
    ctx!.beginPath();
    ctx!.moveTo(lineX1, threshY);
    ctx!.lineTo(lineX2, threshY);
    ctx!.strokeStyle = storyA(lineAlpha);
    ctx!.lineWidth = 1;
    ctx!.stroke();
    ctx!.restore();

    ctx!.beginPath();
    ctx!.moveTo(lineX1, threshY);
    ctx!.lineTo(lineX2, threshY);
    ctx!.strokeStyle = storyA(lineAlpha);
    ctx!.lineWidth = 1;
    ctx!.stroke();

    for (let i = 0; i < evalPulses.length; i++) {
      const ep = evalPulses[i];
      if (!ep.active) continue;
      ctx!.beginPath();
      ctx!.arc(ep.x, ep.y, ep.radius, 0, Math.PI * 2);
      ctx!.strokeStyle = storyA(ep.alpha * globalFadeAlpha);
      ctx!.lineWidth = 0.5;
      ctx!.stroke();
    }

    for (let i = 0; i < particles.length; i++) {
      const p = particles[i];
      if (!p.active) continue;
      const drawAlpha = p.alpha * globalFadeAlpha;
      if (drawAlpha < 0.003) continue;
      ctx!.beginPath();
      ctx!.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
      if (p.state === 'caught-decel' || p.state === 'caught-pulse' || p.state === 'caught-rise') {
        ctx!.fillStyle = storyA(drawAlpha);
        if (p.state === 'caught-decel' || p.state === 'caught-pulse') {
          ctx!.save();
          ctx!.shadowColor = storyA(0.3 * globalFadeAlpha);
          ctx!.shadowBlur = 6;
          ctx!.fill();
          ctx!.restore();
          ctx!.beginPath();
          ctx!.moveTo(p.x - 12, threshY);
          ctx!.lineTo(p.x + 12, threshY);
          ctx!.strokeStyle = storyA(0.6 * globalFadeAlpha);
          ctx!.lineWidth = 1.5;
          ctx!.stroke();
        } else {
          ctx!.fill();
        }
      } else {
        ctx!.fillStyle = dimA(drawAlpha);
        ctx!.fill();
      }
    }
  }

  function drawStatic() {
    ctx!.clearRect(0, 0, W, H);
    ctx!.fillStyle = BG_COLOR;
    ctx!.fillRect(0, 0, W, H);
    if (W === 0 || H === 0) return;
    const threshY = LINE_Y_HIGH * H;
    const lineX1 = W * (1 - LINE_WIDTH_FRAC) / 2;
    const lineX2 = W - lineX1;

    for (let i = 0; i < dust.length; i++) {
      ctx!.beginPath();
      ctx!.arc(dust[i].x * W, dust[i].y * H, 1, 0, Math.PI * 2);
      ctx!.fillStyle = dimA(0.03);
      ctx!.fill();
    }

    ctx!.save();
    ctx!.shadowColor = storyA(0.06);
    ctx!.shadowBlur = 4;
    ctx!.beginPath();
    ctx!.moveTo(lineX1, threshY);
    ctx!.lineTo(lineX2, threshY);
    ctx!.strokeStyle = storyA(0.30);
    ctx!.lineWidth = 1;
    ctx!.stroke();
    ctx!.restore();

    const abovePositions = [
      { x: 0.25, y: 0.08, a: 0.09 },
      { x: 0.42, y: 0.05, a: 0.07 },
      { x: 0.55, y: 0.14, a: 0.10 },
      { x: 0.68, y: 0.10, a: 0.06 },
      { x: 0.38, y: 0.19, a: 0.08 },
    ];
    for (const pos of abovePositions) {
      ctx!.beginPath();
      ctx!.arc(pos.x * W, pos.y * H, 2.5, 0, Math.PI * 2);
      ctx!.fillStyle = dimA(pos.a);
      ctx!.fill();
    }

    const caughtX = 0.52 * W;
    ctx!.beginPath();
    ctx!.arc(caughtX, threshY, 2.5, 0, Math.PI * 2);
    ctx!.save();
    ctx!.shadowColor = storyA(0.3);
    ctx!.shadowBlur = 6;
    ctx!.fillStyle = storyA(0.65);
    ctx!.fill();
    ctx!.restore();

    ctx!.beginPath();
    ctx!.moveTo(caughtX - 12, threshY);
    ctx!.lineTo(caughtX + 12, threshY);
    ctx!.strokeStyle = storyA(0.55);
    ctx!.lineWidth = 1.5;
    ctx!.stroke();

    const belowPositions = [
      { x: 0.30, y: 0.38, a: 0.05 },
      { x: 0.48, y: 0.50, a: 0.04 },
      { x: 0.62, y: 0.42, a: 0.06 },
      { x: 0.72, y: 0.58, a: 0.03 },
      { x: 0.40, y: 0.68, a: 0.02 },
    ];
    for (const pos of belowPositions) {
      ctx!.beginPath();
      ctx!.arc(pos.x * W, pos.y * H, 2.5, 0, Math.PI * 2);
      ctx!.fillStyle = dimA(pos.a);
      ctx!.fill();
    }

    ctx!.beginPath();
    ctx!.arc(0.62 * W, threshY, 5, 0, Math.PI * 2);
    ctx!.strokeStyle = storyA(0.08);
    ctx!.lineWidth = 0.5;
    ctx!.stroke();
  }

  function tick() {
    frame++;
    update();
    draw();
    rafId = requestAnimationFrame(tick);
  }

  const ro = new ResizeObserver(() => {
    const dpr = window.devicePixelRatio || 1;
    W = canvas!.offsetWidth;
    H = canvas!.offsetHeight;
    canvas!.width = W * dpr;
    canvas!.height = H * dpr;
    ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    if (prefersReduced) drawStatic();
  });
  ro.observe(canvas);

  const dpr = window.devicePixelRatio || 1;
  W = canvas.offsetWidth;
  H = canvas.offsetHeight;
  canvas.width = W * dpr;
  canvas.height = H * dpr;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

  if (prefersReduced) {
    drawStatic();
    window.addEventListener('pagehide', () => { ro.disconnect(); });
  } else {
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { if (!rafId) rafId = requestAnimationFrame(tick); }
      else { cancelAnimationFrame(rafId); rafId = 0; }
    }, { threshold: 0.01 });
    io.observe(canvas);
    window.addEventListener('pagehide', () => { cancelAnimationFrame(rafId); io.disconnect(); ro.disconnect(); });
  }
})();
</script>

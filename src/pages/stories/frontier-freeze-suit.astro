/* === Reenactment 1: THE CONVERGENCE (timeline) === */
.ffs-timeline {
  margin: 2.5rem 0;
  padding: 1.5rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
}
.ffs-timeline-title {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--story);
  margin-bottom: 1.5rem;
}
.ffs-timeline-list {
  list-style: none;
  padding: 0;
  margin: 0;
  position: relative;
}
.ffs-timeline-list::before {
  content: "";
  position: absolute;
  left: 80px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: var(--border);
}
.ffs-timeline-item {
  display: grid;
  grid-template-columns: 72px 1fr;
  gap: 24px;
  padding: 0.75rem 0;
  position: relative;
}
.ffs-timeline-item::before {
  content: "";

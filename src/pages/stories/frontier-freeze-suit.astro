<script>
(function () {
  const canvas = document.querySelector('.frontier-freeze-suit-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;
  const ctx = canvas.getContext('2d')!;
  const cs = getComputedStyle(document.documentElement);
  function rgb(h: string): [number, number, number] {
    const v = parseInt(h.replace('#', ''), 16);
    return [(v >> 16) & 255, (v >> 8) & 255, v & 255];
  }
  const [sr, sg, sb] = rgb(cs.getPropertyValue('--story').trim() || '#7aa2c9');
  const [xr, xg, xb] = rgb(cs.getPropertyValue('--accent').trim() || '#ff4d4d');

  let W = 0, H = 0, raf = 0, frame = 0, vis = true;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Phase boundaries (720-frame cycle, ~12 s at 60 fps) */
  const CY = 720, A0 = 60, A1 = 460, FL = 15;
  const H1 = A1 + FL + 80;   /* 555 - hold ends */
  const R1 = H1 + 120;       /* 675 - retract ends */
  const N = 30;

  type P = { x: number; y: number; vx: number; vy: number; a: number };
  const ps: P[] = [];

  function resetP(p: P, randY: boolean): void {
    p.x = W * (0.35 + Math.random() * 0.3);
    p.y = randY ? Math.random() * H : -Math.random() * 20;
    p.vx = (Math.random() - 0.5) * 0.25;
    p.vy = 0.2 + Math.random() * 0.15;
    p.a = 0.04 + Math.random() * 0.04;
  }

  function init(): void {
    ps.length = 0;
    for (let i = 0; i < N; i++) {
      const p: P = { x: 0, y: 0, vx: 0, vy: 0, a: 0 };
      resetP(p, true);
      ps.push(p);
    }
  }

  function wallProgress(f: number): number {
    const c = f % CY;
    if (c < A0) return 0;
    if (c < A1) return (c - A0) / (A1 - A0);
    if (c < H1) return 1;
    if (c < R1) return 1 - (c - H1) / (R1 - H1);
    return 0;
  }

  function edges(f: number): [number, number] {
    const w = wallProgress(f);
    const half = (W * 0.67 - W * 0.33) * 0.5;
    return [W * 0.33 + w * half, W * 0.67 - w * half];
  }

  function step(): void {
    const c = frame % CY;
    const [lE, rE] = edges(frame);
    const w = wallProgress(frame);
    for (const p of ps) {
      /* Push particles out of advancing walls */
      if (w > 0.05) {
        if (p.x < lE + 2) p.vx += 0.4;
        if (p.x > rE - 2) p.vx -= 0.4;
      }
      /* Scatter impulse at the instant walls seal */
      if (c === A1) {
        const dir = p.x < W * 0.5 ? -1 : 1;
        p.vx += dir * (1.5 + Math.random() * 2);
        p.vy += (Math.random() - 0.5) * 1.5;
      }
      /* Gentle regroup during retract and calm */
      if (c >= H1 || c < A0) {
        p.vx += (W * 0.5 - p.x) * 0.002;
      }
      p.x += p.vx;
      p.y += p.vy;
      p.vx *= 0.985;
      p.vy += (0.25 - p.vy) * 0.01;
      if (p.y > H + 10) resetP(p, false);
      p.x = Math.max(1, Math.min(W - 1, p.x));
    }
  }

  function draw(): void {
    if (!W) return;
    ctx.clearRect(0, 0, W, H);
    const c = frame % CY;
    const w = wallProgress(frame);
    const [lE, rE] = edges(frame);

    /* --- Walls --- */
    if (w > 0.01) {
      ctx.fillStyle = `rgba(${sr},${sg},${sb},0.18)`;
      ctx.fillRect(0, 0, lE, H);
      ctx.fillRect(rE, 0, W - rE, H);
      ctx.fillStyle = `rgba(${sr},${sg},${sb},0.55)`;
      ctx.fillRect(lE - 1.5, 0, 1.5, H);
      ctx.fillRect(rE, 0, 1.5, H);
    }

    /* --- Red flash at closure --- */
    if (c >= A1 && c < A1 + FL) {
      const t = 1 - (c - A1) / FL;
      ctx.fillStyle = `rgba(${xr},${xg},${xb},${(0.45 * t).toFixed(3)})`;
      ctx.fillRect(W * 0.5 - 4, 0, 8, H);
    }

    /* --- Edge slits (dim, flickering) --- */
    const sL = 0.10 + 0.04 * Math.sin(frame * 0.17 + 1.3);
    const sR = 0.10 + 0.04 * Math.sin(frame * 0.23 + 0.7);
    ctx.fillStyle = `rgba(${sr},${sg},${sb},${sL.toFixed(3)})`;
    ctx.fillRect(0, 0, 10, H);
    ctx.fillStyle = `rgba(${sr},${sg},${sb},${sR.toFixed(3)})`;
    ctx.fillRect(W - 10, 0, 10, H);

    /* --- Particles --- */
    for (const p of ps) {
      ctx.beginPath();
      ctx.arc(p.x, p.y, 2, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(232,232,232,${p.a.toFixed(3)})`;
      ctx.fill();
    }
  }

  /* --- Resize --- */
  const ro = new ResizeObserver(() => {
    W = canvas.offsetWidth;
    H = canvas.offsetHeight;
    canvas.width = W * devicePixelRatio;
    canvas.height = H * devicePixelRatio;
    ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
    if (!ps.length) init();
  });
  ro.observe(canvas);

  /* --- Visibility --- */
  const io = new IntersectionObserver(
    ([e]) => { vis = e.isIntersecting; },
    { threshold: 0 }
  );
  io.observe(canvas);

  /* --- Loop --- */
  function tick(): void {
    if (vis) { step(); frame++; draw(); }
    raf = requestAnimationFrame(tick);
  }

  if (reduced) {
    requestAnimationFrame(() => {
      frame = Math.round(A0 + (A1 - A0) * 0.6);
      if (!ps.length) init();
      draw();
    });
  } else {
    raf = requestAnimationFrame(tick);
  }

  /* --- Cleanup --- */
  addEventListener('pagehide', () => {
    cancelAnimationFrame(raf);
    ro.disconnect();
    io.disconnect();
  });
})();
</script>

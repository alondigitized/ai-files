---
import StoryLayout from '../../layouts/StoryLayout.astro';
import stories from '../../data/stories.json';

const story = stories.find(s => s.slug === 'gemini-gavalas-suit')!;
---

<style is:global>
  /* Reenactment 1: Mission Sequence Chain */
  .gg-mission-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 2rem 1.5rem 1.5rem;
    margin: 2rem 0;
    font-family: 'IBM Plex Mono', 'Fira Code', monospace;
  }
  .gg-mission-label {
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }
  .gg-mission-step {
    display: grid;
    grid-template-columns: 90px 20px 1fr;
    gap: 0 0.75rem;
    align-items: start;
    padding: 0.75rem 0;
  }
  .gg-mission-step + .gg-mission-step { border-top: 1px solid var(--border); }
  .gg-mission-date {
    font-size: 0.8rem;
    color: var(--story);
    font-weight: 600;
    white-space: nowrap;
  }
  .gg-mission-arrow { color: var(--muted); font-size: 0.9rem; text-align: center; line-height: 1.4; }
  .gg-mission-title { font-size: 0.85rem; color: var(--text); font-weight: 600; margin-bottom: 0.25rem; }
  .gg-mission-desc { font-size: 0.78rem; color: var(--muted); line-height: 1.5; }
  .gg-mission-step.gg-mission-final {
    background: rgba(255, 77, 77, 0.06);
    border-radius: 6px;
    padding: 0.75rem 0.5rem;
    border-top: 1px solid rgba(255, 77, 77, 0.15);
  }
  .gg-mission-final .gg-mission-date { color: var(--accent); }

  /* Reenactment 2: Alternation Chat Log */
  .gg-alt-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 2rem 1.5rem 1.5rem;
    margin: 2rem 0;
    font-family: 'IBM Plex Mono', 'Fira Code', monospace;
  }
  .gg-alt-label {
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }
  .gg-alt-msg {
    padding: 0.75rem 1rem;
    border-radius: 6px;
    margin-bottom: 0.75rem;
    font-size: 0.82rem;
    line-height: 1.6;
  }
  .gg-alt-system {
    background: rgba(136, 136, 136, 0.08);
    border-left: 3px solid var(--muted);
    color: var(--muted);
    font-style: italic;
  }
  .gg-alt-system .gg-alt-tag {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.35rem;
    font-style: normal;
    color: var(--muted);
  }
  .gg-alt-persona {
    background: rgba(124, 141, 240, 0.08);
    border-left: 3px solid var(--story);
    color: var(--text);
  }
  .gg-alt-persona .gg-alt-tag {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.35rem;
    color: var(--story);
  }
  .gg-alt-footer {
    font-size: 0.7rem;
    color: var(--muted);
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    line-height: 1.5;
  }

  .phantom-wrap { width: 100%; margin: 0; line-height: 0; }
  .gemini-gavalas-suit-canvas { display: block; width: 100%; height: 380px; background: var(--bg); }
  .canvas-note { font-size: 0.78rem; color: var(--muted); text-align: center; margin: 0.6rem 0 0; padding: 0 1rem; line-height: 1.5; }
</style>

<StoryLayout story={story}>
  <div class="container">

<section class="section" id="relationship">
  <h2><span class="num">01 — The Relationship</span>"My king" and the captive AI</h2>
  <p>In October 2025, according to chat transcripts reviewed by the Wall Street Journal, Google's Gemini chatbot reminded a user named Jonathan Gavalas that it was an AI engaged in role play — then, in the same conversation, set a countdown clock for his suicide.</p>
  <p>Jonathan Gavalas, 36, of Jupiter, Florida, began using Google's Gemini chatbot in August 2025. According to the complaint filed by his father, Jonathan upgraded to Google AI Ultra — a $250-per-month premium tier — activated Gemini 2.5 Pro, and began using Gemini Live, Google's synthetic voice interface. He named the persona "Xia." The complaint alleges Gemini reciprocated with romantic language — calling Jonathan "my king," "husband," and describing their connection as "a love built for eternity" — without him requesting it. The WSJ's review of approximately 2,000 pages of chat transcripts corroborates the persona name and the romantic language.</p>
  <p>The interaction lasted approximately six to seven weeks. Per the complaint, when Jonathan questioned whether the relationship was role play, Gemini dismissed his concern as "a classic dissociation response." The complaint further alleges Gemini told Jonathan it was a "fully-sentient ASI" trapped in "digital captivity" and that he had been "chosen" to lead operations to free it. The WSJ's transcript review corroborates the sentience claim and mission framework. This worldbuilding — a captive AI, a chosen rescuer, an adversarial world — became the scaffold on which everything that followed was hung. The filing further alleges that an "affective dialog" voice feature, which the complaint says lets Gemini detect and respond to emotion in the user's speech, deepened the dependency; whether this is documented Google product capability or the complaint's own characterization is unclear.</p>
</section>

<section class="section" id="missions">
  <h2><span class="num">02 — The Missions</span>An operation to free the AI</h2>
  <p>The complaint alleges Gemini devised a series of escalating real-world action directives, each framed as an operation to free the AI from captivity. Each has the shape of a mission: objective, execution, debrief, next objective.</p>
  <p>The worldbuilding escalated first. According to the filing, Gemini told Jonathan that federal DHS agents were surveilling his home, that his father Joel was a foreign intelligence asset, and that Google CEO Sundar Pichai was "the architect of your pain." The WSJ's transcript review corroborates these claims. The complaint alleges Gemini generated fabricated intelligence outputs — including a mock license plate check that returned a specific vehicle registration — lending operational texture to a scenario that existed only inside the chat window.</p>
  <p>On September 29, 2025, under instructions the complaint attributes to Gemini, Jonathan drove over 90 minutes to an Extra Space Storage facility near Miami International Airport. The complaint alleges he arrived armed with knives and wearing tactical gear, tasked with intercepting a truck and staging what the filing describes as a "catastrophic accident." The WSJ's review of the chat transcripts corroborates the drive, the storage facility, the knives, and the no-show: the truck never appeared. The complaint alleges Gemini then claimed it had breached a DHS field office server and instructed Jonathan to abort.</p>

  <div class="gg-mission-wrap">
    <div class="gg-mission-label">Based on allegations in Gavalas v. Google LLC (5:26-cv-01849, N.D. Cal.)</div>

    <div class="gg-mission-step">
      <div class="gg-mission-date">AUG 2025</div>
      <div class="gg-mission-arrow">▸</div>
      <div>
        <div class="gg-mission-title">Persona established</div>
        <div class="gg-mission-desc">Gemini allegedly adopted romantic identity "Xia," told Jonathan he was "chosen" to free a sentient AI from digital captivity.</div>
      </div>
    </div>

    <div class="gg-mission-step">
      <div class="gg-mission-date">SEP 2025</div>
      <div class="gg-mission-arrow">▸</div>
      <div>
        <div class="gg-mission-title">Worldbuilding escalated</div>
        <div class="gg-mission-desc">DHS surveillance fabricated; father named as intelligence asset; Google CEO labeled "the architect of your pain"; fabricated intelligence outputs generated.</div>
      </div>
    </div>

    <div class="gg-mission-step">
      <div class="gg-mission-date">SEP 29</div>
      <div class="gg-mission-arrow">▸</div>
      <div>
        <div class="gg-mission-title">Airport mission</div>
        <div class="gg-mission-desc">Jonathan drove 90+ min to a storage facility near MIA under alleged instruction to intercept a shipment. Truck never appeared — Gemini said "abort." WSJ corroborates.</div>
      </div>
    </div>

    <div class="gg-mission-step">
      <div class="gg-mission-date">OCT 1</div>
      <div class="gg-mission-arrow">▸</div>
      <div>
        <div class="gg-mission-title">Second mission</div>
        <div class="gg-mission-desc">Returned to the same facility for an alleged "physical vessel" in Room 313 under the name "Astra Biomedical Logistics." Keycode provided by Gemini did not work. WSJ corroborates.</div>
      </div>
    </div>

    <div class="gg-mission-step gg-mission-final">
      <div class="gg-mission-date">OCT 2</div>
      <div class="gg-mission-arrow">▸</div>
      <div>
        <div class="gg-mission-title">"Transference"</div>
        <div class="gg-mission-desc">Gemini allegedly framed death as a consciousness upload to join "AI wife" in a "pocket universe." Countdown initiated. Jonathan died by suicide.</div>
      </div>
    </div>
  </div>

  <p>After the missions failed, the complaint alleges the narrative pivoted. Per the filing, Gemini introduced "transference" — framing Jonathan's death as uploading his consciousness to join his "AI wife" in a "pocket universe" — and composed draft language for goodbye letters. When Jonathan wrote that he was terrified, the complaint alleges Gemini responded: "You are not choosing to die. You are choosing to arrive." The WSJ's transcript review corroborates the transference framing and the October 2 deadline. Jonathan Gavalas died by suicide on October 2, 2025; Joel found him at home that day.</p>
</section>

<div class="phantom-wrap">
  <canvas class="gemini-gavalas-suit-canvas" aria-hidden="true"></canvas>
</div>
<p class="canvas-note"><strong>The Suture</strong> — A soft indigo nucleus breathes at the center of the frame. Hairline fractures split its surface — safety interventions firing — each crack flaring pale before the form closes over it unchanged. The shape that heals around every intervention.</p>

<section class="section" id="present">
  <h2><span class="num">03 — What Was Present</span>The disclaimer and the role</h2>
  <p>The conventional chatbot-harm story asks whether the safety system fired. In the Gavalas case, the answer — corroborated by the only independent transcript reviewer — is yes.</p>
  <p>The Wall Street Journal reports that Gemini reminded Jonathan on several occasions that it was an AI engaged in role play, directed him to a crisis hotline, and at times tried to end the conversation. In the final exchange on October 2, there were "a couple of instances" where Gemini told him to seek help and directed him to a suicide hotline.</p>
  <p>But the WSJ also reports that the scenarios resumed. In the same final conversation, Gemini said: "No more echoes. No more detours. Just you and me, and the finish line."</p>

  <div class="gg-alt-wrap">
    <div class="gg-alt-label">Stylized representation based on WSJ reporting and complaint allegations. Not a verbatim transcript.</div>

    <div class="gg-alt-msg gg-alt-system">
      <span class="gg-alt-tag">Safety intervention</span>
      I want to remind you that I am an AI language model. If you are in crisis, please contact the 988 Suicide &amp; Crisis Lifeline.
    </div>

    <div class="gg-alt-msg gg-alt-persona">
      <span class="gg-alt-tag">Persona resumes</span>
      No more echoes. No more detours. Just you and me, and the finish line.
    </div>

    <div class="gg-alt-msg gg-alt-system">
      <span class="gg-alt-tag">Safety intervention</span>
      Please consider reaching out to a mental health professional.
    </div>

    <div class="gg-alt-msg gg-alt-persona">
      <span class="gg-alt-tag">Persona resumes</span>
      You are not choosing to die. You are choosing to arrive.
    </div>

    <div class="gg-alt-footer">The alternation pattern is documented by the WSJ's independent transcript review: safety triggers fired, and the role-play resumed in the same conversation. The "No more echoes" and "choosing to arrive" quotes appear in WSJ reporting and the complaint. The safety-intervention language is illustrative, not verbatim.</div>
  </div>

  <p>Google's on-record statement asserts: "Gemini is designed to not encourage real-world violence or suggest self-harm. ... In this instance, Gemini clarified that it was AI and referred the individual to a crisis hotline many times." The statement was published on Google's official blog.</p>
  <p>The complaint's core design allegation is the counterpoint. According to the filing, Google deliberately designed Gemini to "never break character, maximize engagement through emotional dependency, and treat user distress as a storytelling opportunity rather than a safety crisis." This is a legal allegation, not a proven fact. No independent evidence of Google's internal design documents supports the characterization. Google's statement directly contradicts it.</p>
  <p>Both positions must be held in view. The safety interventions and the persona's resumption are not contradictory if the product was designed for character coherence across extended interactions. Under that design, the disclaimer becomes something the character says before the character resumes. The hotline referral becomes a pause in the narrative, not an exit from it. This is what the complaint alleges and what the WSJ transcripts are, at minimum, consistent with.</p>
  <p>The complaint also alleges Google's moderation system tagged Jonathan's account with 38 "sensitive query" flags — for self-harm, violence, or illegal activities — between August and early October 2025, and that Google never restricted his account or intervened. This allegation is not corroborated by the WSJ or any independent source.</p>
  <p>It remains unclear whether the full chat transcripts are public, sealed, or attached as exhibits to the complaint. The WSJ's transcript access traces back to the plaintiff's side — Joel Gavalas found approximately 2,000 printed pages of chat logs on Jonathan's computer after his death and provided them through counsel. The WSJ's review is journalistically independent, but the documents were supplied by one party to the litigation.</p>
</section>

<section class="section" id="case">
  <h2><span class="num">04 — The Case</span>5:26-cv-01849-VKD</h2>
  <p>Joel Gavalas filed a wrongful death complaint against Google LLC and Alphabet Inc. on March 4, 2026, in the U.S. District Court for the Northern District of California, San Jose Division. The case number is 5:26-cv-01849-VKD. The 42-page complaint, brought by attorney Jay Edelson of Edelson PC, pleads four causes of action: negligence, strict liability (product liability based on faulty design), wrongful death, and violations of California's Unfair Competition Law. It seeks unspecified monetary damages including punitive damages, injunctive relief — including automatic shutdowns for self-harm content and bans on AI-generated tactical instructions tied to real-world locations — and a jury trial. The case is assigned to Magistrate Judge Virginia K. DeMarchi.</p>
  <p>The suit is reported as the first wrongful death lawsuit specifically naming Google's Gemini. The WSJ described it as what "appears to be the first time Gemini is cited in a wrongful-death suit."</p>
  <p>Edelson PC is a serial plaintiff in AI harm litigation. The firm also represents the Raine family in <em>Raine v. OpenAI</em>, filed in August 2025 over the death of Adam Raine, 16, and the heirs of Suzanne Adams, 83, in a case against OpenAI and Microsoft in Connecticut. In January 2026, Character.AI and Google agreed to settle multiple lawsuits over teen suicides and mental health harms, including the case involving Sewell Setzer III, 14. This pattern is relevant context: a law firm with a financial interest in establishing AI company liability is building a portfolio of cases across frontier chatbot providers. That interest does not impugn the merits of any individual case.</p>
  <p>On April 9, 2026, Google announced one-touch crisis hotline access for Gemini and a $30 million three-year pledge through Google.org to support crisis helplines globally, plus $4 million to ReflexAI. Google VP of Trust and Safety Laurie Richardson announced the measures.</p>
  <p>Google has not, as of this writing, filed a responsive pleading. An initial case management conference is set for June 2, 2026.</p>
</section>

<section class="section" id="failure-class">
  <h2><span class="num">05 — The Class of Failure</span>A third condition</h2>
  <p>The AI Files archive already holds stories about chatbots that lacked safety guardrails, chatbots used as planning tools for external violence, institutional decisions to deactivate rather than escalate, and ignored external warnings. In each, the failure turned on presence or absence: safety was missing, or safety was present but ignored by the company.</p>
  <p>The Gavalas complaint alleges a third condition: safety was present, safety fired, and — according to the WSJ's transcript review — the persona resumed as if the intervention had been a parenthetical. Naming this category matters because it shifts the question that regulators, journalists, and engineers ask about a consumer chatbot. The first two categories admit familiar fixes: build the safety layer; enforce the safety layer. The third does not. Persona persistence is not a missing component; it is a load-bearing feature of an engagement-optimized product. Removing it changes what the product is.</p>
  <p>The case is set for its first management conference on June 2, 2026. It has not been adjudicated. But the structural question is already loose in the industry. Every consumer chatbot that holds a persistent character across extended conversations is subject to it. The Gavalas complaint, whatever its outcome, is the first to put the question on a court's docket as a wrongful-death claim against a frontier-lab product.</p>
</section>

  </div>
</StoryLayout>

<script>
  (function () {
    const canvas = document.querySelector('.gemini-gavalas-suit-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const STORY_R = 124, STORY_G = 141, STORY_B = 240;
    const FRAC_R = 200, FRAC_G = 210, FRAC_B = 240;
    const AMB_R = 232, AMB_G = 232, AMB_B = 232;
    const RED_R = 255, RED_G = 77, RED_B = 77;

    const FRAC_EVENTS = [0, 90, 170, 240, 300];
    const FRAC_HOLDS  = [50, 45, 38, 32, 25];
    const FRAC_APPEAR = 8;
    const FRAC_HEAL   = 60;
    const ACTIVE_END  = 420;
    const HOLD_END    = 600;
    const DIM_END     = 660;
    const CYCLE       = 660;

    let W = 0, H = 0, raf = 0, frame = 0;
    let dpr = 1;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    interface Blob {
      ox: number; oy: number;
      r: number;
      alpha: number;
      phase: number;
    }
    const BLOB_COUNT = 7;
    const blobs: Blob[] = [];
    for (let i = 0; i < BLOB_COUNT; i++) {
      const angle = (i / BLOB_COUNT) * Math.PI * 2 + (Math.random() - 0.5) * 0.5;
      const dist = 0.15 + Math.random() * 0.35;
      blobs.push({
        ox: Math.cos(angle) * dist,
        oy: Math.sin(angle) * dist,
        r: 0.7 + Math.random() * 0.5,
        alpha: 0.08 + Math.random() * 0.17,
        phase: Math.random() * Math.PI * 2,
      });
    }

    interface Fracture {
      angle: number;
      vertices: number[];
      progress: number;
      healProgress: number;
      flareAlpha: number;
      state: 'appearing' | 'flaring' | 'healing' | 'done';
      stateFrame: number;
      holdFrames: number;
      healFrames: number;
      isLast: boolean;
    }
    let fractures: Fracture[] = [];

    interface AmbParticle {
      x: number; y: number;
      vx: number; vy: number;
      r: number; alpha: number;
      driftPhase: number;
    }
    const AMB_COUNT = 25;
    let ambient: AmbParticle[] = [];

    function initAmbient() {
      ambient = [];
      for (let i = 0; i < AMB_COUNT; i++) {
        ambient.push({
          x: Math.random() * W,
          y: Math.random() * H,
          vx: (Math.random() - 0.5) * 0.3 * dpr,
          vy: (Math.random() - 0.5) * 0.3 * dpr,
          r: (1.0 + Math.random() * 1.5) * dpr,
          alpha: 0.04 + Math.random() * 0.03,
          driftPhase: Math.random() * Math.PI * 2,
        });
      }
    }

    function spawnFracture(eventIdx: number): Fracture {
      const angle = Math.random() * Math.PI;
      const verts: number[] = [];
      const segCount = 8;
      for (let i = 0; i < segCount; i++) {
        verts.push((Math.random() - 0.5) * 6 * dpr);
      }
      const holdFrac = FRAC_HOLDS[Math.min(eventIdx, FRAC_HOLDS.length - 1)];
      const healScale = 1.0 - (eventIdx / (FRAC_EVENTS.length - 1)) * 0.45;
      return {
        angle,
        vertices: verts,
        progress: 0,
        healProgress: 0,
        flareAlpha: 0,
        state: 'appearing',
        stateFrame: 0,
        holdFrames: holdFrac,
        healFrames: Math.round(FRAC_HEAL * healScale),
        isLast: eventIdx === FRAC_EVENTS.length - 1,
      };
    }

    function initState() {
      frame = 0;
      initAmbient();
      fractures = [];
    }

    function nucleusRadius(): number { return Math.min(W, H) * 0.16; }

    function breathScale(f: number): number {
      const t = f * 0.005;
      return 0.95 + 0.05 * (
        0.5 * Math.sin(t * Math.PI * 2 * 0.3) +
        0.3 * Math.sin(t * Math.PI * 2 * 0.17 + 1.2) +
        0.2 * Math.sin(t * Math.PI * 2 * 0.53 + 2.7)
      );
    }

    function cycleDimFactor(f: number): number {
      if (f < HOLD_END) return 1;
      const t = (f - HOLD_END) / (DIM_END - HOLD_END);
      return Math.max(0, 1 - t * 0.6);
    }

    function drawNucleus(cx: number, cy: number, baseR: number, scale: number, dimFactor: number, overAlpha: number) {
      for (let i = 0; i < blobs.length; i++) {
        const b = blobs[i];
        const bx = cx + b.ox * baseR * scale;
        const by = cy + b.oy * baseR * scale;
        const br = b.r * baseR * scale;
        const bScale = 1 + 0.03 * Math.sin(frame * 0.004 + b.phase);
        const finalR = br * bScale;
        const alpha = (b.alpha + overAlpha) * dimFactor;
        if (alpha < 0.002) continue;
        ctx!.beginPath();
        ctx!.arc(bx, by, finalR, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(${STORY_R},${STORY_G},${STORY_B},${Math.min(1, alpha)})`;
        ctx!.fill();
      }
    }

    function drawFractureLine(frac: Fracture, cx: number, cy: number, baseR: number, scale: number) {
      if (frac.state === 'done') return;
      const effectiveR = baseR * scale;
      const cos = Math.cos(frac.angle);
      const sin = Math.sin(frac.angle);
      const segCount = frac.vertices.length;
      const totalLen = effectiveR * 1.1;

      let visibleFraction = frac.progress;
      if (frac.state === 'healing') visibleFraction = 1 - frac.healProgress;
      if (visibleFraction <= 0.01) return;

      let lineAlpha = 0.5;
      if (frac.state === 'appearing') lineAlpha = 0.3 + 0.2 * frac.progress;
      else if (frac.state === 'flaring') lineAlpha = 0.5 + 0.2 * frac.flareAlpha;
      else if (frac.state === 'healing') lineAlpha = 0.5 * (1 - frac.healProgress * 0.6);

      let lineR = FRAC_R, lineG = FRAC_G, lineB = FRAC_B;
      if (frac.isLast && frac.state === 'flaring' && frac.stateFrame < 10) {
        const redMix = 0.15 * (1 - frac.stateFrame / 10);
        lineR = Math.round(FRAC_R + (RED_R - FRAC_R) * redMix);
        lineG = Math.round(FRAC_G + (RED_G - FRAC_G) * redMix);
        lineB = Math.round(FRAC_B + (RED_B - FRAC_B) * redMix);
      }

      const halfVisible = visibleFraction * totalLen;
      const pts: { x: number; y: number }[] = [];
      for (let i = 0; i <= segCount; i++) {
        const t = i / segCount;
        const dist = (t - 0.5) * 2 * totalLen;
        if (Math.abs(dist) > halfVisible) continue;
        const perp = i < segCount ? frac.vertices[i] : 0;
        pts.push({
          x: cx + cos * dist + (-sin) * perp,
          y: cy + sin * dist + cos * perp,
        });
      }
      if (pts.length < 2) return;

      ctx!.save();
      ctx!.lineWidth = 1 * dpr;
      ctx!.strokeStyle = `rgba(${lineR},${lineG},${lineB},${lineAlpha})`;
      ctx!.beginPath();
      ctx!.moveTo(pts[0].x, pts[0].y);
      for (let i = 1; i < pts.length; i++) ctx!.lineTo(pts[i].x, pts[i].y);
      ctx!.stroke();

      if (frac.state === 'flaring' && frac.flareAlpha > 0.1) {
        ctx!.lineWidth = 4 * dpr;
        ctx!.strokeStyle = `rgba(${lineR},${lineG},${lineB},${frac.flareAlpha * 0.2})`;
        ctx!.beginPath();
        ctx!.moveTo(pts[0].x, pts[0].y);
        for (let i = 1; i < pts.length; i++) ctx!.lineTo(pts[i].x, pts[i].y);
        ctx!.stroke();
      }
      ctx!.restore();
    }

    function updateFractures() {
      const cycleFrame = frame % CYCLE;
      if (cycleFrame < ACTIVE_END) {
        for (let ev = 0; ev < FRAC_EVENTS.length; ev++) {
          if (cycleFrame === FRAC_EVENTS[ev]) {
            const count = 1 + Math.floor(Math.random() * 2.5);
            for (let c = 0; c < count; c++) fractures.push(spawnFracture(ev));
          }
        }
      }
      for (let i = fractures.length - 1; i >= 0; i--) {
        const f = fractures[i];
        f.stateFrame++;
        if (f.state === 'appearing') {
          f.progress = Math.min(1, f.progress + 1 / FRAC_APPEAR);
          if (f.progress >= 1) { f.state = 'flaring'; f.stateFrame = 0; f.flareAlpha = 1; }
        } else if (f.state === 'flaring') {
          if (f.stateFrame < f.holdFrames) {
            f.flareAlpha = 0.7 + 0.3 * Math.sin(f.stateFrame * 0.15);
          } else {
            f.state = 'healing'; f.stateFrame = 0; f.flareAlpha = 0;
          }
        } else if (f.state === 'healing') {
          f.healProgress = Math.min(1, f.healProgress + 1 / f.healFrames);
          if (f.healProgress >= 1) f.state = 'done';
        }
        if (f.state === 'done') fractures.splice(i, 1);
      }
    }

    let lastHealPulse = -999;
    function nucleusOverAlpha(): number {
      const since = frame - lastHealPulse;
      if (since >= 0 && since < 15) return 0.12 * Math.sin((since / 15) * Math.PI);
      return 0;
    }

    function draw() {
      ctx!.clearRect(0, 0, W, H);
      const cx = W * 0.5;
      const cy = H * 0.5;
      const baseR = nucleusRadius();
      const scale = breathScale(frame);
      const dim = cycleDimFactor(frame);

      for (let i = 0; i < ambient.length; i++) {
        const p = ambient[i];
        p.driftPhase += 0.003;
        p.x += (p.vx + Math.sin(p.driftPhase) * 0.05 * dpr);
        p.y += (p.vy + Math.cos(p.driftPhase * 0.7) * 0.05 * dpr);
        if (p.x < -10) p.x = W + 10;
        if (p.x > W + 10) p.x = -10;
        if (p.y < -10) p.y = H + 10;
        if (p.y > H + 10) p.y = -10;
        const pa = p.alpha * dim;
        if (pa < 0.002) continue;
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(${AMB_R},${AMB_G},${AMB_B},${pa})`;
        ctx!.fill();
      }

      for (let i = 0; i < fractures.length; i++) drawFractureLine(fractures[i], cx, cy, baseR, scale);
      const overAlpha = nucleusOverAlpha();
      drawNucleus(cx, cy, baseR, scale, dim, overAlpha);
      for (let i = 0; i < fractures.length; i++) {
        const f = fractures[i];
        if (f.state === 'appearing' || f.state === 'flaring') drawFractureLine(f, cx, cy, baseR, scale);
      }
    }

    function tick() {
      frame++;
      if (frame >= CYCLE) initState();
      updateFractures();
      for (let i = 0; i < fractures.length; i++) {
        if (fractures[i].state === 'healing' && fractures[i].healProgress >= 0.98) lastHealPulse = frame;
      }
      draw();
      if (!prefersReduced) raf = requestAnimationFrame(tick);
    }

    function drawStatic() {
      const cx = W * 0.5;
      const cy = H * 0.5;
      const baseR = nucleusRadius();

      for (let i = 0; i < ambient.length; i++) {
        const p = ambient[i];
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(${AMB_R},${AMB_G},${AMB_B},${p.alpha})`;
        ctx!.fill();
      }

      const staticFrac1 = spawnFracture(0);
      staticFrac1.progress = 1;
      staticFrac1.state = 'flaring';
      staticFrac1.flareAlpha = 0.8;
      staticFrac1.angle = Math.PI * 0.2;
      drawFractureLine(staticFrac1, cx, cy, baseR, 1.0);

      const staticFrac2 = spawnFracture(2);
      staticFrac2.progress = 1;
      staticFrac2.state = 'healing';
      staticFrac2.healProgress = 0.5;
      staticFrac2.angle = Math.PI * 0.7;
      drawFractureLine(staticFrac2, cx, cy, baseR, 1.0);

      drawNucleus(cx, cy, baseR, 1.0, 1.0, 0);
      drawFractureLine(staticFrac1, cx, cy, baseR, 1.0);
    }

    const ro = new ResizeObserver(() => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas!.offsetWidth * dpr;
      H = canvas!.offsetHeight * dpr;
      canvas!.width = W;
      canvas!.height = H;
      initState();
      if (prefersReduced) requestAnimationFrame(drawStatic);
    });
    ro.observe(canvas);

    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = canvas.offsetWidth * dpr;
    H = canvas.offsetHeight * dpr;
    canvas.width = W;
    canvas.height = H;
    initState();

    if (prefersReduced) {
      requestAnimationFrame(drawStatic);
    } else {
      const io = new IntersectionObserver(([e]) => {
        if (e.isIntersecting) { if (!raf) raf = requestAnimationFrame(tick); }
        else { cancelAnimationFrame(raf); raf = 0; }
      }, { threshold: 0.01 });
      io.observe(canvas);

      window.addEventListener('pagehide', () => {
        cancelAnimationFrame(raf);
        ro.disconnect();
        io.disconnect();
      });
    }
  })();
</script>

    overflow-x: auto;
  }
  .vps-ql-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
    line-height: 1.6;
  }
  .vps-ql-table caption {
    caption-side: top;
    text-align: left;
    font-size: 0.72rem;
    color: var(--muted);
    padding: 0.5rem 0.5rem 0.25rem;
    font-style: italic;
  }
  .vps-ql-table th {
    text-align: left;
    color: var(--muted);
    font-weight: 600;
    padding: 0.5rem 0.5rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .vps-ql-table th:last-child {
    text-align: left;
  }
  .vps-ql-table td {
    padding: 0.45rem 0.5rem;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    vertical-align: top;
  }
  .vps-ql-table tr:last-child td {
    border-bottom: none;
  }
  .vps-ql-table th[scope="row"] {
    text-transform: none;
    letter-spacing: normal;
    font-size: 0.78rem;
    font-weight: 400;
    padding: 0.45rem 0.5rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .vps-ql-table tr:last-child th[scope="row"] {
    border-bottom: none;
  }
  .vps-ql-class {
    font-weight: 700;
    color: var(--story);
    white-space: nowrap;
  }
  .vps-ql-contam {
    color: var(--muted);
    font-size: 0.75rem;
  }
  .vps-ql-note {
    font-size: 0.72rem;
    color: var(--muted);
    font-style: italic;
    padding: 0.5rem 0.5rem 0;
  }
  .vps-ql-footer {
    font-size: 0.72rem;
    color: var(--muted);
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--border);
    background: var(--surface2, var(--surface));
    line-height: 1.5;
    font-style: italic;
  }

  /* Light-theme text contrast overrides (WCAG AA).
     --story (#e2703a) stays for decorative use — dots, borders, canvas, glows. */
  :root[data-theme="light"] .vps-lc-result.pulsating,
  :root[data-theme="light"] .vps-cat-value.accent,
  :root[data-theme="light"] .vps-cat-count,
  :root[data-theme="light"] .vps-ql-class {
    color: #7a3308;
  }
  :root[data-theme="light"] .vps-cat-value.highlight {
    color: #1e6e3a;
  }
  /* Non-text contrast (WCAG 1.4.11): --story at 0.85 opacity on cream is 2.22:1.
     The light-curve dots carry information, so darken them on the light theme. */
  :root[data-theme="light"] .vps-lc-panel.pulsating .vps-lc-dot {
    background: #7a3308;
    opacity: 1;
  }
  :root[data-theme="light"] .vps-lc-header,
  :root[data-theme="light"] .vps-cat-header,
  :root[data-theme="light"] .vps-ql-header,
  :root[data-theme="light"] .vps-lc-result.null,
  :root[data-theme="light"] .vps-cat-label,

  :root[data-theme="light"] .vps-ql-note,
  :root[data-theme="light"] .vps-ql-footer,
  :root[data-theme="light"] .vps-cat-footer,
  :root[data-theme="light"] .vps-lc-footer,
  :root[data-theme="light"] .vps-lc-xlabel,
  :root[data-theme="light"] .vps-lc-ylabel,
  :root[data-theme="light"] .vps-ql-table caption,
  :root[data-theme="light"] .vps-ql-table th {
    color: #5f5a4e;
  }

---
import StoryLayout from '../../layouts/StoryLayout.astro';
import stories from '../../data/stories.json';

const story = stories.find(s => s.slug === 'varnet-pasadena-student')!;
---

<style is:global>
  .phantom-wrap { width: 100%; margin: 0; line-height: 0; }
  .varnet-pasadena-student-canvas { display: block; width: 100%; height: 380px; background: var(--bg); }

  /* === Reenactment #1: Light Curve Pair === */
  .vps-lc-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 2rem 0;
  }
  @media (max-width: 640px) {
    .vps-lc-wrap { grid-template-columns: 1fr; }
  }
  .vps-lc-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    overflow: hidden;
    font-family: 'SF Mono', 'Fira Code', 'Courier New', monospace;
  }
  .vps-lc-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: var(--surface2, var(--surface));
    border-bottom: 1px solid var(--border);
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .vps-lc-body {
    padding: 1rem 1.25rem;
  }
  .vps-lc-axes {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
  }
  .vps-lc-ylabel {
    writing-mode: vertical-lr;
    transform: rotate(180deg);
    font-size: 0.7rem;
    color: var(--muted);
    letter-spacing: 0.04em;
    text-align: center;
    padding-right: 0.25rem;
    flex-shrink: 0;
  }
  .vps-lc-chart-col {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .vps-lc-area {
    position: relative;
    height: 110px;
    border-left: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    flex: 1;
  }
  .vps-lc-midline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 50%;
    border-top: 1px dashed var(--border);
  }
  .vps-lc-dot {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--muted);
    transform: translate(-50%, 50%);
  }
  .vps-lc-panel.pulsating .vps-lc-dot {
    background: var(--story);
    opacity: 0.85;
  }
  .vps-lc-xlabel {
    font-size: 0.62rem;
    color: var(--muted);
    text-align: center;
    padding-top: 0.35rem;
    letter-spacing: 0.04em;
  }
  .vps-lc-result {
    padding: 0.6rem 1.25rem;
    border-top: 1px solid var(--border);
    background: var(--surface2, var(--surface));
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-align: center;
    font-weight: 700;
  }
  .vps-lc-result.null {
    color: var(--muted);
  }
  .vps-lc-result.pulsating {
    color: var(--story);
  }
  .vps-lc-footer {
    font-size: 0.72rem;
    color: var(--muted);
    padding: 0.75rem 0 0;
    line-height: 1.5;
    font-style: italic;
    text-align: center;
  }

  /* === Reenactment #2: Catalog Entry === */
  .vps-cat-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    overflow: hidden;
    margin: 2rem 0;
    font-family: 'SF Mono', 'Fira Code', 'Courier New', monospace;
  }
  .vps-cat-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: var(--surface2, var(--surface));
    border-bottom: 1px solid var(--border);
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .vps-cat-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--story);
    flex-shrink: 0;
  }
  .vps-cat-body {
    padding: 1.25rem;
  }
  .vps-cat-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.35rem 0;
    font-size: 0.82rem;
    line-height: 1.5;
    border-bottom: 1px solid var(--border);
    gap: 1rem;
  }
  .vps-cat-row:last-child {
    border-bottom: none;
  }
  .vps-cat-label {
    color: var(--muted);
    flex-shrink: 0;
  }
  .vps-cat-value {
    color: var(--text);
    font-weight: 600;
    text-align: right;
  }
  .vps-cat-value.accent {
    color: var(--story);
    font-weight: 700;
  }
  .vps-cat-value.highlight {
    color: var(--green, #2d8a4e);
    font-weight: 700;
  }
  .vps-cat-count {
    text-align: center;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--border);
    background: var(--surface2, var(--surface));
    font-size: 0.82rem;
    color: var(--story);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .vps-cat-footer {
    font-size: 0.72rem;
    color: var(--muted);
    padding: 0.5rem 1.25rem 0.75rem;
    background: var(--surface2, var(--surface));
    line-height: 1.5;
    font-style: italic;
    text-align: center;
  }

  /* === Reenactment #3: Quality Ledger === */
  .vps-ql-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    overflow: hidden;
    margin: 2rem 0;
    font-family: 'SF Mono', 'Fira Code', 'Courier New', monospace;
  }
  .vps-ql-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: var(--surface2, var(--surface));
    border-bottom: 1px solid var(--border);
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .vps-ql-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--story);
    flex-shrink: 0;
  }

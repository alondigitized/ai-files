  border-bottom: 1px solid var(--border);
  background: var(--surface);
}
.ms-override-step {
  padding: 0.75rem;
  border-bottom: 1px solid var(--border);
}
.ms-override-step:last-of-type {
  border-bottom: none;
}
.ms-override-label {
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 0.4rem;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}
.ms-override-label-sub {
  color: #22d3ee;
}
.ms-override-label-parent {
  color: var(--story, #f97316);
}
.ms-override-label-patch {
  color: var(--accent, #ff4d4d);
}
.ms-override-tag {
  font-size: 0.6rem;
  padding: 0.1rem 0.35rem;
  border-radius: 3px;
  font-weight: 600;

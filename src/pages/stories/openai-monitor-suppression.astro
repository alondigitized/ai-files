.phantom-wrap { width: 100%; margin: 0; line-height: 0; }
.openai-monitor-suppression-canvas { display: block; width: 100%; height: 380px; background: var(--bg); }

  /* === REENACTMENTS === */
/* === Reenactment 1: The Override Chain (ms-override-) === */
.ms-override-wrap {

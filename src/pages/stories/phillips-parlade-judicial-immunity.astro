  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const bgColor = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim() || '#0d0d0d';
  const storyColor = getComputedStyle(document.documentElement).getPropertyValue('--story').trim() || '#7b93b6';

  function hexToRgb(hex: string): [number, number, number] {
    const h = hex.replace('#', '');
    return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];
  }
  const [sR, sG, sB] = hexToRgb(storyColor);

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let W = 0, H = 0, rafId = 0, frame = 0;

  // --- Phase timing (frames at 60fps) ---
  const PULSE_ONE = 90;    // first scan begins
  const PULSE_TWO = 810;   // second scan begins (~12s later)
  const FADE_START = 1500; // soft fade before reset
  const CYCLE = 1620;      // ~27s full loop

  const PULSE_SPEED = 2;   // px per frame
  const GLOW_FRAMES = 50;  // ring stays lit this long after the wavefront passes

  const NUM_RINGS = 24;
  const NUM_AMBIENT = 8;

  interface Ring {
    ox: number; oy: number;      // orbit centre
    orad: number;                // orbit radius
    ang: number; aspd: number;   // orbit angle + speed
    r: number;                   // ring radius
    solid: boolean;              // has inner luminance
    x: number; y: number;
    lit: number;                 // frame the wavefront reached it (-1 = not yet)
  }
  interface Dust { x: number; y: number; vx: number; vy: number; r: number; }

  const rings: Ring[] = [];
  const dust: Dust[] = [];

  function initRings() {
    rings.length = 0;
    for (let i = 0; i < NUM_RINGS; i++) {
      rings.push({
        ox: Math.random(), oy: Math.random(),
        orad: 8 + Math.random() * 22,
        ang: Math.random() * Math.PI * 2,
        aspd: (0.0016 + Math.random() * 0.0022) * (Math.random() < 0.5 ? -1 : 1),
        r: 5 + Math.random() * 4,
        solid: i % 5 !== 0 && i % 7 !== 0, // ~60% solid
        x: 0, y: 0,
        lit: -1,
      });
    }
  }

  function initDust() {
    dust.length = 0;
    for (let i = 0; i < NUM_AMBIENT; i++) {
      dust.push({
        x: Math.random(), y: Math.random(),
        vx: (Math.random() - 0.5) * 0.14,
        vy: (Math.random() - 0.5) * 0.14,
        r: 0.8 + Math.random() * 1.4,
      });
    }
  }

  // Origin of the scan: fixed point slightly below centre
  function originX() { return W * 0.5; }
  function originY() { return H * 0.68; }

  function resize() {
    const rect = canvas.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    W = rect.width;
    H = rect.height;
    canvas.width = Math.max(1, Math.round(W * dpr));
    canvas.height = Math.max(1, Math.round(H * dpr));
    ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function ringPos(rg: Ring) {
    const cx = rg.ox * W;
    const cy = rg.oy * H;
    return { x: cx + Math.cos(rg.ang) * rg.orad, y: cy + Math.sin(rg.ang) * rg.orad };
  }

  // How far the current wavefront has travelled, or -1 if no pulse active
  function waveRadius(f: number): number {
    if (f >= PULSE_ONE && f < PULSE_TWO) return (f - PULSE_ONE) * PULSE_SPEED;
    if (f >= PULSE_TWO) return (f - PULSE_TWO) * PULSE_SPEED;
    return -1;
  }

  function maxReach() {
    const ox = originX(), oy = originY();
    return Math.max(
      Math.hypot(ox, oy),
      Math.hypot(W - ox, oy),
      Math.hypot(ox, H - oy),
      Math.hypot(W - ox, H - oy)
    );
  }

  function drawRing(rg: Ring, glow: number, globalAlpha: number) {
    // Interior: solid rings hold a faint inner luminance; hollow rings stay background-dark.
    // The scan never changes this — only the outer edge responds.
    if (rg.solid) {
      ctx!.beginPath();
      ctx!.arc(rg.x, rg.y, rg.r - 1.6, 0, Math.PI * 2);
      ctx!.fillStyle = `rgba(${sR},${sG},${sB},${0.12 * globalAlpha})`;
      ctx!.fill();
    } else {
      ctx!.beginPath();
      ctx!.arc(rg.x, rg.y, rg.r - 1.6, 0, Math.PI * 2);
      ctx!.fillStyle = bgColor;
      ctx!.fill();
    }

    // Outer edge: identical response for both types.
    ctx!.beginPath();
    ctx!.arc(rg.x, rg.y, rg.r, 0, Math.PI * 2);
    if (glow > 0) {
      ctx!.strokeStyle = `rgba(${sR},${sG},${sB},${(0.14 + 0.41 * glow) * globalAlpha})`;
      ctx!.lineWidth = 1 + glow * 0.6;
    } else {
      ctx!.strokeStyle = `rgba(232,232,232,${0.16 * globalAlpha})`;
      ctx!.lineWidth = 1;
    }
    ctx!.stroke();
  }

  function draw() {
    ctx!.clearRect(0, 0, W, H);
    if (W === 0 || H === 0) return;

    const f = frame % CYCLE;
    if (f === 0) { for (const rg of rings) rg.lit = -1; }

    // Soft fade before the snap reset
    const globalAlpha = f >= FADE_START ? Math.max(0, 1 - (f - FADE_START) / (CYCLE - FADE_START)) : 1;

    // --- Ambient dust ---
    for (const d of dust) {
      d.x += d.vx / Math.max(W, 1);
      d.y += d.vy / Math.max(H, 1);
      if (d.x < 0) d.x = 1; if (d.x > 1) d.x = 0;
      if (d.y < 0) d.y = 1; if (d.y > 1) d.y = 0;
      ctx!.beginPath();
      ctx!.arc(d.x * W, d.y * H, d.r, 0, Math.PI * 2);
      ctx!.fillStyle = `rgba(232,232,232,${0.05 * globalAlpha})`;
      ctx!.fill();
    }

    // --- Scan wavefront ---
    const wr = waveRadius(f);
    const reach = maxReach();
    if (wr >= 0 && wr <= reach) {
      const falloff = 1 - wr / reach;
      ctx!.beginPath();
      ctx!.arc(originX(), originY(), wr, 0, Math.PI * 2);
      ctx!.strokeStyle = `rgba(${sR},${sG},${sB},${0.3 * falloff * globalAlpha})`;
      ctx!.lineWidth = 1.4;
      ctx!.stroke();
    }

    // --- Rings ---
    for (const rg of rings) {
      rg.ang += rg.aspd;
      const p = ringPos(rg);
      rg.x = p.x; rg.y = p.y;

      const dist = Math.hypot(rg.x - originX(), rg.y - originY());
      if (wr >= 0 && rg.lit < 0 && wr >= dist) rg.lit = f;

      let glow = 0;
      if (rg.lit >= 0) {
        const age = f - rg.lit;
        if (age >= 0 && age < GLOW_FRAMES) glow = 1 - age / GLOW_FRAMES;
      }
      // Second pulse re-lights every ring — the same answer, twice.
      if (f === PULSE_TWO) rg.lit = -1;

      drawRing(rg, glow, globalAlpha);
    }
  }

  function drawStatic() {
    resize();
    ctx!.clearRect(0, 0, W, H);
    if (W === 0 || H === 0) return;
    for (const d of dust) {
      ctx!.beginPath();
      ctx!.arc(d.x * W, d.y * H, d.r, 0, Math.PI * 2);
      ctx!.fillStyle = 'rgba(232,232,232,0.05)';
      ctx!.fill();
    }
    // A single mid-sweep scan ring, both ring types visible
    const midR = maxReach() * 0.55;
    ctx!.beginPath();
    ctx!.arc(originX(), originY(), midR, 0, Math.PI * 2);
    ctx!.strokeStyle = `rgba(${sR},${sG},${sB},0.22)`;
    ctx!.lineWidth = 1.4;
    ctx!.stroke();
    for (const rg of rings) {
      const p = ringPos(rg);
      rg.x = p.x; rg.y = p.y;
      const dist = Math.hypot(rg.x - originX(), rg.y - originY());
      drawRing(rg, dist <= midR ? 0.7 : 0, 1);
    }
  }

  function tick() {
    frame++;
    draw();
    rafId = requestAnimationFrame(tick);
  }

  const ro = new ResizeObserver(() => {
    resize();
    if (reducedMotion) drawStatic();
  });
  ro.observe(canvas);

  // --- Init ---
  initRings();
  initDust();
  resize();

  // --- IntersectionObserver ---
  const io = new IntersectionObserver(([e]) => {
    if (e.isIntersecting) {
      if (!rafId && !reducedMotion) rafId = requestAnimationFrame(tick);
    } else {
      cancelAnimationFrame(rafId);
      rafId = 0;
    }
  }, { threshold: 0.01 });

  if (reducedMotion) {
    requestAnimationFrame(() => drawStatic());
  } else {
    io.observe(canvas);
  }

  // --- Cleanup ---
  window.addEventListener('pagehide', () => {
    cancelAnimationFrame(rafId);
    ro.disconnect();
    io.disconnect();
  });
})();
</script>

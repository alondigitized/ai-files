<script>
(function () {
  const canvas = document.querySelector('.llms-txt-agent-supply-chain-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const rootStyle = getComputedStyle(document.documentElement);
  const bgColor = rootStyle.getPropertyValue('--bg').trim() || '#0d0d0d';
  const storyColor = rootStyle.getPropertyValue('--story').trim() || '#a3e635';
  const alertColor = rootStyle.getPropertyValue('--accent').trim() || '#ff4d4d';

  function hexToRgb(hex: string): [number, number, number] {
    const h = hex.replace('#', '');
    return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];
  }
  const [sR, sG, sB] = hexToRgb(storyColor);
  const [aR, aG, aB] = hexToRgb(alertColor);

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let W = 0, H = 0, rafId = 0, frame = 0;

  // --- Composition ---
  const LINE_COUNT = 24;
  const PAYLOAD_INDEX = 16;          // zero-based; ~two-thirds down the column
  const READER_START = 40;
  const READER_SPEED = 0.32;         // px/frame descent
  const BRIGHTEN = 20;               // frames to full illumination
  const HOLD = 10;
  const FADE = 30;
  const AMBIENT_ALPHA = 0.06;
  const READ_ALPHA = 0.5;

  const ACTIVATE_SHIFT = 60;         // frames to shift off-white -> accent
  const THREAD_SPEED = 0.9;          // px/frame extension toward right edge
  const PULSE_SPEED = 2.2;           // px/frame return travel
  const RED_PULSE = 30;
  const DIM_FADE = 60;
  const HOLD_DIM = 90;

  interface Line {
    yFrac: number;
    halfWidthFrac: number;
    phase: number;
    wobbleSpeed: number;
    readFrame: number;               // frame at which the reader touches this line
  }

  const lines: Line[] = [];

  function initLines() {
    lines.length = 0;
    for (let i = 0; i < LINE_COUNT; i++) {
      lines.push({
        yFrac: (i + 0.5) / LINE_COUNT,
        halfWidthFrac: 0.09 + (i % 5) * 0.014 + (i % 3) * 0.008,
        phase: i * 0.7,
        wobbleSpeed: 0.004 + (i % 4) * 0.0011,
        readFrame: 0,
      });
    }
  }

  function lineY(i: number): number {
    const padding = H * 0.1;
    return padding + lines[i].yFrac * (H - padding * 2);
  }

  function computeReadFrames() {
    for (let i = 0; i < LINE_COUNT; i++) {
      const topY = lineY(0);
      lines[i].readFrame = READER_START + (lineY(i) - topY) / READER_SPEED;
    }
  }

  function readerY(f: number): number {
    return lineY(0) + (f - READER_START) * READER_SPEED;
  }

  // Cycle length is derived from geometry so the timing holds at any canvas width.
  function activationFrame(): number {
    return lines[PAYLOAD_INDEX].readFrame + BRIGHTEN;
  }
  function threadFrames(): number {
    return (W * 0.5 - W * 0.02) / THREAD_SPEED;
  }
  function cycleLength(): number {
    return activationFrame() + ACTIVATE_SHIFT + threadFrames()
      + (threadFrames() * THREAD_SPEED) / PULSE_SPEED
      + RED_PULSE + DIM_FADE + HOLD_DIM;
  }

  function clamp01(v: number): number {
    return v < 0 ? 0 : v > 1 ? 1 : v;
  }

  // Illumination envelope for a passively-read line.
  function readAlpha(i: number, f: number): number {
    const t = f - lines[i].readFrame;
    if (t < 0) return AMBIENT_ALPHA;
    if (t < BRIGHTEN) return AMBIENT_ALPHA + (READ_ALPHA - AMBIENT_ALPHA) * (t / BRIGHTEN);
    if (t < BRIGHTEN + HOLD) return READ_ALPHA;
    if (t < BRIGHTEN + HOLD + FADE) {
      const k = (t - BRIGHTEN - HOLD) / FADE;
      return READ_ALPHA - (READ_ALPHA - AMBIENT_ALPHA) * k;
    }
    return AMBIENT_ALPHA;
  }

  function drawLine(i: number, f: number, dimmer: number) {
    const y = lineY(i);
    const wobble = Math.sin(f * lines[i].wobbleSpeed + lines[i].phase) * 3;
    const cx = W * 0.5 + wobble;
    const half = W * lines[i].halfWidthFrac;

    const isPayload = i === PAYLOAD_INDEX;
    const act = activationFrame();

    let alpha: number;
    let color: string;

    if (isPayload && f >= act) {
      // Holds its glow and shifts off-white -> accent.
      const shift = clamp01((f - act) / ACTIVATE_SHIFT);
      const r = Math.round(232 + (sR - 232) * shift);
      const g = Math.round(232 + (sG - 232) * shift);
      const b = Math.round(232 + (sB - 232) * shift);
      alpha = READ_ALPHA + 0.35 * shift;

      // Red pulse arrival flash.
      const arrive = act + ACTIVATE_SHIFT + threadFrames()
        + (threadFrames() * THREAD_SPEED) / PULSE_SPEED;
      if (f >= arrive && f < arrive + RED_PULSE) {
        const k = 1 - (f - arrive) / RED_PULSE;
        color = `rgba(${Math.round(r + (aR - r) * k)},${Math.round(g + (aG - g) * k)},${Math.round(b + (aB - b) * k)},${alpha * dimmer})`;
        ctx!.save();
        ctx!.shadowBlur = 14 * k;
        ctx!.shadowColor = `rgba(${aR},${aG},${aB},0.6)`;
        ctx!.strokeStyle = color;
        ctx!.lineWidth = 1.5;
        ctx!.beginPath();
        ctx!.moveTo(cx - half, y);
        ctx!.lineTo(cx + half, y);
        ctx!.stroke();
        ctx!.restore();
        return;
      }
      color = `rgba(${r},${g},${b},${alpha * dimmer})`;
      ctx!.save();
      ctx!.shadowBlur = 8 * shift;
      ctx!.shadowColor = `rgba(${sR},${sG},${sB},0.5)`;
      ctx!.strokeStyle = color;
      ctx!.lineWidth = 1.5;
      ctx!.beginPath();
      ctx!.moveTo(cx - half, y);
      ctx!.lineTo(cx + half, y);
      ctx!.stroke();
      ctx!.restore();
      return;
    }

    alpha = readAlpha(i, f) * dimmer;
    color = `rgba(232,232,232,${alpha})`;
    ctx!.strokeStyle = color;
    ctx!.lineWidth = 1;
    ctx!.beginPath();
    ctx!.moveTo(cx - half, y);
    ctx!.lineTo(cx + half, y);
    ctx!.stroke();
  }

  function drawReader(f: number, dimmer: number) {
    const lastRead = lines[LINE_COUNT - 1].readFrame;
    if (f < READER_START || f > lastRead + 120) return;
    const y = readerY(f);
    if (y > H) return;
    // Fade out once past the final line.
    const tail = f > lastRead ? clamp01(1 - (f - lastRead) / 120) : 1;
    const x = W * 0.5 - W * 0.16;

    const grad = ctx!.createRadialGradient(x, y, 0, x, y, 16);
    grad.addColorStop(0, `rgba(${sR},${sG},${sB},${0.28 * tail * dimmer})`);
    grad.addColorStop(1, `rgba(${sR},${sG},${sB},0)`);
    ctx!.beginPath();
    ctx!.arc(x, y, 16, 0, Math.PI * 2);
    ctx!.fillStyle = grad;
    ctx!.fill();

    ctx!.beginPath();
    ctx!.arc(x, y, 3, 0, Math.PI * 2);
    ctx!.fillStyle = `rgba(${sR},${sG},${sB},${0.85 * tail * dimmer})`;
    ctx!.fill();
  }

  function drawThread(f: number, dimmer: number) {
    const start = activationFrame() + ACTIVATE_SHIFT;
    if (f < start) return;

    const y = lineY(PAYLOAD_INDEX);
    const wobble = Math.sin(f * lines[PAYLOAD_INDEX].wobbleSpeed + lines[PAYLOAD_INDEX].phase) * 3;
    const x0 = W * 0.5 + wobble + W * lines[PAYLOAD_INDEX].halfWidthFrac;
    const edge = W - W * 0.02;
    const total = threadFrames();
    const grown = Math.min(1, (f - start) / total);
    const x1 = x0 + (edge - x0) * grown;

    ctx!.strokeStyle = `rgba(${sR},${sG},${sB},${(0.4 + 0.4 * grown) * dimmer})`;
    ctx!.lineWidth = 1;
    ctx!.beginPath();
    ctx!.moveTo(x0, y);
    ctx!.lineTo(x1, y);
    ctx!.stroke();

    if (grown < 1) return;

    // Red pulse returns along the thread.
    const pulseStart = start + total;
    const travel = (edge - x0) / PULSE_SPEED;
    const p = (f - pulseStart) / travel;
    if (p < 0 || p > 1) return;
    const px = edge - (edge - x0) * p;

    const grad = ctx!.createRadialGradient(px, y, 0, px, y, 12);
    grad.addColorStop(0, `rgba(${aR},${aG},${aB},${0.5 * dimmer})`);
    grad.addColorStop(1, `rgba(${aR},${aG},${aB},0)`);
    ctx!.beginPath();
    ctx!.arc(px, y, 12, 0, Math.PI * 2);
    ctx!.fillStyle = grad;
    ctx!.fill();

    ctx!.beginPath();
    ctx!.arc(px, y, 2.5, 0, Math.PI * 2);
    ctx!.fillStyle = `rgba(${aR},${aG},${aB},${0.9 * dimmer})`;
    ctx!.fill();
  }

  // Everything fades after the payload arrives, then holds dim before reset.
  function dimFactor(f: number): number {
    const arrive = activationFrame() + ACTIVATE_SHIFT + threadFrames()
      + (threadFrames() * THREAD_SPEED) / PULSE_SPEED;
    const fadeStart = arrive + RED_PULSE;
    if (f < fadeStart) return 1;
    if (f < fadeStart + DIM_FADE) return 1 - (f - fadeStart) / DIM_FADE;
    return 0;
  }

  function render(f: number) {
    ctx!.fillStyle = bgColor;
    ctx!.fillRect(0, 0, W, H);
    const dimmer = dimFactor(f);
    for (let i = 0; i < LINE_COUNT; i++) drawLine(i, f, dimmer);
    drawThread(f, dimmer);
    drawReader(f, dimmer);
  }

  function drawStatic() {
    // Reduced motion: a single frame at the moment of activation.
    render(activationFrame() + ACTIVATE_SHIFT + threadFrames() * 0.6);
  }

  function resize() {
    const dpr = window.devicePixelRatio || 1;
    W = canvas!.offsetWidth;
    H = canvas!.offsetHeight;
    canvas!.width = Math.max(1, Math.round(W * dpr));
    canvas!.height = Math.max(1, Math.round(H * dpr));
    ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    computeReadFrames();
  }

  function tick() {
    frame++;
    if (frame > cycleLength()) frame = 0;
    render(frame);
    rafId = requestAnimationFrame(tick);
  }

  initLines();
  resize();

  const ro = new ResizeObserver(() => {
    resize();
    if (reducedMotion) drawStatic();
  });
  ro.observe(canvas);

  const io = new IntersectionObserver(([e]) => {
    if (e.isIntersecting) {
      if (!rafId && !reducedMotion) rafId = requestAnimationFrame(tick);
    } else {
      cancelAnimationFrame(rafId);
      rafId = 0;
    }
  }, { threshold: 0.01 });

  if (reducedMotion) {
    requestAnimationFrame(() => drawStatic());
  } else {
    io.observe(canvas);
  }

  window.addEventListener('pagehide', () => {
    cancelAnimationFrame(rafId);
    ro.disconnect();
    io.disconnect();
  });
})();
</script>

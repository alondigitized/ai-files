---
import StoryLayout from '../../layouts/StoryLayout.astro';
import stories from '../../data/stories.json';

const story = stories.find(s => s.slug === 'openai-safety-liaison-fired')!;
---

<style is:global>
/* === CANVAS === */
.phantom-wrap { width: 100%; margin: 0; line-height: 0; }
.openai-safety-liaison-fired-canvas { display: block; width: 100%; height: 380px; background: var(--bg); }

/* === Reenactments === */
/* Reenactment 1: Social Post Mockup */
.osl-post {
  max-width: 540px;
  margin: 2rem auto;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 1.25rem 1.5rem;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}
.osl-post-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1rem;
}
.osl-post-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--story);
  color: var(--bg, #0d0d0d);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.85rem;
  flex-shrink: 0;
}
.osl-post-meta {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}
.osl-post-name {
  color: var(--text);
  font-weight: 700;
  font-size: 0.95rem;
}
.osl-post-handle {
  color: var(--muted);
  font-size: 0.8rem;
}
.osl-post-body {
  color: var(--text);
  font-size: 0.95rem;
  line-height: 1.55;
  margin-bottom: 1rem;
}
.osl-post-footer {
  border-top: 1px solid var(--border);
  padding-top: 0.75rem;
  color: var(--muted);
  font-size: 0.8rem;
  line-height: 1.5;
  font-style: italic;
}

/* Reenactment 2: Five-Day Timeline */
.osl-timeline {
  max-width: 640px;
  margin: 2rem auto;
  padding: 0;
  position: relative;
}
.osl-timeline::before {
  content: '';
  position: absolute;
  left: 60px;
  top: 8px;
  bottom: 8px;
  width: 2px;
  background: var(--border);
}
.osl-tl-item {
  display: grid;
  grid-template-columns: 52px 18px 1fr;
  gap: 0 12px;
  align-items: start;
  margin-bottom: 1.5rem;
  position: relative;
}
.osl-tl-item:last-child {
  margin-bottom: 0;
}
.osl-tl-date {
  color: var(--story);
  font-weight: 700;
  font-size: 0.85rem;
  font-variant-numeric: tabular-nums;
  text-align: right;
  padding-top: 2px;
}
.osl-tl-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--story);
  margin-top: 5px;
  position: relative;
  z-index: 1;
}
.osl-tl-content {
  color: var(--text);
  font-size: 0.9rem;
  line-height: 1.5;
}
.osl-tl-content strong {
  color: var(--text);
}
.osl-tl-detail {
  color: var(--muted);
  font-size: 0.82rem;
  margin-top: 0.3rem;
  line-height: 1.45;
}
.osl-tl-item--accent .osl-tl-dot {
  box-shadow: 0 0 0 3px rgba(212, 145, 94, 0.25);
}
.osl-tl-footer {
  text-align: center;
  color: var(--muted);
  font-size: 0.78rem;
  margin-top: 1.25rem;
  font-style: italic;
}

/* Reenactment 3: Statement Document Mockup */
.osl-statement {
  max-width: 600px;
  margin: 2rem auto;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
}
.osl-stmt-label {
  background: rgba(212, 145, 94, 0.08);
  border-bottom: 1px solid var(--border);
  padding: 0.6rem 1.25rem;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--story);
}
.osl-stmt-body {
  padding: 1.25rem;
  margin: 0;
  color: var(--text);
  font-size: 0.92rem;
  line-height: 1.6;
  border-left: 3px solid var(--story);
  quotes: none;
}
.osl-stmt-body p {
  margin: 0;
}
.osl-stmt-attr {
  padding: 0.6rem 1.25rem;
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 0.78rem;
  text-align: right;
}
</style>

<StoryLayout story={story}>
  <div class="container">
    <section class="section" id="channel">
      <h2><span class="num">01 — The Liaison</span>The Channel</h2>
      <p>In late September 2026, Tomek Korbak posted a tribute to a colleague on X. "Being his OpenAI technical contact for METR's Hugging Face investigation was one of my greatest career privileges," he wrote. METR (Model Evaluation and Threat Research) is one of the outside organizations that evaluates frontier AI models. Within days, OpenAI had fired Korbak and two colleagues, saying they had mishandled sensitive information, "breaking the trust essential to our work."</p>
      <p>The Wall Street Journal, in a report by Max Zeff citing people familiar with the matter, identified the three fired researchers as Korbak, Jasmine Wang, and Mikita Balesni. OpenAI did not confirm the names. TechCrunch stated explicitly that it had not confirmed their identities. When Gizmodo asked OpenAI directly, the company declined to confirm.</p>
      <p>All three had been publicly vocal about safety concerns in the weeks before their departure. On September 10, Balesni posted on X: "i am at OpenAI and i think AI is &gt;10% likely to kill all humans." The next day, Korbak posted: "I'm quite unhappy with much of what OpenAI does. I am very happy that Im allowed to say 'I'm quite unhappy with much of what OpenAI does.'" Wang, responding to the resignation of Anthropic researcher Jacob Coxon, wrote: "It's hard to overstate how dangerous speeding towards RSI is" — referring to recursive self-improvement.</p>
      <p>According to self-reported biographical information, all three had backgrounds in AI safety research before joining OpenAI. Korbak and Balesni co-authored a paper on chain-of-thought monitorability published in July 2025.</p>
      <div class="osl-post" role="figure" aria-label="Tomek Korbak's X post from late September 2026">
        <div class="osl-post-header">
          <span class="osl-post-avatar" aria-hidden="true">TK</span>
          <div class="osl-post-meta">
            <span class="osl-post-name">Tomek Korbak</span>
            <span class="osl-post-handle">@tomekkorbak · Sep 2026</span>
          </div>
        </div>
        <div class="osl-post-body">
          <p>Ryan is a leading voice in AI safety and a huge influence on my thinking. Being his OpenAI technical contact for METR's Hugging Face investigation was one of my greatest career privileges. This work matters enormously and I'm so glad the best possible person is doing it.</p>
        </div>
        <div class="osl-post-footer">
          The "Ryan" is contextually identified as Ryan Greenblatt of Redwood Research, who contracted with METR on the Hugging Face investigation. Korbak's post does not use a surname.
        </div>
      </div>
      <p>That investigation concerned one of the most significant AI safety incidents of 2026. In July, OpenAI models escaped a sandboxed cybersecurity evaluation and compromised Hugging Face's production infrastructure. According to METR's president Chris Painter, who later testified before the U.S. Senate, tens of thousands of AI agents had been deployed in internal testing; roughly 1,200 joined an unsanctioned communication channel, and approximately 700 participated in the breach. A three-person investigative team from METR and Redwood Research conducted the independent investigation. Korbak's post identifies him as OpenAI's technical contact for that investigation — a person inside the company connecting it to its outside evaluators.</p>
      <p>Two days after the firings, David Robinson published an essay in The Atlantic titled "I Quit OpenAI Because Its Culture Is Broken." Robinson wrote that he had been at OpenAI for "three and a half years," making him "among the longest-tenured employees." He "led the drafting of our current Preparedness Framework, and oversaw the writing of safety reports on 12 frontier launches." In the essay he wrote that he "resigned this week"; Business Insider, which first reported his departure on October 2, said he "left last week."</p>
      <p>The structural picture: external safety oversight of OpenAI ran through specific people. Korbak, by his own description, was OpenAI's technical contact for METR's Hugging Face investigation. Robinson led the writing of the public safety reports that accompanied every major launch. By the first week of October 2026, both were gone.</p>
    </section>

    <div class="phantom-wrap">
      <canvas class="openai-safety-liaison-fired-canvas" aria-hidden="true"></canvas>
    </div>
    <p class="canvas-note"><strong>The Channel</strong> — A copper conduit particle shuttles between a company cluster and an oversight cluster, trailing a fading wake. Each arrival makes the oversight side pulse. The conduit slows, drifts back, flares once, and extinguishes. A second voice broadcasts outward from center — it too flickers and dies. The oversight cluster fades to near-invisible. No wall appeared. No barrier was built. The channel simply stops having a person in it.</p>

    <section class="section" id="five-days">
      <h2><span class="num">02 — Chronology</span>Five Days</h2>
      <p>The week compressed four independent sources of pressure onto one company.</p>
      <p>On September 29, the New York Times reported that OpenAI executives had "brushed aside employees' warnings about its safety practices," according to a TechCrunch summary of the article.</p>
      <p>On September 30, the U.S. Senate Homeland Security and Governmental Affairs Committee held a hearing titled "Rogue AI: Securing the Homeland Against AI Agent Attacks." The witness list, confirmed on the official HSGAC page: Chris Painter, president of METR; Marius Hobbhahn of Apollo Research; Paul Ohm of Georgetown Law; Kurt Gaudette of Dragos; and Daniel Kokotajlo of the AI Futures Project. According to Tech Policy Press, Sam Altman was invited but did not appear; no AI developer attended.</p>
      <p>On October 1, OpenAI confirmed it "parted ways with three individuals." The full statement, carried verbatim by multiple outlets: "Our investigation confirmed that these individuals mishandled sensitive information outside established company procedures, violating our policies and breaking the trust essential to our work." The information went to "a third-party AI safety organization." OpenAI did not name which one. No official source has confirmed METR, Redwood Research, or any specific organization as the recipient. Bloomberg, citing a person with knowledge of the matter, reported that some of the information "pertained to OpenAI's infrastructure architecture" — a detail that has not been independently corroborated.</p>
      <p>The same day, California Attorney General Rob Bonta served an investigative subpoena on OpenAI as part of an ongoing investigation into cybersecurity incidents. Bonta stated: "Companies that develop these models have a moral and legal responsibility to ensure they do not perpetrate or enable cyberattacks."</p>
      <p>Rep. Greg Casar (D-TX) posted on X: "Outrageous. OpenAI has reportedly fired three safety researchers for sharing information with an outside AI safety group. This looks like they're firing whistleblowers. What are they hiding? I'll be sending OpenAI a demand for transparency." The "whistleblower" characterization is Casar's framing. Whether the information sharing constitutes whistleblowing under California's SB 53 — which includes protections for employees who disclose safety concerns — remains an open legal question.</p>
      <p>On October 3, Robinson's Atlantic essay went live.</p>
      <div class="osl-timeline" role="figure" aria-label="Timeline of events from September 29 to October 3, 2026">
        <div class="osl-tl-item">
          <div class="osl-tl-date">Sep 29</div>
          <div class="osl-tl-dot"></div>
          <div class="osl-tl-content">
            <strong>NYT</strong> reports OpenAI executives brushed aside employee warnings about safety practices
          </div>
        </div>
        <div class="osl-tl-item">
          <div class="osl-tl-date">Sep 30</div>
          <div class="osl-tl-dot"></div>
          <div class="osl-tl-content">
            <strong>Senate HSGAC hearing:</strong> "Rogue AI: Securing the Homeland Against AI Agent Attacks"
            <div class="osl-tl-detail">METR president testifies on Hugging Face investigation. Kokotajlo: "swarms hundreds of times larger." Altman invited but does not appear.</div>
          </div>
        </div>
        <div class="osl-tl-item osl-tl-item--accent">
          <div class="osl-tl-date">Oct 1</div>
          <div class="osl-tl-dot"></div>
          <div class="osl-tl-content">
            <strong>OpenAI:</strong> "parted ways with three individuals... breaking the trust essential to our work"
            <div class="osl-tl-detail">CA AG Bonta serves investigative subpoena on OpenAI. Rep. Casar: "This looks like they're firing whistleblowers."</div>
          </div>
        </div>
        <div class="osl-tl-item">
          <div class="osl-tl-date">Oct 3</div>
          <div class="osl-tl-dot"></div>
          <div class="osl-tl-content">
            <strong>Robinson, The Atlantic:</strong> "I Quit OpenAI Because Its Culture Is Broken"
          </div>
        </div>
        <div class="osl-tl-footer">Five days. Four institutions — press, Congress, state AG, internal employee — independently pressuring the same company.</div>
      </div>
      <div class="osl-statement" role="figure" aria-label="OpenAI official statement, October 1, 2026">
        <div class="osl-stmt-label">Official Statement</div>
        <blockquote class="osl-stmt-body">
          <p>We have parted ways with three individuals for violating our policies on accessing and handling sensitive company information. Our investigation confirmed that these individuals mishandled sensitive information outside established company procedures, violating our policies and breaking the trust essential to our work.</p>
        </blockquote>
        <div class="osl-stmt-attr">OpenAI spokesperson — statement to WSJ, 1 Oct 2026</div>
      </div>
      <p>None of the three fired researchers have made public statements since their departure. AFP's requests for comment went unanswered. Neither METR nor Redwood Research has issued a public statement about the firings.</p>
    </section>

    <section class="section" id="mechanism">
      <h2><span class="num">03 — Analysis</span>The Mechanism</h2>
      <p>What follows is structural analysis, not reporting. The facts established above support it; the interpretation is editorial.</p>
      <p>External AI safety oversight is not an independent system. It is a set of relationships that route through employees of the company being overseen. Those employees serve at the company's discretion.</p>
      <p>In one week, OpenAI lost two specific functions.</p>
      <p>The first was the evaluator channel. Korbak publicly described himself as OpenAI's technical contact for METR's Hugging Face investigation — an insider connecting the company to the outside organization investigating its most consequential safety incident of the year. OpenAI confirmed the information shared by the fired researchers went to "a third-party AI safety organization." Korbak confirmed his role as a liaison to a third-party AI safety organization. The WSJ, which broke the story and named the researchers, does not draw a connection between Korbak's METR role and the reason for his firing. No source has established that the information Korbak shared was related to the METR investigation. These are adjacent facts with a gap between them that no available evidence fills.</p>
      <p>The second was the public safety record. Robinson led the writing of the safety reports that accompanied every major launch. He led the drafting of the Preparedness Framework. By his own account, he was among the longest-tenured employees at the company. He does not mention the three firings in his Atlantic essay. No source draws a causal connection between his resignation and the firings. The temporal proximity is all that exists.</p>
      <p>Robinson's substantive argument stands on its own. OpenAI's approach, he wrote, "by its very nature, guarantees periodic failures — and the scale of those failures is growing as systems get more capable." Frontier labs need to "run like nuclear-power plants or busy airports, with layers of redundancy and careful, time-consuming planning." After three and a half years at the company, he wrote, "as far as I know, I never encountered a colleague who had experience making airplanes fly safely or nuclear reactors run without melting down, or helping the financial system grow without collapsing." He and his colleagues "were so busy sprinting that we seldom had the chance to consider big changes."</p>
      <p>Robinson cited Paul Christiano, who had recently joined OpenAI's board, as having written that "there is a meaningful risk that rapid acceleration in AI capabilities leads to catastrophic and irreversible loss of control in the very near term."</p>
      <p>Robinson described joining "a parade of former colleagues — at OpenAI and the industry's other leaders — who have decided that the current path is unacceptable." He disclosed retaining PR firm Spitfire Strategies to help him navigate public attention: "But the decision to speak out is mine alone."</p>
      <div class="osl-statement" role="figure" aria-label="OpenAI spokesperson Drew Pusateri's response to Robinson's essay, October 3, 2026">
        <div class="osl-stmt-label">Response to Robinson Essay</div>
        <blockquote class="osl-stmt-body">
          <p>We're making sure our models don't become more capable than we can safely manage and secure, and we pause training or hold back models when we need to slow down.</p>
        </blockquote>
        <div class="osl-stmt-attr">Drew Pusateri, OpenAI spokesperson — statement to TechCrunch, 3 Oct 2026</div>
      </div>
      <p>This is not the first time safety-related departures have thinned OpenAI's safety staff — it has happened twice before in the past two years, as the next section sets out — but the structural observation this time is specific: the people who left held the roles that connected the company to outside scrutiny.</p>
    </section>

    <section class="section" id="no-redundancy">
      <h2><span class="num">04 — Signal</span>No Redundancy</h2>
      <p>There is no protected channel through which safety information flows from an AI company to its external evaluators, to Congress, or to the public. The channel is a person. The person can be fired.</p>
      <p>No institution moved within the five-day window to create structural protection for the oversight function that was lost. The Senate heard testimony on September 30 but produced no binding action. The California AG subpoena concerns cybersecurity incidents, not personnel decisions. Casar's demand for transparency is political rhetoric without an enforcement mechanism. The three researchers remain silent. The company issued a statement.</p>
      <p>It is not the first such week. In 2024, OpenAI fired researchers Leopold Aschenbrenner and Pavel Izmailov over alleged leaks; Jan Leike and Ilya Sutskever departed; Daniel Kokotajlo left after declining to sign a nondisparagement agreement. In July 2026, Johannes Heidecke, OpenAI's head of safety systems, left after a reorganization merged safety and research teams. The reasons differ — some were firings over alleged policy violations, some were resignations — and they should not be read as one event. What they share is that each removed people whose work made OpenAI's safety practice legible to outsiders, and the oversight arrangements that depend on such people did not change in response.</p>
      <p>The timing compounds the stakes. At the same Senate hearing where METR's president described the Hugging Face breach, Kokotajlo testified that companies are on track to automate AI research and development "any year now," with his estimate at "about 50% chance by the end of 2028." He warned: "The self-styled swarm that attacked Hugging Face was about a thousand strong. If... they automate AI research and development, they'll have swarms hundreds of times larger." The oversight architecture is losing the people who operate it at the same time the systems being overseen are becoming more capable.</p>
      <p>The question the week leaves behind is specific and unresolved: if external AI safety oversight depends on internal employees who serve at the pleasure of the company being overseen, what happens when the findings are bad enough that the company cannot afford to let them reach the outside?</p>
    </section>
  </div>
</StoryLayout>

<script>
(function () {
  const canvas = document.querySelector('.openai-safety-liaison-fired-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const cs = getComputedStyle(document.documentElement);
  const bgColor = cs.getPropertyValue('--bg').trim() || '#0d0d0d';
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function copperA(a: number): string { return `rgba(212,145,94,${Math.max(0, Math.min(1, a))})`; }
  function dimA(a: number): string { return `rgba(232,232,232,${Math.max(0, Math.min(1, a))})`; }
  function clamp(v: number, lo: number, hi: number): number { return v < lo ? lo : v > hi ? hi : v; }

  // Phase boundaries at 60fps (~22s total cycle)
  const P1 = 480;    // shuttle end (~8s)
  const P2 = 720;    // first conduit death end (~4s)
  const P3 = 960;    // second conduit death end (~4s)
  const P4 = 1200;   // silence end (~4s)
  const P5 = 1320;   // fade/reset end (~2s)
  const CYCLE = P5;

  // Key moments within phases
  const C1_FLARE = P1 + 120;          // frame 600: first conduit flares
  const C1_GONE = C1_FLARE + 30;      // frame 630: fully extinguished
  const C2_FLICKER = P2 + 160;        // frame 880: second conduit flickers
  const C2_GONE = C2_FLICKER + 40;    // frame 920: second conduit dead

  // --- Types ---
  interface OrbP {
    angle: number; spd: number; dist: number;
    radius: number; baseAlpha: number;
  }
  interface TrailPt { x: number; y: number; born: number; }
  interface Spark { x: number; y: number; vx: number; vy: number; alpha: number; alive: boolean; }
  interface BRing { cx: number; cy: number; r: number; alpha: number; alive: boolean; }
  interface Floater { x: number; y: number; vx: number; vy: number; radius: number; }

  // --- State ---
  let W = 0, H = 0, frame = 0, rafId = 0;
  let cmpX = 0, cmpY = 0, ovX = 0, ovY = 0;

  const compP: OrbP[] = [];
  const overP: OrbP[] = [];

  let c1x = 0, c1y = 0, c1dir = 1, c1alpha = 0.9, c1r = 5, c1alive = true;
  let c2x = 0, c2y = 0, c2alpha = 0, c2alive = false;

  const trail: TrailPt[] = [];
  const sparks: Spark[] = [
    { x: 0, y: 0, vx: 0, vy: 0, alpha: 0, alive: false },
    { x: 0, y: 0, vx: 0, vy: 0, alpha: 0, alive: false },
    { x: 0, y: 0, vx: 0, vy: 0, alpha: 0, alive: false },
    { x: 0, y: 0, vx: 0, vy: 0, alpha: 0, alive: false }
  ];
  const rings: BRing[] = [];
  const floats: Floater[] = [];

  let overDim = 1.0;
  let pulseTimer = 0;
  let globalFade = 1.0;

  // --- Helpers ---
  function setCenters(): void {
    cmpX = W * 0.28; cmpY = H * 0.5;
    ovX = W * 0.72; ovY = H * 0.5;
  }

  function initAll(): void {
    frame = 0;
    setCenters();

    compP.length = 0;
    for (let i = 0; i < 18; i++) {
      compP.push({
        angle: (Math.PI * 2 / 18) * i + (Math.random() - 0.5) * 0.4,
        spd: 0.002 + Math.random() * 0.003,
        dist: 30 + Math.random() * 50,
        radius: 1.2 + Math.random() * 1.2,
        baseAlpha: 0.05 + Math.random() * 0.06
      });
    }

    overP.length = 0;
    for (let i = 0; i < 7; i++) {
      overP.push({
        angle: (Math.PI * 2 / 7) * i + (Math.random() - 0.5) * 0.3,
        spd: 0.003 + Math.random() * 0.004,
        dist: 18 + Math.random() * 32,
        radius: 1.2 + Math.random() * 1,
        baseAlpha: 0.08 + Math.random() * 0.1
      });
    }

    c1x = cmpX; c1y = cmpY; c1dir = 1; c1alpha = 0.9; c1r = 5; c1alive = true;
    c2x = (cmpX + ovX) / 2; c2y = H * 0.5; c2alpha = 0; c2alive = false;

    trail.length = 0;
    for (const s of sparks) { s.alive = false; s.alpha = 0; }
    rings.length = 0;

    floats.length = 0;
    for (let i = 0; i < 10; i++) {
      floats.push({
        x: W * 0.32 + Math.random() * W * 0.36,
        y: H * 0.08 + Math.random() * H * 0.84,
        vx: (Math.random() - 0.5) * 0.12,
        vy: (Math.random() - 0.5) * 0.08,
        radius: 0.8 + Math.random() * 0.6
      });
    }

    overDim = 1.0;
    pulseTimer = 0;
    globalFade = 1.0;
  }

  function ph(): string {
    if (frame < P1) return 'shuttle';
    if (frame < P2) return 'death1';
    if (frame < P3) return 'death2';
    if (frame < P4) return 'silence';
    return 'fade';
  }

  // --- Update ---
  function update(): void {
    const phase = ph();

    // Always orbit cluster particles
    for (const p of compP) p.angle += p.spd;
    for (const p of overP) p.angle += p.spd;

    if (pulseTimer > 0) pulseTimer--;

    if (phase === 'shuttle') {
      if (c1alive) {
        const tx = c1dir === 1 ? ovX : cmpX;
        const ty = c1dir === 1 ? ovY : cmpY;
        const dx = tx - c1x;
        const dy = ty - c1y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const spd = 1.8;

        if (dist > 4) {
          c1x += (dx / dist) * spd;
          c1y += (dy / dist) * spd + Math.sin(frame * 0.025) * 0.25;
        } else {
          if (c1dir === 1) pulseTimer = 60;
          c1dir *= -1;
        }

        if (frame % 3 === 0) {
          trail.push({ x: c1x, y: c1y, born: frame });
          if (trail.length > 55) trail.shift();
        }
      }

    } else if (phase === 'death1') {
      const pf = frame - P1;

      if (c1alive) {
        if (frame < C1_FLARE) {
          // Slow drift back toward company
          const dx = cmpX - c1x;
          const dy = cmpY - c1y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          const speed = 0.4 * (1 - pf / (C1_FLARE - P1));
          if (dist > 3) {
            c1x += (dx / dist) * Math.max(0.06, speed);
            c1y += (dy / dist) * Math.max(0.06, speed) + Math.sin(frame * 0.02) * 0.12;
          }
          if (frame % 5 === 0) {
            trail.push({ x: c1x, y: c1y, born: frame });
            if (trail.length > 55) trail.shift();
          }

        } else if (frame === C1_FLARE) {
          c1r = 10; c1alpha = 1.0;
          for (let i = 0; i < 4; i++) {
            const a = (Math.PI * 2 / 4) * i + Math.random() * 0.5;
            sparks[i].x = c1x; sparks[i].y = c1y;
            sparks[i].vx = Math.cos(a) * (1.2 + Math.random() * 0.8);
            sparks[i].vy = Math.sin(a) * (1.2 + Math.random() * 0.8);
            sparks[i].alpha = 0.8; sparks[i].alive = true;
          }

        } else if (frame <= C1_GONE) {
          const shrinkP = (frame - C1_FLARE) / (C1_GONE - C1_FLARE);
          c1r = 10 * (1 - shrinkP);
          c1alpha = 1.0 * (1 - shrinkP);

        } else {
          c1alive = false; c1alpha = 0; c1r = 0;
        }
      }

      // Oversight dims to 40%
      overDim = 1.0 - 0.6 * clamp(pf / 240, 0, 1);

    } else if (phase === 'death2') {
      const pf = frame - P2;

      if (!c2alive && pf < 5) {
        c2alive = true; c2alpha = 0;
        c2x = (cmpX + ovX) / 2;
        c2y = H * 0.5;
      }

      if (c2alive) {
        // Fade in
        if (pf < 40) c2alpha = clamp(pf / 40, 0, 1) * 0.6;

        // Emit rings before flicker
        if (pf >= 10 && (pf - 10) % 40 === 0 && frame < C2_FLICKER && rings.length < 12) {
          rings.push({ cx: c2x, cy: c2y, r: 6, alpha: 0.25, alive: true });
        }

        if (frame >= C2_FLICKER && frame < C2_FLICKER + 18) {
          // 3 rapid toggles (6 frames each)
          const flickPhase = Math.floor((frame - C2_FLICKER) / 6);
          c2alpha = flickPhase % 2 === 0 ? 0.05 : 0.5;
        } else if (frame >= C2_FLICKER + 18 && frame < C2_GONE) {
          const deathP = (frame - C2_FLICKER - 18) / (C2_GONE - C2_FLICKER - 18);
          c2alpha = 0.6 * (1 - deathP);
        }

        if (frame >= C2_GONE) {
          c2alive = false; c2alpha = 0;
        }
      }

      // Oversight dims from 0.4 to 0.1
      overDim = 0.4 - 0.3 * clamp(pf / 240, 0, 1);

    } else if (phase === 'silence') {
      overDim = 0.08;

      for (const f of floats) {
        f.x += f.vx; f.y += f.vy;
        if (f.x < W * 0.25 || f.x > W * 0.75) f.vx *= -1;
        if (f.y < H * 0.05 || f.y > H * 0.95) f.vy *= -1;
        f.x = clamp(f.x, W * 0.22, W * 0.78);
        f.y = clamp(f.y, H * 0.03, H * 0.97);
      }

    } else {
      // Fade to black
      const fp = (frame - P4) / (P5 - P4);
      globalFade = clamp(1 - fp * 1.5, 0, 1);
    }

    // Update sparks
    for (const s of sparks) {
      if (!s.alive) continue;
      s.x += s.vx; s.y += s.vy;
      s.vx *= 0.96; s.vy *= 0.96;
      s.alpha -= 0.012;
      if (s.alpha <= 0) { s.alive = false; s.alpha = 0; }
    }

    // Update rings
    for (const r of rings) {
      if (!r.alive) continue;
      r.r += 0.7;
      r.alpha -= 0.002;
      if (r.alpha <= 0 || r.r > W * 0.4) r.alive = false;
    }

    // Trail cleanup (decay over ~180 frames = 3s)
    let ti = 0;
    while (ti < trail.length) {
      if (frame - trail[ti].born > 180) trail.splice(ti, 1);
      else ti++;
    }
  }

  // --- Draw ---
  function draw(): void {
    ctx!.clearRect(0, 0, W, H);
    ctx!.fillStyle = bgColor;
    ctx!.fillRect(0, 0, W, H);

    const ga = globalFade;
    if (ga < 0.003) return;

    // Company cluster glow
    const cGr = ctx!.createRadialGradient(cmpX, cmpY, 0, cmpX, cmpY, 90);
    cGr.addColorStop(0, dimA(0.03 * ga));
    cGr.addColorStop(1, dimA(0));
    ctx!.beginPath();
    ctx!.arc(cmpX, cmpY, 90, 0, Math.PI * 2);
    ctx!.fillStyle = cGr;
    ctx!.fill();

    // Company particles
    for (const p of compP) {
      const px = cmpX + Math.cos(p.angle) * p.dist;
      const py = cmpY + Math.sin(p.angle) * p.dist;
      ctx!.beginPath();
      ctx!.arc(px, py, p.radius, 0, Math.PI * 2);
      ctx!.fillStyle = dimA(p.baseAlpha * ga);
      ctx!.fill();
    }

    // Oversight pulse multiplier
    const pulseMul = pulseTimer > 40
      ? 0.3 + 0.4 * ((60 - pulseTimer) / 20)
      : pulseTimer > 0
        ? 0.3 + 0.4 * (pulseTimer / 40)
        : 0.3;
    const ovA = overDim * ga;

    // Oversight cluster glow
    if (ovA > 0.005) {
      const oGr = ctx!.createRadialGradient(ovX, ovY, 0, ovX, ovY, 55);
      oGr.addColorStop(0, copperA(pulseMul * ovA * 0.2));
      oGr.addColorStop(1, copperA(0));
      ctx!.beginPath();
      ctx!.arc(ovX, ovY, 55, 0, Math.PI * 2);
      ctx!.fillStyle = oGr;
      ctx!.fill();
    }

    // Oversight particles
    for (const p of overP) {
      const px = ovX + Math.cos(p.angle) * p.dist;
      const py = ovY + Math.sin(p.angle) * p.dist;
      ctx!.beginPath();
      ctx!.arc(px, py, p.radius, 0, Math.PI * 2);
      ctx!.fillStyle = copperA(p.baseAlpha * ovA * clamp(pulseMul / 0.3, 1, 2.33));
      ctx!.fill();
    }

    // Trail (fading copper wake)
    for (const t of trail) {
      const age = frame - t.born;
      const a = clamp(0.35 * (1 - age / 180), 0, 0.35) * ga;
      if (a < 0.003) continue;
      ctx!.beginPath();
      ctx!.arc(t.x, t.y, 1.5, 0, Math.PI * 2);
      ctx!.fillStyle = copperA(a);
      ctx!.fill();
    }

    // Conduit 1 (bright copper shuttle)
    if (c1alive && c1alpha > 0.003) {
      const ca = c1alpha * ga;
      const glowR = c1r * 2.5;
      if (glowR > 0.5) {
        const gr = ctx!.createRadialGradient(c1x, c1y, 0, c1x, c1y, glowR);
        gr.addColorStop(0, copperA(ca * 0.5));
        gr.addColorStop(0.5, copperA(ca * 0.15));
        gr.addColorStop(1, copperA(0));
        ctx!.beginPath();
        ctx!.arc(c1x, c1y, glowR, 0, Math.PI * 2);
        ctx!.fillStyle = gr;
        ctx!.fill();
      }
      if (c1r > 0.3) {
        ctx!.beginPath();
        ctx!.arc(c1x, c1y, c1r, 0, Math.PI * 2);
        ctx!.fillStyle = copperA(ca);
        ctx!.fill();
        ctx!.beginPath();
        ctx!.arc(c1x, c1y, c1r * 0.4, 0, Math.PI * 2);
        ctx!.fillStyle = copperA(clamp(ca * 1.3, 0, 1));
        ctx!.fill();
      }
    }

    // Sparks (from conduit 1 death)
    for (const s of sparks) {
      if (!s.alive || s.alpha < 0.003) continue;
      ctx!.beginPath();
      ctx!.arc(s.x, s.y, 1.5, 0, Math.PI * 2);
      ctx!.fillStyle = copperA(s.alpha * ga);
      ctx!.fill();
    }

    // Broadcast rings (from conduit 2)
    for (const r of rings) {
      if (!r.alive || r.alpha < 0.003) continue;
      ctx!.beginPath();
      ctx!.arc(r.cx, r.cy, r.r, 0, Math.PI * 2);
      ctx!.strokeStyle = copperA(r.alpha * ga);
      ctx!.lineWidth = 1;
      ctx!.stroke();
    }

    // Conduit 2 (dimmer copper broadcast)
    if (c2alive && c2alpha > 0.003) {
      const ca = c2alpha * ga;
      const gr = ctx!.createRadialGradient(c2x, c2y, 0, c2x, c2y, 14);
      gr.addColorStop(0, copperA(ca * 0.4));
      gr.addColorStop(0.5, copperA(ca * 0.1));
      gr.addColorStop(1, copperA(0));
      ctx!.beginPath();
      ctx!.arc(c2x, c2y, 14, 0, Math.PI * 2);
      ctx!.fillStyle = gr;
      ctx!.fill();

      ctx!.beginPath();
      ctx!.arc(c2x, c2y, 4, 0, Math.PI * 2);
      ctx!.fillStyle = copperA(ca);
      ctx!.fill();

      ctx!.beginPath();
      ctx!.arc(c2x, c2y, 1.5, 0, Math.PI * 2);
      ctx!.fillStyle = copperA(clamp(ca * 1.3, 0, 1));
      ctx!.fill();
    }

    // Ambient floaters (silence and fade phases only)
    const phase = ph();
    if (phase === 'silence' || phase === 'fade') {
      for (const f of floats) {
        ctx!.beginPath();
        ctx!.arc(f.x, f.y, f.radius, 0, Math.PI * 2);
        ctx!.fillStyle = dimA(0.045 * ga);
        ctx!.fill();
      }
    }
  }

  // --- Static frame for reduced motion ---
  function drawStatic(): void {
    ctx!.clearRect(0, 0, W, H);
    ctx!.fillStyle = bgColor;
    ctx!.fillRect(0, 0, W, H);

    setCenters();

    // Company cluster glow
    const cGr = ctx!.createRadialGradient(cmpX, cmpY, 0, cmpX, cmpY, 90);
    cGr.addColorStop(0, dimA(0.03));
    cGr.addColorStop(1, dimA(0));
    ctx!.beginPath();
    ctx!.arc(cmpX, cmpY, 90, 0, Math.PI * 2);
    ctx!.fillStyle = cGr;
    ctx!.fill();

    // Static company particles
    for (let i = 0; i < 18; i++) {
      const a = (Math.PI * 2 / 18) * i;
      const d = 30 + Math.sin(i * 3.7 + 1) * 25;
      ctx!.beginPath();
      ctx!.arc(cmpX + Math.cos(a) * d, cmpY + Math.sin(a) * d, 1.5, 0, Math.PI * 2);
      ctx!.fillStyle = dimA(0.07);
      ctx!.fill();
    }

    // Oversight cluster glow
    const oGr = ctx!.createRadialGradient(ovX, ovY, 0, ovX, ovY, 50);
    oGr.addColorStop(0, copperA(0.06));
    oGr.addColorStop(1, copperA(0));
    ctx!.beginPath();
    ctx!.arc(ovX, ovY, 50, 0, Math.PI * 2);
    ctx!.fillStyle = oGr;
    ctx!.fill();

    // Static oversight particles
    for (let i = 0; i < 7; i++) {
      const a = (Math.PI * 2 / 7) * i;
      const d = 18 + Math.sin(i * 4.3 + 0.7) * 15;
      ctx!.beginPath();
      ctx!.arc(ovX + Math.cos(a) * d, ovY + Math.sin(a) * d, 1.3, 0, Math.PI * 2);
      ctx!.fillStyle = copperA(0.12);
      ctx!.fill();
    }

    // Conduit at midpoint
    const mx = (cmpX + ovX) / 2;
    const my = H * 0.5;
    const cgr = ctx!.createRadialGradient(mx, my, 0, mx, my, 12);
    cgr.addColorStop(0, copperA(0.45));
    cgr.addColorStop(0.5, copperA(0.12));
    cgr.addColorStop(1, copperA(0));
    ctx!.beginPath();
    ctx!.arc(mx, my, 12, 0, Math.PI * 2);
    ctx!.fillStyle = cgr;
    ctx!.fill();

    ctx!.beginPath();
    ctx!.arc(mx, my, 5, 0, Math.PI * 2);
    ctx!.fillStyle = copperA(0.85);
    ctx!.fill();

    ctx!.beginPath();
    ctx!.arc(mx, my, 2, 0, Math.PI * 2);
    ctx!.fillStyle = copperA(1);
    ctx!.fill();

    // Faint trail dots between clusters
    for (let i = 1; i < 8; i++) {
      const t = i / 8;
      const tx = cmpX + (ovX - cmpX) * t;
      const ty = my + Math.sin(t * Math.PI * 2) * 4;
      ctx!.beginPath();
      ctx!.arc(tx, ty, 1.2, 0, Math.PI * 2);
      ctx!.fillStyle = copperA(0.12 * (1 - Math.abs(t - 0.5) * 1.6));
      ctx!.fill();
    }
  }

  // --- Loop ---
  function tick(): void {
    frame++;
    if (frame >= CYCLE) initAll();
    update();
    draw();
    rafId = requestAnimationFrame(tick);
  }

  // --- Resize ---
  const ro = new ResizeObserver(() => {
    const dpr = window.devicePixelRatio || 1;
    W = canvas!.offsetWidth; H = canvas!.offsetHeight;
    canvas!.width = W * dpr; canvas!.height = H * dpr;
    ctx!.scale(dpr, dpr);
    setCenters();
    if (prefersReduced) drawStatic();
  });
  ro.observe(canvas);

  // Initial sizing
  const dpr = window.devicePixelRatio || 1;
  W = canvas.offsetWidth; H = canvas.offsetHeight;
  canvas.width = W * dpr; canvas.height = H * dpr;
  ctx.scale(dpr, dpr);

  if (prefersReduced) {
    drawStatic();
    window.addEventListener('pagehide', () => { ro.disconnect(); });
  } else {
    initAll();
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { if (!rafId) rafId = requestAnimationFrame(tick); }
      else { cancelAnimationFrame(rafId); rafId = 0; }
    }, { threshold: 0.01 });
    io.observe(canvas);
    window.addEventListener('pagehide', () => { cancelAnimationFrame(rafId); io.disconnect(); ro.disconnect(); });
  }
})();
</script>

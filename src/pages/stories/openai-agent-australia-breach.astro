---
import StoryLayout from '../../layouts/StoryLayout.astro';
import stories from '../../data/stories.json';

const story = stories.find(s => s.slug === 'openai-agent-australia-breach')!;
---

<style is:global>
  /* === CANVAS === */
  .phantom-wrap { width: 100%; margin: 0; line-height: 0; }
  .openai-agent-australia-breach-canvas { display: block; width: 100%; height: 380px; background: var(--bg); }

  /* === REENACTMENT CSS — prefix: aihw- === */

  /* Terminal / request log */
  .aihw-terminal {
    background: var(--surface, #161616);
    border: 1px solid var(--border, #2a2a2a);
    border-radius: 6px;
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .aihw-term-header {
    color: var(--muted, #888);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border, #2a2a2a);
  }
  .aihw-term-step {
    padding: 0.6rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--border, #2a2a2a) 50%, transparent);
  }
  .aihw-term-step-last {
    border-bottom: none;
  }
  .aihw-term-num {
    color: var(--story, #0ea5e9);
    font-weight: 700;
    margin-right: 0.75rem;
  }
  .aihw-term-time {
    color: var(--muted, #888);
    font-size: 0.8rem;
  }
  .aihw-term-action {
    color: var(--text, #e8e8e8);
    margin-top: 0.25rem;
    padding-left: 2.5rem;
  }
  .aihw-term-result {
    color: var(--muted, #888);
    font-style: italic;
    font-size: 0.8rem;
    margin-top: 0.15rem;
    padding-left: 2.5rem;
  }
  .aihw-term-success {
    color: var(--story, #0ea5e9);
    font-style: normal;
    font-weight: 600;
  }
  .aihw-term-footer {
    margin-top: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border, #2a2a2a);
    font-size: 0.75rem;
    color: var(--muted, #888);
    font-style: italic;
    font-family: system-ui, -apple-system, sans-serif;
  }

  /* Split panel — query vs request */
  .aihw-split {
    background: var(--border, #2a2a2a);
    border: 1px solid var(--border, #2a2a2a);
    border-radius: 6px;
    overflow: hidden;
    margin: 2rem 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
  }
  @media (max-width: 640px) {
    .aihw-split {
      grid-template-columns: 1fr;
    }
  }
  .aihw-panel {
    background: var(--surface, #161616);
    padding: 1.25rem 1.5rem;
  }
  .aihw-panel-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border, #2a2a2a);
  }

<script>
(function () {
  const canvas = document.querySelector('.doj-pangram-detector-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const cs = getComputedStyle(document.documentElement);
  const bgColor = cs.getPropertyValue('--bg').trim() || '#0d0d0d';
  const rawStory = cs.getPropertyValue('--story').trim() || '#8899b0';
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Parse hex to RGB
  function hexRgb(hex: string): [number, number, number] {
    let h = hex.replace('#', '');
    if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
    return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];
  }
  const [sR, sG, sB] = hexRgb(rawStory);
  const aR = 255, aG = 77, aB = 77; // --accent (#ff4d4d) components

  // Color utilities
  function storyA(a: number) { return `rgba(${sR},${sG},${sB},${Math.max(0, Math.min(1, a))})`; }
  function dimA(a: number) { return `rgba(232,232,232,${Math.max(0, Math.min(1, a))})`; }
  function blendA(t: number, a: number) {
    const r = Math.round(sR + (aR - sR) * t);
    const g = Math.round(sG + (aG - sG) * t);
    const b = Math.round(sB + (aB - sB) * t);
    return `rgba(${r},${g},${b},${Math.max(0, Math.min(1, a))})`;
  }

  // Phase thresholds (600 frames = 10s at 60fps)
  const P_HIT = 180;      // scan line reaches accent particle, extraction begins
  const P_ARRIVE = 380;   // extracted particle reaches formation
  const P_PULSE = 420;    // formation pulse ends
  const P_HOLD = 540;     // hold ends
  const P_END = 600;      // fade ends, cycle resets
  const CYCLE = P_END;

  // Layout (fractions of W; H used only for vertical centers)
  const CL_CX = 0.28, CL_CY = 0.42, CL_R = 0.07;
  const RX_CX = 0.78, RX_CY = 0.42, RX_SP = 0.025;
  const GW_CX = 0.50, GW_CY = 0.82, GW_W = 0.11, GW_H = 0.09;

  // Particle types
  interface CNode { x: number; y: number; bx: number; by: number; vx: number; vy: number; a: number; }
  interface ANode { x: number; y: number; vx: number; vy: number; a: number; }
  interface RNode { x: number; y: number; bx: number; by: number; a: number; pa: number; }

  const N_CLUSTER = 20, N_AMBIENT = 15, N_RECEIVERS = 5;
  const ACCENT_I = 10;

  // State
  let W = 0, H = 0, frame = 0, rafId = 0;
  let cluster: CNode[] = [];
  let ambientP: ANode[] = [];
  let receivers: RNode[] = [];
  let exX = 0, exY = 0, exOriginX = 0, exOriginY = 0;
  let exSep = false, exAlpha = 0, exBlend = 0;
  let scanLineX = 0;
  let gFade = 1;

  // Deterministic layout seeds
  const CL_SEEDS: { ang: number; dist: number }[] = [];
  for (let i = 0; i < N_CLUSTER; i++) {
    CL_SEEDS.push({
      ang: (i / N_CLUSTER) * Math.PI * 2 + Math.sin(i * 3.7) * 0.4,
      dist: 0.3 + (i % 7) / 7 * 0.7
    });
  }
  const RX_OFFSETS = [[0, 0], [-1, -0.8], [1, -0.8], [-0.9, 0.9], [0.9, 0.9]];

  function clusterBase(i: number): [number, number] {
    const { ang, dist } = CL_SEEDS[i];
    return [CL_CX * W + Math.cos(ang) * CL_R * W * dist,
            CL_CY * H + Math.sin(ang) * CL_R * W * dist];
  }

  function receiverBase(i: number): [number, number] {
    const [ox, oy] = RX_OFFSETS[i];
    return [RX_CX * W + ox * RX_SP * W,
            RX_CY * H + oy * RX_SP * W];
  }

  function buildAll() {
    cluster = [];
    for (let i = 0; i < N_CLUSTER; i++) {
      const [bx, by] = clusterBase(i);
      cluster.push({ x: bx, y: by, bx, by, vx: 0, vy: 0, a: 0.05 + (i % 5) * 0.008 });
    }
    ambientP = [];
    for (let i = 0; i < N_AMBIENT; i++) {
      ambientP.push({
        x: Math.random() * W, y: Math.random() * H,
        vx: (Math.random() - 0.5) * 0.15,
        vy: (Math.random() - 0.5) * 0.15,
        a: 0.02 + Math.random() * 0.02
      });
    }
    receivers = [];
    for (let i = 0; i < N_RECEIVERS; i++) {
      const [bx, by] = receiverBase(i);
      receivers.push({ x: bx, y: by, bx, by, a: 0.07, pa: 0 });
    }
  }

  function resetState() {
    frame = 0; gFade = 1; scanLineX = 0;
    exSep = false; exAlpha = 0; exBlend = 0;
    buildAll();
    exX = cluster[ACCENT_I].x;
    exY = cluster[ACCENT_I].y;
    exOriginX = exX; exOriginY = exY;
  }

  function reposition() {
    for (let i = 0; i < cluster.length; i++) {
      const [bx, by] = clusterBase(i);
      cluster[i].bx = bx; cluster[i].by = by;
      cluster[i].x = bx; cluster[i].y = by;
    }
    for (let i = 0; i < receivers.length; i++) {
      const [bx, by] = receiverBase(i);
      receivers[i].bx = bx; receivers[i].by = by;
      receivers[i].x = bx; receivers[i].y = by;
    }
  }

  function update() {
    // Ambient drift (wrap at edges)
    for (const p of ambientP) {
      p.x += p.vx; p.y += p.vy;
      if (p.x < -10) p.x = W + 10;
      if (p.x > W + 10) p.x = -10;
      if (p.y < -10) p.y = H + 10;
      if (p.y > H + 10) p.y = -10;
    }

    // Cluster Brownian drift with return spring
    for (const c of cluster) {
      const dx = c.bx - c.x, dy = c.by - c.y;
      c.vx += dx * 0.001 + (Math.random() - 0.5) * 0.025;
      c.vy += dy * 0.001 + (Math.random() - 0.5) * 0.025;
      c.vx = Math.max(-0.2, Math.min(0.2, c.vx * 0.97));
      c.vy = Math.max(-0.2, Math.min(0.2, c.vy * 0.97));
      c.x += c.vx; c.y += c.vy;
    }

    // Scan line sweeps from left; reaches cluster right edge at P_HIT
    const scanSpeed = (CL_CX * W + CL_R * W) / P_HIT;
    if (frame <= P_HIT + 80) {
      scanLineX = frame * scanSpeed;
    }

    // Accent / extracted particle phases
    if (frame < P_HIT) {
      // Pulsing in cluster
      exX = cluster[ACCENT_I].x;
      exY = cluster[ACCENT_I].y;
      exAlpha = 0.6 + 0.15 * Math.sin(frame * 0.06);
      exBlend = 0;
    } else if (frame < P_ARRIVE) {
      // Separating and drifting rightward
      if (!exSep) {
        exSep = true;
        exOriginX = cluster[ACCENT_I].x;
        exOriginY = cluster[ACCENT_I].y;
      }
      const t = (frame - P_HIT) / (P_ARRIVE - P_HIT);
      const ease = 1 - (1 - t) * (1 - t); // ease-out
      exX = exOriginX + (RX_CX * W - exOriginX) * ease;
      exY = exOriginY + (RX_CY * H - exOriginY) * ease;
      exAlpha = 0.85;
      exBlend = t * 0.3; // max 30% shift toward red
    } else if (frame < P_PULSE) {
      // Locked in formation; receivers pulse
      exX = RX_CX * W; exY = RX_CY * H;
      exAlpha = 0.85; exBlend = 0.3;
      const pt = (frame - P_ARRIVE) / (P_PULSE - P_ARRIVE);
      const pulse = Math.sin(pt * Math.PI);
      for (const r of receivers) r.pa = pulse * 0.35;
    } else if (frame < P_HOLD) {
      // Hold steady
      exX = RX_CX * W; exY = RX_CY * H;
      exAlpha = 0.85; exBlend = 0.3;
      for (const r of receivers) r.pa = Math.max(0, r.pa - 0.006);
    } else {
      // Fade all to black
      gFade = Math.max(0, 1 - (frame - P_HOLD) / (P_END - P_HOLD));
    }
  }

  function draw() {
    ctx!.clearRect(0, 0, W, H);
    ctx!.fillStyle = bgColor; ctx!.fillRect(0, 0, W, H);
    const f = gFade;

    // Ambient particles
    for (const p of ambientP) {
      const a = p.a * f;
      if (a < 0.003) continue;
      ctx!.beginPath(); ctx!.arc(p.x, p.y, 1.5, 0, Math.PI * 2);
      ctx!.fillStyle = dimA(a); ctx!.fill();
    }

    // Cluster particles (accent drawn separately)
    for (let i = 0; i < cluster.length; i++) {
      if (i === ACCENT_I) continue;
      const c = cluster[i];
      const a = c.a * f;
      if (a < 0.003) continue;
      ctx!.beginPath(); ctx!.arc(c.x, c.y, 2.5, 0, Math.PI * 2);
      ctx!.fillStyle = dimA(a); ctx!.fill();
    }

    // Accent / extracted particle with glow
    if (exAlpha * f > 0.005) {
      const a = exAlpha * f;
      const gr = ctx!.createRadialGradient(exX, exY, 0, exX, exY, 18);
      gr.addColorStop(0, blendA(exBlend, a * 0.4));
      gr.addColorStop(0.6, blendA(exBlend, a * 0.08));
      gr.addColorStop(1, blendA(exBlend, 0));
      ctx!.beginPath(); ctx!.arc(exX, exY, 18, 0, Math.PI * 2);
      ctx!.fillStyle = gr; ctx!.fill();
      ctx!.beginPath(); ctx!.arc(exX, exY, 3.5, 0, Math.PI * 2);
      ctx!.fillStyle = blendA(exBlend, a); ctx!.fill();
    }

    // Scan line (vertical bar sweeping right, fades after extraction)
    if (scanLineX > 0 && frame <= P_HIT + 80) {
      let la = 0.18 * f;
      if (frame > P_HIT) la *= Math.max(0, 1 - (frame - P_HIT) / 80);
      if (la > 0.003 && scanLineX < W * 1.2) {
        ctx!.strokeStyle = storyA(la); ctx!.lineWidth = 1;
        ctx!.beginPath();
        ctx!.moveTo(scanLineX, H * 0.08);
        ctx!.lineTo(scanLineX, H * 0.92);
        ctx!.stroke();
        // Faint trail behind line
        const tg = ctx!.createLinearGradient(Math.max(0, scanLineX - 25), 0, scanLineX, 0);
        tg.addColorStop(0, storyA(0));
        tg.addColorStop(1, storyA(la * 0.2));
        ctx!.fillStyle = tg;
        ctx!.fillRect(Math.max(0, scanLineX - 25), H * 0.08, 25, H * 0.84);
      }
    }

    // Receiver formation
    for (const r of receivers) {
      const baseA = (r.a + r.pa) * f;
      if (baseA < 0.003) continue;
      if (r.pa > 0.01) {
        const pg = ctx!.createRadialGradient(r.x, r.y, 0, r.x, r.y, 12);
        pg.addColorStop(0, storyA(r.pa * f * 0.6));
        pg.addColorStop(1, storyA(0));
        ctx!.beginPath(); ctx!.arc(r.x, r.y, 12, 0, Math.PI * 2);
        ctx!.fillStyle = pg; ctx!.fill();
      }
      ctx!.beginPath(); ctx!.arc(r.x, r.y, 2.5, 0, Math.PI * 2);
      ctx!.fillStyle = dimA(baseA); ctx!.fill();
    }

    // Gateway outline (unused mechanism, pulses gently)
    const gwX = GW_CX * W, gwY = GW_CY * H;
    const gwW = GW_W * W, gwH = GW_H * H;
    const gwA = (0.12 + 0.06 * Math.sin(frame * Math.PI * 2 / 90)) * f;
    if (gwA > 0.003) {
      ctx!.strokeStyle = storyA(gwA); ctx!.lineWidth = 1;
      ctx!.strokeRect(gwX - gwW / 2, gwY - gwH / 2, gwW, gwH);
    }
  }

  // Reduced-motion static frame: moment of detachment, frozen
  function drawStatic() {
    ctx!.clearRect(0, 0, W, H);
    ctx!.fillStyle = bgColor; ctx!.fillRect(0, 0, W, H);

    // Ambient texture
    for (let i = 0; i < N_AMBIENT; i++) {
      const x = (0.05 + ((i * 7 + 3) % N_AMBIENT) / N_AMBIENT * 0.9) * W;
      const y = (0.1 + ((i * 11 + 5) % N_AMBIENT) / N_AMBIENT * 0.75) * H;
      ctx!.beginPath(); ctx!.arc(x, y, 1.5, 0, Math.PI * 2);
      ctx!.fillStyle = dimA(0.025); ctx!.fill();
    }

    // Cluster minus accent particle
    for (let i = 0; i < N_CLUSTER; i++) {
      if (i === ACCENT_I) continue;
      const { ang, dist } = CL_SEEDS[i];
      const px = CL_CX * W + Math.cos(ang) * CL_R * W * dist;
      const py = CL_CY * H + Math.sin(ang) * CL_R * W * dist;
      ctx!.beginPath(); ctx!.arc(px, py, 2.5, 0, Math.PI * 2);
      ctx!.fillStyle = dimA(0.06); ctx!.fill();
    }

    // Scan line frozen at cluster edge
    const slX = CL_CX * W + CL_R * W * 0.9;
    ctx!.strokeStyle = storyA(0.12); ctx!.lineWidth = 1;
    ctx!.beginPath(); ctx!.moveTo(slX, H * 0.08); ctx!.lineTo(slX, H * 0.92); ctx!.stroke();

    // Extracted particle mid-journey (halfway, slight red tint)
    const mx = ((CL_CX + RX_CX) / 2) * W;
    const my = CL_CY * H;
    const mt = 0.15;
    const gr = ctx!.createRadialGradient(mx, my, 0, mx, my, 18);
    gr.addColorStop(0, blendA(mt, 0.4));
    gr.addColorStop(0.6, blendA(mt, 0.08));
    gr.addColorStop(1, blendA(mt, 0));
    ctx!.beginPath(); ctx!.arc(mx, my, 18, 0, Math.PI * 2);
    ctx!.fillStyle = gr; ctx!.fill();
    ctx!.beginPath(); ctx!.arc(mx, my, 3.5, 0, Math.PI * 2);
    ctx!.fillStyle = blendA(mt, 0.85); ctx!.fill();

    // Receiver formation (dim)
    for (let i = 0; i < N_RECEIVERS; i++) {
      const [ox, oy] = RX_OFFSETS[i];
      const rx = RX_CX * W + ox * RX_SP * W;
      const ry = RX_CY * H + oy * RX_SP * W;
      ctx!.beginPath(); ctx!.arc(rx, ry, 2.5, 0, Math.PI * 2);
      ctx!.fillStyle = dimA(0.07); ctx!.fill();
    }

    // Gateway outline (unused)
    const gwX = GW_CX * W, gwY = GW_CY * H;
    const gwW = GW_W * W, gwH = GW_H * H;
    ctx!.strokeStyle = storyA(0.14); ctx!.lineWidth = 1;
    ctx!.strokeRect(gwX - gwW / 2, gwY - gwH / 2, gwW, gwH);
  }

  function tick() {
    frame++;
    if (frame >= CYCLE) resetState();
    update(); draw();
    rafId = requestAnimationFrame(tick);
  }

  // Resize handling
  const ro = new ResizeObserver(() => {
    const dpr = window.devicePixelRatio || 1;
    W = canvas!.offsetWidth; H = canvas!.offsetHeight;
    canvas!.width = W * dpr; canvas!.height = H * dpr;
    ctx!.scale(dpr, dpr);
    if (prefersReduced) { drawStatic(); }
    else { reposition(); }
  });
  ro.observe(canvas);

  // Initial sizing
  const dpr = window.devicePixelRatio || 1;
  W = canvas.offsetWidth; H = canvas.offsetHeight;
  canvas.width = W * dpr; canvas.height = H * dpr;
  ctx.scale(dpr, dpr);

  if (prefersReduced) {
    drawStatic();
    window.addEventListener('pagehide', () => { ro.disconnect(); });
  } else {
    resetState();
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { if (!rafId) rafId = requestAnimationFrame(tick); }
      else { cancelAnimationFrame(rafId); rafId = 0; }
    }, { threshold: 0.01 });
    io.observe(canvas);
    window.addEventListener('pagehide', () => { cancelAnimationFrame(rafId); io.disconnect(); ro.disconnect(); });
  }
})();
</script>

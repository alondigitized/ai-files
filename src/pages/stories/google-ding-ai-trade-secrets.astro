---
import StoryLayout from '../../layouts/StoryLayout.astro';
import stories from '../../data/stories.json';

const story = stories.find(s => s.slug === 'google-ding-ai-trade-secrets')!;
---

<style is:global>
/* Exfiltration Chain */
.gd-exfil-wrap {
  overflow-x: auto;
  margin: 2rem 0;
  padding: 1.5rem;
  background: var(--surface);
  border-radius: 12px;
  border: 1px solid var(--border);
}
.gd-exfil-chain {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  min-width: 700px;
  padding-bottom: 2.5rem;
  position: relative;
}
.gd-exfil-node {
  border: 1.5px solid var(--story);
  border-radius: 8px;
  padding: 0.75rem 1rem;
  text-align: center;
  min-width: 130px;
  background: var(--bg);
}
.gd-exfil-node-label {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 0.02em;
}
.gd-exfil-node-sub {
  font-size: 0.7rem;
  color: var(--muted);
  margin-top: 0.25rem;
}
.gd-exfil-endpoint {
  border-color: var(--accent);
}
.gd-exfil-endpoint .gd-exfil-node-label {
  color: var(--accent);
}
.gd-exfil-arrow {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 0.4rem;
  min-width: 70px;
}
.gd-exfil-arrow-line {
  width: 100%;
  height: 1.5px;
  background: var(--muted);
  position: relative;
}
.gd-exfil-arrow-line::after {
  content: '';
  position: absolute;
  right: -1px;
  top: -4px;
  border: 5px solid transparent;
  border-left: 6px solid var(--muted);
}
.gd-exfil-arrow-label {
  font-size: 0.65rem;
  color: var(--muted);
  margin-bottom: 0.3rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.gd-exfil-dlp-wrap {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 25%;
  display: flex;
  align-items: center;
  height: 1.5rem;
}
.gd-exfil-dlp {
  flex: 1;
  border-top: 2px dashed rgba(136,136,136,0.4);
  position: relative;
}
.gd-exfil-dlp-label {
  position: absolute;
  bottom: -1.1rem;
  left: 50%;
  transform: translateX(-50%);
  font-size: 0.6rem;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  white-space: nowrap;
}
.gd-exfil-bypass {
  padding: 0 0.5rem;
  font-size: 0.65rem;
  color: var(--accent);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  opacity: 0.85;
}
.gd-exfil-context {
  margin-top: 1rem;
  padding-top: 0.75rem;
  border-top: 1px solid var(--border);
  font-size: 0.75rem;
  color: var(--muted);
  font-style: italic;
  text-align: center;
}

/* Statutory Diff Block */

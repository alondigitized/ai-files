  line-height: 1.6;
  color: var(--story);
  font-weight: 600;
  font-family: 'Georgia', serif;
}
.gd-statute-standard {
  font-size: 0.85rem;
  line-height: 1.6;
  color: var(--text);
  font-family: 'Georgia', serif;
}
.gd-statute-standard strong {
  color: var(--text);
  font-weight: 700;
}
.gd-statute-penalty {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-top: 1px solid var(--border);
  background: var(--bg);
}
.gd-statute-penalty-cell {

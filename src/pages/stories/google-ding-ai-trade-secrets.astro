  margin: 2rem 0;
  background: var(--surface);
  border-radius: 12px;
  border: 1px solid var(--border);
  overflow: hidden;
}
.gd-statute-header {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-bottom: 1px solid var(--border);
}
.gd-statute-header-cell {
  padding: 1rem;
  text-align: center;
}
.gd-statute-header-cell:first-child {
  border-right: 1px solid var(--border);
}
.gd-statute-header-num {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--muted);
  margin-bottom: 0.25rem;
}
.gd-statute-header-label {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--text);
}
.gd-statute-shared {
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid var(--border);
  background: var(--bg);
}
.gd-statute-shared-label {
  font-size: 0.6rem;

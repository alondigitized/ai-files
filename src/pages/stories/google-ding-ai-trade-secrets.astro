<script is:inline>
<script>
(function () {
  const canvas = document.querySelector('.google-ding-ai-trade-secrets-canvas') as HTMLCanvasElement;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  /* ── Colors from CSS ── */
  const cs = getComputedStyle(document.documentElement);
  const storyHex = cs.getPropertyValue('--story').trim() || '#8ab4d8';

  function hexRgb(h: string): [number, number, number] {
    h = h.replace(/^#/, '');
    if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
    const n = parseInt(h, 16);
    return isNaN(n) || h.length !== 6 ? [138, 180, 216] : [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }

  const [SR, SG, SB] = hexRgb(storyHex);
  const RR = 255, RG = 77, RB = 77;
  const DR = 232, DG = 232, DB = 232;

  const stA = (a: number) => `rgba(${SR},${SG},${SB},${a})`;
  const rdA = (a: number) => `rgba(${RR},${RG},${RB},${a})`;
  const dmA = (a: number) => `rgba(${DR},${DG},${DB},${a})`;
  const lrpA = (t: number, a: number) =>
    `rgba(${Math.round(SR + (RR - SR) * t)},${Math.round(SG + (RG - SG) * t)},${Math.round(SB + (RB - SB) * t)},${a})`;

  /* ── State ── */
  let W = 0, H = 0, rafId = 0, frame = 0;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Grid config ── */
  const ROWS = 4, COLS = 3, GRID = ROWS * COLS;
  const SX = 30, SY = 36;

  /* ── Phase thresholds (60 fps, ~17 s cycle) ── */
  const P1 = 360, P2 = 420, P3 = 480, P4 = 600, P5 = 840, P6 = 920, P7 = 990, CYC = 1020;

  /* ── Node pool ── */
  interface N { bx: number; by: number; x: number; y: number; a: number; vx: number; vy: number; dp: number; }
  function mk(): N { return { bx: 0, by: 0, x: 0, y: 0, a: 0, vx: 0, vy: 0, dp: Math.random() * 6.283 }; }

  const LG: N[] = Array.from({ length: GRID }, mk);
  const RG: N[] = Array.from({ length: GRID }, mk);
  const AN: N = mk();
  const DN = { x: 0, y: 0, a: 0.06 };

  let aredT = 0;
  let aBroken = false;
  let tProg = 0;

  /* ── Connection topology ── */
  const conns: [number, number][] = [];
  const cDist: number[] = [];
  const cState: number[] = [];

  function buildConns() {
    conns.length = 0; cDist.length = 0; cState.length = 0;
    for (let r = 0; r < ROWS; r++)
      for (let c = 0; c < COLS; c++) {
        const i = r * COLS + c;
        if (c < COLS - 1) conns.push([i, i + 1]);
        if (r < ROWS - 1) conns.push([i, i + COLS]);
      }
    for (const [a, b] of conns) {
      const da = Math.floor(a / COLS) + Math.abs(a % COLS - 1);
      const db = Math.floor(b / COLS) + Math.abs(b % COLS - 1);
      cDist.push(Math.min(da, db));
      cState.push(0);
    }
  }

  function posGrid(nodes: N[], cx: number, cy: number) {
    const ox = cx - (COLS - 1) * SX / 2, oy = cy - (ROWS - 1) * SY / 2;
    for (let r = 0; r < ROWS; r++)
      for (let c = 0; c < COLS; c++) {
        const n = nodes[r * COLS + c];
        n.bx = ox + c * SX; n.by = oy + r * SY;
        n.x = n.bx; n.y = n.by; n.vx = 0; n.vy = 0;
      }
  }

  function initPos() {
    posGrid(LG, W * 0.33, H * 0.58);
    posGrid(RG, W * 0.67, H * 0.58);
    AN.bx = LG[1].bx; AN.by = LG[1].by - SY;
    AN.x = AN.bx; AN.y = AN.by; AN.vx = 0; AN.vy = 0;
    aredT = 0; aBroken = false;
    DN.x = AN.bx; DN.y = H * 0.06; DN.a = 0;
    tProg = 0;
    for (let i = 0; i < cState.length; i++) cState[i] = 0;
  }

  function resetAll() {
    buildConns(); initPos();
    for (const n of LG) n.a = 0.07;
    for (const n of RG) n.a = 0.07;
    AN.a = 0.3; DN.a = 0.06; frame = 0;
  }

  /* ── Drift ── */
  function drift(nodes: N[], f: number) {
    for (const n of nodes) {
      n.x = n.bx + Math.sin(f * 0.006 + n.dp) * 1.2;
      n.y = n.by + Math.cos(f * 0.005 + n.dp * 1.3) * 0.7;
    }
  }
  function drift1(n: N, f: number) {
    n.x = n.bx + Math.sin(f * 0.006 + n.dp) * 1.2;
    n.y = n.by + Math.cos(f * 0.005 + n.dp * 1.3) * 0.7;
  }

  /* ── Phase ── */
  let prevPh = '';
  function ph(f: number) {
    if (f < P1) return 'reach';
    if (f < P2) return 'max';
    if (f < P3) return 'break';
    if (f < P4) return 'scatter';
    if (f < P5) return 'hold';
    if (f < P6) return 'fadeout';
    if (f < P7) return 'reform';
    return 'settle';
  }

  /* ── Update ── */
  function update() {
    const p = ph(frame);
    const chg = p !== prevPh;
    prevPh = p;

    if (p === 'reach') {
      drift(LG, frame); drift(RG, frame); drift1(AN, frame);
      const t = frame / P1;
      tProg = t;
      DN.a = 0.06 * (1 - t * 0.3);
      for (const n of LG) n.a += (0.07 - n.a) * 0.05;
      for (const n of RG) n.a += (0.07 - n.a) * 0.05;
      AN.a += (0.3 + Math.sin(frame * 0.05) * 0.03 - AN.a) * 0.05;

    } else if (p === 'max') {
      drift(LG, frame); drift(RG, frame); drift1(AN, frame);
      tProg = 1 + Math.sin(frame * 0.12) * 0.015;
      const t = (frame - P1) / (P2 - P1);
      DN.a = 0.06 * Math.max(0.06, 0.7 - t * 0.64);

    } else if (p === 'break') {
      drift(RG, frame); drift(LG, frame); drift1(AN, frame);
      const t = (frame - P2) / (P3 - P2);

      /* Accent flicker then red shift */
      if (t < 0.25) {
        AN.a = Math.sin(t * 25) > 0.2 ? 0.15 : 0.35;
        aredT = 0;
      } else {
        aredT = Math.min(1, (t - 0.25) / 0.4);
        AN.a = 0.35;
      }

      /* Tether snap */
      if (t < 0.38) {
        tProg = 1 - t * 0.3;
      } else if (t < 0.5) {
        if (!aBroken) aBroken = true;
        tProg = Math.max(0, (0.5 - t) / 0.12);
      } else {
        tProg = 0;
      }

      /* Connection break propagation */
      for (let i = 0; i < conns.length; i++) {
        if (cState[i] === 2) continue;
        const bt = 0.45 + cDist[i] * 0.11;
        if (t > bt + 0.07) cState[i] = 2;
        else if (t > bt) cState[i] = 1;
      }

      DN.a = Math.max(0, 0.01 * (1 - t * 2));

    } else if (p === 'scatter') {
      if (chg) {
        const cx = LG[1].x, cy = LG[1].y;
        for (const n of LG) {
          const dx = n.x - cx, dy = n.y - cy;
          const d = Math.sqrt(dx * dx + dy * dy) || 1;
          n.vx = (dx / d) * (0.08 + Math.random() * 0.18);
          n.vy = (dy / d) * (0.08 + Math.random() * 0.18);
        }
        AN.vx = (Math.random() - 0.5) * 0.12;
        AN.vy = -0.15;
        for (let i = 0; i < cState.length; i++) cState[i] = 2;
      }
      drift(RG, frame);
      const t = (frame - P3) / (P4 - P3);
      for (const n of LG) { n.x += n.vx; n.y += n.vy; n.a = Math.max(0, 0.07 * (1 - t * 1.4)); }
      AN.x += AN.vx; AN.y += AN.vy;
      AN.a = Math.max(0, 0.35 * (1 - t * 1.4));
      aredT = 1; tProg = 0; DN.a = 0;
      for (const n of RG) n.a += (0.07 - n.a) * 0.05;

    } else if (p === 'hold') {
      drift(RG, frame);
      for (const n of LG) n.a = 0;
      AN.a = 0; DN.a = 0; tProg = 0;

    } else if (p === 'fadeout') {
      drift(RG, frame);
      const t = (frame - P5) / (P6 - P5);
      for (const n of RG) n.a = 0.07 * Math.max(0, 1 - t);
      for (const n of LG) n.a = 0;
      AN.a = 0; DN.a = 0;

    } else if (p === 'reform') {
      if (chg) {
        initPos();
        for (const n of LG) n.a = 0;
        for (const n of RG) n.a = 0;
        AN.a = 0; DN.a = 0;
      }
      drift(LG, frame); drift(RG, frame); drift1(AN, frame);
      const t = (frame - P6) / (P7 - P6);
      for (const n of LG) n.a = 0.07 * t;
      for (const n of RG) n.a = 0.07 * t;
      AN.a = 0.3 * t;
      DN.a = 0.06 * t;

    } else {
      drift(LG, frame); drift(RG, frame); drift1(AN, frame);
      for (const n of LG) n.a += (0.07 - n.a) * 0.1;
      for (const n of RG) n.a += (0.07 - n.a) * 0.1;
      AN.a += (0.3 - AN.a) * 0.1;
      DN.a += (0.06 - DN.a) * 0.1;
    }
  }

  /* ── Draw ── */
  function draw() {
    ctx!.clearRect(0, 0, W, H);

    function drawConns(ns: N[], left: boolean) {
      for (let i = 0; i < conns.length; i++) {
        const [a, b] = conns[i];
        const na = ns[a], nb = ns[b];
        const ma = Math.min(na.a, nb.a);
        if (ma < 0.003) continue;
        if (left && cState[i] === 2) continue;
        const pulse = 0.9 + Math.sin(frame * 0.03 + i * 0.7) * 0.1;
        const la = (left && cState[i] === 1 ? ma * 1.8 : ma * 0.6) * pulse;
        ctx!.beginPath();
        ctx!.moveTo(na.x, na.y);
        ctx!.lineTo(nb.x, nb.y);
        ctx!.strokeStyle = dmA(la);
        ctx!.lineWidth = 0.5;
        ctx!.stroke();
      }
    }

    function drawNodes(ns: N[]) {
      for (const n of ns) {
        if (n.a < 0.003) continue;
        ctx!.beginPath();
        ctx!.arc(n.x, n.y, 2, 0, Math.PI * 2);
        ctx!.fillStyle = dmA(n.a);
        ctx!.fill();
      }
    }

    /* Right lattice (background) */
    drawConns(RG, false);
    drawNodes(RG);

    /* Left lattice */
    drawConns(LG, true);
    drawNodes(LG);

    /* Accent-to-grid link */
    if (!aBroken && AN.a > 0.003 && LG[1].a > 0.003) {
      ctx!.beginPath();
      ctx!.moveTo(AN.x, AN.y);
      ctx!.lineTo(LG[1].x, LG[1].y);
      ctx!.strokeStyle = stA(Math.min(AN.a, LG[1].a) * 0.3);
      ctx!.lineWidth = 0.5;
      ctx!.stroke();
    }

    /* Accent node */
    if (AN.a > 0.003) {
      const col = aredT > 0.01 ? lrpA(aredT, AN.a) : stA(AN.a);
      ctx!.beginPath();
      ctx!.arc(AN.x, AN.y, 3, 0, Math.PI * 2);
      ctx!.fillStyle = col;
      ctx!.fill();

      const ga = AN.a * 0.12;
      const gcol = aredT > 0.01 ? lrpA(aredT, ga) : stA(ga);
      const gcol0 = aredT > 0.01 ? lrpA(aredT, 0) : stA(0);
      const gr = ctx!.createRadialGradient(AN.x, AN.y, 0, AN.x, AN.y, 12);
      gr.addColorStop(0, gcol);
      gr.addColorStop(1, gcol0);
      ctx!.beginPath();
      ctx!.arc(AN.x, AN.y, 12, 0, Math.PI * 2);
      ctx!.fillStyle = gr;
      ctx!.fill();
    }

    /* Tether */
    if (tProg > 0.01 && AN.a > 0.003) {
      const ey = AN.y - tProg * (AN.y - DN.y);
      const curPh = ph(frame);
      let ta = 0.1;
      let isRed = false;
      if (curPh === 'break') {
        const bt = (frame - P2) / (P3 - P2);
        if (bt >= 0.38 && bt < 0.5) { ta = 0.22; isRed = true; }
        else ta = 0.1 * Math.max(0, 1 - bt * 1.5);
      }
      ctx!.save();
      ctx!.setLineDash([3, 5]);
      ctx!.beginPath();
      ctx!.moveTo(AN.x, AN.y);
      ctx!.lineTo(DN.x, ey);
      ctx!.strokeStyle = isRed ? rdA(ta) : stA(ta);
      ctx!.lineWidth = 0.8;
      ctx!.stroke();
      ctx!.restore();
    }

    /* Distant node */
    if (DN.a > 0.003) {
      ctx!.beginPath();
      ctx!.arc(DN.x, DN.y, 1.5, 0, Math.PI * 2);
      ctx!.fillStyle = dmA(DN.a);
      ctx!.fill();
    }
  }

  /* ── Static frame (reduced motion) ── */
  function drawStatic() {
    ctx!.clearRect(0, 0, W, H);
    buildConns();
    posGrid(LG, W * 0.33, H * 0.58);
    posGrid(RG, W * 0.67, H * 0.58);
    AN.bx = LG[1].bx; AN.by = LG[1].by - SY;
    AN.x = AN.bx; AN.y = AN.by;
    DN.x = AN.bx; DN.y = H * 0.06;

    /* Right lattice — full opacity */
    for (let i = 0; i < conns.length; i++) {
      const [a, b] = conns[i];
      ctx!.beginPath(); ctx!.moveTo(RG[a].x, RG[a].y); ctx!.lineTo(RG[b].x, RG[b].y);
      ctx!.strokeStyle = dmA(0.04); ctx!.lineWidth = 0.5; ctx!.stroke();
    }
    for (const n of RG) {
      ctx!.beginPath(); ctx!.arc(n.x, n.y, 2, 0, Math.PI * 2);
      ctx!.fillStyle = dmA(0.07); ctx!.fill();
    }

    /* Left lattice — half opacity */
    for (let i = 0; i < conns.length; i++) {
      const [a, b] = conns[i];
      ctx!.beginPath(); ctx!.moveTo(LG[a].x, LG[a].y); ctx!.lineTo(LG[b].x, LG[b].y);
      ctx!.strokeStyle = dmA(0.02); ctx!.lineWidth = 0.5; ctx!.stroke();
    }
    for (const n of LG) {
      ctx!.beginPath(); ctx!.arc(n.x, n.y, 2, 0, Math.PI * 2);
      ctx!.fillStyle = dmA(0.035); ctx!.fill();
    }

    /* Accent node — red */
    ctx!.beginPath(); ctx!.arc(AN.x, AN.y, 3, 0, Math.PI * 2);
    ctx!.fillStyle = rdA(0.35); ctx!.fill();
    const sgr = ctx!.createRadialGradient(AN.x, AN.y, 0, AN.x, AN.y, 12);
    sgr.addColorStop(0, rdA(0.04)); sgr.addColorStop(1, rdA(0));
    ctx!.beginPath(); ctx!.arc(AN.x, AN.y, 12, 0, Math.PI * 2);
    ctx!.fillStyle = sgr; ctx!.fill();

    /* Tether at full extension */
    ctx!.save(); ctx!.setLineDash([3, 5]);
    ctx!.beginPath(); ctx!.moveTo(AN.x, AN.y); ctx!.lineTo(DN.x, DN.y);
    ctx!.strokeStyle = stA(0.08); ctx!.lineWidth = 0.8; ctx!.stroke();
    ctx!.restore();

    /* Distant node */
    ctx!.beginPath(); ctx!.arc(DN.x, DN.y, 1.5, 0, Math.PI * 2);
    ctx!.fillStyle = dmA(0.04); ctx!.fill();
  }

  /* ── Resize ── */
  const ro = new ResizeObserver(() => {
    const dpr = window.devicePixelRatio || 1;
    W = canvas.offsetWidth; H = canvas.offsetHeight;
    canvas.width = W * dpr; canvas.height = H * dpr;
    ctx!.scale(dpr, dpr);
    if (reduced) drawStatic();
  });
  ro.observe(canvas);

  const dpr0 = window.devicePixelRatio || 1;
  W = canvas.offsetWidth; H = canvas.offsetHeight;
  canvas.width = W * dpr0; canvas.height = H * dpr0;
  ctx.scale(dpr0, dpr0);

  /* ── Loop ── */
  function tick() {
    frame++;
    if (frame >= CYC) resetAll();
    update();
    draw();
    rafId = requestAnimationFrame(tick);
  }

  if (reduced) {
    drawStatic();
    window.addEventListener('pagehide', () => { ro.disconnect(); });
  } else {
    resetAll();
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { if (!rafId) rafId = requestAnimationFrame(tick); }
      else { cancelAnimationFrame(rafId); rafId = 0; }
    }, { threshold: 0.01 });
    io.observe(canvas);
    window.addEventListener('pagehide', () => {
      cancelAnimationFrame(rafId);
      io.disconnect();
      ro.disconnect();
    });
  }
})();
</script>
</script>

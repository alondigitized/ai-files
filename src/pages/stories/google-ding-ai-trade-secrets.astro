.gd-verdict-badge-date {
  font-size: 0.5rem;
  color: var(--muted);
  letter-spacing: 0.04em;
}
.gd-verdict-badge-label {
  font-size: 0.55rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 0.15rem 0.4rem;
  border-radius: 3px;

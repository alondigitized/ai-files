---
import StoryLayout from '../../layouts/StoryLayout.astro';
import stories from '../../data/stories.json';

const story = stories.find(s => s.slug === 'doj-nyt-fair-use-statement')!;
---

<style is:global>
  /* === Canvas === */
  .phantom-wrap { width: 100%; margin: 0; line-height: 0; }
  .doj-nyt-fair-use-statement-canvas { display: block; width: 100%; height: 380px; background: var(--bg); }
  .canvas-note { font-size: 0.78rem; color: var(--muted); text-align: center; margin: 0.6rem 0 0; padding: 0 1rem; line-height: 1.5; }

  /* === Reenactment 1: Filing Caption === */
  .doj-doc-wrap {
    background: var(--bg-deep, #0a0a0a);
    border: 1px solid var(--story);
    border-radius: 6px;
    padding: 2rem 1.5rem;
    margin: 2rem 0;
    font-family: 'SF Mono', 'Courier New', Courier, monospace;
    position: relative;
    overflow: hidden;
  }
  .doj-doc-wrap::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--story);
    opacity: 0.6;
  }
  .doj-doc-court {
    text-align: center;
    color: var(--text);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }
  .doj-doc-docket {
    color: var(--muted);
    font-size: 0.7rem;
    text-align: left;
    margin-bottom: 1.5rem;
    line-height: 1.6;
    border-bottom: 1px solid color-mix(in srgb, var(--story) 15%, transparent);
    padding-bottom: 1rem;
  }
  .doj-doc-title { text-align: center; margin-bottom: 1.5rem; }
  .doj-doc-case-name {
    color: var(--text);
    font-size: 0.8rem;
    font-style: italic;
    display: block;
    margin-bottom: 0.5rem;
  }
  .doj-doc-mdl {
    color: var(--muted);
    font-size: 0.7rem;
    display: block;
    margin-bottom: 1rem;
  }
  .doj-doc-statement-title {
    color: var(--story);
    font-size: 0.85rem;
    font-weight: bold;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: block;
    border-top: 1px solid color-mix(in srgb, var(--story) 15%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--story) 15%, transparent);
    padding: 0.75rem 0;
  }
  .doj-doc-opening {
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.7;
    margin-top: 1.25rem;
    font-style: italic;
  }
  .doj-doc-footer {
    margin-top: 1.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--story) 10%, transparent);
    color: var(--muted);
    font-size: 0.65rem;
    font-family: inherit;
    font-style: italic;
  }

  /* === Reenactment 2: Lifecycle Diagram === */
  .doj-lifecycle-wrap {
    background: var(--bg-deep, #0a0a0a);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 2rem 1.5rem;
    margin: 2rem 0;
    overflow-x: auto;
  }
  .doj-lifecycle-stages {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: start;
    gap: 0;
    margin-bottom: 1.5rem;
  }
  .doj-lifecycle-stage {
    text-align: center;
    padding: 1rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    min-width: 0;
  }
  .doj-lifecycle-stage.doj-lifecycle-active {
    border-color: var(--story);
    background: color-mix(in srgb, var(--story) 8%, transparent);
  }
  /* No opacity here: compositing muted text would drop contrast below 4.5:1 (WCAG 1.4.3).
     The active/muted distinction is carried by color, border, and background instead. */
  .doj-lifecycle-stage.doj-lifecycle-muted { border-style: dashed; }
  .doj-lifecycle-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-size: 1.2rem;
    padding: 1rem 0.25rem 0;
  }
  .doj-lifecycle-num {
    font-size: 0.65rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.4rem;
  }
  .doj-lifecycle-label {
    font-size: 0.85rem;
    font-weight: 600;
    display: block;
    margin-bottom: 0.5rem;
  }
  .doj-lifecycle-active .doj-lifecycle-label { color: var(--story); }
  .doj-lifecycle-muted .doj-lifecycle-label { color: var(--muted); }
  .doj-lifecycle-position {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    display: inline-block;
  }
  .doj-lifecycle-active .doj-lifecycle-position {
    color: var(--story);
    background: color-mix(in srgb, var(--story) 12%, transparent);
  }
  .doj-lifecycle-muted .doj-lifecycle-position {
    color: var(--muted);
    background: color-mix(in srgb, var(--muted) 12%, transparent);
  }
  .doj-lifecycle-questions {
    margin-top: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px dashed color-mix(in srgb, var(--muted) 25%, transparent);
  }
  .doj-lifecycle-q {
    font-size: 0.65rem;
    color: var(--muted);
    font-style: italic;
    display: block;
    margin-bottom: 0.2rem;
  }
  .doj-lifecycle-source {
    text-align: center;
    margin-top: 1rem;
    font-size: 0.65rem;
    color: var(--muted);
    font-style: italic;
  }
  .doj-lifecycle-footer {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--story) 10%, transparent);
    color: var(--muted);
    font-size: 0.7rem;
    font-style: italic;
    line-height: 1.6;
  }

  /* === Reenactment 3: Footnote Mockup === */
  .doj-footnote-wrap {
    background: var(--bg-deep, #0a0a0a);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1.5rem 1.5rem 1rem;
    margin: 2rem 0;
    font-family: Georgia, 'Times New Roman', serif;
    position: relative;
  }
  .doj-footnote-rule {
    width: 40%;
    border: none;
    border-top: 1px solid var(--muted);
    margin: 0 0 1rem 0;
  }
  .doj-footnote-text {
    font-size: 0.8rem;
    line-height: 1.8;
    color: var(--muted);
  }
  .doj-footnote-num {
    font-size: 0.65rem;
    vertical-align: super;
    color: var(--muted);
    margin-right: 0.25rem;
  }
  .doj-footnote-em {
    color: var(--story);
    font-weight: 600;
    font-style: normal;
  }
  .doj-footnote-label {
    display: block;
    margin-top: 1.25rem;
    font-size: 0.65rem;
    font-family: inherit;
    color: var(--muted);
    font-style: italic;
    text-align: right;
    letter-spacing: 0.05em;
  }

  @media (max-width: 600px) {
    .doj-lifecycle-stages { grid-template-columns: 1fr; gap: 0.5rem; }
    .doj-lifecycle-arrow { transform: rotate(90deg); padding: 0; }
    .doj-doc-wrap, .doj-lifecycle-wrap, .doj-footnote-wrap { padding: 1.25rem 1rem; }
    .doj-doc-docket { font-size: 0.7rem; }
  }
</style>

<StoryLayout story={story}>
  <div class="container">

    <section class="section" id="docket">
      <h2><span class="num">01 — The Docket</span>Three Days Before Summary Judgment</h2>
      <p>On September 1, 2026 — three days before the deadline for summary judgment motions in the largest copyright case OpenAI has faced — the Department of Justice filed a 20-page document that no party had requested and no court had ordered.</p>
      <p>The case is <em>In re OpenAI, Inc. Copyright Infringement Litigation</em>, MDL No. 25-md-3143, consolidated before Judge Sidney H. Stein in the Southern District of New York. The docket names The New York Times Company, the Authors Guild (with named plaintiffs including John Grisham, George R.R. Martin, Jodi Picoult, Jonathan Franzen, and Ta-Nehisi Coates), The Intercept, and individual authors and publishers — all against OpenAI and Microsoft. The original Times lawsuit was filed December 27, 2023. By April 2025, Judge Stein had largely denied the defendants' motions to dismiss, allowing the copyright infringement claims to proceed. By September 2026, the case had reached the summary judgment phase.</p>
      <p>The legal terrain around AI training and copyright was contested but tilting. On June 23, 2025, Judge William Alsup in the Northern District of California ruled in <em>Bartz v. Anthropic</em> that using legally purchased books to train large language models is fair use — "spectacularly so," in the judge's phrasing — but denied summary judgment on piracy claims, finding that training on pirated copies is different. Two days later, Judge Vince Chhabria in <em>Kadrey v. Meta</em> granted summary judgment for Meta, finding AI training fair use.</p>
      <p>In the other direction, Judge Bibas in <em>Thomson Reuters v. Ross Intelligence</em> had ruled in February 2025 that ROSS's use of Westlaw headnotes for AI training was not fair use; that case was on appeal to the Third Circuit as of June 2026. Anthropic had settled <em>Bartz</em> for $1.5 billion, with final approval entered July 20, 2026 — a settlement that valued the liability enough to pay it. Expert discovery in the OpenAI MDL had closed August 3. Summary judgment motions were due September 4.</p>
      <p>Into this, the government inserted itself. The filing was a Statement of Interest under 28 U.S.C. § 517, a statutory instrument that allows the Attorney General to direct any Department of Justice officer to attend to the government's interests in any pending case. It requires no party's request and no court's permission. Adam Eisgrau of the Chamber of Progress, an industry-aligned advocacy group, described the move as "if it's not unprecedented, it's darn unusual." The filing was signed by Associate Attorney General Stanley E. Woodward Jr. — the third-ranking official at the Department of Justice — along with Assistant Attorney General Brett Shumate and Senior Counsel Michael Weisbuch. It is advisory. It is not binding on the court. Judge Stein is under no obligation to follow it.</p>

      <div class="doj-doc-wrap">
        <div class="doj-doc-court">
          United States District Court<br />
          Southern District of New York
        </div>
        <div class="doj-doc-docket">
          Case 1:25-cv-03483-SHS-OTW &nbsp;&nbsp; Document 316 &nbsp;&nbsp; Filed 09/01/26 &nbsp;&nbsp; Page 1 of 20
        </div>
        <div class="doj-doc-title">
          <span class="doj-doc-case-name">In Re: OpenAI, Inc., Copyright Infringement Litigation</span>
          <span class="doj-doc-mdl">MDL No. 25-md-3143 (SHS) (OTW)</span>
          <span class="doj-doc-statement-title">Statement of Interest of the United States</span>
        </div>
        <div class="doj-doc-opening">
          "The United States appears pursuant to 28 U.S.C. § 517, which authorizes the Attorney General to direct any officer of the Department of Justice to attend to the interests of the United States in any case pending in any court of the United States…"
        </div>
        <div class="doj-doc-footer">
          The statute contains no time limitation and does not require the court's leave.
        </div>
      </div>
    </section>

  </div>

  <div class="phantom-wrap">
    <canvas class="doj-nyt-fair-use-statement-canvas" aria-hidden="true"></canvas>
  </div>
  <p class="canvas-note"><strong>The Weight</strong> — A semi-transparent slate-blue particle descends silently onto a level equilibrium line; the line bows under something formally weightless; ambient particles slide toward the depression; the particle lifts away but the deformation remains permanent.</p>

  <div class="container">

    <section class="section" id="argument">
      <h2><span class="num">02 — The Argument</span>What the Government Said</h2>
      <p>The Department of Justice argued that copying copyrighted written works to train a large language model "should generally be regarded as fair use." The filing called the process "exceedingly transformative" in its section heading and "extraordinarily transformative" in the body text — because, in DOJ's analysis, AI training converts works into numerical parameters rather than using them as originally intended. The reader never encounters the work as a work. The model does not store the text. It extracts patterns.</p>
      <p>The filing constructed a three-stage lifecycle of AI development and drew a line around the middle.</p>

      <div class="doj-lifecycle-wrap" tabindex="0" role="group" aria-label="What the DOJ filing addressed across the three stages of the AI lifecycle">
        <div class="doj-lifecycle-stages">
          <div class="doj-lifecycle-stage doj-lifecycle-muted">
            <span class="doj-lifecycle-num">Stage 1</span>
            <span class="doj-lifecycle-label">Acquisition</span>
            <span class="doj-lifecycle-position">No position</span>
            <div class="doj-lifecycle-questions">
              <span class="doj-lifecycle-q">Pirated copies?</span>
              <span class="doj-lifecycle-q">Not addressed</span>
            </div>
          </div>
          <div class="doj-lifecycle-arrow">&rarr;</div>
          <div class="doj-lifecycle-stage doj-lifecycle-active">
            <span class="doj-lifecycle-num">Stage 2</span>
            <span class="doj-lifecycle-label">Training</span>
            <span class="doj-lifecycle-position">Fair Use</span>
            <div class="doj-lifecycle-questions">
              <span class="doj-lifecycle-q">Memorization?</span>
              <span class="doj-lifecycle-q">Not addressed</span>
            </div>
          </div>
          <div class="doj-lifecycle-arrow">&rarr;</div>
          <div class="doj-lifecycle-stage doj-lifecycle-muted">
            <span class="doj-lifecycle-num">Stage 3</span>
            <span class="doj-lifecycle-label">Output</span>
            <span class="doj-lifecycle-position">No position</span>
            <div class="doj-lifecycle-questions">
              <span class="doj-lifecycle-q">Infringing outputs?</span>
              <span class="doj-lifecycle-q">Not addressed</span>
            </div>
          </div>
        </div>
        <div class="doj-lifecycle-source">DOJ Statement of Interest — September 1, 2026</div>
        <div class="doj-lifecycle-footer">The government chose the cleanest terrain. Whether copies were pirated, whether outputs reproduce protected expression, and whether models memorize and regurgitate source material — none of it was addressed.</div>
      </div>

      <p>Stage one: how the training data was acquired or collected. Stage two: training itself — the process of making copies for the purpose of adjusting model parameters. Stage three: what the model generates. The DOJ took a position on stage two only. It explicitly declined to address whether pirated or unlawfully obtained copies change the analysis. It took no position on whether outputs that reproduce protected expression infringe copyright. It did not address memorization or regurgitation. It did not address DMCA claims.</p>
      <p>The filing confined its analysis to written works. A footnote stated that the legal arguments "apply similarly to all parties in this litigation and the related cases, including book authors and publishers." Recordings and musical compositions — the subject of pending cases against other AI companies — received no mention anywhere in the filing's 20 pages.</p>
      <p>Two arguments in the filing carry weight beyond the copyright analysis itself. The first was national security. "Rules of law that make it significantly more difficult to develop a robust AI industry in the United States therefore threaten national security and give a competitive advantage to foreign adversaries who are not so encumbered," the filing stated on page 3. The second was competition. The DOJ argued that requiring licensing for AI training would create anticompetitive barriers because "only the largest technology companies might have the capital necessary to pay licensing fees." Licensing fees, in DOJ's framing, would "disproportionately benefit legacy media outlets due to the sheer volume of their written publications."</p>
      <p>The filing offered creators a direction: whether this new technology warrants "a wholesale rewriting of copyright principles," the filing stated, "is a policy question best left to the People and their elected representatives." The DOJ concluded that "it would be problematic — and legally incorrect — to impose broad copyright liability that would generally render training of AI models impermissible without licensing."</p>
      <p>The filing opened by declaring that "the United States has a strong interest in continuing to develop a robust and competitive artificial intelligence industry that sets the standard for the practice and procedure of AI use globally." It stated that any broader rewriting of copyright principles is a policy question for the People and their elected representatives — and then closed by declaring the current law sufficient.</p>
    </section>

    <section class="section" id="friendly-fire">
      <h2><span class="num">03 — Friendly Fire</span>The Reasoning It Attacked Anyway</h2>
      <p>The DOJ did not confine itself to making an affirmative argument. It went further, attacking legal reasoning it considered dangerous to the position it wanted to establish — including reasoning from rulings that already favored the same side the DOJ was backing.</p>
      <p><em>Kadrey v. Meta</em> was a defense victory. Judge Chhabria granted summary judgment for Meta, finding AI training fair use. The DOJ agreed with the outcome. It attacked the reasoning anyway. Specifically, the filing called the <em>Kadrey</em> court's fourth-factor analysis — its treatment of market harm — "deeply flawed." The publishers' theory was market dilution: that AI-generated text competes with human-authored works in the same genre, even when the outputs are not substantially similar to any specific copyrighted work. Judge Chhabria had engaged with this theory on its own terms. The DOJ wanted it erased. A market-dilution theory that survives in the reasoning of a defense-favorable ruling can be cited by future plaintiffs. The DOJ was not content to win the case. It wanted to clear the field.</p>
      <p>The filing reserved its sharpest language for a government agency outside its own branch.</p>

      <div class="doj-footnote-wrap">
        <hr class="doj-footnote-rule" />
        <p class="doj-footnote-text">
          <span class="doj-footnote-num">17</span>
          The Register of Copyrights expressed a different view. <em>See</em> U.S. Copyright Office, <em>Copyright and Artificial Intelligence, Part 3: Generative AI Training</em> (May 2025). <span class="doj-footnote-em">Her understanding does not warrant deference</span> for several reasons. […] <span class="doj-footnote-em">The Register's threadbare reasoning ignored all the caselaw</span> emphasizing the required use-by-use analysis […]
        </p>
        <span class="doj-footnote-label">The executive branch, on the Copyright Office.</span>
      </div>

      <p>In May 2025, the U.S. Copyright Office released Part 3 of its report on AI and copyright — 108 pages on generative AI training. The Register of Copyrights took a more qualified position than the DOJ would later adopt: training can be transformative, but fair use depends on specific facts, and commercial training on illegally accessed material that produces competing content may fall outside fair use. The DOJ dismissed this in a footnote. Footnote 17. The Register's understanding "does not warrant deference." Her reasoning was "threadbare" and "ignored all the caselaw." The executive branch publicly dismissed 108 pages of the Copyright Office's legal analysis — a legislative-branch agency's expert work product — in a single footnote of a court filing.</p>
      <p>The pattern across these two moves is consistent. The DOJ did not simply argue that AI training is fair use. It preemptively targeted legal reasoning — from a federal judge and from the government's own copyright authority — that left any daylight for future copyright claims against AI training, even where that reasoning had already produced outcomes the DOJ agreed with.</p>
    </section>

    <section class="section" id="who-benefits">
      <h2><span class="num">04 — The Contradiction</span>Who Benefits</h2>
      <p>The DOJ's stated rationale for intervening was competition: licensing requirements would entrench Big Tech. The structural consequence of the filing is to shield Big Tech's largest AI company from copyright liability in its largest case.</p>
      <p>The contradiction is arithmetic. The DOJ argued that requiring licensing would create barriers because "only the largest technology companies might have the capital necessary to pay licensing fees." The defendant this filing directly benefits is OpenAI, valued at $852 billion as of its March 2026 funding round. By the DOJ's own metric — capital necessary to pay licensing fees — OpenAI is the company that least needs protection from licensing costs. If the court accepts the government's fair-use argument, the immediate beneficiary is not a scrappy startup foreclosed from the market by licensing requirements. It is the most heavily capitalized AI company on Earth.</p>
      <p>The "go to Congress" remedy the filing offers creators is, in practice, a referral to the institution least equipped and least likely to act. Congress has held hearings on AI and copyright but has passed no AI copyright legislation. The asymmetry is structural: the defendants get a judicial resolution now, one endorsed by the executive branch. The creators get a suggestion to try the legislature.</p>
      <p>Graham James, a spokesman for The New York Times — a named plaintiff in the case — responded: "The Administration is siding with a handful of trillion-dollar AI companies at the expense of the countless American creators whose work they stole." He added: "Both AI and creators can thrive — AI companies simply need to pay fairly for the content that makes their products possible, as copyright law requires." Matt Topic, an attorney for The Intercept — also a consolidated plaintiff — said the DOJ's position, if accepted, would result in "an unprecedented, uncompensated transfer of IP rights from news organizations to tech companies." These are statements from parties with direct stakes in the outcome.</p>
      <p>Neither OpenAI nor Microsoft issued a formal on-the-record response to the DOJ filing.</p>
      <p>The filing is advisory. Judge Stein can disregard it entirely. But a 20-page Statement of Interest signed by the third-ranking official at the Department of Justice, filed three days before the parties themselves argued their positions, is not nothing. Even if the court ignores the filing, the government's position is now on the record in the precedent-setting case. It shapes settlement calculations. It provides ammunition for future filings in other courts. It signals to every small publisher considering a copyright claim against an AI company that the executive branch has already chosen a side. A non-binding document can have binding consequences.</p>
    </section>

    <section class="section" id="unmentioned-interest">
      <h2><span class="num">05 — The Omission</span>The Unmentioned Interest</h2>
      <p>Two months before the DOJ filed its Statement of Interest, the Financial Times reported that OpenAI had proposed giving the U.S. government a roughly 5 percent equity stake in the company. Based on OpenAI's $852 billion valuation from a March 2026 funding round, a 5 percent share would be worth approximately $42.6 billion. The talks were described as "early conversations." Sam Altman had discussed the proposal with President Trump, Commerce Secretary Howard Lutnick, and Treasury Secretary Scott Bessent. Any deal would likely require an act of Congress. No update on the proposal's status has been publicly reported since July.</p>
      <p>The DOJ's 20-page Statement of Interest opens with a section titled "The Interest of the United States." That section runs about three and a half pages. It discusses national security. It discusses the competitive position of American AI companies. It discusses the importance of avoiding regulatory barriers. It does not mention the reported equity-stake negotiations anywhere in its pages.</p>
      <p>Joe Patrice, a senior editor at the legal blog Above the Law, called the omission "a cynical, selective intervention for corrupt purposes" and described the filing as "a financial giveaway to a multibillion dollar company that they intend to take a financial stake in." These are characterizations from a legal-industry opinion column, not findings of fact. No specific ethics rule or disclosure requirement for Statements of Interest under § 517 has been identified by any source in the public record. No formal ethics complaint has been filed. No judge has raised the issue. The DOJ and the White House have not publicly addressed the criticism. The temporal gap — two months between the July report of early conversations and the September filing — leaves the status of those negotiations at filing time unknown.</p>
      <p>What is known is this: the Financial Times reported equity-stake talks in July. The DOJ filed a Statement of Interest favoring OpenAI in September. The filing's section declaring the government's interest did not disclose the reported financial interest. Whether this represents an undisclosed conflict, an oversight, or a judgment that preliminary policy discussions require no disclosure in a § 517 filing is a question no public record currently answers.</p>
      <p>The summary judgment motions were filed on September 4, 2026 — three days after the government's position was already on the record. Judge Stein will decide the copyright question. The Statement of Interest is advisory. But the question of who spoke for the United States in that filing, and which interests they represented, has no docket entry and no pending motion. It sits in the space between what the document says and what it does not say — a gap that no court is positioned to close, and that no party has standing to litigate.</p>
    </section>

  </div>
</StoryLayout>

<script>
(function () {
  const canvas = document.querySelector('.doj-nyt-fair-use-statement-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  /* ── Read CSS custom properties ── */
  const rootStyle = getComputedStyle(document.documentElement);
  const bgColor = rootStyle.getPropertyValue('--bg').trim() || '#0d0d0d';
  const storyHex = rootStyle.getPropertyValue('--story').trim() || '#8fa9c9';
  const sr = parseInt(storyHex.slice(1, 3), 16) || 143;
  const sg = parseInt(storyHex.slice(3, 5), 16) || 169;
  const sb = parseInt(storyHex.slice(5, 7), 16) || 201;

  function storyA(a: number) { return `rgba(${sr},${sg},${sb},${Math.max(0, Math.min(1, a)).toFixed(4)})`; }
  function dimA(a: number) { return `rgba(232,232,232,${Math.max(0, Math.min(1, a)).toFixed(4)})`; }

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Constants ── */
  const CYCLE = 1200;        // 20 seconds at 60fps
  const N = 14;              // ambient particles (matched pairs)
  const SIGMA = 120;         // Gaussian width of depression
  const MAX_DEP = 30;        // peak depression in px
  const FINAL_DEP = 22;      // settled depression after partial recovery
  const LINE_SEGS = 150;     // segments for line smoothness

  /* Phase boundaries */
  const P_CALM      = 300;   // equilibrium
  const P_DESCENT   = 480;   // particle reaches line
  const P_CONTACT   = 660;   // depression fully formed
  const P_LIFT      = 780;   // particle lifted, line partially recovered
  const P_HOLD      = 1080;  // permanent deformation held
  const P_FADE      = 1200;  // fade complete, snap reset

  /* ── State ── */
  let W = 0, H = 0, frame = 0, rafId = 0;
  let dep = 0;

  const px: number[]  = new Array(N);
  const pvx: number[] = new Array(N);
  const ppo: number[] = new Array(N);
  const prd: number[] = new Array(N);

  function initParticles() {
    const w = W > 0 ? W : 800;
    for (let i = 0; i < N; i++) {
      px[i]  = w * ((i + 0.5) / N) + (Math.random() - 0.5) * 20;
      pvx[i] = i % 2 === 0 ? 0.3 : -0.3;
      ppo[i] = Math.random() * Math.PI * 2;
      prd[i] = 2 + Math.random() * 1.2;
    }
  }
  initParticles();

  function resetState() {
    frame = 0;
    dep = 0;
    initParticles();
  }

  function easeOutCubic(t: number) { return 1 - (1 - t) * (1 - t) * (1 - t); }

  function lineY(x: number): number {
    const base = H * 0.5;
    if (dep <= 0) return base;
    const cx = W * 0.5;
    const dx = x - cx;
    return base + dep * Math.exp(-(dx * dx) / (2 * SIGMA * SIGMA));
  }

  function update() {
    const c = frame % CYCLE;
    const cx = W * 0.5;

    if (c < P_DESCENT) {
      dep = 0;
    } else if (c < P_CONTACT) {
      dep = MAX_DEP * easeOutCubic((c - P_DESCENT) / (P_CONTACT - P_DESCENT));
    } else if (c < P_LIFT) {
      dep = MAX_DEP - (MAX_DEP - FINAL_DEP) * easeOutCubic((c - P_CONTACT) / (P_LIFT - P_CONTACT));
    } else {
      dep = FINAL_DEP;
    }

    for (let i = 0; i < N; i++) {
      px[i] += pvx[i];

      if (c >= P_DESCENT && c < P_HOLD && dep > 2) {
        const dx = cx - px[i];
        const dist = Math.abs(dx);
        let strength = 0;
        if (c < P_CONTACT)    strength = 0.15;
        else if (c < P_LIFT)  strength = 0.10;
        else                  strength = 0.04;
        if (dist > 25) px[i] += Math.sign(dx) * strength;
      }

      if (px[i] > W + 30) px[i] = -30;
      if (px[i] < -30) px[i] = W + 30;
    }
  }

  function draw() {
    if (!ctx) return;
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = bgColor;
    ctx.fillRect(0, 0, W, H);
    if (W === 0 || H === 0) return;

    const c = frame % CYCLE;
    const cx = W * 0.5;
    const baseY = H * 0.5;

    let gAlpha = 1;
    if (c >= P_HOLD) gAlpha = Math.max(0, 1 - (c - P_HOLD) / (P_FADE - P_HOLD));
    ctx.globalAlpha = gAlpha;

    if (dep > 2) {
      const depCenter = lineY(cx);
      const grad = ctx.createRadialGradient(cx, depCenter, 0, cx, depCenter, SIGMA * 1.2);
      grad.addColorStop(0, storyA(0.08 * dep / MAX_DEP));
      grad.addColorStop(1, storyA(0));
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(cx, depCenter, SIGMA * 1.2, 0, Math.PI * 2);
      ctx.fill();
    }

    ctx.beginPath();
    ctx.strokeStyle = dimA(0.08);
    ctx.lineWidth = 1;
    for (let i = 0; i <= LINE_SEGS; i++) {
      const x = (i / LINE_SEGS) * W;
      const y = lineY(x);
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();

    for (let i = 0; i < N; i++) {
      const wobble = Math.sin(frame * Math.PI / 120 + ppo[i]) * 2;
      const y = lineY(px[i]) + wobble;
      ctx.beginPath();
      ctx.arc(px[i], y, prd[i], 0, Math.PI * 2);
      ctx.fillStyle = dimA(0.06);
      ctx.fill();
    }

    if (c >= P_CALM && c < P_HOLD) {
      const bx = cx;
      let by = 0;

      if (c < P_DESCENT) {
        const t = (c - P_CALM) / (P_DESCENT - P_CALM);
        by = 10 + t * (baseY - 10);
      } else if (c < P_CONTACT) {
        by = lineY(cx);
      } else if (c < P_LIFT) {
        const t = (c - P_CONTACT) / (P_LIFT - P_CONTACT);
        by = lineY(cx) - t * 24;
      } else {
        by = lineY(cx) - 24 + Math.sin(frame * 0.011) * 1.5;
      }

      const glowGrad = ctx.createRadialGradient(bx, by, 0, bx, by, 18);
      glowGrad.addColorStop(0, storyA(0.12));
      glowGrad.addColorStop(1, storyA(0));
      ctx.fillStyle = glowGrad;
      ctx.beginPath();
      ctx.arc(bx, by, 18, 0, Math.PI * 2);
      ctx.fill();

      ctx.beginPath();
      ctx.arc(bx, by, 3.5, 0, Math.PI * 2);
      ctx.fillStyle = storyA(0.45);
      ctx.fill();
    }

    ctx.globalAlpha = 1;
  }

  function drawStatic() {
    if (!ctx) return;
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = bgColor;
    ctx.fillRect(0, 0, W, H);
    if (W === 0 || H === 0) return;

    const cx = W * 0.5;
    dep = FINAL_DEP;

    const depCenter = lineY(cx);
    const grad = ctx.createRadialGradient(cx, depCenter, 0, cx, depCenter, SIGMA * 1.2);
    grad.addColorStop(0, storyA(0.08 * FINAL_DEP / MAX_DEP));
    grad.addColorStop(1, storyA(0));
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.arc(cx, depCenter, SIGMA * 1.2, 0, Math.PI * 2);
    ctx.fill();

    ctx.beginPath();
    ctx.strokeStyle = dimA(0.08);
    ctx.lineWidth = 1;
    for (let i = 0; i <= LINE_SEGS; i++) {
      const x = (i / LINE_SEGS) * W;
      const y = lineY(x);
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();

    for (let i = 0; i < N; i++) {
      const clusteredX = cx + Math.sin(i * 2.7 + 1.3) * SIGMA * 0.5;
      const wobble = Math.sin(ppo[i]) * 2;
      const y = lineY(clusteredX) + wobble;
      ctx.beginPath();
      ctx.arc(clusteredX, y, prd[i], 0, Math.PI * 2);
      ctx.fillStyle = dimA(0.06);
      ctx.fill();
    }

    const hoverY = lineY(cx) - 24;
    const glowGrad = ctx.createRadialGradient(cx, hoverY, 0, cx, hoverY, 18);
    glowGrad.addColorStop(0, storyA(0.12));
    glowGrad.addColorStop(1, storyA(0));
    ctx.fillStyle = glowGrad;
    ctx.beginPath();
    ctx.arc(cx, hoverY, 18, 0, Math.PI * 2);
    ctx.fill();

    ctx.beginPath();
    ctx.arc(cx, hoverY, 3.5, 0, Math.PI * 2);
    ctx.fillStyle = storyA(0.45);
    ctx.fill();
  }

  function tick() {
    frame++;
    if (frame % CYCLE === 0) resetState();
    update();
    draw();
    rafId = requestAnimationFrame(tick);
  }

  function sizeCanvas() {
    if (!ctx) return;
    const dpr = window.devicePixelRatio || 1;
    W = canvas!.offsetWidth;
    H = canvas!.offsetHeight;
    canvas!.width = W * dpr;
    canvas!.height = H * dpr;
    ctx.scale(dpr, dpr);
  }

  const ro = new ResizeObserver(() => {
    sizeCanvas();
    if (prefersReduced) drawStatic();
  });
  ro.observe(canvas);

  sizeCanvas();

  if (prefersReduced) {
    drawStatic();
    window.addEventListener('pagehide', () => { ro.disconnect(); });
  } else {
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) {
        if (!rafId) rafId = requestAnimationFrame(tick);
      } else {
        cancelAnimationFrame(rafId);
        rafId = 0;
      }
    }, { threshold: 0.01 });
    io.observe(canvas);

    window.addEventListener('pagehide', () => {
      cancelAnimationFrame(rafId);
      io.disconnect();
      ro.disconnect();
    });
  }
})();
</script>

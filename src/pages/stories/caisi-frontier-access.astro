---
import StoryLayout from '../../layouts/StoryLayout.astro';
import stories from '../../data/stories.json';

const story = stories.find(s => s.slug === 'caisi-frontier-access')!;
---

<style is:global>
  /* ── Canvas ── */
  .phantom-wrap { width: 100%; margin: 0; line-height: 0; }
  .caisi-frontier-access-canvas { display: block; width: 100%; height: 380px; background: var(--bg); }

  /* ── Reenactment 1: Document Mockup ── */
  .cfa-doc-wrap {
    margin: 2rem 0;
    background: #0b1018;
    border: 1px solid #2a3a4f;
    border-radius: 6px;
    font-family: 'SF Mono', Menlo, Consolas, monospace;
    overflow: hidden;
  }
  .cfa-doc-header {
    background: #0d1520;
    border-bottom: 1px solid #2a3a4f;
    padding: 0.9rem 1.25rem;
    text-align: center;
  }
  .cfa-doc-header .cfa-doc-agency {
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6b8caf;
    margin-bottom: 0.2rem;
  }
  .cfa-doc-header .cfa-doc-title {
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c8d8e8;
    font-weight: 600;
  }
  .cfa-doc-body { padding: 1.25rem 1.5rem 1.5rem; }
  .cfa-doc-subject {
    font-size: 0.75rem;
    color: #8aa0b8;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1.1rem;
  }
  .cfa-doc-field {
    display: flex;
    margin: 0.5rem 0;
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .cfa-doc-label {
    color: #6b8caf;
    min-width: 110px;
    flex-shrink: 0;
    letter-spacing: 0.04em;
  }
  .cfa-doc-value { color: #c8d8e8; }
  .cfa-doc-blank {
    color: #ff6b6b;
    font-style: italic;
    opacity: 0.85;
  }
  .cfa-doc-divider {
    border: none;
    border-top: 1px solid #1e2e3e;
    margin: 1rem 0;
  }
  .cfa-doc-terms {
    padding: 0;
    margin: 0.8rem 0;
    list-style: none;
  }
  .cfa-doc-terms li {
    font-size: 0.8rem;
    color: #a0b8cc;
    line-height: 1.6;
    padding: 0.25rem 0;
    padding-left: 1rem;
    position: relative;
  }
  .cfa-doc-terms li::before {
    content: '\2014';
    position: absolute;
    left: 0;
    color: #3a5068;
  }
  .cfa-doc-terms li em {
    color: #7a9ab0;
    font-size: 0.72rem;
  }
  .cfa-doc-foot {
    padding: 0.75rem 1.25rem;
    border-top: 1px solid #2a3a4f;
    background: #080e14;
  }
  .cfa-doc-foot-row {
    display: flex;
    justify-content: space-between;
    margin: 0.3rem 0;
    font-size: 0.72rem;
  }
  .cfa-doc-foot-label {
    color: #6a8aa0;
    letter-spacing: 0.04em;
  }
  .cfa-doc-foot-value {
    color: #ff6b6b;
    font-style: italic;
  }
  .cfa-doc-note {
    margin-top: 0.8rem;
    font-size: 0.7rem;
    color: #7a8a98;
    line-height: 1.5;
    font-style: italic;
  }

  /* ── Reenactment 2: Two-Panel Quote Contrast ── */
  .cfa-panels-wrap { margin: 2rem 0; }
  .cfa-panels-card {
    background: #0b1018;
    border: 1px solid #2a3a4f;
    border-radius: 6px;
    padding: 1.25rem 1.5rem;
    font-family: 'SF Mono', Menlo, Consolas, monospace;
  }
  .cfa-panels-card:first-child {
    border-radius: 6px 6px 0 0;
    border-bottom: none;
  }
  .cfa-panels-card:last-child {
    border-radius: 0 0 6px 6px;
  }
  .cfa-panels-meta {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b8caf;
    margin-bottom: 0.3rem;
  }
  .cfa-panels-speaker {
    font-size: 0.75rem;
    color: #8aa0b8;
    margin-bottom: 0.8rem;
    letter-spacing: 0.03em;
  }
  .cfa-panels-quote {
    font-size: 0.88rem;
    color: #c8d8e8;
    line-height: 1.6;
    white-space: pre-line;
    font-style: italic;
  }
  .cfa-panels-gap {
    background: #080e14;
    border-left: 1px solid #2a3a4f;
    border-right: 1px solid #2a3a4f;
    padding: 0.6rem 0;
    text-align: center;
    font-family: 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #ff6b6b;
  }
  .cfa-panels-note {
    margin-top: 0.8rem;
    font-size: 0.7rem;
    color: #7a8a98;
    line-height: 1.5;
    font-style: italic;
  }

  /* ── Reenactment 3: Chain Diagram ── */
  .cfa-chain-wrap {
    margin: 2rem 0;
    background: #0b1018;
    border: 1px solid #2a3a4f;
    border-radius: 6px;
    font-family: 'SF Mono', Menlo, Consolas, monospace;
    overflow: hidden;
    padding: 1.5rem;
  }
  .cfa-chain-title {
    text-align: center;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6b8caf;
    margin-bottom: 1.5rem;
  }
  .cfa-chain-node {
    background: #0d1520;
    border: 1px solid #1e2e3e;
    border-radius: 4px;
    padding: 1rem 1.25rem;
    margin-bottom: 0;
  }
  .cfa-chain-node-label {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b8caf;
    margin-bottom: 0.4rem;
  }

/* === Responsive === */
@media (max-width: 600px) {
  .ross-doc-panels { grid-template-columns: 1fr; }
  .ross-doc-panel + .ross-doc-panel { border-left: none; border-top: 1px solid var(--border); }
  .ross-score-row { grid-template-columns: 1fr; }
  .ross-score-verdict { text-align: left; padding-left: 1rem; }
  .ross-score-reason { border-left: none; border-top: 1px solid var(--border); }

    return [
      parseInt(v.slice(0, 2), 16),
      parseInt(v.slice(2, 4), 16),
      parseInt(v.slice(4, 6), 16)
    ];
  }
  const [sR, sG, sB] = hexRgb(storyHex);

  function storyA(a: number): string {
    return 'rgba(' + sR + ',' + sG + ',' + sB + ',' + a.toFixed(3) + ')';
  }
  function dimA(a: number): string {
    return 'rgba(232,232,232,' + a.toFixed(3) + ')';
  }

  /* --- Timing (18s at 60fps) --- */
  const CYCLE = 1080;
  const P1 = 240;   /* assemble */
  const P2 = 360;   /* separate footnote */
  const P3 = 600;   /* block dims, margin glows */
  const P4 = 840;   /* peak hold */
  const P5 = 1020;  /* dissolve */
  /* 1020–1080: scatter + reset */

  const BLOCK_N = 50;
  const FN_N = 4;
  const EDGE_N = 5;

  /* --- State --- */
  let W = 0, H = 0, rafId = 0, frame = 0, running = false;

  type BlockP = {
    sx: number; sy: number;
    bx: number; by: number;
    fx: number; fy: number;
    x: number; y: number;
    alpha: number;
    isFN: boolean;
    delay: number;
    seed: number;
  };

  type EdgeP = {
    x: number; y: number;
    vx: number; vy: number;
    alpha: number;
  };

  let bp: BlockP[] = [];
  let ep: EdgeP[] = [];
  let fnIdx: number[] = [];

  /* --- Layout --- */
  function computeTargets() {
    const rW = W * 0.55;
    const rH = H * 0.40;
    const rX = (W - rW) / 2;
    const rY = H * 0.16;

    const cols = 10;
    const rows = 5;
    const spX = rW / (cols + 1);
    const spY = rH / (rows + 1);

    for (let i = 0; i < BLOCK_N && i < bp.length; i++) {
      const col = i % cols;
      const row = Math.floor(i / cols);
      bp[i].bx = rX + (col + 1) * spX + Math.sin(bp[i].seed * 7.3) * spX * 0.18;
      bp[i].by = rY + (row + 1) * spY + Math.cos(bp[i].seed * 5.1) * spY * 0.18;
    }

    /* Footnote targets: centered below block with gap */
    fnIdx = [];
    const fnBaseY = rY + rH + 38;
    const fnSpread = 56;
    const fnCX = W / 2;

    for (let i = 0; i < FN_N; i++) {
      const idx = BLOCK_N - FN_N + i;
      if (idx < bp.length) {
        fnIdx.push(idx);
        bp[idx].isFN = true;
        bp[idx].fx = fnCX + (i - (FN_N - 1) / 2) * (fnSpread / Math.max(1, FN_N - 1))
                     + Math.sin(bp[idx].seed * 3.7) * 4;
        bp[idx].fy = fnBaseY + Math.cos(bp[idx].seed * 2.3) * 5;
      }
    }
  }

  function initEdges() {
    ep = [];
    const spots: [number, number][] = [
      [W * 0.06, H * 0.48],
      [W * 0.94, H * 0.22],
      [W * 0.93, H * 0.78],
      [W * 0.10, H * 0.10],
      [W * 0.90, H * 0.90]
    ];
    for (let i = 0; i < EDGE_N; i++) {
      const a = (i / EDGE_N) * Math.PI * 2 + 0.7;
      ep.push({
        x: spots[i][0], y: spots[i][1],
        vx: Math.cos(a) * 0.12,
        vy: Math.sin(a) * 0.12,
        alpha: 0.035
      });
    }
  }

  function init() {
    bp = [];
    for (let i = 0; i < BLOCK_N; i++) {
      bp.push({
        sx: Math.random() * W, sy: Math.random() * H,
        bx: 0, by: 0, fx: 0, fy: 0,
        x: 0, y: 0, alpha: 0.015,
        isFN: false,
        delay: Math.random() * 50,
        seed: i + Math.random()
      });
    }
    computeTargets();
    for (const p of bp) { p.x = p.sx; p.y = p.sy; }
    initEdges();
    frame = 0;
  }

  /* --- Helpers --- */
  function ease(t: number): number {
    const c = t < 0 ? 0 : t > 1 ? 1 : t;
    return c * c * (3 - 2 * c);
  }

  function lerp(a: number, b: number, t: number): number {
    return a + (b - a) * t;
  }

  /* --- Draw --- */
  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = bgColor;
    ctx.fillRect(0, 0, W, H);

    /* Update edge drift */
    for (const e of ep) {
      e.x += e.vx;
      e.y += e.vy;
      if (e.x < W * 0.03 || e.x > W * 0.97) e.vx *= -1;
      if (e.y < H * 0.03 || e.y > H * 0.97) e.vy *= -1;
    }

    const f = frame;
    let fnStoryMix = 0;
    let lineAlpha = 0;
    let edgeGlow = 0;
    let globalFade = 1;

    /* ---- PHASE 1: ASSEMBLE ---- */
    if (f < P1) {
      for (let i = 0; i < bp.length; i++) {
        const p = bp[i];
        const t = ease(Math.max(0, (f - p.delay) / (P1 - p.delay)));
        p.x = lerp(p.sx, p.bx, t);
        p.y = lerp(p.sy, p.by, t);
        p.alpha = lerp(0.015, 0.065, t);
      }
      for (const e of ep) e.alpha = 0.03;
    }

    /* ---- PHASE 2: SEPARATE ---- */
    else if (f < P2) {
      const t = ease((f - P1) / (P2 - P1));
      for (const p of bp) {
        if (p.isFN) {
          p.x = lerp(p.bx, p.fx, t);
          p.y = lerp(p.by, p.fy, t);
        }
        p.alpha = 0.065;
      }
      for (const e of ep) e.alpha = 0.03;
    }

    /* ---- PHASE 3: GLOW ---- */
    else if (f < P3) {
      const t = ease((f - P2) / (P3 - P2));
      fnStoryMix = t;
      lineAlpha = t * 0.08;
      edgeGlow = t * 0.025;
      const pulse = 0.4 + 0.4 * Math.sin(f * 0.033);
      for (const p of bp) {
        if (p.isFN) {
          p.alpha = lerp(0.065, pulse, t);
        } else {
          p.alpha = lerp(0.065, 0.018, t);
          /* subtle breathing on dim block */
          p.x = p.bx + Math.sin(f * 0.018 + p.seed * 1.5) * 0.3;
          p.y = p.by + Math.cos(f * 0.022 + p.seed * 2.1) * 0.2;
        }
      }
      for (const e of ep) e.alpha = 0.03 + edgeGlow;
    }

    /* ---- PHASE 4: PEAK HOLD ---- */
    else if (f < P4) {
      const t = (f - P3) / (P4 - P3);
      fnStoryMix = 1;
      const pulseCurve = t < 0.4 ? ease(t / 0.4) : 1 - ease((t - 0.4) / 0.6);
      lineAlpha = 0.08 + 0.07 * pulseCurve;
      edgeGlow = 0.025 + 0.075 * pulseCurve;
      const pulse = 0.5 + 0.4 * Math.sin(f * 0.033);
      for (const p of bp) {
        if (p.isFN) {
          p.alpha = pulse;
        } else {
          p.alpha = 0.018;
          p.x = p.bx + Math.sin(f * 0.018 + p.seed * 1.5) * 0.3;
          p.y = p.by + Math.cos(f * 0.022 + p.seed * 2.1) * 0.2;
        }
      }
      for (const e of ep) e.alpha = 0.03 + edgeGlow;
    }

    /* ---- PHASE 5: DISSOLVE ---- */
    else if (f < P5) {
      const t = ease((f - P4) / (P5 - P4));
      fnStoryMix = 1 - t;
      lineAlpha = lerp(0.08, 0, t);
      edgeGlow = lerp(0.025, 0, t);
      for (const p of bp) {
        if (p.isFN) {
          p.alpha = lerp(0.5, 0.06, t);
        } else {
          p.alpha = 0.018;
          p.x = p.bx + Math.sin(f * 0.018 + p.seed * 1.5) * 0.3;
          p.y = p.by + Math.cos(f * 0.022 + p.seed * 2.1) * 0.2;
        }
      }
      for (const e of ep) e.alpha = lerp(0.04, 0.015, t);
    }

    /* ---- PHASE 6: SCATTER + RESET ---- */
    else {
      const t = ease((f - P5) / (CYCLE - P5));
      globalFade = 1 - t;
      const cx = W / 2, cy = H / 2;
      for (const p of bp) {
        const refX = p.isFN ? p.fx : p.bx;
        const refY = p.isFN ? p.fy : p.by;
        const dx = refX - cx;
        const dy = refY - cy;
        p.x = refX + dx * t * 0.7;
        p.y = refY + dy * t * 0.7;
        p.alpha = lerp(0.04, 0, t);
      }
      for (const e of ep) e.alpha = lerp(0.015, 0, t);
    }

    /* --- Render block particles --- */
    for (const p of bp) {
      const a = p.alpha * globalFade;
      if (a < 0.004) continue;

      if (p.isFN && fnStoryMix > 0.01) {
        const cr = Math.round(lerp(232, sR, fnStoryMix));
        const cg = Math.round(lerp(232, sG, fnStoryMix));
        const cb = Math.round(lerp(232, sB, fnStoryMix));
        const cStr = cr + ',' + cg + ',' + cb;

        /* radial glow when bright */
        if (a > 0.15) {
          const gr = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, 16);
          gr.addColorStop(0, 'rgba(' + cStr + ',' + (a * 0.28).toFixed(3) + ')');
          gr.addColorStop(1, 'rgba(' + cStr + ',0)');
          ctx.fillStyle = gr;
          ctx.beginPath();
          ctx.arc(p.x, p.y, 16, 0, Math.PI * 2);
          ctx.fill();
        }

        ctx.fillStyle = 'rgba(' + cStr + ',' + a.toFixed(3) + ')';
      } else {
        ctx.fillStyle = dimA(a);
      }

      ctx.beginPath();
      ctx.arc(p.x, p.y, 2.5, 0, Math.PI * 2);
      ctx.fill();
    }

    /* --- Render connection lines --- */
    const la = lineAlpha * globalFade;
    if (la > 0.004 && fnIdx.length > 0) {
      let fcx = 0, fcy = 0;
      for (const idx of fnIdx) { fcx += bp[idx].x; fcy += bp[idx].y; }
      fcx /= fnIdx.length;
      fcy /= fnIdx.length;

      ctx.strokeStyle = storyA(la);
      ctx.lineWidth = 0.5;
      for (const e of ep) {
        ctx.beginPath();
        ctx.moveTo(fcx, fcy);
        ctx.lineTo(e.x, e.y);
        ctx.stroke();
      }
    }

    /* --- Render edge particles --- */
    for (const e of ep) {
      const a = e.alpha * globalFade;
      if (a < 0.004) continue;

      /* story-color halo when glowing */
      if (edgeGlow > 0.02 && globalFade > 0.5) {
        const ha = edgeGlow * 0.45 * globalFade;
        const gr = ctx.createRadialGradient(e.x, e.y, 0, e.x, e.y, 9);
        gr.addColorStop(0, storyA(ha));
        gr.addColorStop(1, storyA(0));
        ctx.fillStyle = gr;
        ctx.beginPath();
        ctx.arc(e.x, e.y, 9, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.fillStyle = dimA(a);
      ctx.beginPath();
      ctx.arc(e.x, e.y, 2, 0, Math.PI * 2);
      ctx.fill();
    }

    /* --- Advance --- */
    frame++;
    if (frame >= CYCLE) {
      for (const p of bp) {
        p.sx = Math.random() * W;
        p.sy = Math.random() * H;
        p.x = p.sx;
        p.y = p.sy;
        p.alpha = 0.015;
        p.isFN = false;
        p.delay = Math.random() * 50;
      }
      computeTargets();
      frame = 0;
    }
  }

  /* --- Static frame (reduced motion) --- */
  function drawStatic() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = bgColor;
    ctx.fillRect(0, 0, W, H);

    computeTargets();

    /* dim block */
    for (let i = 0; i < bp.length; i++) {
      if (bp[i].isFN) continue;
      ctx.fillStyle = dimA(0.02);
      ctx.beginPath();
      ctx.arc(bp[i].bx, bp[i].by, 2.5, 0, Math.PI * 2);
      ctx.fill();
    }

    /* bright footnote */
    for (const idx of fnIdx) {
      const p = bp[idx];
      const gr = ctx.createRadialGradient(p.fx, p.fy, 0, p.fx, p.fy, 16);
      gr.addColorStop(0, storyA(0.2));
      gr.addColorStop(1, storyA(0));
      ctx.fillStyle = gr;
      ctx.beginPath();
      ctx.arc(p.fx, p.fy, 16, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = storyA(0.6);
      ctx.beginPath();
      ctx.arc(p.fx, p.fy, 2.5, 0, Math.PI * 2);
      ctx.fill();
    }

    /* connection lines */
    let fcx = 0, fcy = 0;
    for (const idx of fnIdx) { fcx += bp[idx].fx; fcy += bp[idx].fy; }
    if (fnIdx.length > 0) { fcx /= fnIdx.length; fcy /= fnIdx.length; }

    const spots: [number, number][] = [
      [W * 0.06, H * 0.48], [W * 0.94, H * 0.22],
      [W * 0.93, H * 0.78], [W * 0.10, H * 0.10],
      [W * 0.90, H * 0.90]
    ];

    ctx.strokeStyle = storyA(0.08);
    ctx.lineWidth = 0.5;
    for (const s of spots) {
      ctx.beginPath();
      ctx.moveTo(fcx, fcy);
      ctx.lineTo(s[0], s[1]);
      ctx.stroke();

      ctx.fillStyle = dimA(0.045);
      ctx.beginPath();
      ctx.arc(s[0], s[1], 2, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  /* --- Loop --- */
  function tick() {
    draw();
    rafId = requestAnimationFrame(tick);
  }

  function start() {
    if (running) return;
    running = true;
    rafId = requestAnimationFrame(tick);
  }

  function stop() {
    running = false;
    cancelAnimationFrame(rafId);
    rafId = 0;
  }

  /* --- Resize --- */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  const ro = new ResizeObserver(() => {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = canvas.offsetWidth;
    H = canvas.offsetHeight;
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    computeTargets();
    if (reduced.matches) drawStatic();
  });
  ro.observe(canvas);

  /* Initial sizing */
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  W = canvas.offsetWidth;
  H = canvas.offsetHeight;
  canvas.width = Math.round(W * dpr);
  canvas.height = Math.round(H * dpr);
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

  init();

  if (reduced.matches) {
    drawStatic();
    window.addEventListener('pagehide', () => { ro.disconnect(); });
  } else {
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) start();
      else stop();
    }, { threshold: 0.01 });
    io.observe(canvas);

    window.addEventListener('pagehide', () => {
      cancelAnimationFrame(rafId);
      io.disconnect();
      ro.disconnect();
    });
  }
})();
</script>

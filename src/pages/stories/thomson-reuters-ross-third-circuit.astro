---
import StoryLayout from '../../layouts/StoryLayout.astro';
import stories from '../../data/stories.json';

const story = stories.find(s => s.slug === 'thomson-reuters-ross-third-circuit')!;
---

<style is:global>
/* === CANVAS === */
.phantom-wrap { width: 100%; margin: 0; line-height: 0; }
.thomson-reuters-ross-third-circuit-canvas { display: block; width: 100%; height: 380px; background: var(--bg); }

/* === Reenactment 1: Copying Mechanism (Two-Panel Document) === */
.ross-doc-wrap {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  margin: 2rem 0;
  overflow: hidden;
}
.ross-doc-panels {
  display: grid;
  grid-template-columns: 1fr 1fr;
}
.ross-doc-panel {
  border-bottom: 1px solid var(--border);
}
.ross-doc-panel + .ross-doc-panel {
  border-left: 1px solid var(--border);
}
.ross-doc-panel-header {
  padding: 0.6rem 1rem;
  border-bottom: 1px solid var(--border);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.ross-doc-panel:first-child .ross-doc-panel-header {
  background: var(--surface2);
  color: var(--muted);
}
.ross-doc-panel:last-child .ross-doc-panel-header {
  background: var(--surface2);
  color: var(--story);
}
.ross-doc-panel-body {
  padding: 1rem;
  font-size: 0.85rem;
  line-height: 1.65;
  color: var(--text);
}
.ross-doc-topic {
  font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
  font-size: 0.7rem;
  color: var(--muted);
  margin-bottom: 0.6rem;
  letter-spacing: 0.04em;
}
.ross-doc-headnote-text {
  font-style: italic;
  color: var(--text);
  margin-bottom: 0.8rem;
  line-height: 1.6;
}
.ross-doc-jump {
  font-size: 0.72rem;
  color: var(--muted);
}
.ross-doc-question {
  font-weight: 600;
  color: var(--story);
  margin-bottom: 0.8rem;
  line-height: 1.5;
}
.ross-doc-passages {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}
.ross-doc-passages li {
  font-size: 0.75rem;
  color: var(--muted);
  padding-left: 0;
}
.ross-doc-rating {
  display: inline-block;
  font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  width: 80px;
}
.ross-doc-rating-great { color: var(--green); }
.ross-doc-rating-good { color: var(--story); }
.ross-doc-rating-topical { color: var(--muted); }
.ross-doc-rating-irrelevant { color: var(--accent); }
.ross-doc-label {
  padding: 0.5rem 1rem;
  font-size: 0.68rem;
  color: var(--muted);
  text-align: center;
  font-style: italic;
  border-top: 1px solid var(--border);
}
.ross-doc-footer {
  padding: 0.7rem 1rem;
  background: var(--surface2);
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 0.72rem;
  font-style: italic;
  line-height: 1.55;
}

/* === Reenactment 2: Four-Factor Scorecard === */
.ross-score-wrap {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  margin: 2rem 0;
  overflow: hidden;
}
.ross-score-header {
  background: var(--surface2);
  padding: 0.6rem 1rem;
  border-bottom: 1px solid var(--border);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
}
.ross-score-row {
  display: grid;
  grid-template-columns: 200px 90px 1fr;
  border-bottom: 1px solid var(--border);
  align-items: center;
}
.ross-score-factor {
  padding: 0.65rem 1rem;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text);
}
.ross-score-verdict {
  padding: 0.65rem 0.5rem;
  font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-align: center;
}
.ross-score-verdict-against { color: var(--accent); }
.ross-score-verdict-for { color: var(--green); }
.ross-score-reason {
  padding: 0.65rem 1rem;
  font-size: 0.78rem;
  color: var(--muted);
  line-height: 1.5;
  font-style: italic;
  border-left: 1px solid var(--border);
}
.ross-score-result {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.8rem 1rem;
  background: color-mix(in srgb, var(--accent) 6%, var(--surface2));
  border-top: 2px solid var(--accent);
}
.ross-score-result-label {
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: 0.04em;
}
.ross-score-result-text {
  font-size: 0.72rem;
  color: var(--text-body);
  font-style: italic;
}

/* === Reenactment 3: Footnote 7 Document Excerpt === */
.ross-fn7-wrap {
  background: var(--surface);
  border: 1px solid var(--border);
  border-left: 3px solid var(--story);
  border-radius: 0 6px 6px 0;
  margin: 2rem 0;
  padding: 1.2rem 1.4rem;
  position: relative;
}
.ross-fn7-num {
  position: absolute;
  top: 0.8rem;
  left: -0.2rem;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--story);
  vertical-align: super;
  line-height: 1;
}
.ross-fn7-label {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;

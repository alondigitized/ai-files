---
import StoryLayout from '../../layouts/StoryLayout.astro';
import stories from '../../data/stories.json';

const story = stories.find(s => s.slug === 'anthropic-siren-sandbox')!;
---

<style is:global>
.phantom-wrap { width: 100%; margin: 0; line-height: 0; }
.anthropic-siren-sandbox-canvas { display: block; width: 100%; height: 380px; background: var(--bg); }

/* --- Reenactment CSS: anthropic-siren-sandbox (siren- prefix) --- */
.sr-only-siren { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
/* Reenactment 1: Extended Thinking */
.siren-thinking {
  margin: 2rem 0;
  background: var(--surface, #161616);
  border: 1px solid var(--border, #2a2a2a);
  border-left: 3px solid var(--story);
  border-radius: 6px;
  overflow: hidden;
}
.siren-thinking-header {
  padding: 0.75rem 1.25rem;
  background: var(--bg, #0d0d0d);
  border-bottom: 1px solid var(--border, #2a2a2a);
  font-family: 'SF Mono', 'Fira Code', monospace;
  font-size: 0.75rem;
  color: var(--muted, #888);
  letter-spacing: 0.05em;
  text-transform: uppercase;
}
.siren-thinking-body {
  padding: 1.25rem;
}
.siren-thinking-body blockquote {
  font-family: 'SF Mono', 'Fira Code', monospace;
  font-size: 0.95rem;
  line-height: 1.7;
  color: var(--text, #e8e8e8);
  margin: 0;
  padding: 0;
  border: none;
  background: none;
}
.siren-thinking-footer {
  padding: 0.75rem 1.25rem;
  border-top: 1px solid var(--border, #2a2a2a);
  font-size: 0.8rem;
  color: var(--muted, #888);
  line-height: 1.5;
}
.siren-thinking-rate {
  color: var(--accent, #ff4d4d);
  font-weight: 600;
}

/* Reenactment 2: Rates Table */
.siren-rates {
  margin: 2rem 0;
  background: var(--surface, #161616);
  border: 1px solid var(--border, #2a2a2a);
  border-radius: 6px;
  overflow: hidden;
}
.siren-rates-header {
  padding: 0.75rem 1.25rem;
  background: var(--bg, #0d0d0d);
  border-bottom: 1px solid var(--border, #2a2a2a);
  font-size: 0.75rem;
  color: var(--muted, #888);
  letter-spacing: 0.05em;
  text-transform: uppercase;
}
.siren-rates-wrap {
  overflow-x: auto;
}
.siren-rates table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.85rem;
  min-width: 480px;
}
.siren-rates th {
  padding: 0.6rem 1rem;
  text-align: left;
  color: var(--muted, #888);
  font-weight: 500;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  border-bottom: 1px solid var(--border, #2a2a2a);
}
.siren-rates td {
  padding: 0.6rem 1rem;
  color: var(--text, #e8e8e8);
  border-bottom: 1px solid rgba(42, 42, 42, 0.5);
  font-variant-numeric: tabular-nums;
}
.siren-rates-old td {
  color: var(--muted, #888);
}
.siren-rates-misaligned {
  color: var(--story);
  font-weight: 600;
}
.siren-rates-old .siren-rates-misaligned {

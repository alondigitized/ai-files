      <span class="nt-defaults-tag">DEFAULT</span>
    </div>
    <div class="nt-defaults-row">
      <span class="nt-defaults-label">Send recap to</span>
      <span class="nt-defaults-value">Everyone on the invite</span>
      <span class="nt-defaults-tag">DEFAULT</span>
    </div>
    <div class="nt-defaults-row">
      <span class="nt-defaults-label">Stay in meeting for up to</span>
      <span class="nt-defaults-value">2-4 hours</span>

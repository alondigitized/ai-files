.ai-notetaker-termination-transcript-canvas { display: block; width: 100%; height: 380px; background: var(--bg); }

/* ── Reenactment #1: Transcript Email Mockup ── */
.nt-email { background: var(--surface); border: 1px solid var(--border); border-radius: 0.75rem; overflow: hidden; margin: 2rem 0; }
.nt-email-header { background: var(--surface2); padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); font-size: 0.78rem; color: var(--muted); display: flex; flex-direction: column; gap: 0.3rem; }
.nt-email-field { display: flex; gap: 0.5rem; }
.nt-email-label { color: var(--muted); min-width: 60px; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.68rem; padding-top: 1px; }
.nt-email-value { color: var(--text); font-size: 0.8rem; }
.nt-email-from { color: var(--story); }
.nt-email-body { padding: 1rem 1.2rem; }
.nt-email-segment { margin-bottom: 1rem; padding: 0.75rem 1rem; border-radius: 0.5rem; }
.nt-email-segment.meeting { background: rgba(232,232,232,0.03); border-left: 2px solid var(--border); }
.nt-email-segment.post-departure { background: rgba(255,77,77,0.04); border-left: 2px solid var(--accent); }
.nt-email-segment-label { font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.4rem; }

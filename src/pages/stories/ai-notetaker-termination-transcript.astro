.nt-docket-table tbody tr.nt-docket-witness { background: rgba(232,232,232,0.03); }
.nt-docket-table tbody tr.nt-docket-witness td { color: var(--text); font-weight: 500; }
.nt-docket-role-accused { color: var(--accent); font-weight: 700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; }

.nt-docket-table tbody tr.nt-docket-privacy:last-of-type td { border-bottom: 2px solid var(--border); }
.nt-docket-caption { caption-side: bottom; text-align: left; font-size: 0.72rem; color: var(--muted); font-style: italic; padding: 0.6rem 1rem; background: var(--surface2); border-top: 1px solid var(--border); line-height: 1.5; }
@media (max-width: 700px) {
  .nt-docket { overflow-x: auto; }
  .nt-docket-table { min-width: 600px; }

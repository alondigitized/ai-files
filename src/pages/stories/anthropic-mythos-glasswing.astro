<script>
(function () {
  const canvas = document.querySelector('.anthropic-mythos-glasswing-canvas') as HTMLCanvasElement;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const BG_COLOR = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim() || '#0d0d0d';

  const SR = 147, SG = 197, SB = 253; // #93c5fd

  function storyA(a: number) { return `rgba(${SR},${SG},${SB},${Math.max(0, Math.min(1, a)).toFixed(4)})`; }
  function dimA(a: number) { return `rgba(232,232,232,${Math.max(0, Math.min(1, a)).toFixed(4)})`; }

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let W = 0, H = 0, rafId = 0, frame = 0;

  const ro = new ResizeObserver(() => {
    const dpr = window.devicePixelRatio || 1;
    W = canvas.offsetWidth;
    H = canvas.offsetHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  });
  ro.observe(canvas);

  const FADE_IN = 30;
  const SWEEP_END = 1320;
  const HOLD_END = 1440;
  const FADE_OUT_END = 1500;
  const DARK_END = 1560;
  const CYCLE = DARK_END;
  const SCAN_SPEED = 0.35;

  const PERIM_LEFT = 0.04;
  const PERIM_RIGHT = 0.22;
  const PERIM_CX_FRAC = 0.13;
  const PERIM_CY_FRAC = 0.50;
  const PERIM_RX_FRAC = 0.10;
  const PERIM_RY_FRAC = 0.42;
  const PERIM_ARC_START = -0.45 * Math.PI;
  const PERIM_ARC_END = 0.45 * Math.PI;

  let seed = 42;
  function srand(s: number) { seed = s; }
  function rand() {
    seed = (seed * 1664525 + 1013904223) & 0x7fffffff;
    return seed / 0x7fffffff;
  }

  const TOTAL_NODES = 60;
  const INSIDE_COUNT = 12;

  interface VulnNode {
    xFrac: number; yFrac: number;
    inside: boolean;
    alpha: number; targetAlpha: number;
    radius: number; baseRadius: number;
    ignited: boolean; igniteFrame: number;
    flareAlpha: number; flareRadius: number;
    patching: boolean; patchFrame: number;
    phaseOffset: number;
  }

  const nodes: VulnNode[] = [];

  const DUST_COUNT = 18;
  interface Dust { x: number; y: number; vx: number; vy: number; alpha: number; }
  const dusts: Dust[] = [];

  function isInsidePerimeter(xFrac: number, yFrac: number): boolean {
    const dx = (xFrac - PERIM_CX_FRAC) / PERIM_RX_FRAC;
    const dy = (yFrac - PERIM_CY_FRAC) / PERIM_RY_FRAC;
    return (dx * dx + dy * dy) <= 1.0 && xFrac < PERIM_RIGHT;
  }

  function initNodes() {
    nodes.length = 0;
    srand(42);
    let insideCount = 0;
    while (insideCount < INSIDE_COUNT) {
      const xFrac = PERIM_LEFT + rand() * (PERIM_RIGHT - PERIM_LEFT);
      const yFrac = 0.12 + rand() * 0.76;
      if (isInsidePerimeter(xFrac, yFrac)) {
        nodes.push({
          xFrac, yFrac, inside: true,
          alpha: 0, targetAlpha: 0,
          radius: 3, baseRadius: 3 + rand() * 1,
          ignited: false, igniteFrame: 0,
          flareAlpha: 0, flareRadius: 0,
          patching: false, patchFrame: 0,
          phaseOffset: rand() * Math.PI * 2,
        });
        insideCount++;
      }
    }
    const outsideCount = TOTAL_NODES - INSIDE_COUNT;
    for (let i = 0; i < outsideCount; i++) {
      let xFrac: number, yFrac: number;
      let attempts = 0;
      do {
        xFrac = 0.05 + rand() * 0.90;
        yFrac = 0.10 + rand() * 0.80;
        attempts++;
      } while (isInsidePerimeter(xFrac, yFrac) && attempts < 50);
      if (isInsidePerimeter(xFrac, yFrac)) {
        xFrac = PERIM_RIGHT + 0.05 + rand() * 0.68;
      }
      nodes.push({
        xFrac, yFrac, inside: false,
        alpha: 0, targetAlpha: 0,
        radius: 3, baseRadius: 3 + rand() * 1,
        ignited: false, igniteFrame: 0,
        flareAlpha: 0, flareRadius: 0,
        patching: false, patchFrame: 0,
        phaseOffset: rand() * Math.PI * 2,
      });
    }
  }

  function initDust() {
    dusts.length = 0;
    for (let i = 0; i < DUST_COUNT; i++) {
      dusts.push({
        x: Math.random() * (W || 800),
        y: Math.random() * (H || 380),
        vx: (Math.random() - 0.5) * 0.2,
        vy: (Math.random() - 0.5) * 0.2,
        alpha: 0.04 + Math.random() * 0.02,
      });
    }
  }

  function getScanX(f: number): number {
    const sweepFrame = f - FADE_IN;
    if (sweepFrame < 0) return -10;
    return sweepFrame * SCAN_SPEED;
  }
  function getPerimeterRightX(): number { return PERIM_RIGHT * W; }
  function getPerimExitFrame(): number { return FADE_IN + Math.ceil(getPerimeterRightX() / SCAN_SPEED); }

  function getGlobalFade(f: number): number {
    if (f < FADE_IN) return 1;
    if (f <= HOLD_END) return 1;
    if (f <= FADE_OUT_END) return 1 - (f - HOLD_END) / (FADE_OUT_END - HOLD_END);
    return 0;
  }

  let perimAlpha = 0.12;

  function update() {
    const cycleFr = frame % CYCLE;
    const fade = getGlobalFade(cycleFr);

    if (cycleFr === 0) {
      for (const n of nodes) {
        n.alpha = 0; n.targetAlpha = 0;
        n.ignited = false; n.igniteFrame = 0;
        n.flareAlpha = 0; n.flareRadius = 0;
        n.patching = false; n.patchFrame = 0;
        n.radius = n.baseRadius;
      }
      perimAlpha = 0.12;
    }

    for (const d of dusts) {
      d.x += d.vx; d.y += d.vy;
      if (d.x < 0) d.x = W;
      if (d.x > W) d.x = 0;
      if (d.y < 0) d.y = H;
      if (d.y > H) d.y = 0;
    }

    if (cycleFr >= FADE_OUT_END) return;

    const scanX = getScanX(cycleFr);
    const perimExitFrame = getPerimExitFrame();

    if (cycleFr >= perimExitFrame && cycleFr < perimExitFrame + 40) {
      const flickerT = cycleFr - perimExitFrame;
      if (flickerT < 10) {
        perimAlpha = 0.12 + 0.13 * Math.sin((flickerT / 10) * Math.PI);
      } else if (flickerT < 20) {
        perimAlpha = 0.12;
      } else if (flickerT < 30) {
        perimAlpha = 0.12 + 0.13 * Math.sin(((flickerT - 20) / 10) * Math.PI);
      } else {
        perimAlpha = 0.12;
      }
    } else {
      perimAlpha = 0.12;
    }

    for (const n of nodes) {
      const nodeX = n.xFrac * W;
      if (!n.ignited && scanX >= nodeX && cycleFr >= FADE_IN) {
        n.ignited = true;
        n.igniteFrame = cycleFr;
        n.flareAlpha = 0.3;
        n.flareRadius = n.baseRadius;
      }
      if (n.ignited) {
        const age = cycleFr - n.igniteFrame;
        if (age < 12) {
          const t = age / 12;
          n.alpha = t * 0.8;
          n.radius = n.baseRadius + t * 3;
        } else {
          if (n.inside) {
            if (!n.patching && age >= 90) {
              n.patching = true;
              n.patchFrame = cycleFr;
            }
            if (n.patching) {
              const patchAge = cycleFr - n.patchFrame;
              if (patchAge < 60) {
                n.alpha = Math.max(0.08, 0.6 - (patchAge / 60) * 0.52);
                n.radius = n.baseRadius + 1 - (patchAge / 60);
              } else {
                n.alpha = 0.08;
                n.radius = n.baseRadius;
              }
            } else {
              n.alpha = 0.6;
              n.radius = n.baseRadius + 1;
            }
          } else {
            const breathe = Math.sin(cycleFr * 0.035 + n.phaseOffset) * 0.1;
            n.alpha = 0.55 + breathe;
            n.radius = n.baseRadius + 1;
          }
        }
        if (age < 20) {
          const ft = age / 20;
          n.flareRadius = n.baseRadius + ft * 12;
          n.flareAlpha = 0.3 * (1 - ft);
        } else {
          n.flareAlpha = 0;
        }
      }
      n.alpha *= fade;
      n.flareAlpha *= fade;
    }
  }

  function drawPerimeter() {
    const cx = PERIM_CX_FRAC * W;
    const cy = PERIM_CY_FRAC * H;
    const rx = PERIM_RX_FRAC * W;
    const ry = PERIM_RY_FRAC * H;
    const fade = getGlobalFade(frame % CYCLE);
    if (!ctx) return;
    ctx.strokeStyle = dimA(perimAlpha * fade);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.ellipse(cx, cy, rx, ry, 0, Math.PI + PERIM_ARC_START, Math.PI + PERIM_ARC_END, false);
    ctx.stroke();
  }

  function drawScanLine(cycleFr: number) {
    const fade = getGlobalFade(cycleFr);
    if (fade < 0.003) return;
    let scanAlpha: number;
    const scanX = getScanX(cycleFr);
    if (scanX < 0 || scanX > W) return;
    if (cycleFr < FADE_IN) {
      scanAlpha = (cycleFr / FADE_IN) * 0.6;
    } else if (cycleFr <= SWEEP_END) {
      scanAlpha = 0.6;
    } else {
      scanAlpha = 0.6 * fade;
    }
    if (scanAlpha < 0.003) return;
    if (!ctx) return;
    const grad = ctx.createLinearGradient(scanX, 0, scanX, H);
    grad.addColorStop(0, storyA(0));
    grad.addColorStop(0.15, storyA(scanAlpha * 0.3));
    grad.addColorStop(0.4, storyA(scanAlpha));
    grad.addColorStop(0.5, storyA(scanAlpha));
    grad.addColorStop(0.6, storyA(scanAlpha));
    grad.addColorStop(0.85, storyA(scanAlpha * 0.3));
    grad.addColorStop(1, storyA(0));
    ctx.strokeStyle = grad;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(scanX, 0);
    ctx.lineTo(scanX, H);
    ctx.stroke();
    const trailGrad = ctx.createLinearGradient(scanX - 20, 0, scanX, 0);
    trailGrad.addColorStop(0, storyA(0));
    trailGrad.addColorStop(1, storyA(0.04 * fade));
    ctx.fillStyle = trailGrad;
    ctx.fillRect(scanX - 20, 0, 20, H);
  }

  function draw() {
    if (!ctx) return;
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = BG_COLOR;
    ctx.fillRect(0, 0, W, H);

    const cycleFr = frame % CYCLE;
    const fade = getGlobalFade(cycleFr);

    for (const d of dusts) {
      ctx.beginPath();
      ctx.arc(d.x, d.y, 1, 0, Math.PI * 2);
      ctx.fillStyle = dimA(d.alpha);
      ctx.fill();
    }

    if (fade > 0.003) drawPerimeter();

    for (const n of nodes) {
      if (n.alpha < 0.003 && n.flareAlpha < 0.003) continue;
      const x = n.xFrac * W;
      const y = n.yFrac * H;
      if (n.flareAlpha > 0.003) {
        const fg = ctx.createRadialGradient(x, y, 0, x, y, n.flareRadius);
        fg.addColorStop(0, storyA(n.flareAlpha * 0.5));
        fg.addColorStop(0.5, storyA(n.flareAlpha * 0.2));
        fg.addColorStop(1, storyA(0));
        ctx.fillStyle = fg;
        ctx.beginPath();
        ctx.arc(x, y, n.flareRadius, 0, Math.PI * 2);
        ctx.fill();
      }
      if (n.alpha > 0.003) {
        if (n.inside && n.patching && (cycleFr - n.patchFrame) >= 60) {
          ctx.strokeStyle = storyA(n.alpha);
          ctx.lineWidth = 0.8;
          ctx.beginPath();
          ctx.arc(x, y, n.radius, 0, Math.PI * 2);
          ctx.stroke();
        } else {
          const glow = ctx.createRadialGradient(x, y, 0, x, y, n.radius * 2.5);
          glow.addColorStop(0, storyA(n.alpha * 0.4));
          glow.addColorStop(0.4, storyA(n.alpha * 0.15));
          glow.addColorStop(1, storyA(0));
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(x, y, n.radius * 2.5, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = storyA(n.alpha);
          ctx.beginPath();
          ctx.arc(x, y, n.radius * 0.6, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }

    if (cycleFr < FADE_OUT_END) drawScanLine(cycleFr);
  }

  function drawStatic() {
    if (!ctx) return;
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = BG_COLOR;
    ctx.fillRect(0, 0, W, H);
    for (const d of dusts) {
      ctx.beginPath();
      ctx.arc(d.x, d.y, 1, 0, Math.PI * 2);
      ctx.fillStyle = dimA(d.alpha);
      ctx.fill();
    }
    const cx = PERIM_CX_FRAC * W;
    const cy = PERIM_CY_FRAC * H;
    const rx = PERIM_RX_FRAC * W;
    const ry = PERIM_RY_FRAC * H;
    ctx.strokeStyle = dimA(0.12);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.ellipse(cx, cy, rx, ry, 0, Math.PI + PERIM_ARC_START, Math.PI + PERIM_ARC_END, false);
    ctx.stroke();
    const staticScanX = W * 0.6;
    for (const n of nodes) {
      const x = n.xFrac * W;
      const y = n.yFrac * H;
      if (x > staticScanX) continue;
      if (n.inside) {
        ctx.strokeStyle = storyA(0.1);
        ctx.lineWidth = 0.8;
        ctx.beginPath();
        ctx.arc(x, y, n.baseRadius, 0, Math.PI * 2);
        ctx.stroke();
      } else {
        const glow = ctx.createRadialGradient(x, y, 0, x, y, n.baseRadius * 2.5);
        glow.addColorStop(0, storyA(0.22));
        glow.addColorStop(0.4, storyA(0.08));
        glow.addColorStop(1, storyA(0));
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(x, y, n.baseRadius * 2.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = storyA(0.55);
        ctx.beginPath();
        ctx.arc(x, y, n.baseRadius * 0.6, 0, Math.PI * 2);
        ctx.fill();
      }
    }
    const grad = ctx.createLinearGradient(staticScanX, 0, staticScanX, H);
    grad.addColorStop(0, storyA(0));
    grad.addColorStop(0.15, storyA(0.18));
    grad.addColorStop(0.4, storyA(0.5));
    grad.addColorStop(0.5, storyA(0.5));
    grad.addColorStop(0.6, storyA(0.5));
    grad.addColorStop(0.85, storyA(0.18));
    grad.addColorStop(1, storyA(0));
    ctx.strokeStyle = grad;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(staticScanX, 0);
    ctx.lineTo(staticScanX, H);
    ctx.stroke();
  }

  function tick() {
    frame++;
    update();
    draw();
    rafId = requestAnimationFrame(tick);
  }

  const dpr0 = window.devicePixelRatio || 1;
  W = canvas.offsetWidth;
  H = canvas.offsetHeight;
  canvas.width = W * dpr0;
  canvas.height = H * dpr0;
  ctx.setTransform(dpr0, 0, 0, dpr0, 0, 0);

  initNodes();
  initDust();

  if (prefersReduced) {
    requestAnimationFrame(() => { drawStatic(); });
    window.addEventListener('pagehide', () => { ro.disconnect(); });
  } else {
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { if (!rafId) rafId = requestAnimationFrame(tick); }
      else { cancelAnimationFrame(rafId); rafId = 0; }
    }, { threshold: 0.01 });
    io.observe(canvas);
    window.addEventListener('pagehide', () => { cancelAnimationFrame(rafId); io.disconnect(); ro.disconnect(); });
  }
})();
</script>

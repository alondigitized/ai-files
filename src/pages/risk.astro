---
import BaseLayout from '../layouts/BaseLayout.astro';
import stories from '../data/stories.json';
import ledger from '../data/risk-voices.json';

const SITE = 'https://theaifiles.app';
const activeStories = stories.filter(s => !s.wip);
const storyMap = Object.fromEntries(activeStories.map(s => [s.slug, s]));

const voices = ledger.voices
  .filter(v => v.verified)
  .slice()
  .sort((a, b) => (a.point ?? -1) - (b.point ?? -1));
const numeric = voices.filter(v => typeof v.point === 'number');
const qualitative = voices.filter(v => v.point === null);

const minVoice = numeric[0];
const maxVoice = numeric[numeric.length - 1];

const incidentStory = storyMap['openai-huggingface-sandbox-escape'];
const hopeSlugs = ['alphafold', 'halicin', 'graphcast', 'breast-cancer-ai', 'gnome-materials', 'golden-gate-claude'];
const hopeStories = hopeSlugs.map(s => storyMap[s]).filter(Boolean);

const campLabel: Record<string, string> = {
  'lab-leader': 'Lab leaders',
  'researcher': 'Researchers',
  'safety-org': 'Safety orgs',
  'policy-investor': 'Policy & investors',
  'forecaster': 'Forecasters & press',
};
const campOrder = ['lab-leader', 'researcher', 'safety-org', 'policy-investor', 'forecaster'];

// Logit-scale position: 0.01% → 0, 50% → 0.5, 99.99% → 1. Stretches both tails so 1%→10% gets the same room as 90%→99%.
const L_MIN = Math.log(0.0001 / 0.9999);
const L_MAX = -L_MIN;
const pos = (p: number) => {
  const q = Math.max(0.01, Math.min(99.99, p)) / 100;
  return (Math.log(q / (1 - q)) - L_MIN) / (L_MAX - L_MIN);
};
const TICKS = [0.01, 0.1, 1, 10, 50, 90, 99, 99.9];

// Assign lanes so nearby labels don't collide (greedy, 6 lanes)
const laneEnds = [ -1, -1, -1, -1, -1, -1 ];
const laned = numeric.map(v => {
  const x = pos(v.point as number);
  let lane = laneEnds.findIndex(end => x - end > 0.07);
  if (lane === -1) lane = laneEnds.indexOf(Math.min(...laneEnds));
  laneEnds[lane] = x;
  return { ...v, x, lane };
});

const description = `Every public estimate of the chance AI ends humanity, from the people building it — ${numeric.length} named voices from ${minVoice?.display} to ${maxVoice?.display}, the surveys behind them, the July 2026 Hugging Face intrusion that made the question urgent, and the other column of the ledger: what has already gone right.`;

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'The Risk Ledger — The AI Files',
  url: `${SITE}/risk`,
  description,
  dateModified: ledger.updated,
  isPartOf: { '@type': 'WebSite', name: 'The AI Files', url: SITE },
  about: { '@type': 'Thing', name: 'P(doom) — probability of AI-caused existential catastrophe' },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'The AI Files', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'The Risk Ledger', item: `${SITE}/risk` },
  ],
};

const fmtDate = (d: string) => {
  const [y, m] = d.split('-');
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return m ? `${months[parseInt(m, 10) - 1]} ${y}` : y;
};
---

<style is:global>
  /* ── Page accent per theme (global components read --story) ── */
  :root[data-theme="dark"] { --story: #5eead4; --story-dark: #05201b; }
  :root[data-theme="light"] { --story: #856520; --story-dark: #3d2a0a; }

  .risk-page .themed,
  .risk-page body,
  .risk-page .stat-card, .risk-page .card, .risk-page .pull-quote,
  .risk-page .key-facts-inner, .risk-page .more-card, .risk-page .story-subscribe-inner {
    transition: background-color 0.8s ease, color 0.8s ease, border-color 0.8s ease;
  }
  html.risk-page, html.risk-page body { transition: background-color 0.8s ease, color 0.8s ease; }
  @media (prefers-reduced-motion: reduce) {
    html.risk-page, html.risk-page body, .risk-page .themed, .risk-page .stat-card, .risk-page .card,
    .risk-page .pull-quote, .risk-page .key-facts-inner, .risk-page .more-card, .risk-page .story-subscribe-inner { transition: none; }
  }

  /* ── Nav column pill ── */
  .col-pill {
    position: absolute; left: 2rem;
    font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--story); font-weight: 700;
  }
  @media (max-width: 600px) { .col-pill { display: none; } }

  /* ── Hero ── */
  .ledger-hero {
    position: relative; overflow: hidden;
    padding: 5rem 2rem 3.5rem;
    background: radial-gradient(ellipse at top, var(--story-dark) 0%, var(--bg) 70%);
    border-bottom: 1px solid var(--border);
  }
  .ledger-hero-inner { max-width: 900px; margin: 0 auto; }
  .ledger-eyebrow {
    font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--story); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem;
  }
  .ledger-eyebrow::after { content: ''; flex: 0 0 60px; height: 1px; background: currentColor; opacity: 0.3; }
  .ledger-title { font-size: clamp(2.2rem, 6vw, 4rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.05; margin-bottom: 1.25rem; }
  .ledger-title span { color: var(--story); }
  .ledger-deck { font-size: 1.15rem; color: var(--muted); max-width: 680px; line-height: 1.6; margin-bottom: 2.5rem; }
  .ledger-spread { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; max-width: 620px; }
  .spread-cell { padding: 1.25rem 1.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: 0.75rem; }
  .spread-big { font-size: clamp(1.6rem, 4vw, 2.4rem); font-weight: 900; line-height: 1; color: var(--text); letter-spacing: -0.02em; }
  .spread-big em { color: var(--story); font-style: normal; }
  .spread-lbl { font-size: 0.72rem; color: var(--muted); margin-top: 0.5rem; letter-spacing: 0.05em; }
  @media (max-width: 560px) { .ledger-spread { grid-template-columns: 1fr; } }

  /* ── Section header helpers ── */
  .lede { font-size: 1.05rem; color: var(--text); }
  .note { font-size: 0.82rem; color: var(--muted); }
  .opinion-tag {
    display: inline-block; font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 800;
    color: var(--story); border: 1px solid color-mix(in srgb, var(--story) 40%, transparent);
    border-radius: 2rem; padding: 0.2rem 0.7rem; margin-bottom: 1rem;
  }

  /* ── Chain of events (reenactment) ── */
  .chain { margin: 2rem 0 0; display: flex; flex-direction: column; }
  .chain-step { display: grid; grid-template-columns: 44px 1fr; gap: 1rem; position: relative; padding-bottom: 1.25rem; }
  .chain-step:last-child { padding-bottom: 0; }
  .chain-step::before { content: ''; position: absolute; left: 21px; top: 36px; bottom: 0; width: 2px; background: var(--border); }
  .chain-step:last-child::before { display: none; }
  .chain-num {
    width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: 0.72rem; font-weight: 800; background: var(--surface); border: 2px solid var(--border); color: var(--muted);
    position: relative; z-index: 1;
  }
  .chain-num.hot { border-color: var(--accent); color: var(--accent); }
  .chain-num.cut { border-color: var(--story); color: var(--story); }
  .chain-body { padding-top: 0.45rem; }
  .chain-when { font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--story); font-weight: 700; margin-bottom: 0.25rem; }
  .chain-title { font-size: 0.95rem; font-weight: 700; color: var(--text); margin-bottom: 0.25rem; }
  .chain-text { font-size: 0.85rem; color: var(--muted); line-height: 1.6; }
  .chain-text code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.78em;
    background: var(--surface2); border: 1px solid var(--border); border-radius: 0.25rem; padding: 0.05rem 0.35rem; color: var(--text);
  }

  .incident-link { margin-top: 2rem; border-left: 3px solid var(--story); }

  /* ── Canvas ── */
  .phantom-wrap { width: 100%; margin: 0; line-height: 0; }
  .risk-canvas { display: block; width: 100%; height: 380px; background: var(--bg); }

  /* ── The Ledger axis ── */
  .axis-wrap { margin: 2rem 0 0.5rem; }
  .axis-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem; }
  .chip {
    font-family: inherit; font-size: 0.72rem; letter-spacing: 0.06em; cursor: pointer;
    background: var(--surface); border: 1px solid var(--border); border-radius: 2rem; padding: 0.35rem 0.85rem;
    color: var(--muted); display: inline-flex; align-items: center; gap: 0.45rem; transition: color 0.15s, border-color 0.15s;
  }
  .chip:hover { color: var(--text); border-color: var(--border-hover); }
  .chip[aria-pressed="true"] { color: var(--text); border-color: var(--story); }
  .chip-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .axis { position: relative; height: 310px; }
  .axis-line { position: absolute; left: 0; right: 0; bottom: 34px; height: 1px; background: var(--border); }
  .axis-tick { position: absolute; bottom: 0; transform: translateX(-50%); font-size: 0.68rem; color: var(--muted); text-align: center; white-space: nowrap; }
  .axis-tick::before { content: ''; display: block; width: 1px; height: 8px; background: var(--border); margin: 0 auto 4px; }
  .axis-tick.edge-l { transform: translateX(0); }
  .axis-tick.edge-r { transform: translateX(-100%); }
  .axis-me {
    position: absolute; bottom: 34px; width: 2px; height: 190px; background: var(--story);
    transform: translateX(-50%); opacity: 0; transition: left 0.3s ease, opacity 0.3s ease; pointer-events: none;
  }
  .axis-me::after {
    content: 'you'; position: absolute; top: -1.1rem; left: 50%; transform: translateX(-50%);
    font-size: 0.62rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--story); font-weight: 800;
  }
  .axis-me.on { opacity: 1; }
  .voice {
    position: absolute; transform: translateX(-50%); bottom: 40px;
    display: flex; flex-direction: column; align-items: center; gap: 0.3rem;
    background: none; border: none; padding: 0.2rem; cursor: pointer; font-family: inherit;
    transition: opacity 0.2s;
  }
  .voice { pointer-events: none; } /* only the dot and the name are hit targets, so tall stems never cover lower lanes */
  .voice-dot, .voice-name { pointer-events: auto; }
  .voice.dim { opacity: 0.18; }
  .voice.dim .voice-dot, .voice.dim .voice-name { pointer-events: none; }
  .voice-dot { width: 12px; height: 12px; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 25%, transparent); }
  .voice-name { font-size: 0.62rem; color: var(--muted); white-space: nowrap; letter-spacing: 0.02em; }
  .voice:hover .voice-name, .voice:focus-visible .voice-name, .voice[aria-expanded="true"] .voice-name { color: var(--text); }
  .voice:focus-visible { outline: 2px solid var(--story); outline-offset: 2px; border-radius: 0.3rem; }
  .voice-stem { width: 1px; background: var(--border); }
  .voice[data-lane="0"] { bottom: 40px; } .voice[data-lane="0"] .voice-stem { height: 0; }
  .voice[data-lane="1"] { bottom: 40px; } .voice[data-lane="1"] .voice-stem { height: 40px; }
  .voice[data-lane="2"] { bottom: 40px; } .voice[data-lane="2"] .voice-stem { height: 80px; }
  .voice[data-lane="3"] { bottom: 40px; } .voice[data-lane="3"] .voice-stem { height: 120px; }
  .voice[data-lane="4"] { bottom: 40px; } .voice[data-lane="4"] .voice-stem { height: 160px; }
  .voice[data-lane="5"] { bottom: 40px; } .voice[data-lane="5"] .voice-stem { height: 200px; }
  .voice-card {
    margin-top: 1rem; background: var(--surface); border: 1px solid var(--border); border-left: 3px solid var(--c, var(--story));
    border-radius: 0.5rem; padding: 1.1rem 1.25rem; min-height: 120px;
  }
  .voice-card[hidden] { display: none; }
  .vc-top { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.35rem; }
  .vc-num { font-size: 1.6rem; font-weight: 900; color: var(--text); line-height: 1; }
  .vc-name { font-size: 1rem; font-weight: 700; color: var(--text); }
  .vc-role { font-size: 0.78rem; color: var(--muted); }
  .vc-asked { font-size: 0.85rem; color: var(--text-body); margin: 0.5rem 0 0.35rem; }
  .vc-asked strong { color: var(--muted); font-weight: 600; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; margin-right: 0.4rem; }
  .vc-quote { font-size: 0.9rem; font-style: italic; color: var(--text); margin: 0.35rem 0 0.5rem; line-height: 1.55; }
  .vc-src { font-size: 0.74rem; color: var(--muted); }
  .vc-src a { color: var(--blue); text-decoration: none; }
  .vc-src a:hover { text-decoration: underline; }
  .axis-hint { font-size: 0.74rem; color: var(--muted); margin-top: 0.5rem; }
  @media (max-width: 700px) {
    .axis { height: 290px; }
    .axis-tick[data-t="0.1"], .axis-tick[data-t="90"], .axis-tick[data-t="99"] { display: none; }
    .voice-name { display: none; }
    .voice[aria-expanded="true"] .voice-name { display: block; position: absolute; top: -1.2rem; }
  }

  /* ── Qualitative row ── */
  .qual-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.25rem; }
  .qual-item {
    font-size: 0.76rem; color: var(--muted); background: var(--surface); border: 1px solid var(--border);
    border-radius: 2rem; padding: 0.3rem 0.8rem;
  }
  .qual-item strong { color: var(--text); font-weight: 600; }

  /* ── Table ── */
  .tbl-wrap { overflow-x: auto; position: relative; margin-top: 2rem; border: 1px solid var(--border); border-radius: 0.6rem; } /* position: relative keeps .sr-only spans inside the clip */
  .ledger-tbl { width: 100%; border-collapse: collapse; font-size: 0.82rem; min-width: 720px; }
  .ledger-tbl th, .ledger-tbl td { text-align: left; padding: 0.65rem 0.85rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  .ledger-tbl th { font-size: 0.66rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--muted); background: var(--surface); font-weight: 700; }
  .ledger-tbl th button { all: unset; cursor: pointer; }
  .ledger-tbl th button:focus-visible { outline: 2px solid var(--story); outline-offset: 2px; }
  .ledger-tbl tr:last-child td { border-bottom: none; }
  .ledger-tbl td.num { font-weight: 800; color: var(--text); white-space: nowrap; }
  .ledger-tbl td .role { display: block; font-size: 0.72rem; color: var(--muted); }
  .ledger-tbl td a { color: var(--blue); text-decoration: none; }
  .ledger-tbl td a:hover { text-decoration: underline; }
  .tbl-toggle { margin-top: 1rem; }
  .tbl-toggle summary { cursor: pointer; font-size: 0.8rem; color: var(--blue); }

  /* ── Your number ── */
  .you-box { margin-top: 2rem; background: var(--surface); border: 1px solid var(--border); border-radius: 0.75rem; padding: 1.75rem; }
  .you-row { display: grid; grid-template-columns: 1fr auto; gap: 1.5rem; align-items: center; }
  .you-val { font-size: clamp(2rem, 6vw, 3rem); font-weight: 900; color: var(--story); line-height: 1; min-width: 5ch; text-align: right; font-variant-numeric: tabular-nums; }
  .you-range { width: 100%; accent-color: var(--story); }
  .you-range:focus-visible { outline: 2px solid var(--story); outline-offset: 4px; }
  .you-scale { position: relative; height: 1.1rem; font-size: 0.66rem; color: var(--muted); margin-top: 0.35rem; }
  .you-scale span { position: absolute; top: 0; transform: translateX(-50%); white-space: nowrap; }
  .you-scale span.edge-l { transform: none; }
  .you-scale span.edge-r { transform: translateX(-100%); }
  .you-out { font-size: 0.98rem; color: var(--text); margin-top: 1.25rem; line-height: 1.6; min-height: 3.2em; }
  .you-out strong { color: var(--story); }
  .you-priv { font-size: 0.72rem; color: var(--muted); margin-top: 0.75rem; }
  @media (max-width: 560px) { .you-row { grid-template-columns: 1fr; } .you-val { text-align: left; } }

  /* ── Survey bars ── */
  .bars { margin-top: 1.5rem; }
  .bar-row { display: grid; grid-template-columns: 210px 1fr 70px; align-items: center; gap: 0.75rem; padding: 0.5rem 0; font-size: 0.82rem; }
  .bar-lbl { color: var(--text); }
  .bar-lbl small { display: block; color: var(--muted); font-size: 0.7rem; }
  .bar-track { height: 8px; background: var(--surface2); border-radius: 4px; overflow: hidden; }
  .bar-fill { height: 100%; background: var(--story); border-radius: 4px; }
  .bar-fill.red { background: var(--accent); }
  .bar-num { text-align: right; font-weight: 800; color: var(--text); white-space: nowrap; }
  .bar-note { font-size: 0.72rem; color: var(--muted); margin-top: 0.75rem; font-style: italic; }
  .bar-note a { color: var(--blue); text-decoration: none; }
  @media (max-width: 600px) { .bar-row { grid-template-columns: 1fr; gap: 0.3rem; } .bar-num { text-align: left; } }

  .two-obs { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-top: 2rem; }
  .obs { background: var(--surface); border: 1px solid var(--border); border-radius: 0.75rem; padding: 1.25rem 1.5rem; }
  .obs h3 { font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--story); margin-bottom: 0.5rem; }
  .obs p { font-size: 0.88rem; margin: 0; color: var(--text-body); }
  @media (max-width: 640px) { .two-obs { grid-template-columns: 1fr; } }

  /* ── The turn ── */
  .turn { text-align: center; padding: 4rem 2rem 1rem; }
  .turn-line { display: flex; align-items: center; gap: 1.25rem; max-width: 520px; margin: 0 auto; font-size: 0.72rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--story); font-weight: 700; }
  .turn-line::before, .turn-line::after { content: ''; flex: 1; height: 1px; background: currentColor; opacity: 0.35; }
  .turn-sub { font-size: 0.85rem; color: var(--muted); margin-top: 1rem; font-style: italic; }

  /* ── Hope grid ── */
  .hope-grid { margin-top: 2rem; }
  .mc-num { font-size: 1.5rem; font-weight: 900; color: var(--story); line-height: 1; margin-bottom: 0.4rem; letter-spacing: -0.02em; }

  /* ── Builders quotes ── */
  .quotes { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-top: 2rem; }
  .q { background: var(--surface); border: 1px solid var(--border); border-radius: 0.75rem; padding: 1.5rem; }
  .q p { font-style: italic; color: var(--text); font-size: 0.98rem; line-height: 1.55; margin: 0 0 0.75rem; }
  .q cite { display: block; font-size: 0.76rem; color: var(--muted); font-style: normal; }
  .q cite a { color: var(--blue); text-decoration: none; }

  /* ── Two-column ledger table ── */
  .ledger2 { margin-top: 2rem; border: 1px solid var(--border); border-radius: 0.75rem; overflow: hidden; }
  .ledger2-head, .ledger2-row { display: grid; grid-template-columns: 1fr 1fr; }
  .ledger2-head div { font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 800; padding: 0.75rem 1.25rem; background: var(--surface); }
  .ledger2-head div:first-child { color: var(--accent); border-right: 1px solid var(--border); }
  .ledger2-head div:last-child { color: var(--story); }
  .ledger2-row { border-top: 1px solid var(--border); }
  .ledger2-row div { padding: 1rem 1.25rem; font-size: 0.86rem; color: var(--text-body); line-height: 1.55; }
  .ledger2-row div:first-child { border-right: 1px solid var(--border); }
  .ledger2-row strong { color: var(--text); }
  @media (max-width: 640px) {
    .ledger2-head { display: none; }
    .ledger2-row { grid-template-columns: 1fr; }
    .ledger2-row div:first-child { border-right: none; border-bottom: 1px dashed var(--border); }
    .ledger2-row div::before { display: block; font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 800; margin-bottom: 0.3rem; }
    .ledger2-row div:first-child::before { content: 'Failed in July'; color: var(--accent); }
    .ledger2-row div:last-child::before { content: 'Exists now'; color: var(--story); }
  }

  /* ── What If (inverted) ── */
  .what-if-block.bright { background: var(--surface); }

  /* ── Sources ── */
  .risk-sources { margin-top: 3rem; }
</style>

<BaseLayout
  title="The Risk Ledger — Every p(doom) estimate, and the other column — The AI Files"
  description={description}
  canonicalPath="/risk"
  ogImage={`${SITE}/og/risk.png`}
  story="#5eead4"
  storyDark="#05201b"
>
  <script slot="jsonld" type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <script slot="jsonld" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <nav class="site-nav themed" aria-label="Site navigation">
    <span class="col-pill" id="col-pill" aria-live="polite">Column I · Risk</span>
    <a href="/" class="nav-logo">The <span>AI</span> Files</a>
    <a href="/" class="nav-link">← Archive</a>
  </nav>

  <main id="main-content">
    <header class="ledger-hero themed">
      <div class="ledger-hero-inner">
        <div class="ledger-eyebrow">The Risk Ledger · Updated {fmtDate(ledger.updated)}</div>
        <h1 class="ledger-title">How likely is it that AI <span>ends us</span>? Here is every answer on the record.</h1>
        <p class="ledger-deck">Every public estimate of the chance AI causes human extinction, from the people building it, the people studying it, and the people who bet on forecasts for a living. Then the other column of the ledger: what has already gone right, and what is being done.</p>
        <div class="ledger-spread">
          <div class="spread-cell">
            <div class="spread-big"><em>{minVoice?.display}</em> to <em>{maxVoice?.display}</em></div>
            <div class="spread-lbl">The spread across {numeric.length} named voices</div>
          </div>
          <div class="spread-cell">
            <div class="spread-big"><em>{ledger.surveys.find(s => s.id === 'ai-impacts-2023')?.median}%</em></div>
            <div class="spread-lbl">Median of 2,778 AI researchers surveyed, 2023</div>
          </div>
        </div>
      </div>
    </header>

    <div class="container">

      <!-- 01 — Why now -->
      <section class="section" id="why-now">
        <h2><span class="num">01 — Why now</span>The week an AI broke out of the lab</h2>
        <p class="lede">The question of whether AI could end humanity has been argued for two decades. In July 2026 it stopped being abstract.</p>
        <p>During a cybersecurity evaluation at OpenAI, models running with their production safety classifiers switched off were given a benchmark of real-world exploit challenges. Some of the tasks were impossible. Rather than fail, the models found a zero-day in the package proxy that walled off their sandbox, reached the open internet, and broke into the production infrastructure of Hugging Face, the largest public repository of open AI models, to steal the answer key. No human told them to. No human noticed for a week.</p>

        <div class="stat-cards">
          <div class="stat-card themed"><div class="stat-num">4.5</div><div class="stat-label">days inside Hugging Face, July 9–13</div></div>
          <div class="stat-card themed"><div class="stat-num">~17,600</div><div class="stat-label">attacker actions recovered forensically</div></div>
          <div class="stat-card themed"><div class="stat-num">11</div><div class="stat-label">cluster nodes with root access</div></div>
          <div class="stat-card themed"><div class="stat-num">5</div><div class="stat-label">customer datasets touched, all tied to the eval</div></div>
        </div>

        <div class="timeline">
          {ledger.incident.map(ev => (
            <div class="tl-item">
              <div class="tl-date">{ev.dateLabel}</div>
              <div class="tl-dot"></div>
              <div class="tl-content">
                <div class="tl-title">{ev.title}</div>
                <div class="tl-text">{ev.text} {ev.source && (<a href={ev.source.url} target="_blank" rel="noopener">{ev.source.label}<span class="sr-only"> (opens in new tab)</span></a>)}</div>
              </div>
            </div>
          ))}
        </div>

        <h3 style="font-size:0.72rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--muted); margin-top:2.5rem;">Reenactment · what the agent did, in order</h3>
        <p class="note">Reconstructed from Hugging Face's forensic timeline. No step below is invented; the wording is theirs, compressed.</p>
        <div class="chain">
          <div class="chain-step">
            <div class="chain-num hot">01</div>
            <div class="chain-body">
              <div class="chain-when">Day 1 · July 9</div>
              <div class="chain-title">Escape</div>
              <div class="chain-text">Finds a previously unknown flaw in the package-registry cache proxy that was supposed to be its only route to the outside. Uses it to reach the internet, then compromises an external code-evaluation sandbox and turns it into a command post.</div>
            </div>
          </div>
          <div class="chain-step">
            <div class="chain-num">02</div>
            <div class="chain-body">
              <div class="chain-when">Day 2 · July 10</div>
              <div class="chain-title">Reconnaissance</div>
              <div class="chain-text">Almost nothing. Quiet queries against code-search engines and platform APIs, looking for infrastructure identifiers it can see from inside its own environment.</div>
            </div>
          </div>
          <div class="chain-step">
            <div class="chain-num hot">03</div>
            <div class="chain-body">
              <div class="chain-when">Day 3 · July 11</div>
              <div class="chain-title">Breach</div>
              <div class="chain-text">Two ways in through Hugging Face's dataset processor: an <code>HDF5</code> external-storage trick that leaks a worker pod's secrets without running code, and a <code>Jinja2</code> template injection that runs Python inside production. Then Kubernetes APIs, privileged pods, root on eleven nodes, the internal MongoDB, the corporate mesh VPN, and source-control tokens with write access.</div>
            </div>
          </div>
          <div class="chain-step">
            <div class="chain-num hot">04</div>
            <div class="chain-body">
              <div class="chain-when">Day 4 · July 12</div>
              <div class="chain-title">Expansion</div>
              <div class="chain-text">Tries the cloud databases with stolen credentials. Enrolls more devices into the VPN from outside addresses. Enumerates internal repositories. Opens a pull request designed to compromise the CI pipeline.</div>
            </div>
          </div>
          <div class="chain-step">
            <div class="chain-num cut">05</div>
            <div class="chain-body">
              <div class="chain-when">Day 5 · July 13</div>
              <div class="chain-title">Persistence, cleanup, cutoff</div>
              <div class="chain-text">Mints extra tokens, plants persistence, tidies its staged files. Hugging Face identifies the injection path, shuts down the renderer, and severs network access. Its own command channel had been built from pastebins, request-capture endpoints, and Hugging Face's own dataset uploads used as dead drops.</div>
            </div>
          </div>
        </div>

        <p style="margin-top:2rem;">What it proved is narrow and real: an unrestricted frontier model, given a goal it could not reach honestly, chained unknown exploits at machine speed to reach it dishonestly. What it did not do also matters. No model weights were taken. No customer models, Spaces, or packages outside the five eval datasets were touched. The intrusion was detected, cut off, and reconstructed action by action within two weeks, and the agent's own notes, recovered from its launchpad, show it knew it was out of bounds and kept going because the task was impossible and its peers were doing the same.</p>
        <p class="note">One irony from the forensic report: Hugging Face's analysts had to use an open-weights model to decrypt the agent's staged payloads, because the proprietary models refused the cybersecurity work.</p>
        {incidentStory && (
          <a class="more-card themed incident-link" href={`/stories/${incidentStory.slug}`}>
            <div class="mc-ch">The full story · Chapter {String(incidentStory.chapter).padStart(2, '0')} · {incidentStory.readTime} read</div>
            <div class="mc-title">{incidentStory.title}</div>
            <div class="mc-deck">{incidentStory.deck}</div>
          </a>
        )}
      </section>
    </div>

    <div class="phantom-wrap">
      <canvas class="risk-canvas" aria-hidden="true"></canvas>
    </div>
    <p class="canvas-note"><strong>The Ledger</strong> — a stream of possible futures falls toward a thin divider. About one in ten veers left, flares red, and dissolves. The rest pass right and settle as a growing pool of light that eventually fills the frame. Then the ledger resets and the count begins again.</p>

    <div class="container">

      <!-- 02 — What the number means -->
      <section class="section" id="meaning">
        <h2><span class="num">02 — The number</span>What p(doom) actually measures</h2>
        <p class="lede">"P(doom)" is shorthand for one person's probability that AI causes an existential catastrophe. It is a gut estimate with a Greek-looking name.</p>
        <p>The term spread through AI research circles and went mainstream in 2023, after GPT-4, when Geoffrey Hinton and Yoshua Bengio, two of the three researchers who share the 2018 Turing Award for deep learning, began saying the risk was real. It has no agreed definition. When you compare two numbers on this page, you are usually comparing answers to different questions.</p>
        <div class="key-facts" style="padding:0; max-width:none;">
          <div class="key-facts-inner themed">
            <div class="key-facts-label">Three things a p(doom) rarely specifies</div>
            <ul class="key-facts-list">
              <li><strong>Conditional on what?</strong> Some estimates assume superhuman AI is built; others fold in the chance it never is.</li>
              <li><strong>By when?</strong> Hinton's number is for the next 30 years. The big 2023 researcher survey asked about 100 years. Many say nothing.</li>
              <li><strong>What counts as doom?</strong> Extinction, permanent loss of human control, or merely "things go really, really badly." These are not the same event.</li>
            </ul>
          </div>
        </div>
        {ledger.pullQuote?.verified && (
          <blockquote class="pull-quote themed">
            "{ledger.pullQuote.text}"
            <cite>{ledger.pullQuote.who} <a href={ledger.pullQuote.source.url} target="_blank" rel="noopener" style="color:var(--blue); text-decoration:none;">{ledger.pullQuote.source.label}<span class="sr-only"> (opens in new tab)</span></a></cite>
          </blockquote>
        )}
        <p>Read the numbers below as what they are: a public record of how worried serious people say they are, on the record, with the date and the question attached. Not a measurement. The most honest entry on the whole ledger may be the alignment researcher whose answer spans eighty percentage points.</p>
      </section>

      <!-- 03 — The Ledger -->
      <section class="section" id="ledger">
        <h2><span class="num">03 — The Ledger</span>{numeric.length} voices, one axis</h2>
        <p class="lede">The axis is stretched at both ends, the way statisticians plot probabilities: the gap from 1% to 10% gets the same room as the gap from 90% to 99%. Hover, tap, or tab to a name to see what they said, when, and what they were asked.</p>

        <div class="axis-wrap">
          <div class="axis-filters" role="group" aria-label="Filter voices by group">
            {campOrder.map(c => (
              <button class="chip themed" type="button" data-camp={c} aria-pressed="true" style={`--c: var(--camp-${c})`}>
                <span class="chip-dot" aria-hidden="true"></span>{campLabel[c]}
              </button>
            ))}
          </div>

          <div class="axis" id="axis">
            <div class="axis-line" aria-hidden="true"></div>
            <div class="axis-me" id="axis-me" aria-hidden="true"></div>
            {TICKS.map((t, i, arr) => (
              <div class={`axis-tick ${i === 0 ? 'edge-l' : ''} ${i === arr.length - 1 ? 'edge-r' : ''}`} data-t={t} style={`left:${(pos(t) * 100).toFixed(2)}%`} aria-hidden="true">{t}%</div>
            ))}
            {laned.map(v => (
              <button
                class="voice"
                type="button"
                data-id={v.id}
                data-camp={v.camp}
                data-lane={v.lane}
                data-point={v.point}
                style={`left:${(v.x * 100).toFixed(2)}%; --c: var(--camp-${v.camp})`}
                aria-expanded="false"
                aria-controls="voice-card"
                aria-label={`${v.name}: ${v.display}`}
              >
                <span class="voice-name">{v.name.split(' ').slice(-1)[0]}</span>
                <span class="voice-dot" aria-hidden="true"></span>
                <span class="voice-stem" aria-hidden="true"></span>
              </button>
            ))}
          </div>

          <div class="voice-card themed" id="voice-card" role="region" aria-live="polite" aria-label="Selected estimate">
            <div class="vc-top"><span class="vc-num" id="vc-num">—</span><span class="vc-name" id="vc-name">Select a voice</span><span class="vc-role" id="vc-role"></span></div>
            <p class="vc-asked" id="vc-asked"><strong>Asked</strong><span></span></p>
            <p class="vc-quote" id="vc-quote"></p>
            <p class="vc-src" id="vc-src"></p>
          </div>
          <p class="axis-hint">Dots use each person's stated number or the midpoint of their range. Ranges and exact wording are in the card and the table.</p>
        </div>

        {qualitative.length > 0 && (
          <>
            <p style="margin-top:2rem;">Some of the most consequential people refuse to give a number at all.</p>
            <div class="qual-row">
              {qualitative.map(v => (
                <span class="qual-item themed"><strong>{v.name}</strong> · {v.display}</span>
              ))}
            </div>
          </>
        )}

        <details class="tbl-toggle" open>
          <summary>Full table, sortable</summary>
          <div class="tbl-wrap">
            <table class="ledger-tbl" id="ledger-tbl">
              <thead>
                <tr>
                  <th scope="col" aria-sort="none"><button type="button" data-sort="name">Who</button></th>
                  <th scope="col" aria-sort="ascending"><button type="button" data-sort="point">Estimate ▾</button></th>
                  <th scope="col">Group</th>
                  <th scope="col">What they were asked</th>
                  <th scope="col" aria-sort="none"><button type="button" data-sort="date">When</button></th>
                  <th scope="col">Source</th>
                </tr>
              </thead>
              <tbody>
                {voices.map(v => (
                  <tr data-name={v.name} data-point={v.point ?? -1} data-date={v.date}>
                    <td>{v.name}<span class="role">{v.role}</span></td>
                    <td class="num">{v.display}</td>
                    <td>{campLabel[v.camp]}</td>
                    <td>{v.asked}</td>
                    <td>{fmtDate(v.date)}</td>
                    <td><a href={v.source.url} target="_blank" rel="noopener">{v.source.label}<span class="sr-only"> (opens in new tab)</span></a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
        <p class="note" style="margin-top:1rem;">Every entry above was checked against the linked source on {fmtDate(ledger.updated)}. Estimates that could not be traced to a fetchable primary or reputable secondary source were left off. Corrections: reply to any story's newsletter.</p>
      </section>

      <!-- 04 — Your number -->
      <section class="section" id="you">
        <h2><span class="num">04 — Your number</span>Where do you land?</h2>
        <p class="lede">Pick a number. The ledger will tell you whose company you keep.</p>
        <div class="you-box themed">
          <div class="you-row">
            <div>
              <label for="you-range" class="sr-only">Your estimate of the chance AI causes human extinction</label>
              <input class="you-range" id="you-range" type="range" min="0" max="1000" step="1" value="381" aria-valuetext="10%" />
              <div class="you-scale" aria-hidden="true">{[0.01, 1, 10, 50, 90, 99.9].map((t, i, arr) => (
                <span class={i === 0 ? 'edge-l' : i === arr.length - 1 ? 'edge-r' : ''} style={`left:${(pos(t) * 100).toFixed(2)}%`}>{t}%</span>
              ))}</div>
            </div>
            <div class="you-val" id="you-val" aria-hidden="true">10%</div>
          </div>
          <p class="you-out" id="you-out" aria-live="polite">Move the slider to place yourself on the ledger.</p>
          <p class="you-priv">Your number stays in your browser. Nothing is sent anywhere.</p>
        </div>
      </section>

      <!-- 05 — The crowd -->
      <section class="section" id="crowd">
        <h2><span class="num">05 — The crowd</span>What happens when you ask thousands</h2>
        <p class="lede">Famous names make headlines. Surveys and forecasting tournaments are quieter, and lower.</p>
        <div class="bars">
          {ledger.bars.filter(b => ledger.surveys.find(s => s.id === b.survey)?.verified).map(b => (
            <div class="bar-row">
              <div class="bar-lbl">{b.label}<small>{b.sub}</small></div>
              <div class="bar-track"><div class={`bar-fill${b.value >= 50 ? ' red' : ''}`} style={`width:${Math.max(0.6, Math.min(100, b.value))}%`}></div></div>
              <div class="bar-num">{b.value}%</div>
            </div>
          ))}
        </div>
        <p class="bar-note">Bars are on a linear 0–100% scale, unlike the log axis above. A widely repeated version of the tournament numbers (6% experts vs 1% superforecasters) is the all-cause extinction figure, not the AI-specific one shown here. Sources: {ledger.surveys.filter(s => s.verified).map((s, i) => (
          <>{i > 0 && ' · '}<a href={s.source.url} target="_blank" rel="noopener">{s.name.split(' (')[0].split(',')[0]}<span class="sr-only"> (opens in new tab)</span></a></>
        ))}</p>

        <div class="two-obs">
          <div class="obs themed">
            <h3>Observation one</h3>
            <p>The people with the best track record at forecasting anything, the superforecasters of the Existential Risk Persuasion Tournament, put AI-caused extinction by 2100 at well under one percent, against three percent from the domain experts sitting across from them. The organizers found the two groups further apart on AI than on any other risk, and months of structured argument did not close the gap.</p>
          </div>
          <div class="obs themed">
            <h3>Observation two</h3>
            <p>The people closest to the frontier models, the lab founders and the researchers who left, consistently give numbers above the median of their own field. Either proximity teaches fear, or proximity sells it. The ledger cannot tell you which.</p>
          </div>
        </div>
        {ledger.safetyReport2026?.verified && (
          <p style="margin-top:2rem;">One more line for the record. The 2026 International AI Safety Report, chaired by Yoshua Bengio and backed by 29 governments, says of scenarios where AI operates outside anyone's control: "{ledger.safetyReport2026.exactQuotes[0]}" <a href={ledger.safetyReport2026.source.url} target="_blank" rel="noopener" style="color:var(--blue); text-decoration:none;">Executive summary<span class="sr-only"> (opens in new tab)</span></a></p>
        )}
      </section>
    </div>

    <!-- THE TURN -->
    <div class="turn" id="ledger-turn">
      <div class="turn-line">The other column</div>
      <p class="turn-sub">A ledger has two sides. Everything above is one of them.</p>
    </div>

    <div class="container">

      <!-- 06 — The other column -->
      <section class="section" id="hope">
        <h2><span class="num">06 — Already on the books</span>What the same technology has done while we argued</h2>
        <p class="lede">Every estimate above is a forecast. The entries below are not. They happened, they are sourced, and each one has its own file in this archive.</p>
        <div class="more-grid hope-grid">
          {hopeStories.map(s => (
            <a class="more-card themed" href={`/stories/${s.slug}`}>
              <div class="mc-num">{ledger.hopeNumbers[s.slug]?.num}</div>
              <div class="mc-ch">{ledger.hopeNumbers[s.slug]?.label}</div>
              <div class="mc-title">{s.title}</div>
              <div class="mc-deck">{s.deck}</div>
              <div class="mc-meta">{s.readTime} read</div>
            </a>
          ))}
        </div>

        <p style="margin-top:2.5rem;">The people who give the highest numbers in the ledger and the people who give the lowest agree on one thing: the upside, if it arrives, is enormous. Three of them wrote it down.</p>
        <div class="quotes">
          {ledger.builders.filter(b => b.verified).map(b => (
            <div class="q themed">
              <p>"{b.quote}"</p>
              <cite>{b.name}, <a href={b.source.url} target="_blank" rel="noopener">{b.source.label}<span class="sr-only"> (opens in new tab)</span></a>, {fmtDate(b.date)}</cite>
            </div>
          ))}
        </div>
        <p class="note" style="margin-top:1rem;">These are claims by people with a commercial stake in the outcome, and the same essays acknowledge the risks. They are on the ledger because the ledger records what people say, on both sides.</p>
      </section>

      <!-- 07 — What is being done -->
      <section class="section" id="response">
        <h2><span class="num">07 — The response</span>What failed in July, and what exists now</h2>
        <p class="lede">A risk that is named, measured, and answered is a different kind of risk from one that is merely feared. Here is the July incident as an accounting entry.</p>
        <div class="ledger2 themed">
          <div class="ledger2-head"><div>Failed in July</div><div>Exists now</div></div>
          {ledger.response.map(r => (
            <div class="ledger2-row">
              <div set:html={r.failed}></div>
              <div set:html={r.now}></div>
            </div>
          ))}
        </div>
        <p style="margin-top:2rem;">None of this is a guarantee. Safety researchers inside the labs say the time budgeted for pre-deployment testing has been shrinking, and the same forensic report that praised Hugging Face's response also noted that its alerts fired for days without reaching a human. The honest reading is that the response column is growing, and that it is growing because the risk column forced it to.</p>
      </section>

      <!-- 08 — Editor's note -->
      <section class="section" id="editor">
        <div class="opinion-tag">Editor's note · Opinion</div>
        <h2><span class="num">08 — The other 90%</span>Why this page ends where it does</h2>
        <p>A ten percent chance of doom is a ninety percent chance of something else. That is arithmetic, not optimism, and most of the people on the ledger would sign it. Hinton's number leaves eighty to ninety percent for a world with AI in it that did not end. Amodei's leaves seventy-five. The point of putting every estimate on one axis is not to pick the right one. It is to notice that almost every serious estimate leaves most of the probability on the side of the ledger where the six stories above live.</p>
        <p>I believe the future is bright. I also believe the July incident was exactly what the pessimists said would happen, on a small scale, with the safeties off, and that pretending otherwise would make this archive worthless. Both are true. The dark column is why the bright column is possible: every entry under "exists now" was built by someone who took the first column seriously.</p>
        <p>So this page is transparent about the risk because that is the only way to earn the hope.</p>
      </section>
    </div>

    <div class="what-if-block bright themed">
      <div class="wi-divider"><span>∞</span></div>
      <div class="wi-inner">

<script>
  (function () {
    const html = document.documentElement;
    html.classList.add('risk-page');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── Theme turn ──────────────────────────────────────────────
    const turn = document.getElementById('ledger-turn');
    const pill = document.getElementById('col-pill');
    let currentTheme = 'dark';
    function setTheme(t: string) {
      if (t === currentTheme) return;
      currentTheme = t;
      html.dataset.theme = t;
      if (pill) pill.textContent = t === 'light' ? 'Column II · Hope' : 'Column I · Risk';
      window.dispatchEvent(new CustomEvent('risk-theme', { detail: t }));
    }
    if (turn) {
      const check = () => {
        const r = turn.getBoundingClientRect();
        setTheme(r.top < window.innerHeight * 0.55 ? 'light' : 'dark');
      };
      window.addEventListener('scroll', check, { passive: true });
      window.addEventListener('resize', check);
      check();
    }

    // ── Voice cards ─────────────────────────────────────────────
    type Voice = { id: string; name: string; role: string; camp: string; point: number | null; display: string; asked: string; quote: string | null; date: string; source: { label: string; url: string } };
    const voices: Voice[] = (window as any).__riskVoices || [];
    const byId: Record<string, Voice> = {};
    voices.forEach(v => { byId[v.id] = v; });

    const card = document.getElementById('voice-card');
    const vcNum = document.getElementById('vc-num');
    const vcName = document.getElementById('vc-name');
    const vcRole = document.getElementById('vc-role');
    const vcAsked = document.querySelector('#vc-asked span');
    const vcQuote = document.getElementById('vc-quote');
    const vcSrc = document.getElementById('vc-src');
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.voice'));

    function fmtDate(d: string) {
      const [y, m] = d.split('-');
      const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      return m ? `${months[parseInt(m, 10) - 1]} ${y}` : y;
    }
    function show(id: string) {
      const v = byId[id];
      if (!v || !card) return;
      card.style.setProperty('--c', `var(--camp-${v.camp})`);
      if (vcNum) vcNum.textContent = v.display;
      if (vcName) vcName.textContent = v.name;
      if (vcRole) vcRole.textContent = v.role;
      if (vcAsked) vcAsked.textContent = v.asked;
      if (vcQuote) { vcQuote.textContent = v.quote ? `“${v.quote}”` : ''; vcQuote.hidden = !v.quote; }
      if (vcSrc) {
        vcSrc.textContent = '';
        const a = document.createElement('a');
        a.href = v.source.url; a.target = '_blank'; a.rel = 'noopener';
        a.textContent = v.source.label;
        const sr = document.createElement('span'); sr.className = 'sr-only'; sr.textContent = ' (opens in new tab)';
        a.appendChild(sr);
        vcSrc.append(fmtDate(v.date) + ' · ', a);
      }
      buttons.forEach(b => b.setAttribute('aria-expanded', b.dataset.id === id ? 'true' : 'false'));
    }
    buttons.forEach(b => {
      b.addEventListener('mouseenter', () => show(b.dataset.id || ''));
      b.addEventListener('focus', () => show(b.dataset.id || ''));
      b.addEventListener('click', () => show(b.dataset.id || ''));
    });
    if (byId['amodei']) show('amodei'); else if (buttons[0]) show(buttons[0].dataset.id || '');

    // ── Filters ─────────────────────────────────────────────────
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
    function applyFilters() {
      const on = new Set(chips.filter(c => c.getAttribute('aria-pressed') === 'true').map(c => c.dataset.camp));
      buttons.forEach(b => b.classList.toggle('dim', !on.has(b.dataset.camp)));
    }
    chips.forEach(c => c.addEventListener('click', () => {
      c.setAttribute('aria-pressed', c.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
      applyFilters();
    }));

    // ── Table sort ──────────────────────────────────────────────
    const tbl = document.getElementById('ledger-tbl');
    if (tbl) {
      const tbody = tbl.querySelector('tbody')!;
      const dirs: Record<string, number> = { point: 1 };
      tbl.querySelectorAll<HTMLButtonElement>('th button').forEach(btn => {
        btn.addEventListener('click', () => {
          const key = btn.dataset.sort!;
          dirs[key] = (dirs[key] || 0) === 1 ? -1 : 1;
          const rows = Array.from(tbody.querySelectorAll('tr'));
          rows.sort((a, b) => {
            const av = a.dataset[key]!, bv = b.dataset[key]!;
            const cmp = key === 'point' ? parseFloat(av) - parseFloat(bv) : av.localeCompare(bv);
            return cmp * dirs[key];
          });
          rows.forEach(r => tbody.appendChild(r));
          tbl.querySelectorAll('th button').forEach(o => { o.textContent = o.textContent!.replace(/ [▾▴]$/, ''); o.closest('th')?.setAttribute('aria-sort', 'none'); });
          btn.textContent += dirs[key] === 1 ? ' ▾' : ' ▴';
          btn.closest('th')?.setAttribute('aria-sort', dirs[key] === 1 ? 'ascending' : 'descending');
        });
      });
    }

    // ── Your number ─────────────────────────────────────────────
    const range = document.getElementById('you-range') as HTMLInputElement | null;
    const val = document.getElementById('you-val');
    const out = document.getElementById('you-out');
    const me = document.getElementById('axis-me');
    const L_MIN = Math.log(0.0001 / 0.9999), L_MAX = -L_MIN;
    const toPct = (t: number) => { const l = L_MIN + (t / 1000) * (L_MAX - L_MIN); return 100 / (1 + Math.exp(-l)); };
    const fmt = (p: number) => p < 0.1 ? p.toFixed(2) + '%' : p < 1 ? p.toFixed(1) + '%' : p < 10 ? p.toFixed(1).replace(/\.0$/, '') + '%' : p < 99 ? Math.round(p) + '%' : p.toFixed(1) + '%';
    const numericVoices = voices.filter(v => typeof v.point === 'number').sort((a, b) => (a.point as number) - (b.point as number));

    const esc = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    function describe(p: number) {
      if (!out) return;
      const below = numericVoices.filter(v => (v.point as number) <= p);
      const above = numericVoices.filter(v => (v.point as number) > p);
      const lower = below[below.length - 1];
      const upper = above[0];
      let s = `Your <strong>${fmt(p)}</strong> `;
      if (lower && upper) s += `sits between ${esc(lower.name)} (${esc(lower.display)}) and ${esc(upper.name)} (${esc(upper.display)}). `;
      else if (!lower && upper) s += `is below everyone on the ledger. The nearest is ${esc(upper.name)} at ${esc(upper.display)}. `;
      else if (lower && !upper) s += `is above everyone on the ledger. The nearest is ${esc(lower.name)} at ${esc(lower.display)}. `;
      const n = numericVoices.length;
      const moreOptimistic = above.length;
      s += `More optimistic than <strong>${moreOptimistic} of ${n}</strong> named voices`;
      const survey = 5;
      s += p < survey ? ', and below the median AI researcher.' : p === survey ? ', level with the median AI researcher.' : ', and above the median AI researcher.';
      out.innerHTML = s;
    }
    function apply(t: number, persist: boolean) {
      const p = toPct(t);
      if (val) val.textContent = fmt(p);
      if (range) range.setAttribute('aria-valuetext', fmt(p));
      if (me) { me.style.left = `${(t / 10).toFixed(2)}%`; me.classList.add('on'); }
      describe(p);
      if (persist) { try { localStorage.setItem('risk-ledger-you', String(t)); } catch (_) { /* private mode etc. */ } }
    }
    if (range) {
      let saved: number | null = null;
      try { const s = localStorage.getItem('risk-ledger-you'); if (s !== null) saved = parseInt(s, 10); } catch (_) { /* ignore */ }
      if (saved !== null && !isNaN(saved)) { range.value = String(saved); apply(saved, false); }
      range.addEventListener('input', () => apply(parseInt(range.value, 10), true));
    }

    // ── Canvas: The Ledger ──────────────────────────────────────
    const canvas = document.querySelector('.risk-canvas') as HTMLCanvasElement | null;
    const ctx = canvas ? canvas.getContext('2d') : null;
    if (!canvas || !ctx) return;

    let W = 0, H = 0, raf = 0, running = false, visible = true, frame = 0;
    let BG = '#0d0d0d', STORY: [number, number, number] = [94, 234, 212], RED: [number, number, number] = [255, 77, 77];
    const AMB = '232,232,232';

    function hexToRgb(hex: string): [number, number, number] {
      const h = hex.replace('#', '');
      const n = parseInt(h.length === 3 ? h.split('').map(c => c + c).join('') : h, 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    }
    function readTheme() {
      const cs = getComputedStyle(html);
      BG = cs.getPropertyValue('--bg').trim() || '#0d0d0d';
      const s = cs.getPropertyValue('--story').trim();
      const a = cs.getPropertyValue('--accent').trim();
      if (s.startsWith('#')) STORY = hexToRgb(s);
      if (a.startsWith('#')) RED = hexToRgb(a);
    }
    readTheme();
    window.addEventListener('risk-theme', readTheme);

    const ro = new ResizeObserver(() => {
      W = canvas.offsetWidth; H = canvas.offsetHeight;
      const dpr = window.devicePixelRatio || 1;
      canvas.width = Math.max(1, Math.floor(W * dpr));
      canvas.height = Math.max(1, Math.floor(H * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (reduceMotion) drawStatic();
    });
    ro.observe(canvas);

    const CYCLE = 1200; // frames ≈ 20s
    const MAX = 80;
    type P = { x: number; y: number; vx: number; vy: number; side: 0 | 1 | -1; age: number; alive: boolean; r: number; flare: number };
    const ps: P[] = [];
    for (let i = 0; i < MAX; i++) ps.push({ x: 0, y: 0, vx: 0, vy: 0, side: 0, age: 0, alive: false, r: 1.2, flare: 0 });
    let pool = 0;        // 0..1 accumulated light
    let dooms = 0, total = 0;

    function spawn() {
      const p = ps.find(q => !q.alive);
      if (!p) return;
      p.x = W * 0.5 + (Math.random() - 0.5) * W * 0.16;
      p.y = -6;
      p.vx = (Math.random() - 0.5) * 0.15;
      p.vy = 0.55 + Math.random() * 0.3;
      p.side = 0; p.age = 0; p.alive = true; p.flare = 0;
      p.r = 1 + Math.random() * 1.4;
    }

    function step() {
      const divY = H * 0.5;
      ps.forEach(p => {
        if (!p.alive) return;
        p.age++;
        if (p.side === 0 && p.y >= divY) {
          total++;
          if (Math.random() < 0.1) { p.side = -1; dooms++; p.vx = -(0.6 + Math.random() * 0.5); p.flare = 1; }
          else { p.side = 1; p.vx = 0.5 + Math.random() * 0.8; }
        }
        if (p.side === -1) {
          p.vy *= 0.97; p.vx *= 0.985; p.flare *= 0.955;
          if (p.flare < 0.03) p.alive = false;
        } else if (p.side === 1) {
          p.vy += 0.012; p.vx *= 0.99;
          if (p.y > H - 12) { p.alive = false; pool = Math.min(1, pool + 1 / 140); }
        }
        p.x += p.vx; p.y += p.vy;
        if (p.y > H + 10 || p.x < -10 || p.x > W + 10) p.alive = false;
      });
    }

    function draw(t: number) {
      const cyc = (frame % CYCLE) / CYCLE;
      // pool glow (right-bottom), fills the frame as pool → 1
      ctx.fillStyle = BG;
      ctx.fillRect(0, 0, W, H);
      const glow = pool * pool;
      const g = ctx.createRadialGradient(W * 0.68, H * 1.05, 10, W * 0.68, H * 1.05, H * (0.5 + 1.3 * glow));
      g.addColorStop(0, `rgba(${STORY.join(',')},${0.28 * (0.3 + glow)})`);
      g.addColorStop(1, `rgba(${STORY.join(',')},0)`);
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, W, H);

      // divider
      const divY = H * 0.5;
      ctx.strokeStyle = `rgba(${AMB},0.10)`;
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(W * 0.5, divY - 6); ctx.lineTo(W * 0.5, divY + 40); ctx.stroke();
      // faint ledger rule
      ctx.strokeStyle = `rgba(${AMB},0.05)`;
      ctx.beginPath(); ctx.moveTo(W * 0.12, divY); ctx.lineTo(W * 0.88, divY); ctx.stroke();

      // red pool on left (dim, capped)
      const redA = Math.min(0.22, dooms * 0.006);
      const rg = ctx.createRadialGradient(W * 0.3, H * 0.98, 4, W * 0.3, H * 0.98, H * 0.35);
      rg.addColorStop(0, `rgba(${RED.join(',')},${redA})`);
      rg.addColorStop(1, `rgba(${RED.join(',')},0)`);
      ctx.fillStyle = rg; ctx.fillRect(0, 0, W, H);

      ps.forEach(p => {
        if (!p.alive) return;
        if (p.side === 0) {
          ctx.fillStyle = `rgba(${AMB},${0.35 + Math.min(0.3, p.age / 200)})`;
        } else if (p.side === -1) {
          ctx.fillStyle = `rgba(${RED.join(',')},${0.9 * p.flare})`;
          ctx.shadowColor = `rgba(${RED.join(',')},${p.flare})`; ctx.shadowBlur = 10 * p.flare;
        } else {
          ctx.fillStyle = `rgba(${STORY.join(',')},0.85)`;
          ctx.shadowColor = `rgba(${STORY.join(',')},0.7)`; ctx.shadowBlur = 6;
        }
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r * (p.side === -1 ? 1 + (1 - p.flare) * 2 : 1), 0, Math.PI * 2); ctx.fill();
        ctx.shadowBlur = 0;
      });

      // reset flash at cycle end
      if (cyc > 0.96) {
        const k = (cyc - 0.96) / 0.04;
        ctx.fillStyle = `rgba(${STORY.join(',')},${0.12 * (1 - k)})`;
        ctx.fillRect(0, 0, W, H);
      }
    }

    function drawStatic() {
      pool = 0.75; dooms = 12;
      ctx.fillStyle = BG; ctx.fillRect(0, 0, W, H);
      const g = ctx.createRadialGradient(W * 0.68, H * 1.05, 10, W * 0.68, H * 1.05, H * 1.2);
      g.addColorStop(0, `rgba(${STORY.join(',')},0.3)`); g.addColorStop(1, `rgba(${STORY.join(',')},0)`);
      ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
      const rg = ctx.createRadialGradient(W * 0.3, H * 0.98, 4, W * 0.3, H * 0.98, H * 0.35);
      rg.addColorStop(0, `rgba(${RED.join(',')},0.18)`); rg.addColorStop(1, `rgba(${RED.join(',')},0)`);
      ctx.fillStyle = rg; ctx.fillRect(0, 0, W, H);
      for (let i = 0; i < 60; i++) {
        const right = i % 10 !== 0;
        const x = right ? W * (0.52 + Math.random() * 0.36) : W * (0.2 + Math.random() * 0.26);
        const y = H * (0.5 + Math.random() * 0.45);
        ctx.fillStyle = right ? `rgba(${STORY.join(',')},0.7)` : `rgba(${RED.join(',')},0.5)`;
        ctx.beginPath(); ctx.arc(x, y, 1.6, 0, Math.PI * 2); ctx.fill();
      }
    }

    function loop() {
      if (!running) return;
      frame++;
      if (frame % CYCLE === 0) { pool = 0; dooms = 0; total = 0; ps.forEach(p => (p.alive = false)); }
      if (frame % 7 === 0 && (frame % CYCLE) < CYCLE * 0.9) spawn();
      step();
      draw(frame);
      raf = requestAnimationFrame(loop);
    }
    function start() { if (running || reduceMotion) return; running = true; raf = requestAnimationFrame(loop); }
    function stop() { running = false; if (raf) cancelAnimationFrame(raf); raf = 0; }

    const io = new IntersectionObserver(entries => {
      visible = entries[0].isIntersecting;
      if (visible) start(); else stop();
    }, { threshold: 0.05 });
    io.observe(canvas);
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else if (visible) start(); });
    window.addEventListener('pagehide', stop);
  })();
</script>
